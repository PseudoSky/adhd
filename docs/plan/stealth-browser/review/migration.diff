index 000000000..af8e5955a
--- /dev/null
+++ b/packages/resilience/resilience-core-tripwire/test/unit/scenario-agent-search.spec.ts
@@ -0,0 +1,296 @@
+/**
+ * guards: the agent-search flow reaches Chrome past a tripped key, or the HITL and expiry paths regress end to end
+ * tier: S
+ * cites: ticket 8468f7b1; [tripwire-interactive.7] (TW13, TW15, TW18, TW24, TW26).
+ * Ticket 8468f7b1 - scenario: the agent-search consumer, end to end on the
+ * memory fs, with its real configuration (clearPolicy 'open', expiry
+ * ttlMs 2 h, namespace agent-search). A miniature search mirrors the
+ * MCP and CLI flows: the tripwire gate runs before Chrome is touched; a
+ * captcha trips the provider key; later searches get a locked `hitl`
+ * response without touching Chrome; the CLI HITL loop (interactiveGate)
+ * offers retry, clear and abort; confirmSolved handles the post-trip
+ * prompt; the TTL expiry removes the lock lazily with an audit line; a
+ * successful search resolves a still-tripped key; the MCP clear needs no
+ * token.
+ * Criteria: [tripwire-interactive.7] (TW13, TW15, TW18, TW24, TW26).
+ */
+import {
+  TripwireAbortedError,
+  confirmSolved,
+  interactiveGate,
+  renderStatusText,
+  statusJsonLine,
+  type TripwireIo,
+  type TripwireRecord,
+} from '../../src/index';
+import { eventsOf, makeEnv, rejectionOf, type Env } from '../helpers/harness';
+import { fakeIo } from '../helpers/io';
+
+const TWO_HOURS = 7_200_000;
+const PAGE = 'https://www.google.com/sorry/index';
+
+type Outcome = 'ok' | 'captcha';
+
+interface SearchResponse {
+  outcome: 'ok' | 'hitl';
+  locked?: boolean;
+  record?: TripwireRecord | null;
+  hitl?: { reason: string; pageUrl: string; strategy: string };
+}
+
+function agentSearchEnv(): Env {
+  return makeEnv({
+    namespace: 'agent-search',
+    clearPolicy: 'open',
+    expiry: { ttlMs: TWO_HOURS },
+    sessionId: () => 'search-session-1',
+  });
+}
+
+/** The agent-search consumer in miniature. */
+function agentSearch(env: Env, outcomes: Outcome[]) {
+  const tw = env.tw;
+  const chrome = { ready: 0 };
+  const script = [...outcomes];
+
+  /** The MCP path: a locked key answers `hitl` without touching Chrome. */
+  async function search(provider: string, query: string):
+  Promise<SearchResponse> {
+    const g = await tw.gate(provider);
+    if (!g.open) {
+      return { outcome: 'hitl', locked: true, record: g.snapshot.record };
+    }
+    return run(provider, query);
+  }
+
+  async function run(provider: string, query: string):
+  Promise<SearchResponse> {
+    chrome.ready += 1;
+    const outcome = script.shift() ?? 'ok';
+    if (outcome === 'captcha') {
+      await tw.trip(provider, {
+        reason: 'captcha',
+        context: {
+          query,
+          pageUrl: PAGE,
+          strategy: 'serp',
+          browserSessionId: 'target-1',
+        },
+      });
+      return {
+        outcome: 'hitl',
+        hitl: { reason: 'captcha', pageUrl: PAGE, strategy: 'serp' },
+      };
+    }
+    // a later success resolves a tripwire that is still tripped
+    if ((await tw.read(provider)).status !== 'clear') {
+      await tw.resolve(provider);
+    }
+    return { outcome: 'ok' };
+  }
+
+  /** The CLI path: HITL gate loop, then the post-trip prompt. */
+  async function cliSearch(
+    provider: string,
+    query: string,
+    io: TripwireIo,
+  ): Promise<SearchResponse> {
+    await interactiveGate(tw, provider, io, { keyLabel: 'Provider' });
+    for (;;) {
+      const r = await run(provider, query);
+      if (r.outcome !== 'hitl' || !r.hitl) return r;
+      await confirmSolved(tw, provider, {
+        ...r.hitl,
+        query,
+        sessionId: 'search-session-1',
+      }, io, { keyLabel: 'Provider' });
+    }
+  }
+
+  /** The part of a search after its gate passed (an in-flight search). */
+  const afterGate = run;
+
+  return { chrome, search, cliSearch, afterGate };
+}
+
+describe('[tripwire-interactive.7] agent-search: captcha trips, later ' +
+  'searches are locked', () => {
+  it('a captcha trips the provider key with the forensic context',
+    async () => {
+      const env = agentSearchEnv();
+      const s = agentSearch(env, ['captcha']);
+      const r = await s.search('google', 'tripwire latch');
+      expect(r.outcome).toBe('hitl');
+      const snap = await env.tw.read('google');
+      expect(snap.status).toBe('tripped');
+      expect(snap.record).toMatchObject({
+        namespace: 'agent-search',
+        reason: 'captcha',
+        trippedBy: { sessionId: 'search-session-1' },
+        context: {
+          query: 'tripwire latch',
+          pageUrl: PAGE,
+          strategy: 'serp',
+          browserSessionId: 'target-1',
+        },
+      });
+      // the query text is never audited
+      expect(env.auditText()).not.toContain('tripwire latch');
+    });
+
+  it('later searches get a locked hitl response without touching Chrome',
+    async () => {
+      const env = agentSearchEnv();
+      const s = agentSearch(env, ['captcha']);
+      await s.search('google', 'q');
+      expect(s.chrome.ready).toBe(1);
+      for (let i = 1; i <= 3; i++) {
+        const r = await s.search('google', `q${i}`);
+        expect(r).toMatchObject({ outcome: 'hitl', locked: true });
+        expect(r.record?.reason).toBe('captcha');
+        expect(r.record?.blockedCount).toBe(i);
+      }
+      expect(s.chrome.ready).toBe(1);
+      // other providers still search
+      expect((await s.search('bing', 'q')).outcome).toBe('ok');
+      // status: one sparse entry, rendered with the JSON line last
+      const map = await env.tw.status();
+      expect(Object.keys(map)).toEqual(['google']);
+      expect(renderStatusText(map)).toContain('  blockedCount: 3');
+      expect(JSON.parse(statusJsonLine(map)).status.google.reason)
+        .toBe('captcha');
+    });
+});
+
+describe('[tripwire-interactive.7] agent-search: the HITL loop offers ' +
+  'retry, clear and abort', () => {
+  async function trippedSearch(): Promise<{
+    env: Env;
+    s: ReturnType<typeof agentSearch>;
+  }> {
+    const env = agentSearchEnv();
+    const s = agentSearch(env, ['captcha', 'ok']);
+    await s.search('google', 'q');
+    return { env, s };
+  }
+
+  it('retry: reverified + clear, then the search runs', async () => {
+    const { env, s } = await trippedSearch();
+    const io = fakeIo(['retry']);
+    expect((await s.cliSearch('google', 'q', io)).outcome).toBe('ok');
+    expect(io.errText()).toContain('  Provider:    google');
+    expect(eventsOf(env, 'tripwire-cleared')).toEqual([
+      expect.objectContaining({ method: 'hitl-retry', reverified: true }),
+    ]);
+    expect(s.chrome.ready).toBe(2);
+  });
+
+  it('clear: force-clear (hitl-clear), then the search runs', async () => {
+    const { env, s } = await trippedSearch();
+    expect((await s.cliSearch('google', 'q', fakeIo(['clear']))).outcome)
+      .toBe('ok');
+    expect(eventsOf(env, 'tripwire-cleared')).toEqual([
+      expect.objectContaining({ method: 'hitl-clear', reverified: false }),
+    ]);
+  });
+
+  it('abort: TripwireAbortedError, Chrome untouched, lock kept', async () => {
+    const { env, s } = await trippedSearch();
+    const err = await rejectionOf(s.cliSearch('google', 'q', fakeIo(['abort'])));
+    expect(err).toBeInstanceOf(TripwireAbortedError);
+    expect(s.chrome.ready).toBe(1);
+    expect((await env.tw.read('google')).status).toBe('tripped');
+  });
+
+  it('closed stdin aborts instead of hanging; the lock is kept', async () => {
+    const { env, s } = await trippedSearch();
+    const err = await rejectionOf(s.cliSearch('google', 'q', fakeIo([null])));
+    expect(err).toBeInstanceOf(TripwireAbortedError);
+    expect((await env.tw.read('google')).status).toBe('tripped');
+  });
+
+  it('a captcha during a CLI search: Enter after solving clears and ' +
+    'retries; abort keeps the lock for the next invocation', async () => {
+    const env = agentSearchEnv();
+    const s = agentSearch(env, ['captcha', 'ok', 'captcha']);
+    const io = fakeIo(['']);
+    expect((await s.cliSearch('google', 'q', io)).outcome).toBe('ok');
+    expect(io.errText()).toContain('HUMAN-IN-THE-LOOP INTERRUPT');
+    expect(io.errText()).toContain('  Session:      search-session-1');
+    expect(eventsOf(env, 'tripwire-cleared')).toEqual([
+      expect.objectContaining({ method: 'hitl-retry', reverified: true }),
+    ]);
+    const err = await rejectionOf(s.cliSearch('google', 'q', fakeIo(['abort'])));
+    expect((err as Error).message).toBe('HITL aborted by user');
+    const next = await s.search('google', 'q');
+    expect(next).toMatchObject({ outcome: 'hitl', locked: true });
+  });
+
+  it('the MCP clear (policy open) needs no token', async () => {
+    const { env, s } = await trippedSearch();
+    expect(await env.tw.clear('google', { method: 'mcp-clear' }))
+      .toEqual({ cleared: true });
+    expect((await s.search('google', 'q')).outcome).toBe('ok');
+    expect(eventsOf(env, 'tripwire-cleared')[0]?.method).toBe('mcp-clear');
+  });
+});
+
+describe('[tripwire-interactive.7] agent-search: TTL expiry (2 h) and ' +
+  'resolve on success', () => {
+  it('the lock expires lazily after ttlMs, with one audit line', async () => {
+    const env = agentSearchEnv();
+    const s = agentSearch(env, ['captcha', 'ok']);
+    await s.search('google', 'q');
+    env.clock.advance(TWO_HOURS);
+    expect((await s.search('google', 'q')).locked).toBe(true);
+    env.clock.advance(1);
+    // hidden from status before anyone gates it, but still on disk
+    expect(await env.tw.status()).toEqual({});
+    expect(Object.keys(await env.tw.status({ includeExpired: true })))
+      .toEqual(['google']);
+    expect(env.mfs.exists(env.lockPath('google'))).toBe(true);
+    expect(eventsOf(env, 'tripwire-expired')).toHaveLength(0);
+    // the next search removes it lazily and proceeds
+    expect((await s.search('google', 'q')).outcome).toBe('ok');
+    expect(env.mfs.exists(env.lockPath('google'))).toBe(false);
+    expect(eventsOf(env, 'tripwire-expired')).toEqual([
+      expect.objectContaining({
+        key: 'google',
+        reason: 'ttl-expired',
+        method: 'expired',
+        blockedCount: 1,
+      }),
+    ]);
+    // a successful search on a clear key resolves nothing
+    expect(eventsOf(env, 'tripwire-resolved')).toHaveLength(0);
+  });
+
+  it('a successful search resolves a still-tripped key', async () => {
+    const env = agentSearchEnv();
+    const s = agentSearch(env, ['captcha', 'ok']);
+    // search A passes the gate; search B then hits a captcha and trips
+    expect((await env.tw.gate('google')).open).toBe(true);
+    await s.search('google', 'b');
+    expect((await env.tw.read('google')).status).toBe('tripped');
+    env.clock.advance(60_000);
+    // search A succeeds afterwards: the provider is fine, resolve
+    expect((await s.afterGate('google', 'a')).outcome).toBe('ok');
+    expect(eventsOf(env, 'tripwire-resolved')).toEqual([
+      expect.objectContaining({
+        key: 'google',
+        reason: 'captcha',
+        durationMs: 60_000,
+        blockedCount: 0,
+      }),
+    ]);
+    expect(eventsOf(env, 'tripwire-cleared')).toEqual([
+      expect.objectContaining({ method: 'resolved' }),
+    ]);
+    expect(env.mfs.exists(env.lockPath('google'))).toBe(false);
+    expect((await s.search('google', 'c')).outcome).toBe('ok');
+    // the resolve is recorded for the next trip
+    await agentSearch(env, ['captcha']).search('google', 'd');
+    expect((await env.tw.read('google')).record?.priorClear?.method)
+      .toBe('resolved');
+  });
+});
diff --git a/packages/resilience/resilience-core-tripwire/test/unit/scenario-request-builder.spec.ts b/packages/resilience/resilience-core-tripwire/test/unit/scenario-request-builder.spec.ts
new file mode 100644
index 000000000..418918e53
--- /dev/null
+++ b/packages/resilience/resilience-core-tripwire/test/unit/scenario-request-builder.spec.ts
@@ -0,0 +1,268 @@
+/**
+ * guards: a tripped client key still lets a send reach the network, or the confirm-token unlock does not reopen it
+ * tier: S
+ * cites: ticket 8468f7b1; [tripwire-interactive.6] (TW1, TW3, TW10, TW14, TW27).
+ * Ticket 8468f7b1 - scenario: the reverse-apis request-builder consumer,
+ * end to end on the memory fs. A miniature `send` mirrors the real
+ * pipeline order: the tripwire gate (assertOpen) runs BEFORE pacing and
+ * the network; any 4xx trips the client key (5xx never does) and throws
+ * TripwireTrippedError carrying the in-memory response. Flow: a 4xx trips,
+ * three following sends are blocked and counted with zero network calls,
+ * the confirm-token unlock clears it, the next send is open; a corrupt
+ * lock blocks; a second 4xx keeps the first record.
+ * Criteria: [tripwire-interactive.6] (TW1, TW3, TW10, TW14, TW27).
+ */
+import {
+  CONFIRM_TOKEN,
+  TripwireConfirmError,
+  TripwireTrippedError,
+  isTripwireTrippedError,
+  runUnlockCli,
+  type Tripwire,
+} from '../../src/index';
+import { eventsOf, makeEnv, rejectionOf, type Env } from '../helpers/harness';
+import { fakeIo } from '../helpers/io';
+
+interface Response {
+  status: number;
+  body: unknown;
+}
+
+type Network = (op: string) => Promise<Response>;
+
+/** The request-builder consumer in miniature. */
+function requestBuilder(tw: Tripwire, network: Network) {
+  const calls: string[] = [];
+  const paced: string[] = [];
+  return {
+    calls,
+    paced,
+    async send(client: string, op: string): Promise<Response> {
+      // 1. tripwire gate, before sequencing / pacing / the network
+      await tw.assertOpen(client);
+      // 2. pacing floor is recorded only after the gate passed
+      paced.push(op);
+      calls.push(op);
+      const res = await network(op);
+      if (res.status >= 400 && res.status <= 499) {
+        const t = await tw.trip(client, {
+          reason: 'http-4xx',
+          context: { lastStatus: res.status, lastOperationId: op },
+        });
+        throw TripwireTrippedError.fromRecord(t.record, {
+          responseStatus: res.status,
+          responseBody: res.body,
+        });
+      }
+      return res;
+    },
+  };
+}
+
+const ok: Network = () => Promise.resolve({ status: 200, body: { ok: true } });
+
+function scripted(statuses: number[]): Network {
+  const left = [...statuses];
+  return () => Promise.resolve({
+    status: left.shift() ?? 200,
+    body: { error: 'nope' },
+  });
+}
+
+async function tripped(): Promise<{
+  env: Env;
+  rb: ReturnType<typeof requestBuilder>;
+}> {
+  const env = makeEnv({ namespace: 'request-builder' });
+  const rb = requestBuilder(env.tw, scripted([401]));
+  const err = await rejectionOf(rb.send('tinder', 'getProfile'));
+  expect(err).toBeInstanceOf(TripwireTrippedError);
+  return { env, rb };
+}
+
+describe('[tripwire-interactive.6] request-builder: 4xx trips, sends are ' +
+  'blocked and counted, the confirm-token unlock reopens', () => {
+  it('a 4xx trips the key and the error carries the response in memory',
+    async () => {
+      const env = makeEnv({ namespace: 'request-builder' });
+      const rb = requestBuilder(env.tw, scripted([401]));
+      const err = await rejectionOf(rb.send('tinder', 'getProfile'));
+      expect(isTripwireTrippedError(err)).toBe(true);
+      const e = err as TripwireTrippedError;
+      expect(e.key).toBe('tinder');
+      expect(e.reason).toBe('http-4xx');
+      expect(e.responseStatus).toBe(401);
+      expect(e.responseBody).toEqual({ error: 'nope' });
+      const lock = JSON.parse(env.mfs.readText(env.lockPath('tinder')) ?? '');
+      expect(lock).toMatchObject({
+        key: 'tinder',
+        namespace: 'request-builder',
+        reason: 'http-4xx',
+        context: { lastStatus: 401, lastOperationId: 'getProfile' },
+      });
+      // the response body is never persisted
+      expect(env.mfs.readText(env.lockPath('tinder'))).not.toContain('nope');
+      expect(env.auditText()).not.toContain('nope');
+      expect(eventsOf(env, 'tripwire-fired')).toHaveLength(1);
+    });
+
+  it('every 4xx trips (400 and 499 inclusive); 5xx never trips', async () => {
+    for (const status of [400, 403, 429, 499]) {
+      const env = makeEnv();
+      const rb = requestBuilder(env.tw, scripted([status]));
+      await rejectionOf(rb.send('c1', 'op'));
+      expect((await env.tw.read('c1')).status).toBe('tripped');
+    }
+    for (const status of [500, 502, 503]) {
+      const env = makeEnv();
+      const rb = requestBuilder(env.tw, scripted([status]));
+      expect((await rb.send('c1', 'op')).status).toBe(status);
+      expect((await env.tw.read('c1')).status).toBe('clear');
+    }
+  });
+
+  it('three following sends are blocked before pacing and the network, ' +
+    'and blockedCount is 3', async () => {
+    const { env, rb } = await tripped();
+    for (const op of ['a', 'b', 'c']) {
+      const err = await rejectionOf(rb.send('tinder', op));
+      expect(err).toBeInstanceOf(TripwireTrippedError);
+      const e = err as TripwireTrippedError;
+      expect(e.recoveryHint).toContain(CONFIRM_TOKEN);
+      expect(e.responseStatus).toBeUndefined();
+    }
+    expect(rb.calls).toEqual(['getProfile']);
+    expect(rb.paced).toEqual(['getProfile']);
+    const snap = await env.tw.read('tinder');
+    expect(snap.record?.blockedCount).toBe(3);
+    expect(eventsOf(env, 'tripwire-gate-blocked').map((e) => e.blockedCount))
+      .toEqual([1, 2, 3]);
+    // another process on the same disk is blocked too
+    const other = requestBuilder(env.otherProcess(), ok);
+    await rejectionOf(other.send('tinder', 'd'));
+    expect(other.calls).toEqual([]);
+    expect((await env.tw.read('tinder')).record?.blockedCount).toBe(4);
+    // other keys are unaffected
+    expect((await rb.send('bumble', 'x')).status).toBe(200);
+  });
+
+  it('programmatic unlock needs CONFIRM_TOKEN; then the next send is open',
+    async () => {
+      const { env, rb } = await tripped();
+      await rejectionOf(rb.send('tinder', 'a'));
+      const wrong = await rejectionOf(env.tw.clear('tinder', {
+        method: 'programmatic-confirm',
+      }));
+      expect(wrong).toBeInstanceOf(TripwireConfirmError);
+      expect((await env.tw.read('tinder')).status).toBe('tripped');
+      expect(await env.tw.clear('tinder', {
+        method: 'programmatic-confirm',
+        confirm: CONFIRM_TOKEN,
+        actor: 'reverse-auth',
+      })).toEqual({ cleared: true });
+      const ok2 = requestBuilder(env.tw, ok);
+      expect((await ok2.send('tinder', 'next')).status).toBe(200);
+      expect(ok2.calls).toEqual(['next']);
+      expect(eventsOf(env, 'tripwire-cleared')).toEqual([
+        expect.objectContaining({
+          method: 'programmatic-confirm',
+          actor: 'reverse-auth',
+          blockedCount: 1,
+        }),
+      ]);
+      // the next trip carries the prior clear
+      const again = requestBuilder(env.tw, scripted([403]));
+      await rejectionOf(again.send('tinder', 'later'));
+      expect((await env.tw.read('tinder')).record?.priorClear?.method)
+        .toBe('programmatic-confirm');
+    });
+
+  it('the unlock bin (CONFIRM env) clears it; the next send is open',
+    async () => {
+      const { env, rb } = await tripped();
+      for (const op of ['a', 'b', 'c']) await rejectionOf(rb.send('tinder', op));
+      const io = fakeIo([], { isTTY: false, env: { CONFIRM: CONFIRM_TOKEN } });
+      expect(await runUnlockCli(['tinder'], io, env.tw)).toBe(0);
+      expect(io.outLines).toEqual(['unlocked tripwire for tinder']);
+      const next = requestBuilder(env.tw, ok);
+      expect((await next.send('tinder', 'next')).status).toBe(200);
+      expect(eventsOf(env, 'tripwire-cleared')).toEqual([
+        expect.objectContaining({ method: 'unlock-cli-env', blockedCount: 3 }),
+      ]);
+    });
+});
+
+describe('[tripwire-interactive.6] request-builder: a corrupt lock blocks',
+  () => {
+    it.each([
+      ['garbage', '{"reason": "http-'],
+      ['empty', ''],
+      ['wrong schema', '[1,2,3]'],
+    ])('a %s lock fails closed: no network call', async (_name, raw) => {
+      const env = makeEnv();
+      env.mfs.writeText(env.lockPath('tinder'), raw, 0o600);
+      const rb = requestBuilder(env.tw, ok);
+      const err = await rejectionOf(rb.send('tinder', 'op'));
+      expect(err).toBeInstanceOf(TripwireTrippedError);
+      expect((err as TripwireTrippedError).reason).toBe('unreadable-lock');
+      expect(rb.calls).toEqual([]);
+    });
+
+    it('an unreadable (EACCES) lock fails closed', async () => {
+      const env = makeEnv();
+      env.mfs.writeText(env.lockPath('tinder'), '{}', 0o600);
+      env.mfs.failOn({ op: 'readFile', path: /tinder\.lock$/, code: 'EACCES' });
+      const rb = requestBuilder(env.tw, ok);
+      const err = await rejectionOf(rb.send('tinder', 'op'));
+      expect((err as TripwireTrippedError).reason).toBe('unreadable-lock');
+      expect(rb.calls).toEqual([]);
+    });
+  });
+
+describe('[tripwire-interactive.6] request-builder: a second 4xx keeps the ' +
+  'first record', () => {
+  it('two in-flight sends both 4xx: the first trip wins, the second is ' +
+    'audited as retripped', async () => {
+    const env = makeEnv({ namespace: 'request-builder' });
+    const pending: Array<(r: Response) => void> = [];
+    const network: Network = () =>
+      new Promise((res) => {
+        pending.push(res);
+      });
+    const rb = requestBuilder(env.tw, network);
+    const first = rejectionOf(rb.send('tinder', 'first'));
+    const second = rejectionOf(rb.send('tinder', 'second'));
+    // both passed the gate before either response arrived
+    await new Promise((r) => setTimeout(r, 0));
+    expect(rb.calls).toEqual(['first', 'second']);
+    pending[0]?.({ status: 401, body: 'a' });
+    const e1 = (await first) as TripwireTrippedError;
+    pending[1]?.({ status: 403, body: 'b' });
+    const e2 = (await second) as TripwireTrippedError;
+    expect(e1.responseStatus).toBe(401);
+    // the second error carries its own response but the FIRST record
+    expect(e2.responseStatus).toBe(403);
+    expect(e2.record?.context).toEqual({
+      lastStatus: 401,
+      lastOperationId: 'first',
+    });
+    const lock = JSON.parse(env.mfs.readText(env.lockPath('tinder')) ?? '');
+    expect(lock.context).toEqual({ lastStatus: 401, lastOperationId: 'first' });
+    expect(eventsOf(env, 'tripwire-fired')).toHaveLength(1);
+    expect(eventsOf(env, 'tripwire-retripped')).toEqual([
+      expect.objectContaining({ reason: 'http-4xx', trippedAt: lock.trippedAt }),
+    ]);
+  });
+
+  it('a 4xx in another process keeps the first record too', async () => {
+    const { env } = await tripped();
+    const before = env.mfs.readText(env.lockPath('tinder'));
+    const r = await env.otherProcess().trip('tinder', {
+      reason: 'http-4xx',
+      context: { lastStatus: 404, lastOperationId: 'other' },
+    });
+    expect(r.created).toBe(false);
+    expect(r.record.context).toMatchObject({ lastOperationId: 'getProfile' });
+    expect(env.mfs.readText(env.lockPath('tinder'))).toBe(before);
+  });
+});
