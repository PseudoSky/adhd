index 000000000..d71958255
--- /dev/null
+++ b/entrypoint/stealth-search/src/lib/fetch/pinned.ts
@@ -0,0 +1,115 @@
+/**
+ * @adhd/stealth-search — src/lib/fetch/pinned.ts
+ *
+ * The direct byte fetch of the fetch provider (the PDF fallback): one GET that CONNECTS to an address the
+ * caller already validated, never to the name, so a DNS answer that changes between the policy check and
+ * the connection cannot redirect it ([audit-fixes.1], pre-review P4). The TLS handshake still uses the
+ * hostname (SNI and certificate check). The response is bounded in size and time: an oversized or endless
+ * body ends the request instead of filling memory (P29).
+ *
+ * Redirects are never followed here: a 3xx comes back as `status` + `location` so the caller can run its
+ * policy on the next hop and pin that one too.
+ *
+ * Ticket 8468f7b1 · plan state audit-fixes.
+ */
+import https from 'node:https'
+import net from 'node:net'
+import { searchError } from '../../errors.js'
+
+/** Largest direct PDF body accepted, in bytes. */
+export const PDF_MAX_BYTES = 32 * 1024 * 1024
+
+/** Time allowed for the whole direct fetch (connect, headers and body), in milliseconds. */
+export const PDF_DIRECT_TIMEOUT_MS = 30_000
+
+/** What a direct fetch answers. `body` is empty for a redirect. */
+export interface DirectResponse {
+  status: number
+  location: string | null
+  body: Uint8Array
+}
+
+/** Options of one direct fetch. */
+export interface DirectFetchOptions {
+  headers: Record<string, string>
+  maxBytes: number
+  timeoutMs: number
+}
+
+/** The direct fetch collaborator of `FetchDeps`: GET `url`, connecting to `address`. */
+export type DirectFetch = (url: string, address: string, opts: DirectFetchOptions) => Promise<DirectResponse>
+
+/** A `lookup` that always answers `address`, in the single and the `all` shape Node's connect may ask for. */
+export function pinnedLookup(address: string): (host: string, options: { all?: boolean }, cb: (...args: unknown[]) => void) => void {
+  const family = net.isIP(address)
+  return (_host, options, cb) => {
+    if (options.all) cb(null, [{ address, family }])
+    else cb(null, address, family)
+  }
+}
+
+/** The production direct fetch: HTTPS GET to the pinned address, bounded in bytes and time. */
+export const pinnedGet: DirectFetch = (url, address, opts) =>
+  new Promise<DirectResponse>((resolve, reject) => {
+    const u = new URL(url)
+    let settled = false
+    const chunks: Buffer[] = []
+    let total = 0
+    let request: ReturnType<typeof https.request> | undefined
+    const timer = setTimeout(() => end(searchError('SEARCH_FAILED', `fetching ${u.hostname} took longer than ${opts.timeoutMs} ms`, { detail: { reason: 'direct-fetch-timeout', host: u.hostname } })), opts.timeoutMs)
+    const end = (outcome: DirectResponse | Error): void => {
+      if (settled) return
+      settled = true
+      clearTimeout(timer)
+      if (outcome instanceof Error) {
+        request?.destroy()
+        reject(outcome)
+      } else {
+        resolve(outcome)
+      }
+    }
+    const tooLarge = (): Error => searchError('SEARCH_FAILED', `the response from ${u.hostname} is larger than ${opts.maxBytes} bytes`, { detail: { reason: 'direct-fetch-too-large', host: u.hostname, maxBytes: opts.maxBytes } })
+    try {
+      request = https.request(
+        {
+          hostname: u.hostname,
+          port: u.port || undefined,
+          path: `${u.pathname}${u.search}`,
+          method: 'GET',
+          headers: opts.headers,
+          ...(net.isIP(u.hostname) ? {} : { servername: u.hostname }),
+          lookup: pinnedLookup(address) as never,
+        },
+        (res) => {
+          const status = res.statusCode ?? 0
+          const location = typeof res.headers.location === 'string' ? res.headers.location : null
+          if (status >= 300 && status < 400) {
+            res.destroy()
+            end({ status, location, body: new Uint8Array(0) })
+            return
+          }
+          const declared = Number(res.headers['content-length'])
+          if (Number.isFinite(declared) && declared > opts.maxBytes) {
+            res.destroy()
+            end(tooLarge())
+            return
+          }
+          res.on('data', (chunk: Buffer) => {
+            total += chunk.length
+            if (total > opts.maxBytes) {
+              res.destroy()
+              end(tooLarge())
+              return
+            }
+            chunks.push(chunk)
+          })
+          res.on('end', () => end({ status, location, body: new Uint8Array(Buffer.concat(chunks)) }))
+          res.on('error', (err: Error) => end(searchError('SEARCH_FAILED', `reading ${u.hostname} failed: ${err.message}`, { cause: err, detail: { reason: 'direct-fetch-failed', host: u.hostname } })))
+        },
+      )
+      request.on('error', (err: Error) => end(searchError('SEARCH_FAILED', `fetching ${u.hostname} failed: ${err.message}`, { cause: err, detail: { reason: 'direct-fetch-failed', host: u.hostname } })))
+      request.end()
+    } catch (err) {
+      end(searchError('SEARCH_FAILED', `fetching ${u.hostname} failed: ${err instanceof Error ? err.message : String(err)}`, { cause: err, detail: { reason: 'direct-fetch-failed', host: u.hostname } }))
+    }
+  })
diff --git a/entrypoint/stealth-search/src/lib/fetch/policy.ts b/entrypoint/stealth-search/src/lib/fetch/policy.ts
new file mode 100644
index 000000000..b2f077aac
--- /dev/null
+++ b/entrypoint/stealth-search/src/lib/fetch/policy.ts
@@ -0,0 +1,209 @@
+/**
+ * @adhd/stealth-search — src/lib/fetch/policy.ts
+ *
+ * URL validation and SSRF target blocking for the fetch provider (inventory I-28, a security
+ * failsafe, [search-port-fetch.3]).
+ *
+ * The check is a TARGET check ("is this pointed at my own infrastructure?"), never a reputation
+ * blocklist. IP literals, RFC1918, link-local (cloud metadata), loopback, CGNAT, single-label hosts,
+ * internal TLDs, a trailing DNS root dot, non-http(s) schemes, embedded credentials and over-long
+ * URLs are refused locally BEFORE any navigation. A refusal is a RESPONSE outcome `error` whose
+ * message carries `FETCH_URL_REFUSED` (built in fetch.ts), never a thrown error.
+ *
+ * `validateFetchUrl` is the name-based half. `resolveAndCheck` is the resolution half: a public
+ * hostname is resolved through an INJECTED resolver and every returned address must be public, so a
+ * name that RESOLVES to a private address (DNS rebinding) is refused with `FETCH_URL_REFUSED`
+ * carrying the offending address in `detail`. A resolver failure is a typed `SEARCH_FAILED`.
+ *
+ * Resolve once, validate every answer, connect to what was validated: the direct PDF fetch connects
+ * to the first validated address (`pinned`), never to the name. Chrome resolves by name itself, so for
+ * the browser the validated address is enforced after the fact: the address each document actually
+ * connected to (`Network.Response.remoteIPAddress`, including every redirect hop) must pass
+ * `isForbiddenAddress` before any content is read.
+ *
+ * Ticket 8468f7b1 · plan state search-port-fetch.
+ */
+import dns from 'node:dns'
+import net from 'node:net'
+import { searchError } from '../../errors.js'
+
+/** Max URL length (matches the reference WebFetch cap). */
+export const MAX_URL_LENGTH = 2000
+
+/** The verdict of `validateFetchUrl`. */
+export interface UrlVerdict {
+  ok: boolean
+  /** Present when ok=false. Safe to surface to the caller. */
+  reason?: string
+  /** The parsed, normalized URL (http upgraded to https) when ok=true. */
+  url?: URL
+}
+
+/** True when the dotted-quad octets `p` lie in the range `a.b.c.0/prefix` (arithmetic stays below 2^32, so plain numbers are exact). */
+function inV4(p: readonly number[], a: number, b: number, c: number, prefix: number): boolean {
+  const n = (p[0] ?? 0) * 2 ** 24 + (p[1] ?? 0) * 2 ** 16 + (p[2] ?? 0) * 2 ** 8 + (p[3] ?? 0)
+  const base = a * 2 ** 24 + b * 2 ** 16 + c * 2 ** 8
+  return n >= base && n < base + 2 ** (32 - prefix)
+}
+
+/** The non-public IPv4 ranges (IANA special-purpose registry, RFC 6890 and successors). */
+const FORBIDDEN_V4: ReadonlyArray<readonly [number, number, number, number]> = [
+  [0, 0, 0, 8], // this network
+  [10, 0, 0, 8], // RFC1918
+  [100, 64, 0, 10], // CGNAT
+  [127, 0, 0, 8], // loopback
+  [169, 254, 0, 16], // link-local / cloud metadata
+  [172, 16, 0, 12], // RFC1918
+  [192, 0, 0, 24], // IETF protocol assignments
+  [192, 0, 2, 24], // TEST-NET-1
+  [192, 88, 99, 24], // 6to4 relay anycast
+  [192, 168, 0, 16], // RFC1918
+  [198, 18, 0, 15], // benchmarking
+  [198, 51, 100, 24], // TEST-NET-2
+  [203, 0, 113, 24], // TEST-NET-3
+  [224, 0, 0, 4], // multicast
+  [240, 0, 0, 4], // reserved, includes 255.255.255.255 broadcast
+]
+
+function isForbiddenV4(ip: string): boolean {
+  const p = ip.split('.').map(Number)
+  if (p.length !== 4 || p.some((x) => !Number.isInteger(x) || x < 0 || x > 255)) return true
+  return FORBIDDEN_V4.some(([a, b, c, prefix]) => inV4(p, a, b, c, prefix))
+}
+
+/** The eight 16-bit groups of an IPv6 literal (a dotted-quad tail is folded into two groups), or null. */
+function parseV6(raw: string): number[] | null {
+  let s = raw.toLowerCase().replace(/^\[|\]$/g, '')
+  const zone = s.indexOf('%')
+  if (zone >= 0) s = s.slice(0, zone)
+  const dotted = s.match(/^(.*:)(\d+\.\d+\.\d+\.\d+)$/)
+  if (dotted?.[1] !== undefined && dotted[2] !== undefined) {
+    const q = dotted[2].split('.').map(Number)
+    if (q.length !== 4 || q.some((x) => !Number.isInteger(x) || x < 0 || x > 255)) return null
+    s = `${dotted[1]}${(((q[0] ?? 0) << 8) | (q[1] ?? 0)).toString(16)}:${(((q[2] ?? 0) << 8) | (q[3] ?? 0)).toString(16)}`
+  }
+  const halves = s.split('::')
+  if (halves.length > 2) return null
+  const head = halves[0] ? halves[0].split(':') : []
+  const tail = halves.length === 2 && halves[1] ? halves[1].split(':') : []
+  const fill = 8 - head.length - tail.length
+  if (halves.length === 1 ? head.length !== 8 : fill < 1) return null
+  const groups = [...head, ...(halves.length === 2 ? Array<string>(fill).fill('0') : []), ...tail].map((g) => (/^[0-9a-f]{1,4}$/.test(g) ? parseInt(g, 16) : NaN))
+  return groups.length === 8 && groups.every((g) => Number.isInteger(g)) ? groups : null
+}
+
+const v4Of = (hi: number, lo: number): string => [hi >> 8, hi & 255, lo >> 8, lo & 255].join('.')
+
+function isForbiddenV6(ip: string): boolean {
+  const g = parseV6(ip)
+  if (!g) return true // not parseable: refuse
+  const [g0 = 0, g1 = 0, g2 = 0, g3 = 0, g4 = 0, g5 = 0, g6 = 0, g7 = 0] = g
+  const firstFiveZero = g0 === 0 && g1 === 0 && g2 === 0 && g3 === 0 && g4 === 0
+  if (firstFiveZero && g5 === 0 && g6 === 0 && (g7 === 0 || g7 === 1)) return true // :: and ::1
+  if (firstFiveZero && g5 === 0xffff) return isForbiddenV4(v4Of(g6, g7)) // IPv4-mapped ::ffff:a.b.c.d
+  if (firstFiveZero && g5 === 0) return isForbiddenV4(v4Of(g6, g7)) // IPv4-compatible ::a.b.c.d
+  if (g0 === 0x64 && g1 === 0xff9b && g2 === 0 && g3 === 0 && g4 === 0 && g5 === 0) return isForbiddenV4(v4Of(g6, g7)) // NAT64 64:ff9b::/96
+  if (g0 === 0x64 && g1 === 0xff9b && g2 === 1) return true // local-use NAT64 64:ff9b:1::/48
+  if (g0 === 0x2002) return isForbiddenV4(v4Of(g1, g2)) // 6to4 2002::/16 embeds the v4 address
+  if (g0 === 0x2001 && g1 === 0) return true // Teredo 2001::/32
+  if (g0 === 0x2001 && g1 === 0xdb8) return true // documentation 2001:db8::/32
+  if (g0 === 0x100 && g1 === 0 && g2 === 0 && g3 === 0) return true // discard-only 100::/64
+  if ((g0 & 0xfe00) === 0xfc00) return true // unique-local fc00::/7
+  if ((g0 & 0xffc0) === 0xfe80) return true // link-local fe80::/10
+  if ((g0 & 0xffc0) === 0xfec0) return true // deprecated site-local fec0::/10
+  if ((g0 & 0xff00) === 0xff00) return true // multicast ff00::/8
+  return false
+}
+
+/**
+ * True for an address a fetch must never reach: private, loopback, link-local, CGNAT, reserved,
+ * multicast, documentation, NAT64, 6to4, IPv4-mapped and Teredo forms. A string that is not an IP
+ * literal is refused too, so the answer to "is it safe to connect" is never true by accident.
+ */
+export function isForbiddenAddress(ip: string): boolean {
+  const bare = ip.replace(/^\[|\]$/g, '')
+  const v = net.isIP(bare)
+  if (v === 4) return isForbiddenV4(bare)
+  if (v === 6) return isForbiddenV6(bare)
+  return true
+}
+
+/**
+ * Is this URL pointed at infrastructure a fetch must never reach?
+ * Returns a reason string when forbidden, or null when the target is allowed.
+ */
+export function forbiddenTargetReason(u: URL): string | null {
+  if (u.protocol !== 'https:' && u.protocol !== 'http:') {
+    return `unsupported protocol '${u.protocol}' (only http/https)`
+  }
+  // Unwrap IPv6 brackets AND strip a trailing DNS root dot: `localhost.` resolves to loopback but
+  // would otherwise slip past the localhost / single-label checks.
+  const host = u.hostname.replace(/^\[|\]$/g, '').replace(/\.$/, '')
+  if (net.isIP(host)) {
+    return isForbiddenAddress(host) ? `blocked IP literal ${host} (private/loopback/link-local)` : null
+  }
+  const lower = host.toLowerCase()
+  if (lower === 'localhost') return 'blocked host localhost'
+  if (/\.(local|internal|home|lan|localdomain)$/.test(lower)) return `blocked internal TLD in ${host}`
+  if (host.split('.').length < 2) return `blocked single-label host ${host} (not a public domain)`
+  return null
+}
+
+/**
+ * Validate + normalize a URL for fetching: length cap, parseable, no embedded credentials, not a
+ * forbidden target, http upgraded to https.
+ */
+export function validateFetchUrl(raw: string): UrlVerdict {
+  if (!raw || raw.length > MAX_URL_LENGTH) {
+    return { ok: false, reason: `URL missing or longer than ${MAX_URL_LENGTH} chars` }
+  }
+  let u: URL
+  try {
+    u = new URL(raw)
+  } catch {
+    return { ok: false, reason: 'not a valid URL' }
+  }
+  if (u.username || u.password) {
+    return { ok: false, reason: 'URL must not embed credentials (user:pass@)' }
+  }
+  const forbidden = forbiddenTargetReason(u)
+  if (forbidden) return { ok: false, reason: forbidden }
+  if (u.protocol === 'http:') u.protocol = 'https:'
+  return { ok: true, url: u }
+}
+
+/** Resolves a hostname to every address it maps to. Injected so the unit lane never touches the network. */
+export type HostResolver = (host: string) => Promise<string[]>
+
+/** The production resolver: the system resolver, all A and AAAA answers. */
+export const systemResolver: HostResolver = async (host) => (await dns.promises.lookup(host, { all: true })).map((a) => a.address)
+
+/**
+ * Resolve `host` and refuse it when ANY returned address is private, loopback, link-local or
+ * unique-local. IP literals are not resolved (the name-based check already judged them).
+ *
+ * @throws StealthSearchError `FETCH_URL_REFUSED` (detail.address, detail.host) for a private answer;
+ *   `SEARCH_FAILED` (detail.reason `dns-resolution-failed`) when the resolver fails or answers nothing.
+ */
+export async function resolveAndCheck(host: string, resolve: HostResolver): Promise<string[]> {
+  const bare = host.replace(/^\[|\]$/g, '').replace(/\.$/, '')
+  if (net.isIP(bare)) return [bare]
+  let addresses: string[]
+  try {
+    addresses = await resolve(bare)
+  } catch (err) {
+    const msg = err instanceof Error ? err.message : String(err)
+    throw searchError('SEARCH_FAILED', `could not resolve ${bare}: ${msg}`, { detail: { reason: 'dns-resolution-failed', host: bare } })
+  }
+  if (addresses.length === 0) {
+    throw searchError('SEARCH_FAILED', `resolver returned no address for ${bare}`, { detail: { reason: 'dns-resolution-failed', host: bare } })
+  }
+  for (const address of addresses) {
+    if (isForbiddenAddress(address)) {
+      throw searchError('FETCH_URL_REFUSED', `${bare} resolves to ${address} (private/loopback/link-local)`, {
+        detail: { reason: 'resolves-to-private-address', host: bare, address },
+      })
+    }
+  }
+  return addresses
+}
diff --git a/entrypoint/stealth-search/src/lib/guard.ts b/entrypoint/stealth-search/src/lib/guard.ts
new file mode 100644
index 000000000..286995dda
--- /dev/null
+++ b/entrypoint/stealth-search/src/lib/guard.ts
@@ -0,0 +1,214 @@
+/**
+ * @adhd/stealth-search: src/lib/guard.ts
+ *
+ * Cross-process spam guards, ported from the source runner's search-guard (inventory rows I-19
+ * and I-20). Two layers stop an agent from opening window after window against a hostile
+ * provider:
+ *
+ *   1. A per-provider COOLDOWN, file-backed and shared across processes. After `captcha`,
+ *      `rate_limited` or `banned` a cooldown is written atomically (unique temp file, then
+ *      rename) to `<dataDir>/guard/<provider>.json`. `hitl` never arms one (the tripwire lock is
+ *      the durable gate there); `success` and `empty` disarm it. An expired cooldown is removed
+ *      lazily on read.
+ *   2. A bounded per-process concurrency cap (`maxConcurrent`, default 2, 0 or below disables):
+ *      a FIFO queue in which a finishing call hands its slot directly to the next waiter, so
+ *      the cap can never be overshot by a newcomer racing the waiter.
+ *
+ * Every setting comes from `SearchHostConfig` (ADR-0001); state I/O goes through the tripwire
+ * package's `FsPort` so the unit lane runs on the in-memory fs. Unreadable state raises
+ * PROVIDER_STATE_IO.
+ *
+ * Ticket 8468f7b1 · plan state search-port-guards · [search-port-guards.2] [search-port-guards.4]
+ */
+import { randomBytes } from 'node:crypto'
+import { join } from 'node:path'
+import { createNodeFs } from '@adhd/resilience-core-tripwire'
+import type { FsPort } from '@adhd/resilience-core-tripwire'
+import type { SearchHostConfig } from './config.js'
+import { searchError } from '../errors.js'
+
+/** A cooldown record as stored in `<dataDir>/guard/<provider>.json`. */
+export interface ProviderCooldown {
+  provider: string
+  /** Epoch ms at which the cooldown lifts. */
+  until: number
+  /** ISO timestamp when it was recorded. */
+  firedAt: string
+  /** The hostile outcome that armed it. */
+  reason: string
+  /** The query or URL that triggered it, when known. */
+  query?: string
+}
+
+/** Diagnostic snapshot of the concurrency queue. */
+export interface ConcurrencyInfo {
+  active: number
+  queued: number
+  max: number
+}
+
+/** The guard bound to one `SearchHostConfig`. */
+export interface SearchGuard {
+  setProviderCooldown(provider: string, reason: string, durationMs: number, query?: string): Promise<ProviderCooldown>
+  readProviderCooldown(provider: string): Promise<ProviderCooldown | null>
+  clearProviderCooldown(provider: string): Promise<void>
+  /** Milliseconds until the cooldown lifts (0 = not cooling); removes an expired one. */
+  cooldownRemainingMs(provider: string): Promise<number>
+  /** Cooldown duration for an outcome, or 0 when none applies. */
+  cooldownForOutcome(outcome: string): number
+  /** Hostile outcomes arm a cooldown, success and empty disarm it, everything else (hitl) is ignored. */
+  recordSearchOutcome(provider: string, outcome: string, query?: string): Promise<void>
+  /** Run `fn` under the FIFO concurrency cap. */
+  withSearchConcurrency<T>(fn: () => Promise<T>): Promise<T>
+  searchConcurrencyInfo(): ConcurrencyInfo
+}
+
+const PROVIDER_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/
+const FILE_MODE = 0o600
+const DIR_MODE = 0o700
+const dec = new TextDecoder()
+const enc = new TextEncoder()
+
+function codeOf(e: unknown): string | undefined {
+  if (typeof e !== 'object' || e === null) return undefined
+  const c = (e as { code?: unknown }).code
+  return typeof c === 'string' ? c : undefined
+}
+
+function validCooldown(v: unknown): v is ProviderCooldown {
+  if (typeof v !== 'object' || v === null) return false
+  const r = v as Record<string, unknown>
+  return typeof r['provider'] === 'string' && typeof r['until'] === 'number' && Number.isFinite(r['until']) &&
+    typeof r['firedAt'] === 'string' && typeof r['reason'] === 'string'
+}
+
+/** Build the guard for one config. Construction performs no I/O. */
+export function createSearchGuard(config: SearchHostConfig): SearchGuard {
+  const fs: FsPort = config.fs ?? createNodeFs()
+  const now = config.clock ?? ((): number => Date.now())
+  const dir = join(config.dataDir, 'guard')
+
+  const pathOf = (provider: string): string => {
+    if (!PROVIDER_PATTERN.test(provider)) {
+      throw searchError('UNKNOWN_PROVIDER', `invalid provider id ${JSON.stringify(String(provider)).slice(0, 80)}`, { detail: { provider: String(provider) } })
+    }
+    return join(dir, `${provider}.json`)
+  }
+
+  const io = (what: string, path: string, cause: unknown) =>
+    searchError('PROVIDER_STATE_IO', `${what} ${path} failed: ${cause instanceof Error ? cause.message : String(cause)}`, { cause, detail: { path } })
+
+  const setProviderCooldown: SearchGuard['setProviderCooldown'] = async (provider, reason, durationMs, query) => {
+    const fp = pathOf(provider)
+    const cd: ProviderCooldown = {
+      provider,
+      until: now() + Math.max(0, durationMs),
+      firedAt: new Date(now()).toISOString(),
+      reason,
+      ...(query ? { query } : {}),
+    }
+    const tmp = `${fp}.${process.pid}.${randomBytes(6).toString('hex')}.tmp`
+    try {
+      await fs.mkdir(dir, DIR_MODE)
+      const h = await fs.openExclusive(tmp, FILE_MODE)
+      try {
+        await h.write(enc.encode(JSON.stringify(cd, null, 2)))
+        await h.sync()
+      } finally {
+        await h.close()
+      }
+      await fs.rename(tmp, fp)
+    } catch (e) {
+      try { await fs.unlink(tmp) } catch { /* the temp file may not exist */ }
+      throw io('writing cooldown', fp, e)
+    }
+    return cd
+  }
+
+  const readProviderCooldown: SearchGuard['readProviderCooldown'] = async (provider) => {
+    const fp = pathOf(provider)
+    let raw: Uint8Array
+    try {
+      raw = await fs.readFile(fp)
+    } catch (e) {
+      if (codeOf(e) === 'ENOENT') return null
+      throw io('reading cooldown', fp, e)
+    }
+    let doc: unknown
+    try {
+      doc = JSON.parse(dec.decode(raw))
+    } catch (e) {
+      throw io('parsing cooldown', fp, e)
+    }
+    if (!validCooldown(doc)) throw io('validating cooldown', fp, 'unexpected shape')
+    return doc
+  }
+
+  const clearProviderCooldown: SearchGuard['clearProviderCooldown'] = async (provider) => {
+    const fp = pathOf(provider)
+    try {
+      await fs.unlink(fp)
+    } catch (e) {
+      if (codeOf(e) === 'ENOENT') return
+      throw io('removing cooldown', fp, e)
+    }
+  }
+
+  const cooldownRemainingMs: SearchGuard['cooldownRemainingMs'] = async (provider) => {
+    const cd = await readProviderCooldown(provider)
+    if (!cd) return 0
+    const remaining = cd.until - now()
+    if (remaining <= 0) {
+      await clearProviderCooldown(provider)
+      return 0
+    }
+    return remaining
+  }
+
+  const cooldownForOutcome: SearchGuard['cooldownForOutcome'] = (outcome) => {
+    switch (outcome) {
+      case 'captcha': return config.cooldownCaptchaMs
+      case 'rate_limited': return config.cooldownRateMs
+      case 'banned': return config.cooldownBannedMs
+      default: return 0
+    }
+  }
+
+  const recordSearchOutcome: SearchGuard['recordSearchOutcome'] = async (provider, outcome, query) => {
+    const dur = cooldownForOutcome(outcome)
+    if (dur > 0) await setProviderCooldown(provider, outcome, dur, query)
+    else if (outcome === 'success' || outcome === 'empty') await clearProviderCooldown(provider)
+  }
+
+  let active = 0
+  const waiters: Array<() => void> = []
+
+  const withSearchConcurrency = async <T>(fn: () => Promise<T>): Promise<T> => {
+    const max = config.maxConcurrent
+    if (max <= 0) return fn()
+    if (active >= max) {
+      // The releasing call hands its slot over, so `active` is unchanged for the waiter.
+      await new Promise<void>((resolve) => waiters.push(resolve))
+    } else {
+      active++
+    }
+    try {
+      return await fn()
+    } finally {
+      const next = waiters.shift()
+      if (next) next()
+      else active--
+    }
+  }
+
+  return {
+    setProviderCooldown,
+    readProviderCooldown,
+    clearProviderCooldown,
+    cooldownRemainingMs,
+    cooldownForOutcome,
+    recordSearchOutcome,
+    withSearchConcurrency,
+    searchConcurrencyInfo: () => ({ active, queued: waiters.length, max: config.maxConcurrent }),
+  }
+}
