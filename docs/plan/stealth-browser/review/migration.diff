index 000000000..ecc76ccc7
--- /dev/null
+++ b/entrypoint/stealth-search/test/unit/hosts/search-tracing-rejected-flag.spec.ts
@@ -0,0 +1,123 @@
+/**
+ * guards: a rejected flag leaves no span because telemetry starts after flag validation, or --help writes a span
+ * tier: S
+ * cites: ticket 8468f7b1 [search-tracing-fixes.2] [search-hosts.16] backlog 5152786d
+ * The REAL `runCli` over the real package, an injected telemetry initializer that starts a real sox-telemetry file
+ * sink in a temp dir, and a process-spawn fake (no Chrome, no socket, no subprocess). Criteria: [search-tracing-fixes.2].
+ */
+import { existsSync, mkdtempSync, readFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { _resetTelemetryForTest, initTelemetry } from '@adhd/sox-telemetry'
+import type { TelemetryHandle } from '@adhd/sox-telemetry'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { runCli } from '../../../src/cli.js'
+import { exitCodeFor } from '../../../src/errors.js'
+import { BUILD_TIMEOUT_MS, cliHarness, fakeVerbs, packageFor } from '../../helpers/hosts/host-harness.js'
+
+interface Rec {
+  event: string
+  [key: string]: unknown
+}
+
+let logDir: string | undefined
+let handle: TelemetryHandle | undefined
+
+afterEach(() => {
+  handle?.close()
+  handle = undefined
+  _resetTelemetryForTest()
+  if (logDir) rmSync(logDir, { recursive: true, force: true })
+  logDir = undefined
+})
+
+function freshDir(): string {
+  logDir = mkdtempSync(join(tmpdir(), 'stealth-search-trace-'))
+  return logDir
+}
+
+/** The injected telemetry initializer: the real sox-telemetry file sink in the directory the host asks for. */
+function realInit(calls: unknown[]): (o: { role: 'cli'; logDir?: string }) => void {
+  return (o) => {
+    calls.push(o)
+    handle = initTelemetry({ service: 'stealth-search', role: o.role, logSink: 'file', logDir: o.logDir as string, otel: true })
+  }
+}
+
+async function records(): Promise<Rec[]> {
+  await handle?.otelReady()
+  const path = handle?.currentLogFilePath() ?? null
+  if (path === null || !existsSync(path)) return []
+  return readFileSync(path, 'utf8')
+    .split('\n')
+    .filter((l) => l.trim().length > 0)
+    .map((l) => JSON.parse(l) as Rec)
+}
+
+/** The span records of one operation (the shared plugin also writes its documented `adhd.op.error` twin). */
+function ofOp(recs: Rec[], id: string): Rec[] {
+  return recs.filter((r) => r.event.startsWith(`adhd.${id}.`))
+}
+
+describe('telemetry starts before flag validation [search-tracing-fixes.2]', () => {
+  it(
+    'rejected flag span before flag validation: --cdp-port abc still writes the start and error span of the operation',
+    async () => {
+      const dir = freshDir()
+      const verbs = fakeVerbs(vi.fn)
+      const built = await packageFor(verbs)
+      const id = built.surface.find((s) => s.operation === 'chromeStatus')?.id as string
+      const calls: unknown[] = []
+      const spawned: string[] = []
+      const h = cliHarness(verbs, { build: async () => built, initTelemetry: realInit(calls), restartBrowser: async () => void spawned.push('restart') })
+      const code = await runCli(['chromeStatus', '--cdp-port', 'abc', '--log-dir', dir], h.deps)
+      expect(code).toBe(exitCodeFor('HOST_FLAG_INVALID'))
+      expect(h.stderr.join('\n')).toContain('--cdp-port')
+      expect(calls).toEqual([{ role: 'cli', logDir: dir }])
+      const recs = await records()
+      const span = ofOp(recs, id)
+      expect(span.map((r) => r.event)).toEqual([`adhd.${id}.start`, `adhd.${id}.error`])
+      expect(String(span[1]?.['error'])).toContain('--cdp-port')
+      expect(span[1]?.['adhd.transport']).toBe('cli')
+      expect(spawned).toEqual([])
+    },
+    BUILD_TIMEOUT_MS
+  )
+
+  it(
+    'rejected flag span before flag validation: an unknown verb flag (after the host flags parsed) also writes the start and error span',
+    async () => {
+      const dir = freshDir()
+      const verbs = fakeVerbs(vi.fn)
+      const built = await packageFor(verbs)
+      const id = built.surface.find((s) => s.operation === 'chromeStatus')?.id as string
+      const calls: unknown[] = []
+      const h = cliHarness(verbs, { build: async () => built, initTelemetry: realInit(calls) })
+      const code = await runCli(['chromeStatus', '--no-such-flag', '1', '--log-dir', dir], h.deps)
+      expect(code).toBe(exitCodeFor('HOST_FLAG_INVALID'))
+      const recs = await records()
+      expect(ofOp(recs, id).map((r) => r.event)).toEqual([`adhd.${id}.start`, `adhd.${id}.error`])
+    },
+    BUILD_TIMEOUT_MS
+  )
+
+  it(
+    'help is not a dispatch: --help, an operation --help and no arguments start no telemetry and write no span',
+    async () => {
+      const dir = freshDir()
+      const verbs = fakeVerbs(vi.fn)
+      const built = await packageFor(verbs)
+      handle = initTelemetry({ service: 'stealth-search', role: 'cli', logSink: 'file', logDir: dir, otel: true })
+      const calls: unknown[] = []
+      for (const argv of [['--help'], ['chromeStatus', '--help'], [] as string[]]) {
+        const h = cliHarness(verbs, { build: async () => built, initTelemetry: (o) => void calls.push(o) })
+        const code = await runCli(argv, h.deps)
+        expect(code, argv.join(' ')).toBe(0)
+        expect(h.stdout.join('')).not.toBe('')
+      }
+      expect(calls).toEqual([])
+      expect(await records()).toEqual([])
+    },
+    BUILD_TIMEOUT_MS
+  )
+})
diff --git a/entrypoint/stealth-search/test/unit/hosts/search-tracing-single-error.spec.ts b/entrypoint/stealth-search/test/unit/hosts/search-tracing-single-error.spec.ts
new file mode 100644
index 000000000..7153c72e4
--- /dev/null
+++ b/entrypoint/stealth-search/test/unit/hosts/search-tracing-single-error.spec.ts
@@ -0,0 +1,101 @@
+/**
+ * guards: a failing call writes more than one adhd.<op>.error for its real op id, or more than the single documented upstream twin adhd.op.error (op id `op`)
+ * tier: S
+ * cites: ticket 8468f7b1 [search-tracing-fixes.3] [search-hosts.16] backlog 5152786d
+ * The REAL `runCli` over the real package with a failing verb, and the MCP-side layer driven in process, each over
+ * a real sox-telemetry file sink in a temp dir and a process-spawn fake (no Chrome, no socket, no subprocess).
+ * The shared apigen tracing plugin writes a documented upstream twin `adhd.op.error` (op id `op`) next to every
+ * `adhd.<op>.error`; it is kept as is. Criteria: [search-tracing-fixes.3].
+ */
+import { existsSync, mkdtempSync, readFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import type { Call, Result } from '@adhd/apigen-core-client'
+import { _resetTelemetryForTest, initTelemetry } from '@adhd/sox-telemetry'
+import type { TelemetryHandle } from '@adhd/sox-telemetry'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { runCli } from '../../../src/cli.js'
+import { searchError } from '../../../src/errors.js'
+import { tracingPlugin } from '../../../src/tracing.js'
+import { BUILD_TIMEOUT_MS, cliHarness, fakeVerbs, packageFor } from '../../helpers/hosts/host-harness.js'
+
+interface Rec {
+  event: string
+  [key: string]: unknown
+}
+
+let logDir: string | undefined
+let handle: TelemetryHandle | undefined
+
+afterEach(() => {
+  handle?.close()
+  handle = undefined
+  _resetTelemetryForTest()
+  if (logDir) rmSync(logDir, { recursive: true, force: true })
+  logDir = undefined
+})
+
+function startSink(role: 'cli' | 'live-service'): void {
+  _resetTelemetryForTest()
+  logDir = mkdtempSync(join(tmpdir(), 'stealth-search-trace-'))
+  handle = initTelemetry({ service: 'stealth-search', role, logSink: 'file', logDir, otel: true })
+}
+
+async function records(): Promise<Rec[]> {
+  await handle?.otelReady()
+  const path = handle?.currentLogFilePath() ?? null
+  if (path === null || !existsSync(path)) return []
+  return readFileSync(path, 'utf8')
+    .split('\n')
+    .filter((l) => l.trim().length > 0)
+    .map((l) => JSON.parse(l) as Rec)
+}
+
+/** The one tolerated record carrying the literal op id `op`: the plugin's documented upstream twin. */
+const TWIN = 'adhd.op.error'
+
+describe('one error event per failing call [search-tracing-fixes.3]', () => {
+  it(
+    'duplicate adhd.op.error: a failing CLI verb writes exactly one adhd.<op>.error and the only op id op record is the single adhd.op.error twin',
+    async () => {
+      startSink('cli')
+      const verbs = fakeVerbs(vi.fn, {
+        chromeStatus: async () => {
+          throw searchError('SEARCH_FAILED', 'forced failure')
+        },
+      })
+      const built = await packageFor(verbs)
+      const id = built.surface.find((s) => s.operation === 'chromeStatus')?.id as string
+      const h = cliHarness(verbs, { build: async () => built })
+      await runCli(['chromeStatus'], h.deps)
+      const recs = await records()
+      const own = recs.filter((r) => r.event.startsWith(`adhd.${id}.`))
+      expect(own.map((r) => r.event)).toEqual([`adhd.${id}.start`, `adhd.${id}.error`])
+      expect(String(own[1]?.['error'])).toContain('forced failure')
+      expect(recs.filter((r) => r.event === TWIN)).toHaveLength(1)
+      expect(recs.filter((r) => r.event.endsWith('.error'))).toHaveLength(2)
+      expect(recs.every((r) => r['adhd.op'] === id)).toBe(true)
+    },
+    BUILD_TIMEOUT_MS
+  )
+
+  it('duplicate adhd.op.error op id: the layer both hosts mount writes one error record for a failing call and a single adhd.op.error twin, no other record has the op id op', async () => {
+    startSink('live-service')
+    await handle?.otelReady()
+    const layer = tracingPlugin.capabilities.layer?.layer as unknown as (call: Call, next: () => Promise<Result>) => Promise<Result>
+    const call = {
+      operation: { id: 'stealth/probe' },
+      data: {},
+      envelope: {},
+      ctx: new Map(),
+      transport: 'mcp',
+      signal: new AbortController().signal,
+    } as unknown as Call
+    await expect(layer(call, async () => Promise.reject(searchError('UNKNOWN_PROVIDER', 'nope')))).rejects.toMatchObject({ code: 'UNKNOWN_PROVIDER' })
+    const recs = await records()
+    expect(recs.filter((r) => r.event === 'adhd.stealth/probe.error')).toHaveLength(1)
+    expect(recs.filter((r) => r.event === TWIN)).toHaveLength(1)
+    expect(recs.map((r) => r.event).sort()).toEqual(['adhd.op.error', 'adhd.stealth/probe.error', 'adhd.stealth/probe.start'])
+    for (const r of recs) expect(r['adhd.op']).toBe('stealth/probe')
+  })
+})
