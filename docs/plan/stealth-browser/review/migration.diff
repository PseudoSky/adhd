+  it('drops responseBody and non-JSON values', () => {
+    const out = redact({
+      responseBody: { secret: 1 },
+      responseStatus: 401,
+      nan: Number.NaN,
+      fn: (() => 1) as unknown as string,
+      ok: true,
+    });
+    expect(out).toEqual({
+      nan: null,
+      ok: true,
+    });
+  });
+});
