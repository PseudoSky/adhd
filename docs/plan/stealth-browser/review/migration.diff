@@ -0,0 +1,38 @@
+/**
+ * Test-only fixture builder (ticket 8468f7b1, [tests-unit-data.3]).
+ * Creates a throwaway Chrome-shaped profile under the OS temp dir. Never reads a real profile.
+ */
+import { DatabaseSync } from 'node:sqlite'
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+/** Unix seconds -> Chrome microseconds since 1601-01-01. */
+export const chromeMicros = (unixSeconds: number): number => (unixSeconds + 11644473600) * 1_000_000
+
+export interface Fixture {
+  root: string
+  defaultDir: string
+  db(name: string, ddl: string[]): DatabaseSync
+  json(name: string, value: unknown): void
+  raw(name: string, text: string): void
+  cleanup(): void
+}
+
+export function makeProfile(): Fixture {
+  const root = mkdtempSync(join(tmpdir(), 'stealth-browser-profile-'))
+  const defaultDir = join(root, 'Default')
+  mkdirSync(defaultDir, { recursive: true })
+  return {
+    root,
+    defaultDir,
+    db(name, ddl) {
+      const d = new DatabaseSync(join(defaultDir, name))
+      for (const stmt of ddl) d.exec(stmt)
+      return d
+    },
+    json(name, value) { writeFileSync(join(defaultDir, name), JSON.stringify(value)) },
+    raw(name, text) { writeFileSync(join(defaultDir, name), text) },
+    cleanup() { rmSync(root, { recursive: true, force: true }) },
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/test/helpers/fake-cdp.ts b/packages/stealth/stealth-core-browser/test/helpers/fake-cdp.ts
new file mode 100644
index 000000000..3f513eb82
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/test/helpers/fake-cdp.ts
@@ -0,0 +1,209 @@
+/**
+ * In-memory Chrome DevTools Protocol server for the unit lane.
+ * Ticket 8468f7b1 · criteria [cdp-test-harness.1] [cdp-test-harness.2]
+ *
+ * No socket, no subprocess, no Chrome: `install()` replaces the global
+ * `WebSocket` (the same effect as vi.stubGlobal, restored by the returned function) with a `FakeWebSocket` that talks to a
+ * `FakeCdpServer`. The server is a small protocol state machine: a client
+ * command is answered by `id`, exactly as CDP does, according to a fixture's
+ * ordered steps (`when` subset-match, `reply`, then `emit` events in order,
+ * each optionally delayed by `delayMs` on the (fake) timer clock).
+ *
+ * Step selection: the first not-yet-used step whose `when` matches; once every
+ * matching step has been used the last match answers again, so a repeated
+ * command (Network.enable on each of two tabs) keeps working.
+ *
+ * Fixture honesty: `meta.origin` is `synthetic-protocol-conformant` until a
+ * dev-only recorder replaces them with `recorded` captures.
+ */
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+
+export interface CdpFixtureStep {
+  /** Subset match on the client command: method equal, every key in params deep-equal. */
+  when: { method: string; params?: Record<string, unknown> }
+  /** Default result `{}`. */
+  reply?: { result?: Record<string, unknown>; error?: { code: number; message: string } }
+  /** Events pushed after the reply, in order. */
+  emit?: Array<{ method: string; params: Record<string, unknown>; delayMs?: number }>
+}
+
+export interface CdpFixture {
+  meta: { name: string; origin: 'recorded' | 'synthetic-protocol-conformant'; chromeVersion?: string }
+  steps: CdpFixtureStep[]
+}
+
+type Listener = (ev: { data?: string; code?: number }) => void
+
+const CONNECTING = 0
+const OPEN = 1
+const CLOSING = 2
+const CLOSED = 3
+
+/** True when every key of `want` deep-equals the same key of `have` (arrays and scalars compare whole). */
+function subsetMatch(want: unknown, have: unknown): boolean {
+  if (want === null || typeof want !== 'object' || Array.isArray(want)) {
+    return JSON.stringify(want) === JSON.stringify(have)
+  }
+  if (have === null || typeof have !== 'object') return false
+  return Object.entries(want as Record<string, unknown>).every(([k, v]) =>
+    subsetMatch(v, (have as Record<string, unknown>)[k]),
+  )
+}
+
+export class FakeWebSocket {
+  static readonly CONNECTING = CONNECTING
+  static readonly OPEN = OPEN
+  static readonly CLOSING = CLOSING
+  static readonly CLOSED = CLOSED
+  readonly CONNECTING = CONNECTING
+  readonly OPEN = OPEN
+  readonly CLOSING = CLOSING
+  readonly CLOSED = CLOSED
+
+  readyState = CONNECTING
+  private listeners = new Map<string, Array<{ fn: Listener; once: boolean }>>()
+
+  constructor(
+    readonly url: string,
+    private readonly server: FakeCdpServer,
+  ) {
+    server._register(this)
+    // CDP clients see `open` on a later tick, never synchronously from the constructor.
+    queueMicrotask(() => {
+      if (this.readyState !== CONNECTING) return
+      this.readyState = OPEN
+      this.dispatch('open', {})
+    })
+  }
+
+  addEventListener(type: string, fn: Listener, opts?: boolean | { once?: boolean }): void {
+    const once = typeof opts === 'object' && opts !== null && opts.once === true
+    this.listeners.set(type, [...(this.listeners.get(type) ?? []), { fn, once }])
+  }
+
+  removeEventListener(type: string, fn: Listener): void {
+    this.listeners.set(type, (this.listeners.get(type) ?? []).filter((l) => l.fn !== fn))
+  }
+
+  send(raw: string): void {
+    if (this.readyState !== OPEN) throw new Error(`FakeWebSocket.send in readyState ${this.readyState}`)
+    this.server._handleCommand(this, JSON.parse(raw) as { id: number; method: string; params?: Record<string, unknown> })
+  }
+
+  close(code = 1000): void {
+    if (this.readyState === CLOSED || this.readyState === CLOSING) return
+    this.readyState = CLOSING
+    queueMicrotask(() => this._finishClose(code))
+  }
+
+  /** @internal server → client frame. */
+  _deliver(frame: Record<string, unknown>): void {
+    if (this.readyState !== OPEN) return
+    this.dispatch('message', { data: JSON.stringify(frame) })
+  }
+
+  /** @internal */
+  _finishClose(code: number): void {
+    if (this.readyState === CLOSED) return
+    this.readyState = CLOSED
+    this.dispatch('close', { code })
+  }
+
+  private dispatch(type: string, ev: { data?: string; code?: number }): void {
+    for (const l of [...(this.listeners.get(type) ?? [])]) {
+      if (l.once) this.removeEventListener(type, l.fn)
+      l.fn(ev)
+    }
+  }
+}
+
+export class FakeCdpServer {
+  readonly received: Array<{ id: number; method: string; params: Record<string, unknown> }> = []
+  readonly unexpected: string[] = []
+  private readonly sockets: FakeWebSocket[] = []
+  private readonly used = new Set<number>()
+  private opened = 0
+  private readonly strict: boolean
+
+  constructor(
+    private readonly fixture: CdpFixture,
+    opts: { strict?: boolean } = {},
+  ) {
+    this.strict = opts.strict ?? true
+  }
+
+  /** Stub the global WebSocket; returns the restore function. */
+  install(): () => void {
+    const bind = (url: string): FakeWebSocket => new FakeWebSocket(url, this)
+    const BoundSocket = Object.assign(function BoundSocket(url: string) {
+      return bind(url)
+    } as unknown as typeof WebSocket, { CONNECTING, OPEN, CLOSING, CLOSED })
+    const g = globalThis as { WebSocket?: unknown }
+    const had = Object.prototype.hasOwnProperty.call(g, 'WebSocket')
+    const previous = g.WebSocket
+    g.WebSocket = BoundSocket
+    return () => {
+      if (had) g.WebSocket = previous
+      else delete g.WebSocket
+    }
+  }
+
+  /** Number of sockets ever opened against this server (leak assertions). */
+  openCount(): number {
+    return this.opened
+  }
+
+  /** Push an event to every open socket right now, bypassing the fixture. */
+  emitNow(method: string, params: Record<string, unknown>): void {
+    for (const s of this.sockets) s._deliver({ method, params })
+  }
+
+  /** Simulate Chrome dying: every open socket fires `close`. */
+  closeFromServer(code = 1006): void {
+    for (const s of this.sockets) s._finishClose(code)
+  }
+
+  /** @internal */
+  _register(ws: FakeWebSocket): void {
+    this.opened += 1
+    this.sockets.push(ws)
+  }
+
+  /** @internal */
+  _handleCommand(ws: FakeWebSocket, cmd: { id: number; method: string; params?: Record<string, unknown> }): void {
+    const params = cmd.params ?? {}
+    this.received.push({ id: cmd.id, method: cmd.method, params })
+    const matches = this.fixture.steps
+      .map((step, i) => ({ step, i }))
+      .filter(({ step }) => step.when.method === cmd.method && subsetMatch(step.when.params ?? {}, params))
+    const pick = matches.find((m) => !this.used.has(m.i)) ?? matches[matches.length - 1]
+    queueMicrotask(() => {
+      if (!pick) {
+        this.unexpected.push(cmd.method)
+        if (this.strict) {
+          ws._deliver({ id: cmd.id, error: { code: -32601, message: `'${cmd.method}' wasn't found` } })
+        } else {
+          ws._deliver({ id: cmd.id, result: {} })
+        }
+        return
+      }
+      this.used.add(pick.i)
+      const { reply, emit } = pick.step
+      if (reply?.error) ws._deliver({ id: cmd.id, error: reply.error })
+      else ws._deliver({ id: cmd.id, result: reply?.result ?? {} })
+      for (const ev of emit ?? []) {
+        const frame = { method: ev.method, params: ev.params }
+        if (ev.delayMs && ev.delayMs > 0) setTimeout(() => ws._deliver(frame), ev.delayMs)
+        else ws._deliver(frame)
+      }
+    })
+  }
+}
+
+const FIXTURE_DIR = join(__dirname, '..', 'fixtures', 'cdp')
+
+/** Read `test/fixtures/cdp/<name>.cdp.json`. */
+export function loadFixture(name: string): CdpFixture {
+  return JSON.parse(readFileSync(join(FIXTURE_DIR, `${name}.cdp.json`), 'utf8')) as CdpFixture
+}
diff --git a/packages/stealth/stealth-core-browser/test/helpers/fake-proc.ts b/packages/stealth/stealth-core-browser/test/helpers/fake-proc.ts
new file mode 100644
index 000000000..73c5edf2f
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/test/helpers/fake-proc.ts
@@ -0,0 +1,108 @@
+/**
+ * Fake process table for the unit lane.
+ * Ticket 8468f7b1 · criterion [cdp-test-harness.6]
+ *
+ * `FakeProc` simulates liveness (`pidAlive`), process identity (`procStart`,
+ * the start-time token that distinguishes a recycled pid), signal delivery
+ * (`kill(pid | -pgid, signal)`, logged, never touches a real process) and a
+ * recording `spawn`. Nothing here touches a real process.
+ */
+
+export interface SpawnCall {
+  command: string
+  args: string[]
+  opts: Record<string, unknown>
+  pid: number
+}
+
+export interface KillCall {
+  /** Positive pid, or negative pgid to signal the whole group. */
+  target: number
+  signal: string | number
+}
+
+export interface FakeProcEntry {
+  pid: number
+  pgid: number
+  start: string
+  alive: boolean
+  command: string
+}
+
+export class FakeProc {
+  readonly killLog: KillCall[] = []
+  readonly spawnLog: SpawnCall[] = []
+  private table = new Map<number, FakeProcEntry>()
+  private nextPid: number
+  private startSeq = 0
+
+  constructor(firstPid = 4000) {
+    this.nextPid = firstPid
+  }
+
+  /** Register an already-running process (e.g. a Chrome another manager launched). Returns its entry. */
+  addProcess(init: { pid?: number; pgid?: number; start?: string; command?: string } = {}): FakeProcEntry {
+    const pid = init.pid ?? this.nextPid++
+    const entry: FakeProcEntry = {
+      pid,
+      pgid: init.pgid ?? pid,
+      start: init.start ?? `start-${++this.startSeq}`,
+      alive: true,
+      command: init.command ?? 'fake',
+    }
+    this.table.set(pid, entry)
+    return entry
+  }
+
+  /** True while the process exists and has not died; unknown pids are dead. */
+  pidAlive(pid: number): boolean {
+    return this.table.get(pid)?.alive === true
+  }
+
+  /** Start-time token for a live pid; null when dead/unknown. A recycled pid gets a different token. */
+  procStart(pid: number): string | null {
+    const e = this.table.get(pid)
+    return e?.alive ? e.start : null
+  }
+
+  /**
+   * Deliver a signal. Mirrors process.kill: signal 0 probes only (throws ESRCH
+   * when absent), a negative target signals every live member of that group,
+   * SIGTERM/SIGKILL (and numeric 15/9) kill. Every call is logged first.
+   */
+  kill(target: number, signal: string | number = 'SIGTERM'): true {
+    this.killLog.push({ target, signal })
+    const victims =
+      target < 0
+        ? [...this.table.values()].filter((e) => e.alive && e.pgid === -target)
+        : [this.table.get(target)].filter((e): e is FakeProcEntry => e?.alive === true)
+    if (victims.length === 0) {
+      const err = new Error(`kill ESRCH ${target}`) as NodeJS.ErrnoException
+      err.code = 'ESRCH'
+      throw err
+    }
+    if (signal === 0 || signal === '0') return true
+    if (signal === 'SIGTERM' || signal === 15 || signal === 'SIGKILL' || signal === 9 || signal === 'SIGINT') {
+      for (const v of victims) v.alive = false
+    }
+    return true
+  }
+
+  /** Recording spawn: allocates a live process (its own group leader) and returns `{ pid }`. */
+  spawn(command: string, args: string[] = [], opts: Record<string, unknown> = {}): { pid: number; unref(): void } {
+    const entry = this.addProcess({ command })
+    this.spawnLog.push({ command, args, opts, pid: entry.pid })
+    return { pid: entry.pid, unref: () => undefined }
+  }
+
+  /** Test helper: the process dies by itself (crash). */
+  die(pid: number): void {
+    const e = this.table.get(pid)
+    if (e) e.alive = false
+  }
+
+  /** Test helper: the OS recycles `pid` for an unrelated new process (new start token). */
+  recycle(pid: number): FakeProcEntry {
+    return this.addProcess({ pid, command: 'unrelated' })
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/test/helpers/lifecycle/browser-mocks.ts b/packages/stealth/stealth-core-browser/test/helpers/lifecycle/browser-mocks.ts
new file mode 100644
index 000000000..1ac6dec7a
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/test/helpers/lifecycle/browser-mocks.ts
@@ -0,0 +1,52 @@
+/**
+ * Shared doubles for the lifecycle specs that drive src/lib/cdp/browser.ts.
+ * Each spec declares the `vi.mock` calls itself (they are hoisted per file)
+ * and installs `processDoubles().kill` with `vi.spyOn(process, 'kill')`
+ * (this module imports nothing from the test runner).
+ * No Chrome is launched, no process is signalled, port 9222 is never contacted.
+ * Ticket 8468f7b1 · plan state chrome-lifecycle ([chrome-lifecycle.11] [chrome-lifecycle.12]).
+ */
+export interface KillEntry {
+  pid: number
+  sig: string | number | undefined
+}
+
+export interface ProcessDoubles {
+  /** Every process.kill call, in order (signal-0 probes included). */
+  log: KillEntry[]
+  /** Pids that answer a signal-0 probe (still alive). */
+  alive: Set<number>
+  /** Negative pids whose group signal throws (not a group leader). */
+  ungrouped: Set<number>
+  /** The replacement for process.kill: logs, never signals anything real. */
+  kill: typeof process.kill
+}
+
+export function processDoubles(): ProcessDoubles {
+  const d = { log: [] as KillEntry[], alive: new Set<number>(), ungrouped: new Set<number>() }
+  const kill = ((pid: number, sig?: string | number) => {
+    d.log.push({ pid, sig })
+    if (sig === 0 && !d.alive.has(pid)) throw Object.assign(new Error('ESRCH'), { code: 'ESRCH' })
+    if (pid < 0 && d.ungrouped.has(pid)) throw Object.assign(new Error('EPERM'), { code: 'EPERM' })
+    return true
+  }) as typeof process.kill
+  return { ...d, kill }
+}
+
+/** The signals delivered (signal-0 liveness probes removed). */
+export function signals(log: KillEntry[]): KillEntry[] {
+  return log.filter((e) => e.sig !== 0)
+}
+
+/** A scripted `execSync`: the first needle contained in the command decides the output (or throw). */
+export function execScript(map: Record<string, string | Error>): (cmd: string) => string {
+  return (cmd: string) => {
+    for (const [needle, out] of Object.entries(map)) {
+      if (cmd.includes(needle)) {
+        if (out instanceof Error) throw out
+        return out
+      }
+    }
+    throw new Error(`unexpected exec: ${cmd}`)
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/test/helpers/lifecycle/fake-backend.ts b/packages/stealth/stealth-core-browser/test/helpers/lifecycle/fake-backend.ts
new file mode 100644
index 000000000..7dbf09c80
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/test/helpers/lifecycle/fake-backend.ts
@@ -0,0 +1,98 @@
+/**
+ * An in-memory stand-in for the service-proxy transport a `createProxyReaperLink`
+ * dials: `dialBackend` returns a `FakeConnection` whose frames are answered by
+ * a handler (usually a real `createReaperHost`), and the test controls whether
+ * the backend accepts connections and when it drops one. No socket.
+ * Ticket 8468f7b1 · plan state chrome-lifecycle ([chrome-lifecycle.15] [chrome-lifecycle.29]).
+ */
+import type { ReaperHost, RpcRequest, RpcResponse } from '../../../src/lib/lifecycle/reaper-host.js'
+
+export interface DialOptionsSeen {
+  socketPath: string
+  backoff?: { giveUpAfterMs?: number }
+  onConnect?: () => void
+  onDisconnect?: () => void
+  onDiagnostic?: (line: string) => void
+}
+
+export class FakeConnection {
+  readonly sent: RpcRequest[] = []
+  readonly notified: RpcRequest[] = []
+  closed = false
+  connected = false
+
+  constructor(
+    readonly backend: FakeBackend,
+    readonly opts: DialOptionsSeen,
+    readonly connectionId: string,
+  ) {}
+
+  async send(req: RpcRequest): Promise<RpcResponse> {
+    this.sent.push(req)
+    if (this.closed) return { jsonrpc: '2.0', id: req.id ?? null, error: { code: -32001, message: 'connection closed' } }
+    if (!this.backend.accepting) {
+      // Never connected within the give-up bound: the transport fast-fails with -32001.
+      return { jsonrpc: '2.0', id: req.id ?? null, error: { code: -32001, message: 'backend unavailable' } }
+    }
+    if (!this.connected) {
+      this.connected = true
+      this.backend.host?.onClientConnect(this.connectionId)
+      this.opts.onConnect?.()
+    }
+    const r = this.backend.host ? await this.backend.host.handler(req, { connectionId: this.connectionId }) : undefined
+    return r ?? { jsonrpc: '2.0', id: req.id ?? null, result: null }
+  }
+
+  notify(req: RpcRequest): void {
+    if (this.backend.notifyThrows) throw new Error('EPIPE: notify on a dead socket')
+    this.notified.push(req)
+    if (this.connected && !this.closed) void this.backend.host?.handler(req, { connectionId: this.connectionId })
+  }
+
+  isConnected(): boolean {
+    return this.connected && !this.closed
+  }
+
+  close(): void {
+    if (this.closed) return
+    this.closed = true
+    if (this.connected) this.backend.host?.onClientDisconnect(this.connectionId, 'end')
+    this.connected = false
+  }
+
+  /** The backend closed this ESTABLISHED connection (host retired or crashed). */
+  dropByBackend(): void {
+    if (!this.connected || this.closed) return
+    this.connected = false
+    this.backend.host?.onClientDisconnect(this.connectionId, 'closed-by-backend')
+    this.opts.onDisconnect?.()
+  }
+}
+
+export class FakeBackend {
+  /** The host serving the socket (null: nothing answers frames). */
+  host: ReaperHost | null = null
+  /** False: connections never come up (every send resolves -32001). */
+  accepting = true
+  notifyThrows = false
+  readonly dials: FakeConnection[] = []
+  private seq = 0
+
+  /** Use as the `dialBackend` double. */
+  dial = (opts: Record<string, unknown>): FakeConnection => {
+    const c = new FakeConnection(this, opts as unknown as DialOptionsSeen, `conn-${++this.seq}`)
+    this.dials.push(c)
+    return c
+  }
+
+  /** Live (not closed) dials. */
+  live(): FakeConnection[] {
+    return this.dials.filter((d) => !d.closed)
+  }
+
+  /** The host retires: every established connection is dropped by the backend. */
+  retire(): void {
+    for (const d of this.dials) d.dropByBackend()
+    this.host = null
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/test/helpers/lifecycle/fake-reaper-link.ts b/packages/stealth/stealth-core-browser/test/helpers/lifecycle/fake-reaper-link.ts
new file mode 100644
index 000000000..31d436d46
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/test/helpers/lifecycle/fake-reaper-link.ts
@@ -0,0 +1,160 @@
+/**
+ * The unit-test substitute for the one lifecycle seam, `ReaperLink`.
+ * Ticket 8468f7b1 · plan state chrome-lifecycle ([chrome-lifecycle.22]).
+ *
+ * `FakeReaperHub` stands in for the reaper host PROCESS of one port: it owns a
+ * real `createReaperHost` (the same pure host the production entry serves) and
+ * plays the transport — connection ids, connect/disconnect hooks, a host that
+ * retires or cannot be started. `FakeReaperLink` is one client's held
+ * connection to it. No socket, no process: the manager tests substitute these
+ * through `ChromeManagerOptions.link`.
+ */
+import { lifecycleErrors, type LifecycleError } from '../../../src/lib/lifecycle/errors.js'
+import type { ReaperLink } from '../../../src/lib/lifecycle/reaper-link.js'
+import type { ReapOutcome, ReaperHost, ReaperStatus, RpcResponse } from '../../../src/lib/lifecycle/reaper-host.js'
+
+export interface FakeHubOptions {
+  /** Builds a fresh host (called on the first ensure and after every retire). */
+  makeHost: () => ReaperHost
+}
+
+export class FakeReaperHub {
+  host: ReaperHost | null = null
+  /** False: `ensure` fails (e.g. the state dir is unsafe, E_UDS_DIR_UNSAFE). */
+  available = true
+  /** The CDP port this hub's host serves (only used in error messages). */
+  port = 9333
+  /** How many times a host was started (spawned). */
+  spawns = 0
+  private seq = 0
+  private readonly links = new Set<FakeReaperLink>()
+
+  constructor(private readonly opts: FakeHubOptions) {}
+
+  /** The transport side of `ensureBackend`: start a host if none runs. */
+  ensure(): boolean {
+    if (!this.available) return false
+    if (!this.host) {
+      this.host = this.opts.makeHost()
+      this.spawns++
+    }
+    return true
+  }
+
+  /** @internal accept one connection. */
+  connect(link: FakeReaperLink): string {
+    const id = `c${++this.seq}`
+    this.links.add(link)
+    this.host?.onClientConnect(id)
+    return id
+  }
+
+  /** @internal a connection closed. */
+  disconnect(link: FakeReaperLink, id: string, reason: 'end' | 'error' | 'closed-by-backend' = 'end'): void {
+    this.links.delete(link)
+    this.host?.onClientDisconnect(id, reason)
+  }
+
+  /** The host retires (Chrome gone + orphan window): every held connection is closed by the backend. */
+  retire(): void {
+    const links = [...this.links]
+    for (const l of links) l._droppedByHost()
+    this.host = null
+  }
+
+  async rpc(id: string, method: string, params?: unknown, notification = false): Promise<RpcResponse | undefined> {
+    if (!this.host) return undefined
+    return this.host.handler(notification ? { jsonrpc: '2.0', method, params } : { jsonrpc: '2.0', id: 1, method, params }, { connectionId: id })
+  }
+}
+
+export class FakeReaperLink implements ReaperLink {
+  ensureCalls = 0
+  activityCalls = 0
+  releaseCalls = 0
+  reapCalls = 0
+  /** Make the next operations reject/throw (a broken transport). */
+  broken = false
+  private conn: string | null = null
+  private failure: LifecycleError | null = null
+
+  constructor(
+    readonly hub: FakeReaperHub,
+    readonly hello: { pid: number; checkHistory: boolean },
+  ) {}
+
+  get connectionId(): string | null {
+    return this.conn
+  }
+
+  async ensureAndHello(): Promise<boolean> {
+    this.ensureCalls++
+    if (this.broken) return this.fail(new Error('fake transport broken'))
+    if (this.conn) return true
+    if (!this.hub.ensure()) return this.fail(Object.assign(new Error('socket directory is not private'), { code: 'E_UDS_DIR_UNSAFE' }))
+    this.conn = this.hub.connect(this)
+    await this.hub.rpc(this.conn, 'hello', this.hello)
+    this.failure = null
+    return true
+  }
+
+  lastError(): LifecycleError | null {
+    return this.failure
+  }
+
+  private fail(cause: Error): false {
+    this.failure = lifecycleErrors.reaperUnavailable(this.hub.port, cause)
+    return false
+  }
+
+  activity(): void {
+    this.activityCalls++
+    if (this.broken) throw new Error('fake transport broken')
+    if (this.conn) void this.hub.rpc(this.conn, 'activity', undefined, true)
+  }
+
+  async reapIfIdle(): Promise<ReapOutcome | null> {
+    this.reapCalls++
+    if (this.broken) throw new Error('fake transport broken')
+    if (!this.conn) return null
+    const r = await this.hub.rpc(this.conn, 'reapIfIdle')
+    return (r?.result as ReapOutcome | undefined) ?? null
+  }
+
+  async release(): Promise<void> {
+    this.releaseCalls++
+    if (this.broken) throw new Error('fake transport broken')
+    if (!this.conn) return
+    const id = this.conn
+    this.conn = null
+    await this.hub.rpc(id, 'release')
+    this.hub.disconnect(this, id)
+  }
+
+  async status(): Promise<ReaperStatus | null> {
+    if (this.broken) throw new Error('fake transport broken')
+    if (!this.conn) return null
+    const r = await this.hub.rpc(this.conn, 'status')
+    return (r?.result as ReaperStatus | undefined) ?? null
+  }
+
+  isUp(): boolean {
+    return this.conn !== null
+  }
+
+  /** The client process is killed with kill -9: the kernel closes its socket, no release is sent. */
+  kill9(): void {
+    if (!this.conn) return
+    const id = this.conn
+    this.conn = null
+    this.hub.disconnect(this, id, 'end')
+  }
+
+  /** @internal the host closed this connection (retire). */
+  _droppedByHost(): void {
+    if (!this.conn) return
+    const id = this.conn
+    this.conn = null
+    this.hub.disconnect(this, id, 'closed-by-backend')
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/test/helpers/lifecycle/host-fixture.ts b/packages/stealth/stealth-core-browser/test/helpers/lifecycle/host-fixture.ts
new file mode 100644
index 000000000..12733c6e8
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/test/helpers/lifecycle/host-fixture.ts
@@ -0,0 +1,123 @@
+/**
+ * Test world for the reaper host: a scripted Chrome (reachability, http pages,
+ * history), an owner record, a manual host clock and an ordered event log of
+ * every effect the host performs. No socket, no process, no real Chrome.
+ * Ticket 8468f7b1 · plan state chrome-lifecycle ([chrome-lifecycle.5] [chrome-lifecycle.16]).
+ */
+import { createReaperHost, type OwnerRecord, type ReaperHost, type ReaperHostDeps, type RpcResponse } from '../../../src/lib/lifecycle/reaper-host.js'
+
+export interface HostWorld {
+  now: number
+  chromeUp: boolean
+  /** A number of http(s) pages, or an Error to simulate an unreachable CDP during the check. */
+  httpPages: number | Error
+  /** A recent visit, or an Error to simulate an unavailable history database. */
+  history: boolean | Error
+  owner: OwnerRecord | null
+  ownerValid: boolean
+  /** Ordered effects: close-pages, kill-group:<pid>, kill-port:<port>, remove-record. */
+  events: string[]
+  logs: string[]
+  /** Number of history reads (the tier is skipped entirely when disabled). */
+  historyReads: number
+  activityTouches: number
+}
+
+export const PORT = 9333
+export const IDLE = 120_000
+export const GRACE = 30_000
+
+export interface HostHarness {
+  world: HostWorld
+  host: ReaperHost
+  deps: ReaperHostDeps
+  /** A JSON-RPC request from `conn` (id 1 unless given). */
+  call(conn: string, method: string, params?: unknown, id?: number): Promise<RpcResponse | undefined>
+  /** A JSON-RPC notification (no id) from `conn`. */
+  notify(conn: string, method: string, params?: unknown): Promise<RpcResponse | undefined>
+  /** Connect + hello. */
+  join(conn: string, pid: number, checkHistory?: boolean): Promise<void>
+  advance(ms: number): void
+}
+
+export function makeHost(overrides: Partial<ReaperHostDeps> = {}, init: Partial<HostWorld> = {}): HostHarness {
+  const world: HostWorld = {
+    now: 1_000_000,
+    chromeUp: true,
+    httpPages: 0,
+    history: false,
+    owner: null,
+    ownerValid: false,
+    events: [],
+    logs: [],
+    historyReads: 0,
+    activityTouches: 0,
+    ...init,
+  }
+  const deps: ReaperHostDeps = {
+    port: PORT,
+    idleTimeoutMs: IDLE,
+    shutdownGraceMs: GRACE,
+    now: () => world.now,
+    probeChrome: async () => world.chromeUp,
+    countHttpPages: async () => {
+      if (world.httpPages instanceof Error) throw world.httpPages
+      return world.httpPages
+    },
+    historyRecent: () => {
+      world.historyReads++
+      if (world.history instanceof Error) throw world.history
+      return world.history
+    },
+    owner: {
+      read: () => world.owner,
+      isValid: () => world.ownerValid,
+      remove: () => {
+        world.events.push('remove-record')
+        world.owner = null
+      },
+    },
+    closeAllPageTargets: async () => {
+      world.events.push('close-pages')
+    },
+    killProcessGroup: async (pid: number) => {
+      world.events.push(`kill-group:${pid}`)
+      world.chromeUp = false
+    },
+    killChrome: async (port: number) => {
+      world.events.push(`kill-port:${port}`)
+      world.chromeUp = false
+    },
+    logger: (m: string) => world.logs.push(m),
+    onActivity: () => {
+      world.activityTouches++
+    },
+    ...overrides,
+  }
+  const host = createReaperHost(deps)
+  const call = (conn: string, method: string, params?: unknown, id = 1) =>
+    host.handler({ jsonrpc: '2.0', id, method, params }, { connectionId: conn })
+  const notify = (conn: string, method: string, params?: unknown) =>
+    host.handler({ jsonrpc: '2.0', method, params }, { connectionId: conn })
+  return {
+    world,
+    host,
+    deps,
+    call,
+    notify,
+    async join(conn: string, pid: number, checkHistory?: boolean) {
+      host.onClientConnect(conn)
+      await call(conn, 'hello', checkHistory === undefined ? { pid } : { pid, checkHistory })
+    },
+    advance(ms: number) {
+      world.now += ms
+    },
+  }
+}
+
+/** The `result` of a response, asserting there was no error. */
+export function resultOf<T = Record<string, unknown>>(r: RpcResponse | undefined): T {
+  if (!r) throw new Error('expected a response, got none (notification?)')
+  if (r.error) throw new Error(`expected a result, got error ${r.error.code} ${r.error.message}`)
+  return r.result as T
+}
diff --git a/packages/stealth/stealth-core-browser/test/helpers/lifecycle/manager-clients.ts b/packages/stealth/stealth-core-browser/test/helpers/lifecycle/manager-clients.ts
new file mode 100644
index 000000000..43315e771
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/test/helpers/lifecycle/manager-clients.ts
@@ -0,0 +1,106 @@
+/**
+ * Builders for the ChromeManager-level specs over `manager-world.ts`: the
+ * reaper host process of the port (a real pure `createReaperHost` whose effects
+ * act on the world, served by `FakeReaperHub`) and client processes (a
+ * `ChromeManager` holding a `FakeReaperLink`). Import it AFTER the spec's
+ * `vi.mock` calls (it imports the mocked modules).
+ *
+ * Ticket 8468f7b1 · plan state chrome-lifecycle ([chrome-lifecycle.22]).
+ */
+import { ChromeManager, type ChromeManagerOptions } from '../../../src/lib/chrome-manager.js'
+import { createOwnershipStore, type OwnershipFs } from '../../../src/lib/lifecycle/ownership.js'
+import { countActiveWebPages } from '../../../src/lib/lifecycle/page-tier.js'
+import { createReaperHost, type ReaperHost, type ReaperHostDeps } from '../../../src/lib/lifecycle/reaper-host.js'
+import { FakeReaperHub, FakeReaperLink } from './fake-reaper-link.js'
+import { chromeGone, GRACE, HOST, IDLE, PORT, STATE_DIR, world } from './manager-world.js'
+
+export interface WorldHostOptions {
+  idleTimeoutMs?: number
+  shutdownGraceMs?: number
+  scope?: ReaperHostDeps['scope']
+  checkHistoryDefault?: boolean
+  logs?: string[]
+}
+
+/** A real `createReaperHost` whose effects act on the world (host clock = the faked `Date.now`). */
+export function worldHost(o: WorldHostOptions = {}): ReaperHost {
+  const owner = createOwnershipStore({
+    stateDir: STATE_DIR,
+    port: PORT,
+    fs: world.fs as unknown as OwnershipFs,
+    isSameProcess: (pid, start) => start !== null && world.procs.get(pid) === start,
+    readProcessStartToken: (pid) => world.procs.get(pid) ?? null,
+  })
+  return createReaperHost({
+    port: PORT,
+    idleTimeoutMs: o.idleTimeoutMs ?? IDLE,
+    shutdownGraceMs: o.shutdownGraceMs ?? GRACE,
+    ...(o.scope ? { scope: o.scope } : {}),
+    ...(o.checkHistoryDefault === undefined ? {} : { checkHistoryDefault: o.checkHistoryDefault }),
+    now: () => Date.now(),
+    probeChrome: async () => world.chromeUp,
+    countHttpPages: () =>
+      countActiveWebPages(async () => {
+        if (!world.chromeUp || world.listFails) throw new Error('connect ECONNREFUSED')
+        return world.pages
+      }),
+    historyRecent: () => {
+      if (world.history instanceof Error) throw world.history
+      return world.history
+    },
+    owner: {
+      read: () => owner.read(),
+      isValid: (r) => owner.isValid(r),
+      remove: () => {
+        world.events.push('host:remove-record')
+        owner.remove()
+      },
+    },
+    closeAllPageTargets: async () => {
+      world.events.push('host:close-pages')
+      if (world.failClose) throw new Error('close failed')
+      world.pages = []
+    },
+    killProcessGroup: async (pid) => {
+      world.events.push(`host:kill-group:${pid}`)
+      if (world.failKill) throw new Error('kill EPERM')
+      world.procs.delete(pid)
+      chromeGone()
+    },
+    killChrome: async (port) => {
+      world.events.push(`host:kill:${port}`)
+      if (world.failKill) throw new Error('kill EPERM')
+      chromeGone()
+    },
+    logger: (m) => o.logs?.push(m),
+  })
+}
+
+/** One reaper host process for the port, started on the first ensure. */
+export function makeHub(o: WorldHostOptions = {}): FakeReaperHub {
+  return new FakeReaperHub({ makeHost: () => worldHost(o) })
+}
+
+export interface Client {
+  manager: ChromeManager
+  link: FakeReaperLink
+  logs: string[]
+  /** Only the degraded-mode warnings (`warning:` lines). */
+  warnings(): string[]
+}
+
+/** One client process: a ChromeManager holding a FakeReaperLink to `hub`. */
+export function client(hub: FakeReaperHub, pid: number, opts: ChromeManagerOptions = {}): Client {
+  const logs: string[] = []
+  const link = new FakeReaperLink(hub, { pid, checkHistory: opts.checkHistory ?? true })
+  const manager = new ChromeManager({
+    cdpHost: HOST,
+    idleTimeoutMs: IDLE,
+    shutdownGraceMs: GRACE,
+    stateDir: STATE_DIR,
+    logger: (m) => logs.push(m),
+    link,
+    ...opts,
+  })
+  return { manager, link, logs, warnings: () => logs.filter((l) => l.startsWith('warning:')) }
+}
diff --git a/packages/stealth/stealth-core-browser/test/helpers/lifecycle/manager-world.ts b/packages/stealth/stealth-core-browser/test/helpers/lifecycle/manager-world.ts
