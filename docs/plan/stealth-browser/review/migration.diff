+    await expect(chromeStatus({ host: 'evil/host', port: world.port })).rejects.toMatchObject({ code: 'CDP_UNREACHABLE' })
+    expect(world.requested).toEqual([])
+  })
+})
diff --git a/packages/stealth/stealth-core-browser/test/unit/use-cases/open-an-isolated-page-and-clean-up.spec.ts b/packages/stealth/stealth-core-browser/test/unit/use-cases/open-an-isolated-page-and-clean-up.spec.ts
