+/**
+ * CL15 (F24 N1 N5) the reaper host process body, `runChromeReaper(cfg)`.
+ * Ticket 8468f7b1 · [chrome-lifecycle.15]
+ *
+ * The detached reaper serves the pure host over `serveBackend` (handler plus
+ * the connection hooks, so a killed client's connection drops it at once),
+ * ticks every 5 s to reap an idle Chrome, and retires itself through
+ * `createIdleRetirer` over `orphanWindowMs` once Chrome is gone: a host nobody
+ * uses must still exit. vi.mock('@adhd/sox-service-proxy') keeps the real
+ * `createIdleRetirer` and replaces only `serveBackend`; CDP, kills and history
+ * act on the simulated machine (manager-world). No socket, no process.
+ * guards: serveBackend gets the socket, the host handler and both connection hooks
+ * guards: the history safety tier reads the profile the reaper guards, not the default profile
+ * tier: S
+ * cites: 8468f7b1 [chrome-lifecycle.15] [audit-fixes.5]
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const seen = vi.hoisted(() => ({ historyProfiles: [] as Array<string | undefined> }))
+
+vi.mock('node:fs', async () => (await import('../../helpers/lifecycle/manager-world.js')).fsModule())
+vi.mock('../../../src/lib/cdp/browser.js', async () => (await import('../../helpers/lifecycle/manager-world.js')).browserModule(vi.fn))
+vi.mock('../../../src/lib/cdp/targets.js', async () => (await import('../../helpers/lifecycle/manager-world.js')).targetsModule(vi.fn))
+vi.mock('@adhd/sox-service-proxy', async (orig) => (await import('../../helpers/lifecycle/manager-world.js')).spModule(await orig<Record<string, unknown>>()))
+vi.mock('../../../src/lib/storage/history.js', async () => {
+  const { world } = await import('../../helpers/lifecycle/manager-world.js')
+  return {
+    HistoryClient: class {
+      constructor(profileDir?: string) {
+        seen.historyProfiles.push(profileDir)
+      }
+      isRecentlyUsed(): boolean {
+        if (world.history instanceof Error) throw world.history
+        return world.history
+      }
+    },
+  }
+})
+
+import { REAPER_TICK_MS, runChromeReaper, type ChromeReaperConfig } from '../../../src/lib/lifecycle/reaper-entry.js'
+import type { RpcRequest, RpcResponse } from '../../../src/lib/lifecycle/reaper-host.js'
+import { chromeGone, openPage, PORT, resetSp, resetWorld, sp, STATE_DIR, world } from '../../helpers/lifecycle/manager-world.js'
+import { must } from '../../helpers/must.js'
+
+interface Served {
+  socketPath: string
+  handler: (req: RpcRequest, ctx: { connectionId: string }) => Promise<RpcResponse | undefined>
+  onClientConnect: (id: string) => void
+  onClientDisconnect: (id: string, reason: 'end' | 'error' | 'closed-by-backend') => void
+}
+
+const orphanWindowMs = 12_000
+const CFG: ChromeReaperConfig = {
+  port: PORT,
+  stateDir: STATE_DIR,
+  socketPath: `${STATE_DIR}/reaper.sock`,
+  idleTimeoutMs: 20_000,
+  shutdownGraceMs: 5_000,
+  orphanWindowMs,
+}
+
