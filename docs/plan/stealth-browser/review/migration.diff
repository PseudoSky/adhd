+ * @adhd/resilience-core-tripwire: a persistent kill-switch latch with a
+ * lock-file protocol, fail-closed reads, an NDJSON audit trail and a
+ * break-glass clear. Single entry point (no subpath exports).
+ *
+ * The runtime surface is exactly the API of the package specification
+ * (pinned by test/unit/api-surface.spec.ts), plus `createNodeFs`, the
+ * Node `FsPort` a caller needs to run `createFileStorage` on a real disk.
+ * The interactive and CLI surface (interactiveGate, confirmSolved,
+ * runUnlockCli, renderStatusText, statusJsonLine) takes an injected
+ * `TripwireIo`; nodeTripwireIo is the single Node adapter of it.
+ */
+export { createTripwire } from './lib/tripwire.js';
+export { adhdDataDir } from './lib/paths.js';
+export { CONFIRM_TOKEN } from './lib/types.js';
+export type {
+  AuditEvent,
+  AuditEventName,
+  ClearMethod,
+  ClearOptions,
+  GateResult,
+  JsonValue,
+  KnownTripReason,
+  PriorClear,
+  Redactor,
+  StatusOptions,
+  TripContext,
+  TripInput,
+  TripResult,
+  Tripwire,
+  TripwireOptions,
+  TripwireRecord,
+  TripwireSnapshot,
+  TripwireStatus,
+  TripwireWarning,
+} from './lib/types.js';
+export { defaultRedactor } from './lib/redact.js';
+export {
+  TripwireAbortedError,
+  TripwireConfirmError,
+  TripwireError,
+  TripwireIoError,
+  TripwireKeyError,
+  TripwireTrippedError,
+  isTripwireError,
+  isTripwireTrippedError,
+} from './lib/errors.js';
+export type {
+  TripwireErrorCode,
+  TrippedErrorExtra,
+  TrippedErrorInit,
+} from './lib/errors.js';
+export {
+  createFileStorage,
+  createMemoryStorage,
+  createNodeFs,
+} from './lib/storage.js';
+export type {
+  FileStorageOptions,
+  MemoryTripwireStorage,
+  TripwireStorage,
