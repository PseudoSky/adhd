@@ -0,0 +1,186 @@
+/**
+ * Cross-process coordination failsafes, proven through the connection-based
+ * mechanism (one held connection per client to the reaper host; no shared
+ * heartbeat file). The FEATURE of each row is unchanged; the mechanism that
+ * provides it is the host registry (`createReaperHost`).
+ * Ticket 8468f7b1 · [chrome-lifecycle.5] [chrome-lifecycle.6] [chrome-lifecycle.16] [chrome-lifecycle.21] ·
+ * inventory [fs-012] [fs-013] [fs-014] [fs-015] [fs-016] [fs-017] [fs-018] [fs-019]
+ *
+ * The host-level rows call `createReaperHost` directly (host-fixture); the
+ * client-side rows (fs-017, fs-018) drive real ChromeManagers on the simulated
+ * machine (manager-world). No socket, no process, no real port.
+ * guards: defers while a live sibling was active within the window
+ * tier: S
+ * cites: 8468f7b1 [chrome-lifecycle.5] [chrome-lifecycle.6] [chrome-lifecycle.16] [chrome-lifecycle.21]
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('node:fs', async () => (await import('../../helpers/lifecycle/manager-world.js')).fsModule())
+vi.mock('../../../src/lib/cdp/browser.js', async () => (await import('../../helpers/lifecycle/manager-world.js')).browserModule(vi.fn))
+vi.mock('../../../src/lib/cdp/targets.js', async () => (await import('../../helpers/lifecycle/manager-world.js')).targetsModule(vi.fn))
+vi.mock('@adhd/sox-service-proxy', async (orig) => (await import('../../helpers/lifecycle/manager-world.js')).spModule(await orig<Record<string, unknown>>()))
+
+import { GRACE, IDLE, makeHost, resultOf } from '../../helpers/lifecycle/host-fixture.js'
+import { IDLE as CLIENT_IDLE, openPage, resetSp, resetWorld, world } from '../../helpers/lifecycle/manager-world.js'
+import { client, makeHub } from '../../helpers/lifecycle/manager-clients.js'
+import { must } from '../../helpers/must.js'
+
+beforeEach(() => {
+  resetWorld()
+  resetSp()
+})
+
+afterEach(() => {
+  vi.useRealTimers()
+  vi.restoreAllMocks()
+})
+
+describe('8468f7b1 [chrome-lifecycle.5] cross-process coordination through the reaper host', () => {
+  it('defers while a live sibling was active within the window', async () => {
+    // [fs-012] tier 1: client B sent `activity` inside the window, A's reapIfIdle keeps Chrome.
+    const h = makeHost()
+    await h.join('A', 11)
+    await h.join('B', 22)
+    await h.notify('B', 'activity')
+    h.advance(60_000)
+    expect(resultOf(await h.call('A', 'reapIfIdle'))).toEqual({ action: 'keep', pinnedBy: 'client', reaped: false })
+    expect(h.world.events).toEqual([])
+  })
+
+  it('ignores its own activity record and honours the window', async () => {
+    // [fs-013] the caller is excluded from the client pin; the window is exactly idleTimeoutMs.
+    const h = makeHost()
+    await h.join('A', 11)
+    await h.join('B', 22)
+    await h.notify('A', 'activity')
+    expect(resultOf<{ action: string }>(await h.call('A', 'reapIfIdle')).action).toBe('reap')
+
+    const w = makeHost()
+    await w.join('A', 11)
+    await w.join('B', 22)
+    await w.notify('B', 'activity')
+    w.advance(IDLE - 1)
+    expect(resultOf<{ action: string }>(await w.call('A', 'reapIfIdle')).action).toBe('keep')
+    w.advance(1)
+    expect(resultOf<{ action: string }>(await w.call('A', 'reapIfIdle')).action).toBe('reap')
+  })
+
+  it("merges its record with the siblings' records", async () => {
+    // [fs-014] one entry per connection: a third client's hello and activity leave A and B untouched.
+    const h = makeHost()
+    await h.join('A', 11)
+    await h.notify('A', 'activity')
+    h.advance(1_000)
+    await h.join('B', 22)
+    await h.notify('B', 'activity')
+    const before = h.host.clients()
+    h.advance(1_000)
+    await h.join('C', 33)
+    await h.notify('C', 'activity')
+    const after = h.host.clients()
+    expect(after.filter((c) => c.id !== 'C')).toEqual(before)
+    expect(after.map((c) => [c.id, c.pid])).toEqual([
+      ['A', 11],
+      ['B', 22],
+      ['C', 33],
+    ])
+  })
+
+  it('ignores records of dead processes', async () => {
+    // [fs-015] a killed client (kill -9: no release) disconnects and is dropped at once; it cannot hold Chrome.
+    const h = makeHost()
+    await h.join('A', 11)
+    await h.join('B', 22)
+    await h.notify('B', 'activity')
+    h.host.onClientDisconnect('B', 'end')
+    expect(h.host.clients().map((c) => c.id)).toEqual(['A'])
+    expect(resultOf<{ action: string }>(await h.call('A', 'reapIfIdle')).action).toBe('reap')
+  })
+
+  it('tolerates missing and malformed coordination data', async () => {
+    // [fs-016] malformed/unknown params and a missing hello never break a decision.
+    const h = makeHost()
+    h.host.onClientConnect('X') // connected, never said hello
+    expect((await h.call('X', 'hello', { pid: 'not-a-pid' }))?.error?.code).toBe(-32602)
+    expect((await h.call('X', 'hello', null))?.error?.code).toBe(-32602)
+    expect(await h.notify('X', 'mystery', [1, 2, 3])).toBeUndefined()
+    expect(h.host.clients()).toEqual([])
+    // A disconnect / release of an unknown connection is harmless.
+    h.host.onClientDisconnect('never-seen', 'error')
+    expect(resultOf(await h.call('ghost', 'release'))).toEqual({ released: true })
+    // The decision still works: nobody pins, Chrome is reaped.
+    expect(resultOf<{ action: string }>(await h.call('X', 'reapIfIdle')).action).toBe('reap')
+  })
+})
+
+describe('8468f7b1 [chrome-lifecycle.6] livelock protection on the host tick', () => {
+  it('two idle managers do not keep each other alive forever', async () => {
+    // [fs-019] two idle clients, zero http pages, history off: reaped within idle + grace (+ one 5 s tick).
+    const h = makeHost()
+    await h.join('A', 11, false)
+    await h.join('B', 22, false)
+    await h.notify('A', 'activity')
+    await h.notify('B', 'activity')
+    const start = h.world.now
+    const stamps = h.host.clients().map((c) => c.lastActivityAt)
+    let reapedAt: number | null = null
+    for (let t = 0; t <= IDLE + GRACE + 10_000 && reapedAt === null; t += 5_000) {
+      const out = await h.host.tick()
+      // Deferral never writes activity: every stamp is unchanged by every tick.
+      expect(h.host.clients().map((c) => c.lastActivityAt)).toEqual(stamps)
+      if (out.reaped) reapedAt = h.world.now
+      else h.advance(5_000)
+    }
+    expect(reapedAt).not.toBeNull()
+    expect(must(reapedAt) - start).toBeLessThanOrEqual(IDLE + GRACE + 5_000)
+    expect(must(reapedAt) - start).toBeGreaterThanOrEqual(IDLE)
+  })
+})
+
+describe('8468f7b1 [chrome-lifecycle.21] coordination is best effort on the client', () => {
+  it('coordination write failures never break a call', async () => {
+    // [fs-017] a link whose sends fail, a dial that never comes up and an unsafe state dir never fail bump()/ready().
+    vi.useFakeTimers()
+    const hub = makeHub()
+    const c = client(hub, 11)
+    await c.manager.ready()
+    c.link.broken = true // activity / release / reapIfIdle now throw inside the transport
+    expect(() => c.manager.bump()).not.toThrow()
+    await expect(c.manager.ready()).resolves.toBeUndefined()
+    await expect(c.manager.withBrowser(async () => 42)).resolves.toBe(42)
+    await expect(c.manager.release()).resolves.toBeUndefined()
+
+    resetWorld()
+    const down = makeHub()
+    down.available = false // the reaper cannot be started
+    const d = client(down, 22)
+    await expect(d.manager.ready()).resolves.toBeUndefined()
+    expect(() => d.manager.bump()).not.toThrow()
+
+    resetWorld()
+    world.dirUnsafe = true
+    const u = client(makeHub(), 33)
+    await expect(u.manager.ready()).resolves.toBeUndefined()
+    expect(() => u.manager.bump()).not.toThrow()
+  })
+
+  it('a deferring process does not advertise activity', async () => {
+    // [fs-018] livelock protection: A's idle fires keep deferring to an open page; A never sends
+    // `activity` for them and its lastActivityAt on the host never moves.
+    vi.useFakeTimers()
+    const hub = makeHub()
+    const a = client(hub, 11)
+    const b = client(hub, 22)
+    await a.manager.ready()
+    await b.manager.ready()
+    openPage('https://captcha.example/')
+    const sent = a.link.activityCalls
+    const stamp = must(must(hub.host).clients().find((x) => x.pid === 11)).lastActivityAt
+    await vi.advanceTimersByTimeAsync(CLIENT_IDLE * 5)
+    expect(a.link.reapCalls).toBe(5)
+    expect(a.link.activityCalls).toBe(sent)
+    expect(must(must(hub.host).clients().find((x) => x.pid === 11)).lastActivityAt).toBe(stamp)
+    // B, equally idle, is not kept alive by A's deferrals either: its stamp never moved.
+    expect(must(must(hub.host).clients().find((x) => x.pid === 22)).lastActivityAt).toBe(stamp)
+  })
+})
diff --git a/packages/stealth/stealth-core-browser/test/unit/lifecycle/degraded.spec.ts b/packages/stealth/stealth-core-browser/test/unit/lifecycle/degraded.spec.ts
new file mode 100644
index 000000000..661f5f3a2
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/test/unit/lifecycle/degraded.spec.ts
@@ -0,0 +1,136 @@
+/**
+ * CL28 degraded mode (decision D1).
+ * Ticket 8468f7b1 · [chrome-lifecycle.28]
+ *
+ * On a machine where the reaper cannot run — `ensureBackend` gives `failed`
+ * (including E_UDS_DIR_UNSAFE: the socket directory is not private) or the
+ * state directory itself is unsafe — the user's work is never blocked:
+ * `ready()` still succeeds, `status().reaper` is false, the idle timer still
+ * fires but never closes Chrome (it cannot see sibling clients, so it defers),
+ * a force `shutdown()` still works, and exactly one warning is logged for the
+ * whole degraded session.
+ *
+ * The manager runs with NO injected link: the real `createProxyReaperLink` is
+ * used, over vi.mock('@adhd/sox-service-proxy') whose `ensureBackend` double is
+ * asserted to have actually been called (the degraded path is not reached by
+ * a short-circuit). Simulated machine (manager-world); no socket, no process.
+ * guards: ready() still succeeds and status().reaper is false
+ * tier: S
+ * cites: 8468f7b1 [chrome-lifecycle.28]
+ */
+import { afterEach, beforeEach, describe, expect, it, vi, type Mock } from 'vitest'
+
+vi.mock('node:fs', async () => (await import('../../helpers/lifecycle/manager-world.js')).fsModule())
+vi.mock('../../../src/lib/cdp/browser.js', async () => (await import('../../helpers/lifecycle/manager-world.js')).browserModule(vi.fn))
+vi.mock('../../../src/lib/cdp/targets.js', async () => (await import('../../helpers/lifecycle/manager-world.js')).targetsModule(vi.fn))
+vi.mock('@adhd/sox-service-proxy', async (orig) => (await import('../../helpers/lifecycle/manager-world.js')).spModule(await orig<Record<string, unknown>>()))
+
+import { ChromeManager } from '../../../src/lib/chrome-manager.js'
+import { HOST, PORT, resetSp, resetWorld, sp, STATE_DIR, world } from '../../helpers/lifecycle/manager-world.js'
+import { must } from '../../helpers/must.js'
+
+const IDLE = 300
+
+let warn: Mock<(msg: string) => void>
+let logs: string[]
+
+function degradedManager(): ChromeManager {
+  return new ChromeManager({
+    cdpHost: HOST,
+    idleTimeoutMs: IDLE,
+    stateDir: STATE_DIR,
+    entryPath: '/pkg/dist/index.js',
+    logger: (m) => {
+      logs.push(m)
+      if (m.startsWith('warning:')) warn(m)
+    },
+  })
+}
+
+beforeEach(() => {
+  vi.useFakeTimers()
+  resetWorld()
+  resetSp()
+  logs = []
+  warn = vi.fn()
+  sp.ensureBackend = vi.fn(async () => ({ disposition: 'failed', detail: 'socket directory is group-writable', errorCode: 'E_UDS_DIR_UNSAFE' }))
+  sp.dialBackend = vi.fn(() => {
+    throw new Error('a degraded manager must never dial')
+  })
+})
+
+afterEach(() => {
+  vi.useRealTimers()
+  vi.restoreAllMocks()
+})
+
+describe('8468f7b1 [chrome-lifecycle.28] ensureBackend fails with E_UDS_DIR_UNSAFE: degraded', () => {
+  it('ready() still succeeds and status().reaper is false', async () => {
+    const m = degradedManager()
+    await expect(m.ready()).resolves.toBeUndefined()
+    expect(sp.ensureBackend).toHaveBeenCalledTimes(1)
+    expect(sp.dialBackend).not.toHaveBeenCalled()
+    expect(m.isReady).toBe(true)
+    expect(await m.status()).toMatchObject({ ready: true, reaper: false, processes: 0, siblingWarning: false })
+  })
+
+  it('the idle timer fires but never closes Chrome (it defers), forever', async () => {
+    const m = degradedManager()
+    await m.ready()
+    for (let i = 0; i < 5; i++) await vi.advanceTimersByTimeAsync(IDLE)
+    expect(world.chromeUp).toBe(true)
+    expect(world.events.filter((e) => e.includes('kill'))).toEqual([])
+    expect(logs.filter((l) => l.startsWith('reaper unavailable — not closing Chrome')).length).toBe(5)
+    // The previously failed ensure is retried exactly once, at the first idle fire.
+    expect(sp.ensureBackend).toHaveBeenCalledTimes(2)
+    expect(m.isReady).toBe(true)
+  })
+
+  it('a force shutdown() still works', async () => {
+    const m = degradedManager()
+    await m.ready()
+    await m.shutdown()
+    expect(world.events).toContain(`kill:${PORT}`)
+    expect(world.chromeUp).toBe(false)
+    expect(m.isReady).toBe(false)
+  })
+
+  it('exactly one warning is logged for the whole degraded session', async () => {
+    const m = degradedManager()
+    await m.ready()
+    await m.ready()
+    m.bump()
+    await vi.advanceTimersByTimeAsync(2_500) // a bump with the link down retries (rate-limited) while Chrome is up
+    m.bump()
+    await vi.advanceTimersByTimeAsync(IDLE * 3)
+    await m.shutdownIfIdle()
+    expect(vi.mocked(sp.ensureBackend).mock.calls.length).toBeGreaterThan(1)
+    expect(warn).toHaveBeenCalledTimes(1)
+    expect(must(warn.mock.calls[0])[0]).toMatch(/^warning: reaper unavailable, running degraded/)
+    expect(must(warn.mock.calls[0])[0]).toMatch(/E_UDS_DIR_UNSAFE|not private|0700/)
+  })
+})
+
+describe('8468f7b1 [chrome-lifecycle.28] the state directory is unsafe: degraded', () => {
+  beforeEach(() => {
+    world.dirUnsafe = true
+  })
+
+  it('ready() succeeds, status().reaper is false, and the reaper is never even ensured', async () => {
+    const m = degradedManager()
+    await expect(m.ready()).resolves.toBeUndefined()
+    expect(sp.ensureBackend).toHaveBeenCalledTimes(0)
+    expect((await m.status()).reaper).toBe(false)
+  })
+
+  it('the idle timer defers, shutdown() still closes Chrome, one warning in total', async () => {
+    const m = degradedManager()
+    await m.ready()
+    await vi.advanceTimersByTimeAsync(IDLE * 4)
+    expect(world.chromeUp).toBe(true)
+    await m.shutdown()
+    expect(world.chromeUp).toBe(false)
+    expect(warn).toHaveBeenCalledTimes(1)
+    expect(must(warn.mock.calls[0])[0]).toMatch(/E_UDS_DIR_UNSAFE|not private/)
+  })
+})
diff --git a/packages/stealth/stealth-core-browser/test/unit/lifecycle/errors.spec.ts b/packages/stealth/stealth-core-browser/test/unit/lifecycle/errors.spec.ts
new file mode 100644
index 000000000..a122490f7
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/test/unit/lifecycle/errors.spec.ts
@@ -0,0 +1,125 @@
+/**
+ * CL20 typed lifecycle errors.
+ * Ticket 8468f7b1 · [chrome-lifecycle.20]
+ *
+ * `LifecycleError` has exactly six codes: LAUNCH_FAILED, LAUNCH_LOCK_TIMEOUT,
+ * CHROME_UNREACHABLE_AFTER_LAUNCH, LAUNCH_CIRCUIT_OPEN, REAPER_UNAVAILABLE,
+ * ISOLATED_CONTEXT_FAILED. Each is reachable with `cause` or `detail`
+ * (`retryAfterMs`, `port`, `path`) and a one-line message that names the fix.
+ * guards: has exactly the six lifecycle codes
+ * tier: S
+ * cites: 8468f7b1 [chrome-lifecycle.20]
+ */
+import { describe, expect, it } from 'vitest'
+import {
+  LIFECYCLE_ERROR_CODES,
+  LifecycleError,
+  isLifecycleError,
+  lifecycleError,
+  lifecycleErrors,
+  type LifecycleErrorCode,
+} from '../../../src/lib/lifecycle/errors.js'
+
+const oneLine = (e: LifecycleError) => {
+  expect(e.message).not.toContain('\n')
+  expect(e.message.length).toBeGreaterThan(20)
+}
+
+describe('8468f7b1 [chrome-lifecycle.20] the code set', () => {
+  it('has exactly the six lifecycle codes', () => {
+    expect([...LIFECYCLE_ERROR_CODES]).toEqual([
+      'LAUNCH_FAILED',
+      'LAUNCH_LOCK_TIMEOUT',
+      'CHROME_UNREACHABLE_AFTER_LAUNCH',
+      'LAUNCH_CIRCUIT_OPEN',
+      'REAPER_UNAVAILABLE',
+      'ISOLATED_CONTEXT_FAILED',
+    ])
+  })
+
+  it('is an Error subclass carrying name, code, cause and detail', () => {
+    const cause = new Error('root')
+    const e = lifecycleError('LAUNCH_FAILED', 'x', { cause, detail: { port: 1 } })
+    expect(e).toBeInstanceOf(Error)
+    expect(e).toBeInstanceOf(LifecycleError)
+    expect(e.name).toBe('LifecycleError')
+    expect(e.code).toBe('LAUNCH_FAILED')
+    expect(e.cause).toBe(cause)
+    expect(e.detail).toEqual({ port: 1 })
+    expect(isLifecycleError(e)).toBe(true)
+    expect(isLifecycleError(e, 'LAUNCH_FAILED')).toBe(true)
+    expect(isLifecycleError(e, 'REAPER_UNAVAILABLE')).toBe(false)
+    expect(isLifecycleError(new Error('plain'))).toBe(false)
+  })
+})
+
+describe('8468f7b1 [chrome-lifecycle.20] every code is reachable with cause/detail and a fix-naming message', () => {
+  it('LAUNCH_FAILED keeps the spawn cause and the port', () => {
+    const cause = Object.assign(new Error('spawn /x ENOENT'), { code: 'ENOENT' })
+    const e = lifecycleErrors.launchFailed(9333, cause)
+    expect(e.code).toBe('LAUNCH_FAILED')
+    expect(e.cause).toBe(cause)
+    expect(e.detail).toEqual({ port: 9333 })
+    expect(e.message).toMatch(/install Chrome in its standard location \(library callers may also pass chromePath\)/)
+    oneLine(e)
+  })
+
+  it('LAUNCH_LOCK_TIMEOUT names the lock path and port', () => {
+    const e = lifecycleErrors.launchLockTimeout(9333, '/tmp/stealth-chrome-launch-9333.lock')
+    expect(e.code).toBe('LAUNCH_LOCK_TIMEOUT')
+    expect(e.detail).toEqual({ port: 9333, path: '/tmp/stealth-chrome-launch-9333.lock' })
+    expect(e.message).toMatch(/remove the stale lock file/)
+    oneLine(e)
+  })
+
+  it('CHROME_UNREACHABLE_AFTER_LAUNCH carries the port and the underlying cause', () => {
+    const cause = new Error('Chrome did not start CDP on port 9333 within 10s')
+    const e = lifecycleErrors.unreachableAfterLaunch(9333, cause)
+    expect(e.code).toBe('CHROME_UNREACHABLE_AFTER_LAUNCH')
+    expect(e.cause).toBe(cause)
+    expect(e.detail).toEqual({ port: 9333 })
+    expect(e.message).toMatch(/within 10 s; check that nothing else holds the port/)
+    oneLine(e)
+  })
+
+  it('LAUNCH_CIRCUIT_OPEN carries retryAfterMs', () => {
+    const e = lifecycleErrors.circuitOpen(9333, 12_345)
+    expect(e.code).toBe('LAUNCH_CIRCUIT_OPEN')
+    expect(e.detail).toEqual({ port: 9333, retryAfterMs: 12_345 })
+    expect(e.message).toMatch(/retry in 13 s after fixing the launch error/)
+    oneLine(e)
+  })
+
+  it('REAPER_UNAVAILABLE keeps the transport cause (E_UDS_DIR_UNSAFE) and the state path', () => {
+    const cause = Object.assign(new Error('socket dir is writable by others'), { code: 'E_UDS_DIR_UNSAFE' })
+    const e = lifecycleErrors.reaperUnavailable(9333, cause, '/tmp/stealth-browser-501-9333')
+    expect(e.code).toBe('REAPER_UNAVAILABLE')
+    expect(e.cause).toBe(cause)
+    expect(e.detail).toEqual({ port: 9333, path: '/tmp/stealth-browser-501-9333' })
+    expect(e.message).toMatch(/state directory is private \(0700, own uid\)/)
+    oneLine(e)
+    expect(lifecycleErrors.reaperUnavailable(9333).detail).toEqual({ port: 9333 })
+  })
+
+  it('ISOLATED_CONTEXT_FAILED names the failed step and keeps the cause', () => {
+    const cause = new Error('WebSocket connection failed')
+    const e = lifecycleErrors.isolatedContextFailed('connect', cause)
+    expect(e.code).toBe('ISOLATED_CONTEXT_FAILED')
+    expect(e.cause).toBe(cause)
+    expect(e.detail).toEqual({ step: 'connect' })
+    expect(e.message).toMatch(/the context was disposed, check that Chrome is reachable and retry/)
+    oneLine(e)
+  })
+
+  it('every code is produced by exactly one factory', () => {
+    const produced: LifecycleErrorCode[] = [
+      lifecycleErrors.launchFailed(1, 'x').code,
+      lifecycleErrors.launchLockTimeout(1, '/p').code,
+      lifecycleErrors.unreachableAfterLaunch(1).code,
+      lifecycleErrors.circuitOpen(1, 1).code,
+      lifecycleErrors.reaperUnavailable(1).code,
+      lifecycleErrors.isolatedContextFailed('s', 'x').code,
+    ]
+    expect(produced.sort()).toEqual([...LIFECYCLE_ERROR_CODES].sort())
+  })
+})
diff --git a/packages/stealth/stealth-core-browser/test/unit/lifecycle/exit-hooks.spec.ts b/packages/stealth/stealth-core-browser/test/unit/lifecycle/exit-hooks.spec.ts
new file mode 100644
index 000000000..8771e84e2
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/test/unit/lifecycle/exit-hooks.spec.ts
@@ -0,0 +1,210 @@
+/**
+ * CL14 (F23, gap G2) exit hooks.
+ * Ticket 8468f7b1 · [chrome-lifecycle.14]
+ *
+ * `installProcessExitHooks(manager, { forceExitMs = 5000, stdinEof, exit })`
+ * against an injected EventEmitter standing in for `process` (no real signal
+ * handler is ever installed) and fake timers.
+ * guards: uncaughtException: exit code 1, the error is logged
+ * tier: S
+ * cites: 8468f7b1 [chrome-lifecycle.14]
+ */
+import { EventEmitter } from 'node:events'
+import { afterEach, beforeEach, describe, expect, it, vi, type Mock } from 'vitest'
+import { installProcessExitHooks, type ExitHookProcess, type ExitHookStdin } from '../../../src/lib/lifecycle/exit-hooks.js'
+
+interface Rig {
+  proc: EventEmitter
+  stdin: EventEmitter
+  calls: string[]
+  exit: Mock<(code: number) => void>
+  manager: { release: Mock<() => Promise<void>>; shutdownIfIdle: Mock<() => Promise<void>> }
+  logs: string[]
+}
+
+function rig(opts: { shutdownMs?: number; releaseThrows?: boolean; shutdownThrows?: boolean } = {}): Rig {
+  const calls: string[] = []
+  const r: Rig = {
+    proc: new EventEmitter(),
+    stdin: new EventEmitter(),
+    calls,
+    exit: vi.fn((code: number) => {
+      calls.push(`exit:${code}`)
+    }),
+    manager: {
+      release: vi.fn(async () => {
+        calls.push('release')
+        if (opts.releaseThrows) throw new Error('link down')
+      }),
+      shutdownIfIdle: vi.fn(async () => {
+        calls.push('shutdownIfIdle:start')
+        if (opts.shutdownMs) await new Promise((res) => setTimeout(res, opts.shutdownMs))
+        if (opts.shutdownThrows) throw new Error('kill failed')
+        calls.push('shutdownIfIdle:end')
+      }),
+    },
+    logs: [],
+  }
+  return r
+}
+
+function install(r: Rig, extra: { stdinEof?: boolean; forceExitMs?: number } = {}) {
+  return installProcessExitHooks(r.manager, {
+    exit: r.exit,
+    proc: r.proc as unknown as ExitHookProcess,
+    stdin: r.stdin as unknown as ExitHookStdin,
+    logger: (m) => r.logs.push(m),
+    ...extra,
+  })
+}
+
+beforeEach(() => {
+  vi.useFakeTimers()
+})
+
+afterEach(() => {
+  vi.useRealTimers()
+})
+
+describe('8468f7b1 [chrome-lifecycle.14] each exit path runs release() then the soft shutdown once', () => {
+  it.each([
+    ['SIGINT', 130],
+    ['SIGTERM', 143],
+  ] as const)('%s: release, then shutdownIfIdle, then exit %i', async (sig, code) => {
+    const r = rig()
+    install(r)
+    r.proc.emit(sig)
+    await vi.advanceTimersByTimeAsync(0)
+    expect(r.calls).toEqual(['release', 'shutdownIfIdle:start', 'shutdownIfIdle:end', `exit:${code}`])
+  })
+
+  it('uncaughtException: exit code 1, the error is logged', async () => {
+    const r = rig()
+    install(r)
+    r.proc.emit('uncaughtException', new Error('kaboom'))
+    await vi.advanceTimersByTimeAsync(0)
+    expect(r.calls).toEqual(['release', 'shutdownIfIdle:start', 'shutdownIfIdle:end', 'exit:1'])
+    expect(r.logs.some((l) => l.includes('kaboom'))).toBe(true)
+  })
+
+  it('unhandledRejection: exit code 1', async () => {
+    const r = rig()
+    install(r)
+    r.proc.emit('unhandledRejection', new Error('nope'), Promise.resolve())
+    await vi.advanceTimersByTimeAsync(0)
+    expect(r.calls).toEqual(['release', 'shutdownIfIdle:start', 'shutdownIfIdle:end', 'exit:1'])
+  })
+
+  it('stdin end (opt-in, orphaned stdio server): release then soft shutdown, exit 0', async () => {
+    const r = rig()
+    install(r, { stdinEof: true })
+    r.stdin.emit('end')
+    await vi.advanceTimersByTimeAsync(0)
+    expect(r.calls).toEqual(['release', 'shutdownIfIdle:start', 'shutdownIfIdle:end', 'exit:0'])
+  })
+
+  it('stdin end is ignored unless stdinEof is set', async () => {
+    const r = rig()
+    install(r)
+    r.stdin.emit('end')
+    await vi.advanceTimersByTimeAsync(0)
+    expect(r.calls).toEqual([])
+    expect(r.stdin.listenerCount('end')).toBe(0)
+  })
+
+  it('exit (synchronous): starts release and the soft shutdown, never calls exit again', async () => {
+    const r = rig()
+    install(r)
+    r.proc.emit('exit', 0)
+    await vi.advanceTimersByTimeAsync(0)
+    expect(r.calls).toEqual(['release', 'shutdownIfIdle:start', 'shutdownIfIdle:end'])
+    expect(r.exit).not.toHaveBeenCalled()
+  })
+
+  it('runs once: a second signal while shutting down is ignored', async () => {
+    const r = rig({ shutdownMs: 1_000 })
+    install(r)
+    r.proc.emit('SIGINT')
+    r.proc.emit('SIGTERM')
+    r.proc.emit('uncaughtException', new Error('late'))
+    await vi.advanceTimersByTimeAsync(1_000)
+    expect(r.manager.release).toHaveBeenCalledTimes(1)
+    expect(r.manager.shutdownIfIdle).toHaveBeenCalledTimes(1)
+    expect(r.exit).toHaveBeenCalledTimes(1)
+    expect(r.exit).toHaveBeenCalledWith(130)
+  })
+
+  it('a failing release (link down) still runs the soft shutdown', async () => {
+    const r = rig({ releaseThrows: true })
+    install(r)
+    r.proc.emit('SIGTERM')
+    await vi.advanceTimersByTimeAsync(0)
+    expect(r.calls).toEqual(['release', 'shutdownIfIdle:start', 'shutdownIfIdle:end', 'exit:143'])
+    expect(r.logs.some((l) => l.includes('release failed'))).toBe(true)
+  })
+
+  it('a failing soft shutdown is logged and the process still exits', async () => {
+    const r = rig({ shutdownThrows: true })
+    install(r)
+    r.proc.emit('SIGINT')
+    await vi.advanceTimersByTimeAsync(0)
+    expect(r.exit).toHaveBeenCalledWith(130)
+    expect(r.logs.some((l) => l.includes('soft shutdown failed'))).toBe(true)
+  })
+})
+
+describe('8468f7b1 [chrome-lifecycle.14] bounded by a force-exit', () => {
+  it('force-exits after 5000 ms by default when the teardown hangs', async () => {
+    const r = rig({ shutdownMs: 60_000 })
+    install(r)
+    r.proc.emit('SIGTERM')
+    await vi.advanceTimersByTimeAsync(4_999)
+    expect(r.exit).not.toHaveBeenCalled()
+    await vi.advanceTimersByTimeAsync(1)
+    expect(r.exit).toHaveBeenCalledTimes(1)
+    expect(r.exit).toHaveBeenCalledWith(143)
+    // The hung teardown finishing later never exits a second time.
+    await vi.advanceTimersByTimeAsync(60_000)
+    expect(r.exit).toHaveBeenCalledTimes(1)
+  })
+
+  it('honours a custom forceExitMs', async () => {
+    const r = rig({ shutdownMs: 60_000 })
+    install(r, { forceExitMs: 250 })
+    r.proc.emit('SIGINT')
+    await vi.advanceTimersByTimeAsync(250)
+    expect(r.exit).toHaveBeenCalledWith(130)
+  })
+
+  it('a teardown that finishes in time cancels the force-exit', async () => {
+    const r = rig({ shutdownMs: 100 })
+    install(r)
+    r.proc.emit('SIGINT')
+    await vi.advanceTimersByTimeAsync(100)
+    expect(r.exit).toHaveBeenCalledTimes(1)
+    await vi.advanceTimersByTimeAsync(10_000)
+    expect(r.exit).toHaveBeenCalledTimes(1)
+  })
+})
+
+describe('8468f7b1 [chrome-lifecycle.14] uninstall', () => {
+  it('removes every listener it added (and is idempotent)', () => {
+    const r = rig()
+    const before = ['exit', 'SIGINT', 'SIGTERM', 'uncaughtException', 'unhandledRejection'].map((e) => r.proc.listenerCount(e))
+    const uninstall = install(r, { stdinEof: true })
+    expect(['exit', 'SIGINT', 'SIGTERM', 'uncaughtException', 'unhandledRejection'].map((e) => r.proc.listenerCount(e))).toEqual([1, 1, 1, 1, 1])
+    expect(r.stdin.listenerCount('end')).toBe(1)
+    uninstall()
+    uninstall()
+    expect(['exit', 'SIGINT', 'SIGTERM', 'uncaughtException', 'unhandledRejection'].map((e) => r.proc.listenerCount(e))).toEqual(before)
+    expect(r.stdin.listenerCount('end')).toBe(0)
+  })
+
+  it('after uninstall a signal does nothing', async () => {
+    const r = rig()
+    install(r)()
+    r.proc.emit('SIGINT')
+    await vi.advanceTimersByTimeAsync(0)
+    expect(r.calls).toEqual([])
+  })
+})
diff --git a/packages/stealth/stealth-core-browser/test/unit/lifecycle/grace-exit.spec.ts b/packages/stealth/stealth-core-browser/test/unit/lifecycle/grace-exit.spec.ts
new file mode 100644
