+      reason: 'mine',
+      context: {},
+    });
+    env.mfs.observe(undefined);
+    expect(r.created).toBe(false);
+    expect(r.record.reason).toBe('other');
+    expect(env.mfs.exists(env.markerPath('k'))).toBe(true);
+  });
+});
