+
+// ─── Process tracking ─────────────────────────────────────────────────────────
+
+/** The pid of the Chrome this process launched, per CDP port: one port's launch never decides another port's kill. */
+const launchedPids = new Map<number, number>()
+
+// ─── Launch ───────────────────────────────────────────────────────────────────
+
