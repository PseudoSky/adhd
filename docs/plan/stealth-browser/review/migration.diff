+        stdin: new FakeStdin({ isTTY: true, ended: true }),
+      })
+      const code = await runCli(['search', 'github', 'vite'], fail.deps)
+      expect(code === 0 && fail.stdout.length === 0).toBe(false)
+      expect(code).toBe(2)
+    },
+    BUILD_TIMEOUT_MS
+  )
+})
