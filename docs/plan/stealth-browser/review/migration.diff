--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/domains/transport.ts
@@ -0,0 +1,32 @@
+/**
+ * stealth-core-browser/src/lib/domains/transport.ts — Shared CDP WebSocket transport.
+ *
+ * Wraps the common pattern: GET /json/version → open WS → wait for open → send command → receive response.
+ * All domain services use this instead of duplicating WS logic. The socket itself is owned by
+ * CdpSession (cdp/session.ts), the single WebSocket opener under src/lib.
+ *
+ * Defect 3 (port-fixes.4): nothing is sent until the socket is open. CdpSession.connect resolves only
+ * once the socket's `open` event fires (readyState OPEN) and rejects on error, early close, or the
+ * 10 s deadline passed below; send() is reached only after that, and any rejection becomes null.
+ */
+import { CdpSession } from '../cdp/session.js'
+
+const CDP_TIMEOUT_MS = 10_000
+
+export async function cdpCall<T = unknown>(
+  host: string,
+  method: string,
+  params: Record<string, unknown> = {},
+): Promise<T | null> {
+  const session = new CdpSession()
+  try {
+    const res = await fetch(`http://${host}/json/version`)
+    const v = (await res.json()) as Record<string, string>
+    await session.connect(v['webSocketDebuggerUrl'] as string, CDP_TIMEOUT_MS)
+    return (await session.send(method, params, CDP_TIMEOUT_MS)) as T
+  } catch {
+    return null
+  } finally {
+    session.close()
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/src/lib/endpoint.ts b/packages/stealth/stealth-core-browser/src/lib/endpoint.ts
new file mode 100644
index 000000000..88ee803fa
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/endpoint.ts
@@ -0,0 +1,115 @@
+/**
+ * @adhd/stealth-core-browser — src/lib/endpoint.ts
+ *
+ * Which Chrome DevTools endpoint a verb may talk to. The `host` input of every chrome verb reaches the host
+ * process from an MCP caller, so it is validated here once ([audit-fixes.1], pre-review P9):
+ *
+ *  - the host is a bare DNS name, an IPv4 address or an IPv6 address; `@ ? # / \ :` (outside an IPv6
+ *    literal), whitespace and percent escapes are refused, so it cannot smuggle credentials, a path or a
+ *    second port into `http://<host>:<port>`;
+ *  - only loopback (`localhost`, `127.0.0.0/8`, `::1`) is allowed by default; any other host must be
+ *    allowed explicitly by the process that hosts the verbs with `configureEndpointPolicy`, never by a
+ *    verb input;
+ *  - `assertSameEndpoint` refuses a debugger WebSocket URL that points anywhere but the endpoint that
+ *    was asked, so a hostile endpoint cannot redirect the connection to a third host.
+ *
+ * Ticket 8468f7b1 · plan state audit-fixes.
+ */
+import net from 'node:net'
+import { StealthCoreBrowserError } from '../errors.js'
+
+/** Host used when a verb is called without one. */
+export const DEFAULT_HOST = '127.0.0.1'
+/** CDP port used when a verb is called without one. */
+export const DEFAULT_PORT = 9222
+
+/** A validated endpoint: `host` is bracketed when it is an IPv6 literal, so `cdpHost` is always `host:port`. */
+export interface ResolvedEndpoint {
+  host: string
+  port: number
+  cdpHost: string
+}
+
+/** What the hosting process allows beyond loopback. */
+export interface EndpointPolicy {
+  /** Extra hosts (names or addresses) the verbs may address. Compared case-insensitively, without brackets. */
+  allowHosts?: readonly string[]
+}
+
+let allowed: ReadonlySet<string> = new Set()
+
+/** Replace the set of non-loopback hosts the verbs may address (empty by default; loopback is always allowed). */
+export function configureEndpointPolicy(policy: EndpointPolicy = {}): void {
+  const next = new Set<string>()
+  for (const h of policy.allowHosts ?? []) next.add(bare(normalizeHost(h)).toLowerCase())
+  allowed = next
+}
+
+/** The extra hosts currently allowed (for logs and tests). */
+export function allowedHosts(): string[] {
+  return [...allowed]
+}
+
+const bare = (host: string): string => host.replace(/^\[|\]$/g, '')
+
+/** True when `host` is `localhost`, an address of 127.0.0.0/8 or the IPv6 loopback. */
+export function isLoopbackHost(host: string): boolean {
+  const h = bare(host).toLowerCase()
+  if (h === 'localhost') return true
+  if (net.isIPv4(h)) return h.startsWith('127.')
+  if (net.isIPv6(h)) return new URL(`http://[${h}]/`).hostname === '[::1]'
+  return false
+}
+
+const HOSTNAME = /^(?=.{1,253}$)[A-Za-z0-9_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?(?:\.[A-Za-z0-9_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)*$/
+
+/** The syntactically valid, bracket-normalized form of a host, or the endpoint error naming the offence. */
+function normalizeHost(raw: string): string {
+  const host = raw.trim()
+  const bracketed = host.startsWith('[') && host.endsWith(']')
+  const inner = bracketed ? host.slice(1, -1) : host
+  if (net.isIPv6(inner)) return `[${inner}]`
+  if (!bracketed && (net.isIPv4(host) || HOSTNAME.test(host))) return host
+  throw StealthCoreBrowserError.invalidEndpoint(`host must be a bare host name or address (no scheme, credentials, path, port, query or whitespace), got "${raw}"`)
+}
+
+/** Validate the endpoint of a verb input against the syntax rules and the loopback-or-allowed policy. */
+export function resolveEndpoint(input: { host?: string; port?: number } = {}): ResolvedEndpoint {
+  const port = input.port ?? DEFAULT_PORT
+  if (!Number.isInteger(port) || port < 1 || port > 65535) {
+    throw StealthCoreBrowserError.invalidEndpoint(`port must be an integer between 1 and 65535, got ${String(port)}`)
+  }
+  const host = normalizeHost(input.host?.trim() || DEFAULT_HOST)
+  if (!isLoopbackHost(host) && !allowed.has(bare(host).toLowerCase())) {
+    throw StealthCoreBrowserError.invalidEndpoint(
+      `host "${bare(host)}" is not a loopback address and is not on the allowed list; the process that hosts the verbs must allow it explicitly (configureEndpointPolicy, or --allow-cdp-hosts for stealth-search)`
+    )
+  }
+  return { host, port, cdpHost: `${host}:${port}` }
+}
+
+/** The port of a `host:port` string (IPv6 hosts are bracketed), or `fallback` when it has none. */
+export function portOf(cdpHost: string, fallback = DEFAULT_PORT): number {
+  const m = cdpHost.match(/:(\d+)$/)
+  const port = m?.[1] ? parseInt(m[1], 10) : NaN
+  return Number.isInteger(port) && port >= 1 && port <= 65535 ? port : fallback
+}
+
+/**
+ * Refuse a WebSocket URL that does not point at the host that was asked. Chrome echoes the `Host` header
+ * of the request in `webSocketDebuggerUrl`, so an honest endpoint always matches.
+ *
+ * @throws StealthCoreBrowserError CDP_BAD_RESPONSE (detail.reason `ws-host-mismatch`)
+ */
+export function assertSameEndpoint(cdpHost: string, wsUrl: string): void {
+  const expected = bare(cdpHost.replace(/:\d+$/, '')).toLowerCase()
+  let actual: string
+  try {
+    actual = bare(new URL(wsUrl).hostname).toLowerCase()
+  } catch {
+    throw StealthCoreBrowserError.of('CDP_BAD_RESPONSE', `CDP on ${cdpHost} returned an invalid debugger WebSocket URL`, { detail: { cdpHost, reason: 'ws-url-invalid' } })
+  }
+  if (actual !== expected) {
+    throw StealthCoreBrowserError.of('CDP_BAD_RESPONSE', `CDP on ${cdpHost} returned a debugger WebSocket URL for another host (${actual})`, { detail: { cdpHost, reason: 'ws-host-mismatch', wsHost: actual } })
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/src/lib/helpers.ts b/packages/stealth/stealth-core-browser/src/lib/helpers.ts
new file mode 100644
index 000000000..e8a01e839
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/helpers.ts
@@ -0,0 +1,118 @@
+/**
+ * stealth-core-browser/src/lib/helpers.ts — Shared helper functions for the ADHD package.
+ *
+ * Extracted from cdp-query-client.ts (helper section + VisitRow).
+ */
+
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+import type { ChromeVisit } from './types.js'
+
+/** The single read-only (`mode=ro&immutable=1`) Chrome database opener lives in storage/helpers.ts; re-exported here under the same name. */
+export { openDb } from './storage/helpers.js'
+
+// ═══════════════════════════════════════════════════════════════════════════════
+// Transition helpers
+// ═══════════════════════════════════════════════════════════════════════════════
+
+const TRANSITION_NAMES: Record<number, string> = {
+  [0]: 'LINK',
+  [1]: 'TYPED',
+  [2]: 'AUTO_BOOKMARK',
+  [3]: 'AUTO_SUBFRAME',
+  [4]: 'MANUAL_SUBFRAME',
+  [5]: 'GENERATED',
+  [6]: 'AUTO_TOPLEVEL',
+  [7]: 'FORM_SUBMIT',
+  [8]: 'RELOAD',
+  [9]: 'KEYWORD',
+  [10]: 'KEYWORD_GENERATED',
+}
+
+export function transitionName(raw: number): string {
+  return TRANSITION_NAMES[raw & 0xff] ?? `UNKNOWN(${raw & 0xff})`
+}
+
+// ═══════════════════════════════════════════════════════════════════════════════
+// Chrome profile / paths
+// ═══════════════════════════════════════════════════════════════════════════════
+
+export function chromeProfileDir(): string {
+  return join(homedir(), 'Library', 'Application Support', 'Google', 'Chrome-CDP')
+}
+
+export function defaultChromeDir(): string {
+  return join(homedir(), 'Library', 'Application Support', 'Google', 'Chrome')
+}
+
+// ═══════════════════════════════════════════════════════════════════════════════
+// Placeholder helper
+// ═══════════════════════════════════════════════════════════════════════════════
+
+export function notYet(name: string): void {
+  console.warn(`[cdp-query] ${name} is not yet implemented`)
+}
+
+// ═══════════════════════════════════════════════════════════════════════════════
+// Chrome timestamp conversion
+// ═══════════════════════════════════════════════════════════════════════════════
+
+/** Convert a Chrome timestamp (microseconds since 1601-01-01) to a JS Date. */
+export function chromeTimeToDate(chromeTime: number): Date {
+  return new Date((chromeTime / 1000) - 11644473600000)
+}
+
+// ═══════════════════════════════════════════════════════════════════════════════
+// SQL column helpers (used by HistoryClient)
+// ═══════════════════════════════════════════════════════════════════════════════
+
+/** Convert a Chrome timestamp column to Unix epoch seconds in SQL. */
+export function toUnixTimeSql(column: string): string {
+  return `((${column} / 1000000) - 11644473600)`
+}
+
+// ═══════════════════════════════════════════════════════════════════════════════
+// Visit row helpers
+// ═══════════════════════════════════════════════════════════════════════════════
+
+/**
+ * Row shape returned by visit queries (visit_time computed to unix epoch in SQL).
+ * The read-only opener runs with `readBigInts`, so integer columns arrive as `bigint`;
+ * {@link hydrateVisit} converts every one of them to a plain number.
+ */
+export interface VisitRow {
+  id: number | bigint
+  url_id: number | bigint
+  url: string
+  title: string
+  /** Unix timestamp in seconds. */
+  visit_time_unix: number | bigint
+  transition: number | bigint
+  from_visit: number | bigint
+  visit_duration: number | bigint
+  opener_visit: number | bigint
+}
+
+export function hydrateVisit(row: VisitRow): ChromeVisit {
+  const transition = Number(row.transition)
+  const visitTimeUnix = Number(row.visit_time_unix)
+  return {
+    id: Number(row.id),
+    urlId: Number(row.url_id),
+    url: row.url,
+    title: row.title,
+    visitTimeUnix,
+    visitTime: new Date(visitTimeUnix * 1000),
+    transitionType: transitionName(transition),
+    transitionRaw: transition,
+    fromVisitId: Number(row.from_visit),
+    visitDurationMs: Math.round(Number(row.visit_duration) / 1000),
+    openerVisitId: Number(row.opener_visit),
+  }
+}
+
+export const VISIT_COLUMNS = `
+  v.id, v.url AS url_id, u.url, u.title,
+  ${toUnixTimeSql('v.visit_time')} AS visit_time_unix,
+  v.transition, v.from_visit, v.visit_duration, v.opener_visit
+`
diff --git a/packages/stealth/stealth-core-browser/src/lib/lifecycle/errors.ts b/packages/stealth/stealth-core-browser/src/lib/lifecycle/errors.ts
new file mode 100644
index 000000000..753bf8a59
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/lifecycle/errors.ts
@@ -0,0 +1,113 @@
+/**
+ * @adhd/stealth-core-browser — src/lib/lifecycle/errors.ts
+ *
+ * The six failure modes of the Chrome lifecycle. Every throw site under
+ * src/lib/lifecycle (and the lifecycle paths of chrome-manager.ts) goes
+ * through `lifecycleError`; the class is a `StealthCoreBrowserError`, so one
+ * `instanceof` covers every package error.
+ *
+ * There is deliberately no presence/lease code: presence is one held
+ * connection per client to the reaper host, so there is no presence file whose
+ * directory could be insecure.
+ *
+ * Ticket 8468f7b1 · plan state chrome-lifecycle (SPEC-single-pass-lifecycle.md 3.6, CL20).
+ */
+
+import { StealthCoreBrowserError } from '../../errors.js'
+
+export const LIFECYCLE_ERROR_CODES = [
+  'LAUNCH_FAILED',
+  'LAUNCH_LOCK_TIMEOUT',
+  'CHROME_UNREACHABLE_AFTER_LAUNCH',
+  'LAUNCH_CIRCUIT_OPEN',
+  'REAPER_UNAVAILABLE',
+  'ISOLATED_CONTEXT_FAILED',
+] as const
+
+export type LifecycleErrorCode = (typeof LIFECYCLE_ERROR_CODES)[number]
+
+/** Structured, machine-readable facts about a lifecycle failure. */
+export interface LifecycleErrorDetail {
+  /** LAUNCH_CIRCUIT_OPEN: how long until the breaker lets one probe launch through. */
+  retryAfterMs?: number
+  /** The CDP port the failure is about. */
+  port?: number
+  /** A filesystem path involved (lock file, state directory, socket). */
+  path?: string
+  [key: string]: unknown
+}
+
+export interface LifecycleErrorInit {
+  cause?: unknown
+  detail?: LifecycleErrorDetail
+}
+
+/** A lifecycle failure: a StealthCoreBrowserError whose code is one of the six lifecycle codes. */
+export class LifecycleError extends StealthCoreBrowserError {
+  declare readonly code: LifecycleErrorCode
+  declare readonly detail?: LifecycleErrorDetail
+
+  constructor(code: LifecycleErrorCode, message: string, init: LifecycleErrorInit = {}) {
+    super(code, message, init)
+    this.name = 'LifecycleError'
+  }
+}
+
+/** The single construction site for lifecycle failures. */
+export function lifecycleError(code: LifecycleErrorCode, message: string, init: LifecycleErrorInit = {}): LifecycleError {
+  return new LifecycleError(code, message, init)
+}
+
+/** True for a LifecycleError (optionally of one code). */
+export function isLifecycleError(e: unknown, code?: LifecycleErrorCode): e is LifecycleError {
+  return e instanceof LifecycleError && (code === undefined || e.code === code)
+}
+
+/** Message text of anything thrown. */
+export function errorMessage(e: unknown): string {
+  return e instanceof Error ? e.message : String(e)
+}
+
+/**
+ * One-line messages that name the fix. Kept together so every code has
+ * exactly one phrasing and `errors.spec.ts` can reach each through the
+ * factory below.
+ */
+export const lifecycleErrors = {
+  launchFailed: (port: number, cause: unknown): LifecycleError =>
+    lifecycleError(
+      'LAUNCH_FAILED',
+      `Chrome could not be launched on port ${port} (${errorMessage(cause)}); install Chrome in its standard location (library callers may also pass chromePath), and free the port.`,
+      { cause, detail: { port } },
+    ),
+  launchLockTimeout: (port: number, path: string): LifecycleError =>
+    lifecycleError(
+      'LAUNCH_LOCK_TIMEOUT',
+      `Timed out waiting for the Chrome launch lock ${path} on port ${port}; remove the stale lock file if no launcher is running.`,
+      { detail: { port, path } },
+    ),
+  unreachableAfterLaunch: (port: number, cause?: unknown): LifecycleError =>
+    lifecycleError(
+      'CHROME_UNREACHABLE_AFTER_LAUNCH',
+      `Chrome started but CDP did not answer on port ${port} within 10 s; check that nothing else holds the port and the profile is not locked.`,
+      { cause, detail: { port } },
+    ),
+  circuitOpen: (port: number, retryAfterMs: number): LifecycleError =>
+    lifecycleError(
+      'LAUNCH_CIRCUIT_OPEN',
+      `Chrome failed to launch 3 times in 60 s on port ${port}; retry in ${Math.ceil(retryAfterMs / 1000)} s after fixing the launch error.`,
+      { detail: { port, retryAfterMs } },
+    ),
+  reaperUnavailable: (port: number, cause?: unknown, path?: string): LifecycleError =>
+    lifecycleError(
+      'REAPER_UNAVAILABLE',
+      `The Chrome reaper for port ${port} could not be started (${errorMessage(cause ?? 'unknown')}); idle Chrome is not auto-closed until the state directory is private (0700, own uid).`,
+      { cause, detail: path === undefined ? { port } : { port, path } },
+    ),
+  isolatedContextFailed: (step: string, cause: unknown): LifecycleError =>
+    lifecycleError(
+      'ISOLATED_CONTEXT_FAILED',
+      `Opening an isolated page failed at ${step} (${errorMessage(cause)}); the context was disposed, check that Chrome is reachable and retry.`,
+      { cause, detail: { step } },
+    ),
+} as const
diff --git a/packages/stealth/stealth-core-browser/src/lib/lifecycle/exit-hooks.ts b/packages/stealth/stealth-core-browser/src/lib/lifecycle/exit-hooks.ts
new file mode 100644
index 000000000..be06f374a
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/lifecycle/exit-hooks.ts
@@ -0,0 +1,150 @@
+/**
+ * @adhd/stealth-core-browser — src/lib/lifecycle/exit-hooks.ts
+ *
+ * Shutdown on EVERY exit path of a hosting process (F23, gap G2): `exit`,
+ * SIGINT, SIGTERM, uncaughtException, unhandledRejection and — opt-in, for a
+ * stdio server whose parent may vanish — stdin end. Each runs, exactly once,
+ * `release()` (this process leaves the reaper's registry) and then the SOFT
+ * `shutdownIfIdle()` (never a sibling's or a human's Chrome), bounded by a
+ * force-exit after `forceExitMs` (default 5000). Exit codes: SIGINT 130,
+ * SIGTERM 143, uncaughtException / unhandledRejection 1, stdin end 0.
+ *
+ * `exit` is synchronous in Node: on it the hooks only START the release and
+ * soft shutdown (best effort) and never call `exit` again.
+ *
+ * The hosts (`src/server.ts`, `src/cli.ts`) wire this in surface-hosts.14.
+ * Every process touch point is injectable so the unit lane never installs a
+ * real signal handler.
+ *
+ * Ticket 8468f7b1 · plan state chrome-lifecycle (CL14).
+ */
+
+import { errorMessage } from './errors.js'
+
+/** What the hooks need from a ChromeManager. */
+export interface ExitHookTarget {
+  release(): Promise<void> | void
+  shutdownIfIdle(): Promise<void>
+}
+
+/** The subset of `process` the hooks listen on. */
+export interface ExitHookProcess {
+  on(event: string, listener: (...args: unknown[]) => void): unknown
+  removeListener(event: string, listener: (...args: unknown[]) => void): unknown
+}
+
+/** The subset of `process.stdin` the opt-in stdin-EOF hook listens on. */
+export interface ExitHookStdin {
+  on(event: 'end', listener: () => void): unknown
+  removeListener(event: 'end', listener: () => void): unknown
+}
+
+export interface ExitHookOptions {
+  /** Force-exit bound in ms. Default 5000. */
+  forceExitMs?: number
+  /** Also shut down when stdin ends (orphaned stdio server). Default false. */
+  stdinEof?: boolean
+  /** Default `process.exit`. */
+  exit?: (code: number) => void
+  /** Default `process`. */
+  proc?: ExitHookProcess
+  /** Default `process.stdin`. */
+  stdin?: ExitHookStdin
+  /** Diagnostics sink. Default `console.error` with a `[exit-hooks]` prefix. */
+  logger?: (msg: string) => void
+  /** Timer injection (tests use fake timers instead). */
+  setTimer?: (fn: () => void, ms: number) => unknown
+  clearTimer?: (handle: unknown) => void
+}
+
+export const EXIT_CODE_SIGINT = 130
+export const EXIT_CODE_SIGTERM = 143
+export const EXIT_CODE_FATAL = 1
+export const EXIT_CODE_STDIN_EOF = 0
+
+/**
+ * Install the exit hooks for `manager`. Returns an uninstall function that
+ * removes every listener it added (idempotent).
+ */
+export function installProcessExitHooks(manager: ExitHookTarget, opts: ExitHookOptions = {}): () => void {
+  const forceExitMs = opts.forceExitMs ?? 5000
+  const proc: ExitHookProcess = opts.proc ?? (process as unknown as ExitHookProcess)
+  const exit = opts.exit ?? ((code: number) => process.exit(code))
+  const log = opts.logger ?? ((m: string) => console.error(`[exit-hooks] ${m}`))
+  const setTimer = opts.setTimer ?? ((fn: () => void, ms: number) => setTimeout(fn, ms))
+  const clearTimer = opts.clearTimer ?? ((h: unknown) => clearTimeout(h as ReturnType<typeof setTimeout>))
+
+  let started = false
+
+  /** release() then the soft shutdown, each failure logged, never thrown. */
+  const teardown = async (): Promise<void> => {
+    try {
+      await manager.release()
+    } catch (e) {
+      log(`release failed: ${errorMessage(e)}`)
+    }
+    try {
+      await manager.shutdownIfIdle()
+    } catch (e) {
+      log(`soft shutdown failed: ${errorMessage(e)}`)
+    }
+  }
+
+  const run = (reason: string, code: number): void => {
+    if (started) return
+    started = true
+    log(`${reason}: releasing and shutting Chrome down if idle (exit ${code})`)
+    let exited = false
+    const finish = (): void => {
+      if (exited) return
+      exited = true
+      exit(code)
+    }
+    const force = setTimer(() => {
+      log(`teardown exceeded ${forceExitMs} ms: forcing exit ${code}`)
+      finish()
+    }, forceExitMs)
+    void teardown().then(() => {
+      clearTimer(force)
+      finish()
+    })
+  }
+
+  const onExit = (): void => {
+    if (started) return
+    started = true
+    // Synchronous `exit`: start the teardown best effort; the process is already leaving.
+    void teardown()
+  }
+  const onSigint = (): void => run('SIGINT', EXIT_CODE_SIGINT)
+  const onSigterm = (): void => run('SIGTERM', EXIT_CODE_SIGTERM)
+  const onUncaught = (err: unknown): void => {
+    log(`uncaughtException: ${errorMessage(err)}`)
+    run('uncaughtException', EXIT_CODE_FATAL)
+  }
+  const onUnhandled = (reason: unknown): void => {
+    log(`unhandledRejection: ${errorMessage(reason)}`)
+    run('unhandledRejection', EXIT_CODE_FATAL)
+  }
+  const onStdinEnd = (): void => run('stdin end', EXIT_CODE_STDIN_EOF)
+
+  const listeners: Array<[string, (...args: unknown[]) => void]> = [
+    ['exit', onExit],
+    ['SIGINT', onSigint],
+    ['SIGTERM', onSigterm],
+    ['uncaughtException', onUncaught as (...args: unknown[]) => void],
+    ['unhandledRejection', onUnhandled as (...args: unknown[]) => void],
+  ]
+  for (const [ev, fn] of listeners) proc.on(ev, fn)
+
+  const stdin = opts.stdinEof ? (opts.stdin ?? (process.stdin as unknown as ExitHookStdin)) : null
+  stdin?.on('end', onStdinEnd)
+
+  let installed = true
+  return () => {
+    if (!installed) return
+    installed = false
+    for (const [ev, fn] of listeners) proc.removeListener(ev, fn)
+    stdin?.removeListener('end', onStdinEnd)
+  }
+}
