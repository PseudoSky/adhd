index 000000000..670f9b9eb
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/recording/open-store-sink.ts
@@ -0,0 +1,99 @@
+/**
+ * @adhd/stealth-core-browser — src/lib/recording/open-store-sink.ts
+ *
+ * The default concrete adapter: open a store at `dbPath` through the shared
+ * store adapter and wrap it in a `StoreRecordingSink` that owns (and closes) it.
+ *
+ * The adapter package is ESM-only while this package publishes CommonJS
+ * (ADR-0003), and Node 22.5 to 22.11 cannot require() an ES module. It is
+ * therefore reached ONLY through the lazy dynamic import in the default
+ * `loadAdapter` below, never at module load: consumers that never record to a
+ * store never touch it, and a missing or broken install surfaces as
+ * CAPTURE_SINK_UNAVAILABLE from this factory alone.
+ *
+ * A recording holds whatever the page exchanged, which by default includes cookies and authorization headers
+ * (see `redactHeaders`). The database file, and the `-wal` and `-shm` files SQLite derives from it, are therefore
+ * created and kept owner-only (0600) whatever the umask; a file that cannot be secured fails the open with
+ * CAPTURE_SINK_UNAVAILABLE instead of recording into a readable file.
+ *
+ * Ticket 8468f7b1 · plan state capture-upgrade [capture-upgrade.26] [capture-upgrade.27].
+ */
+import type { createStoreAdapter } from '@adhd/sox-store-adapter'
+import { chmodSync, closeSync, existsSync, mkdirSync, openSync } from 'node:fs'
+import { dirname } from 'node:path'
+import { captureError, errorMessage } from './errors.js'
+import { StoreRecordingSink } from './store-sink.js'
+
+export interface OpenStoreRecordingSinkOptions {
+  /** Database file handed to the adapter factory as `{ dbPath }`. */
+  dbPath: string
+  /** Table name; default `recordings`. */
+  table?: string
+  /** Seam for tests and alternate loaders. Default: lazy dynamic import of the adapter package. */
+  loadAdapter?: () => Promise<{ createStoreAdapter: typeof createStoreAdapter }>
+}
+
+/** Owner read/write only: the mode of a recording database and its SQLite side files. */
+export const RECORDING_FILE_MODE = 0o600
+
+const SIDE_FILES = ['', '-wal', '-shm'] as const
+
+/** True for the paths that name no file (an in-memory database). */
+function isMemoryPath(dbPath: string): boolean {
+  return dbPath === '' || dbPath === ':memory:' || dbPath.startsWith('file::memory:')
+}
+
+/** Create the database file owner-only before the adapter opens it, so it is never readable even briefly. */
+function precreateOwnerOnly(dbPath: string): void {
+  if (isMemoryPath(dbPath) || existsSync(dbPath)) return
+  mkdirSync(dirname(dbPath), { recursive: true, mode: 0o700 })
+  closeSync(openSync(dbPath, 'a', RECORDING_FILE_MODE))
+}
+
+/** Force owner-only on the database and any side file that exists (a file created earlier under a wider umask). */
+function secureOwnerOnly(dbPath: string): void {
+  if (isMemoryPath(dbPath)) return
+  for (const suffix of SIDE_FILES) {
+    const file = `${dbPath}${suffix}`
+    if (existsSync(file)) chmodSync(file, RECORDING_FILE_MODE)
+  }
+}
+
+export async function openStoreRecordingSink(opts: OpenStoreRecordingSinkOptions): Promise<StoreRecordingSink> {
+  const loadAdapter = opts.loadAdapter ?? (() => import('@adhd/sox-store-adapter'))
+
+  let adapterModule: { createStoreAdapter: typeof createStoreAdapter }
+  try {
+    adapterModule = await loadAdapter()
+  } catch (cause) {
+    throw captureError('CAPTURE_SINK_UNAVAILABLE', `cannot load @adhd/sox-store-adapter (is it installed?): ${errorMessage(cause)}`, { cause })
+  }
+
+  try {
+    precreateOwnerOnly(opts.dbPath)
+  } catch (cause) {
+    throw captureError('CAPTURE_SINK_UNAVAILABLE', `cannot create the recording store ${opts.dbPath} owner-only: ${errorMessage(cause)}`, { cause })
+  }
+
+  let adapter: Awaited<ReturnType<typeof createStoreAdapter>>
+  try {
+    adapter = await adapterModule.createStoreAdapter({ dbPath: opts.dbPath })
+  } catch (cause) {
+    throw captureError('CAPTURE_SINK_UNAVAILABLE', `cannot open the recording store at ${opts.dbPath}: ${errorMessage(cause)}`, { cause })
+  }
+
+  const sink = new StoreRecordingSink(adapter, { table: opts.table }, { close: () => adapter.close() })
+  try {
+    await sink.init()
+  } catch (cause) {
+    await adapter.close().catch(() => undefined)
+    throw captureError('CAPTURE_SINK_UNAVAILABLE', `cannot initialise the recording schema at ${opts.dbPath}: ${errorMessage(cause)}`, { cause })
+  }
+  try {
+    secureOwnerOnly(opts.dbPath)
+  } catch (cause) {
+    await adapter.close().catch(() => undefined)
+    throw captureError('CAPTURE_SINK_UNAVAILABLE', `cannot restrict the recording store ${opts.dbPath} to its owner: ${errorMessage(cause)}`, { cause })
+  }
+  return sink
+}
diff --git a/packages/stealth/stealth-core-browser/src/lib/recording/redact.ts b/packages/stealth/stealth-core-browser/src/lib/recording/redact.ts
new file mode 100644
index 000000000..c7e6e54ac
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/recording/redact.ts
@@ -0,0 +1,41 @@
+/**
+ * @adhd/stealth-core-browser — src/lib/recording/redact.ts
+ *
+ * Header redaction for persisted recordings. Identity is the recorder default
+ * (replay use needs the cookies), so a recording written to a sink holds cookies and
+ * authorization headers in clear: the store sink keeps its file owner-only (0600), and
+ * a caller that does not need them stored passes `redactHeaders()` as `redact` to mask
+ * credentials at the sink and `onExchange` boundary while in-memory exchanges stay raw.
+ * Only header values are masked: a token carried in a URL query string is NOT, so a
+ * recording of such requests must be treated as secret whatever `redact` is.
+ *
+ * Ticket 8468f7b1 · plan state capture-upgrade [capture-upgrade.16].
+ */
+import type { Headers, RecordedExchange, RecordedRequest, RecordedResponse } from './types.js'
+
+export const DEFAULT_REDACTED_HEADERS: readonly string[] = ['cookie', 'set-cookie', 'authorization', 'proxy-authorization']
+
+export const REDACTED = '[REDACTED]'
+
+function maskHeaders(headers: Headers, names: ReadonlySet<string>): Headers {
+  const out: Headers = {}
+  for (const [k, v] of Object.entries(headers)) out[k] = names.has(k.toLowerCase()) ? REDACTED : v
+  return out
+}
+
+/**
+ * Returns a `redact` function masking the named headers (case-insensitive) in
+ * the request, the response and every redirect hop. The input exchange is
+ * never mutated.
+ */
+export function redactHeaders(names: readonly string[] = DEFAULT_REDACTED_HEADERS): (exchange: RecordedExchange) => RecordedExchange {
+  const set = new Set(names.map((n) => n.toLowerCase()))
+  const req = (r: RecordedRequest): RecordedRequest => ({ ...r, headers: maskHeaders(r.headers, set) })
+  const res = (r: RecordedResponse): RecordedResponse => ({ ...r, headers: maskHeaders(r.headers, set) })
+  return (ex) => ({
+    ...ex,
+    request: req(ex.request),
+    response: ex.response ? res(ex.response) : undefined,
+    redirects: ex.redirects.map((h) => ({ request: req(h.request), response: res(h.response) })),
+  })
+}
diff --git a/packages/stealth/stealth-core-browser/src/lib/recording/store-sink.ts b/packages/stealth/stealth-core-browser/src/lib/recording/store-sink.ts
new file mode 100644
index 000000000..058292966
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/recording/store-sink.ts
@@ -0,0 +1,158 @@
+/**
+ * @adhd/stealth-core-browser — src/lib/recording/store-sink.ts
+ *
+ * `RecordingSink` over the shared store adapter. The store is typed as the
+ * three adapter methods the sink needs (`import type` only, so a signature
+ * drift in the adapter is a compile error here, and no module of the adapter
+ * is loaded by this file). Batches run inside ONE immediate transaction;
+ * every envelope is one parametrized INSERT OR REPLACE keyed by
+ * (recording_id, request_id), so a replay never duplicates a row.
+ *
+ * Ticket 8468f7b1 · plan state capture-upgrade [capture-upgrade.11].
+ */
+import type { StoreAdapter } from '@adhd/sox-store-adapter'
+import { captureError } from './errors.js'
+import type { RecordingEnvelope, RecordingSink } from './types.js'
+
+export type RecordingStore = Pick<StoreAdapter, 'exec' | 'executeRun' | 'transaction'>
+
+export const RECORDING_SCHEMA_VERSION = 1
+export const DEFAULT_RECORDING_TABLE = 'recordings'
+
+export interface StoreRecordingSinkOptions {
+  /** Table name; letters, digits and underscore. Default `recordings`. */
+  table?: string
+}
+
+/** Closes a store the sink does not own the lifetime of by default (set by `openStoreRecordingSink`). */
+export interface StoreOwnership {
+  close(): Promise<void>
+}
+
+const TABLE_NAME = /^[A-Za-z_][A-Za-z0-9_]*$/
+
+/** The DDL statements, one per `exec` call, followed by the schema-version upsert SQL. */
+export function recordingDdl(table: string = DEFAULT_RECORDING_TABLE): { statements: string[]; versionSql: string } {
+  if (!TABLE_NAME.test(table)) {
+    throw captureError('CAPTURE_SINK_UNAVAILABLE', `invalid recording table name: ${JSON.stringify(table)}`)
+  }
+  return {
+    statements: [
+      `CREATE TABLE IF NOT EXISTS ${table} (
+  recording_id TEXT NOT NULL,
+  request_id TEXT NOT NULL,
+  seq INTEGER NOT NULL,
+  ts TEXT NOT NULL,
+  method TEXT NOT NULL,
+  url TEXT NOT NULL,
+  url_path TEXT NOT NULL,
+  state TEXT NOT NULL,
+  status INTEGER,
+  request_headers TEXT NOT NULL,
+  request_body TEXT,
+  response_headers TEXT NOT NULL,
+  response_body TEXT,
+  body_encoding TEXT,
+  redirects TEXT NOT NULL,
+  failure TEXT,
+  duration_ms INTEGER,
+  PRIMARY KEY (recording_id, request_id)
+)`,
+      `CREATE INDEX IF NOT EXISTS ${table}_ts ON ${table} (ts)`,
+      `CREATE INDEX IF NOT EXISTS ${table}_url_path ON ${table} (url_path)`,
+      `CREATE INDEX IF NOT EXISTS ${table}_status ON ${table} (status)`,
+      'CREATE TABLE IF NOT EXISTS recording_schema (table_name TEXT PRIMARY KEY, version INTEGER NOT NULL)',
+    ],
+    versionSql: 'INSERT OR REPLACE INTO recording_schema (table_name, version) VALUES (?, ?)',
+  }
+}
+
+function urlPath(url: string): string {
+  try {
+    return new URL(url).pathname
+  } catch {
+    return url
+  }
+}
+
+/** The parameter array of one envelope's INSERT OR REPLACE, in column order. */
+export function envelopeParams(env: RecordingEnvelope): unknown[] {
+  const ex = env.exchange
+  return [
+    env.recordingId,
+    ex.requestId,
+    env.seq,
+    env.ts,
+    ex.request.method,
+    ex.url,
+    urlPath(ex.url),
+    ex.state,
+    ex.response?.status ?? null,
+    JSON.stringify(ex.request.headers),
+    ex.request.postData ?? null,
+    JSON.stringify(ex.response?.headers ?? {}),
+    ex.response?.body ?? null,
+    ex.response?.bodyEncoding ?? null,
+    JSON.stringify(ex.redirects),
+    ex.failure ? JSON.stringify(ex.failure) : null,
+    ex.durationMs ?? null,
+  ]
+}
+
+export class StoreRecordingSink implements RecordingSink {
+  private readonly store: RecordingStore
+  private readonly table: string
+  private readonly owned?: StoreOwnership
+  private initPromise?: Promise<void>
+  private closePromise?: Promise<void>
+  private readonly insertSql: string
+
+  /**
+   * @param store an injected store is NEVER closed by the sink
+   * @param owned set only by `openStoreRecordingSink`: closing the sink then closes the store it opened
+   */
+  constructor(store: RecordingStore, opts: StoreRecordingSinkOptions = {}, owned?: StoreOwnership) {
+    this.store = store
+    this.table = opts.table ?? DEFAULT_RECORDING_TABLE
+    this.owned = owned
+    recordingDdl(this.table) // validates the table name eagerly
+    this.insertSql =
+      `INSERT OR REPLACE INTO ${this.table} (recording_id, request_id, seq, ts, method, url, url_path, state, status, ` +
+      'request_headers, request_body, response_headers, response_body, body_encoding, redirects, failure, duration_ms) ' +
+      'VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
+  }
+
+  /** Creates the table and records the schema version. Runs once; later calls return the same promise. */
+  init(): Promise<void> {
+    this.initPromise ??= this.runInit()
+    return this.initPromise
+  }
+
+  private async runInit(): Promise<void> {
+    const ddl = recordingDdl(this.table)
+    for (const sql of ddl.statements) await this.store.exec(sql)
+    await this.store.executeRun(ddl.versionSql, [this.table, RECORDING_SCHEMA_VERSION])
+  }
+
+  async write(envelope: RecordingEnvelope): Promise<void> {
+    await this.writeBatch([envelope])
+  }
+
+  /** One immediate transaction for the whole batch. */
+  async writeBatch(envelopes: readonly RecordingEnvelope[]): Promise<void> {
+    if (this.closePromise) throw captureError('CAPTURE_SINK_FAILED', 'StoreRecordingSink is closed')
+    await this.init()
+    await this.store.transaction(
+      async (tx) => {
+        for (const env of envelopes) await tx.executeRun(this.insertSql, envelopeParams(env))
+      },
+      { mode: 'immediate' },
+    )
+  }
+
+  /** Idempotent. Closes the store only when this sink opened it. */
+  close(): Promise<void> {
+    this.closePromise ??= this.owned ? this.owned.close() : Promise.resolve()
+    return this.closePromise
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/src/lib/recording/types.ts b/packages/stealth/stealth-core-browser/src/lib/recording/types.ts
