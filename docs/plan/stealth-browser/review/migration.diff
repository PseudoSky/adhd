+    const args = [
+      `--remote-debugging-port=${port}`,
+      `--user-data-dir=${profileDir}`,
+      '--no-first-run',
+      '--start-minimized',
+      // ⚠️  Detection risk: --disable-backgrounding-occluded-windows prevents Chrome
