+/**
+ * guards: a SearchHostConfig default is wrong, a bad value is accepted, or two configs share state through the environment
+ * tier: S
+ * cites: ticket 8468f7b1 [search-port-guards.1] [search-port-guards.4]
+ * SearchHostConfig: typed defaults, derivation from the data dir and rejection of bad values;
+ * two different configs coexist in one process because nothing is read from the environment.
+ * Ticket 8468f7b1 · [search-port-guards.1] [search-port-guards.4]
+ */
+import { describe, expect, it } from 'vitest'
+import { adhdDataDir } from '@adhd/resilience-core-tripwire'
+import { DEFAULT_DATA_DIR, DEFAULT_SEARCH_HOST_CONFIG, createSearchHostConfig } from '../../../src/lib/config.js'
+import type { InteractionPort } from '../../../src/lib/config.js'
+import { createSearchGuard } from '../../../src/lib/guard.js'
+import { createSearchTripwire } from '../../../src/lib/tripwire.js'
+import { isSearchError } from '../../../src/errors.js'
+import { fireInput, makeEnv } from '../../helpers/guards/guards-harness.js'
+
+describe('DEFAULT_SEARCH_HOST_CONFIG [search-port-guards.1]', () => {
+  it('carries the spec defaults 7200000, 30000, 20000, 60000, 2 and 4', () => {
+    const d = DEFAULT_SEARCH_HOST_CONFIG
+    expect([d.tripwireTtlMs, d.cooldownCaptchaMs, d.cooldownRateMs, d.cooldownBannedMs, d.maxConcurrent, d.maxSiblings]).toEqual([7200000, 30000, 20000, 60000, 2, 4])
+    expect(d.auditMaxBytes).toBe(5 * 1024 * 1024)
+  })
+
+  it('derives the data dir from adhdDataDir under ~/.adhd/reverse/data so the shared audit.log survives', () => {
+    expect(DEFAULT_DATA_DIR).toBe(adhdDataDir(['reverse', 'data']))
+    expect(DEFAULT_DATA_DIR.endsWith('/.adhd/reverse/data')).toBe(true)
+    expect(DEFAULT_SEARCH_HOST_CONFIG.auditPath).toBe(`${DEFAULT_DATA_DIR}/audit.log`)
+  })
+
+  it('is frozen so no caller mutates the defaults', () => {
+    expect(Object.isFrozen(DEFAULT_SEARCH_HOST_CONFIG)).toBe(true)
+  })
+})
+
+describe('createSearchHostConfig [search-port-guards.1]', () => {
+  it('moves the audit log with a dataDir override and keeps an explicit auditPath', () => {
+    expect(createSearchHostConfig({ dataDir: '/x' }).auditPath).toBe('/x/audit.log')
+    expect(createSearchHostConfig({ dataDir: '/x', auditPath: '/y/a.log' }).auditPath).toBe('/y/a.log')
+    expect(createSearchHostConfig().auditPath).toBe(DEFAULT_SEARCH_HOST_CONFIG.auditPath)
+  })
+
+  it('ignores undefined overrides and lets maxConcurrent be zero or negative (cap disabled)', () => {
+    expect(createSearchHostConfig({ maxConcurrent: undefined }).maxConcurrent).toBe(2)
+    expect(createSearchHostConfig({ maxConcurrent: 0 }).maxConcurrent).toBe(0)
+    expect(createSearchHostConfig({ maxConcurrent: -1 }).maxConcurrent).toBe(-1)
+  })
+
+  it.each([
+    ['tripwireTtlMs', 0],
+    ['cooldownRateMs', -5],
+    ['maxSiblings', 1.5],
+    ['auditMaxBytes', Number.NaN],
+  ] as const)('rejects %s = %s with HOST_FLAG_INVALID naming the field', (field, value) => {
+    try {
+      createSearchHostConfig({ [field]: value })
+      expect.unreachable('should have thrown')
+    } catch (e) {
+      expect(isSearchError(e, 'HOST_FLAG_INVALID')).toBe(true)
+      expect((e as { detail?: { field?: string } }).detail?.field).toBe(field)
+    }
+  })
+
+  it('rejects an empty dataDir', () => {
+    expect(() => createSearchHostConfig({ dataDir: ' ' })).toThrow(/dataDir/)
+  })
+})
+
+describe('no environment is read: two SearchHostConfig values in one process [search-port-guards.4]', () => {
+  it('keep independent cooldown durations, caps, data dirs and tripwire locks', async () => {
+    const a = makeEnv({ dataDir: '/a', cooldownCaptchaMs: 1000, maxConcurrent: 1 })
+    const b = makeEnv({ dataDir: '/b', cooldownCaptchaMs: 9000, maxConcurrent: 0 })
+    await a.guard.recordSearchOutcome('github', 'captcha')
+    await b.guard.recordSearchOutcome('github', 'captcha')
+    expect((await a.guard.readProviderCooldown('github'))?.until).toBe(a.clock.now + 1000)
+    expect((await b.guard.readProviderCooldown('github'))?.until).toBe(b.clock.now + 9000)
+    expect(a.guard.searchConcurrencyInfo().max).toBe(1)
+    expect(b.guard.searchConcurrencyInfo().max).toBe(0)
+    await a.tripwire.fire(fireInput('github', 'captcha'))
+    expect(await a.tripwire.isTripped('github')).toBe(true)
+    expect(await b.tripwire.isTripped('github')).toBe(false)
+  })
+
+  it('shares nothing between two guards built over the same process-wide defaults', () => {
+    const g1 = createSearchGuard(createSearchHostConfig({ dataDir: '/one', maxConcurrent: 3 }))
+    const g2 = createSearchGuard(createSearchHostConfig({ dataDir: '/two', maxConcurrent: 5 }))
+    expect([g1.searchConcurrencyInfo().max, g2.searchConcurrencyInfo().max]).toEqual([3, 5])
+    expect(createSearchTripwire(createSearchHostConfig({ dataDir: '/one' }))).toBeDefined()
+  })
+})
+
+describe('InteractionPort [search-port-guards.1]', () => {
+  it('is implementable with a gate prompt and a solved confirmation', async () => {
+    const port: InteractionPort = {
+      promptTripwireGate: async () => 'retry',
+      confirmSolved: async () => 'solved',
+    }
+    expect(await port.promptTripwireGate({ provider: 'g', reason: 'captcha', trippedAt: '', blockedCount: 0, pageUrl: '' })).toBe('retry')
+    expect(await port.confirmSolved({ provider: 'g', reason: 'captcha', query: 'q', strategy: 'dom', pageUrl: '' })).toBe('solved')
+  })
+})
diff --git a/entrypoint/stealth-search/test/unit/guards/cooldown.spec.ts b/entrypoint/stealth-search/test/unit/guards/cooldown.spec.ts
new file mode 100644
index 000000000..91f73cb92
--- /dev/null
+++ b/entrypoint/stealth-search/test/unit/guards/cooldown.spec.ts
@@ -0,0 +1,119 @@
+/**
+ * guards: a provider cooldown is written non-atomically, expires late, survives expiry, or arms for a hitl outcome
+ * tier: S
+ * cites: ticket 8468f7b1 [search-port-guards.2]
+ * Provider cooldown (inventory row [I-19]): atomic temp-file-then-rename writes to
+ * `<data>/guard/<provider>.json`, the three durations, lazy removal of an expired cooldown,
+ * the hitl exclusion and PROVIDER_STATE_IO for unreadable state.
+ * Ticket 8468f7b1 · [search-port-guards.2]
+ */
+import { describe, expect, it } from 'vitest'
+import { isSearchError } from '../../../src/errors.js'
+import { makeEnv } from '../../helpers/guards/guards-harness.js'
+
+describe('provider cooldown [search-port-guards.2] [I-19]', () => {
+  it('cooldown arms and disarms atomically', async () => {
+    const env = makeEnv()
+    await env.guard.recordSearchOutcome('github', 'captcha', 'repo:x')
+    const path = '/data/guard/github.json'
+    expect(env.fs.exists(path)).toBe(true)
+    // atomic: a unique temp file was created, then renamed over the final name, and none is left
+    const rename = env.fs.ops.find((o) => o.op === 'rename')
+    expect(rename?.path2).toBe(path)
+    expect(rename?.path).toMatch(/\/data\/guard\/github\.json\.\d+\.[0-9a-f]+\.tmp$/)
+    expect(env.fs.files().filter((f) => f.endsWith('.tmp'))).toEqual([])
+    expect(await env.guard.cooldownRemainingMs('github')).toBe(30000)
+    // success disarms
+    await env.guard.recordSearchOutcome('github', 'success')
+    expect(env.fs.exists(path)).toBe(false)
+    expect(await env.guard.cooldownRemainingMs('github')).toBe(0)
+    // empty disarms too
+    await env.guard.recordSearchOutcome('github', 'banned')
+    expect(env.fs.exists(path)).toBe(true)
+    await env.guard.recordSearchOutcome('github', 'empty')
+    expect(env.fs.exists(path)).toBe(false)
+  })
+
+  it('arms the three cooldown durations 30000, 20000 and 60000 from the config', async () => {
+    const env = makeEnv()
+    for (const [outcome, ms] of [['captcha', 30000], ['rate_limited', 20000], ['banned', 60000]] as const) {
+      expect(env.guard.cooldownForOutcome(outcome)).toBe(ms)
+      await env.guard.recordSearchOutcome(outcome, outcome)
+      const cd = await env.guard.readProviderCooldown(outcome)
+      expect(cd).toMatchObject({ provider: outcome, reason: outcome, until: env.clock.now + ms })
+    }
+    const custom = makeEnv({ cooldownCaptchaMs: 5, cooldownRateMs: 6, cooldownBannedMs: 7 })
+    expect([custom.guard.cooldownForOutcome('captcha'), custom.guard.cooldownForOutcome('rate_limited'), custom.guard.cooldownForOutcome('banned')]).toEqual([5, 6, 7])
+  })
+
+  it('removes an expired cooldown lazily on read and only then', async () => {
+    const env = makeEnv()
+    await env.guard.recordSearchOutcome('github', 'rate_limited')
+    env.clock.now += 19999
+    expect(await env.guard.cooldownRemainingMs('github')).toBe(1)
+    expect(env.fs.exists('/data/guard/github.json')).toBe(true)
+    env.clock.now += 1
+    // nothing removed until a read happens (lazy)
+    expect(env.fs.exists('/data/guard/github.json')).toBe(true)
+    expect(await env.guard.cooldownRemainingMs('github')).toBe(0)
+    expect(env.fs.exists('/data/guard/github.json')).toBe(false)
+  })
+
+  it('never arms a cooldown for a hitl outcome and leaves an armed one alone', async () => {
+    const env = makeEnv()
+    await env.guard.recordSearchOutcome('github', 'hitl')
+    expect(env.fs.files()).toEqual([])
+    await env.guard.recordSearchOutcome('github', 'captcha')
+    await env.guard.recordSearchOutcome('github', 'hitl')
+    expect(env.fs.exists('/data/guard/github.json')).toBe(true)
+    for (const other of ['error', 'timeout', 'weird']) {
+      await env.guard.recordSearchOutcome('github', other)
+      expect(env.fs.exists('/data/guard/github.json')).toBe(true)
+    }
+  })
+
+  it('creates the cooldown file 0600 in a 0700 directory and records the query', async () => {
+    const env = makeEnv()
+    await env.guard.setProviderCooldown('github', 'captcha', 100, 'q1')
+    expect(env.fs.modeOf('/data/guard/github.json')).toBe(0o600)
+    expect(env.fs.modeOf('/data/guard')).toBe(0o700)
+    expect((await env.guard.readProviderCooldown('github'))?.query).toBe('q1')
+  })
+
+  it('shares one cooldown between two guards over the same data dir (cross-process)', async () => {
+    const env = makeEnv()
+    const other = (await import('../../../src/lib/guard.js')).createSearchGuard(env.config)
+    await env.guard.recordSearchOutcome('github', 'captcha')
+    expect(await other.cooldownRemainingMs('github')).toBe(30000)
+  })
+
+  it('raises PROVIDER_STATE_IO for a corrupt, mis-shaped or unreadable state file', async () => {
+    const env = makeEnv()
+    env.fs.writeText('/data/guard/github.json', '{not json')
+    await expect(env.guard.readProviderCooldown('github')).rejects.toSatisfy((e) => isSearchError(e, 'PROVIDER_STATE_IO'))
+    env.fs.writeText('/data/guard/github.json', '{"until":"soon"}')
+    await expect(env.guard.cooldownRemainingMs('github')).rejects.toSatisfy((e) => isSearchError(e, 'PROVIDER_STATE_IO'))
+    env.fs.failOn({ op: 'readFile', path: '/data/guard/github.json', code: 'EACCES' })
+    await expect(env.guard.readProviderCooldown('github')).rejects.toSatisfy((e) => isSearchError(e, 'PROVIDER_STATE_IO'))
+  })
+
+  it('raises PROVIDER_STATE_IO when the rename fails and removes the temp file', async () => {
+    const env = makeEnv()
+    env.fs.failOn({ op: 'rename', code: 'ENOSPC' })
+    await expect(env.guard.setProviderCooldown('github', 'captcha', 10)).rejects.toSatisfy((e) => isSearchError(e, 'PROVIDER_STATE_IO'))
+    expect(env.fs.files()).toEqual([])
+  })
+
+  it('raises PROVIDER_STATE_IO when a cooldown cannot be removed, but not when it is already gone', async () => {
+    const env = makeEnv()
+    await expect(env.guard.clearProviderCooldown('github')).resolves.toBeUndefined()
+    await env.guard.recordSearchOutcome('github', 'captcha')
+    env.fs.failOn({ op: 'unlink', path: '/data/guard/github.json', code: 'EACCES' })
+    await expect(env.guard.clearProviderCooldown('github')).rejects.toSatisfy((e) => isSearchError(e, 'PROVIDER_STATE_IO'))
+  })
+
+  it('refuses a provider id that would escape the guard directory', async () => {
+    const env = makeEnv()
+    await expect(env.guard.readProviderCooldown('../tripwire/x')).rejects.toSatisfy((e) => isSearchError(e, 'UNKNOWN_PROVIDER'))
+  })
+})
diff --git a/entrypoint/stealth-search/test/unit/guards/login-required.spec.ts b/entrypoint/stealth-search/test/unit/guards/login-required.spec.ts
