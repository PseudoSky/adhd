diff --git a/packages/stealth/stealth-core-browser/src/lib/storage/profile.ts b/packages/stealth/stealth-core-browser/src/lib/storage/profile.ts
new file mode 100644
index 000000000..ab4593871
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/storage/profile.ts
@@ -0,0 +1,120 @@
+import { chromeProfileDir } from '../helpers.js'
+import { openDb } from './helpers.js'
+import { join } from 'node:path'
+import { readFileSync, readdirSync } from 'node:fs'
+
+/** The value shown in place of an autofill value when `redactValues` is set. */
+export const AUTOFILL_REDACTED = '[REDACTED]'
+
+export class ProfileClient {
+  private readonly profileDir: string
+
+  constructor(profileDir?: string) {
+    this.profileDir = profileDir ?? chromeProfileDir()
+  }
+
+  get defaultDir(): string { return join(this.profileDir, 'Default') }
+
+  getTopSites(limit = 20): Array<{ url: string; title: string; score: number }> {
+    const db = openDb(join(this.defaultDir, 'Top Sites'))
+    try {
+      const rows = db.prepare('SELECT url, title, url_rank FROM top_sites ORDER BY url_rank DESC LIMIT ?').all(limit) as Array<{
+        url: string; title: string; url_rank: unknown
+      }>
+      return rows.map((r) => ({ url: r.url ?? '', title: r.title ?? '', score: Number(r.url_rank ?? 0) }))
+    } finally { db.close() }
+  }
+
+  getFaviconData(pageUrl: string): { url: string; data?: string; mimeType?: string } | null {
+    const db = openDb(join(this.defaultDir, 'Favicons'))
+    try {
+      const row = db.prepare(`
+        SELECT f.url, fb.image_data
+        FROM icon_mapping im
+        JOIN favicons f ON im.icon_id = f.id
+        JOIN favicon_bitmaps fb ON f.id = fb.icon_id
+        WHERE im.page_url = ?
+        ORDER BY fb.last_updated DESC
+        LIMIT 1
+      `).get(pageUrl) as { url: string; image_data?: Buffer } | undefined
+      if (!row) return null
+      return {
+        url: row.url ?? '',
+        data: row.image_data ? Buffer.from(row.image_data).toString('base64') : undefined,
+        mimeType: 'image/png',
+      }
+    } finally { db.close() }
+  }
+
+  /**
+   * Saved form-fill entries, newest first (at most 100). The values are personal data (names, emails, addresses):
+   * pass `{ redactValues: true }` to get the field names, counts and dates with every value replaced by
+   * `[REDACTED]`. The default returns the values, because reading them is what this call is for.
+   */
+  getAutofillData(opts: { redactValues?: boolean } = {}): Array<{ name: string; value: string; count: number; lastUsed: Date }> {
+    const db = openDb(join(this.defaultDir, 'Web Data'))
+    try {
+      const rows = db.prepare(`
+        SELECT name, value, count, date_last_used
+        FROM autofill
+        ORDER BY date_last_used DESC
+        LIMIT 100
+      `).all() as Array<{ name: string; value: string; count: unknown; date_last_used: unknown }>
+      return rows.map((r) => ({
+        name: r.name ?? '',
+        value: opts.redactValues ? AUTOFILL_REDACTED : (r.value ?? ''),
+        count: Number(r.count ?? 0),
+        lastUsed: new Date((Number(r.date_last_used ?? 0) / 1000) - 11644473600000),
+      }))
+    } finally { db.close() }
+  }
+
+  getSearchEngines(): Array<{ name: string; keyword: string; url: string }> {
+    const db = openDb(join(this.defaultDir, 'Web Data'))
+    try {
+      const rows = db.prepare(`
+        SELECT short_name, keyword, url
+        FROM keywords
+        ORDER BY keyword
+      `).all() as Array<{ short_name: string; keyword: string; url: string }>
+      return rows.map((r) => ({
+        name: r.short_name ?? '',
+        keyword: r.keyword ?? '',
+        url: r.url ?? '',
+      }))
+    } finally { db.close() }
+  }
+
+  getPreference<T = unknown>(key: string): T | undefined {
+    try {
+      const raw = readFileSync(join(this.defaultDir, 'Preferences'), 'utf8')
+      const data = JSON.parse(raw)
+      const parts = key.split('.')
+      let cur: unknown = data
+      for (const part of parts) {
+        if (cur === null || cur === undefined || typeof cur !== 'object') return undefined
+        cur = (cur as Record<string, unknown>)[part]
+      }
+      return cur as T
+    } catch { return undefined }
+  }
+
+  getExtensionIds(): string[] {
+    try {
+      const extDir = join(this.defaultDir, 'Extensions')
+      return readdirSync(extDir, { withFileTypes: true })
+        .filter((d) => d.isDirectory())
+        .map((d) => d.name)
+    } catch { return [] }
+  }
+
+  hasSavedCredentials(): boolean {
+    try {
+      const db = openDb(join(this.defaultDir, 'Login Data'))
+      try {
+        const row = db.prepare('SELECT COUNT(*) AS cnt FROM logins').get() as { cnt: unknown } | undefined
+        return Number(row?.cnt ?? 0) > 0
+      } finally { db.close() }
+    } catch { return false }
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/src/lib/types.ts b/packages/stealth/stealth-core-browser/src/lib/types.ts
new file mode 100644
index 000000000..627368370
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/types.ts
@@ -0,0 +1,285 @@
+/**
+ * stealth-core-browser/src/lib/types.ts — Shared types for the ADHD package.
+ *
+ * Consolidated from cdp-query-client.ts (CDP query types) and
+ * search-types.ts (search / parsing types).
+ */
+
+// ═══════════════════════════════════════════════════════════════════════════════
+// From cdp-query-client.ts
+// ═══════════════════════════════════════════════════════════════════════════════
+
+export interface CdpTargetInfo {
+  targetId: string
+  type: 'page' | 'iframe' | 'worker' | 'service_worker' | 'browser' | 'tab' | 'background_contents'
+  title: string
+  url: string
+  attached: boolean
+  browserContextId?: string
+  openerId?: string
+  parentId?: string
+  subtype?: string
+}
+
+export interface ChromeVisit {
+  id: number
+  urlId: number
+  url: string
+  title: string
+  /** Unix timestamp in seconds (from SQL computation, avoids BigInt). */
+  visitTimeUnix: number
+  /** JavaScript Date. */
+  visitTime: Date
+  /** Core transition type name. */
+  transitionType: string
+  /** Transition bitfield value. */
+  transitionRaw: number
+  fromVisitId: number
+  /** Visit duration in ms. */
+  visitDurationMs: number
+  openerVisitId: number
+}
+
+export interface UrlInfo {
+  id: number
+  url: string
+  title: string
+  visitCount: number
+  typedCount: number
+  lastVisitTime: Date
+  hidden: boolean
+}
+
+export interface VisitStat {
+  date: string
+  visits: number
+  uniqueUrls: number
+  transitionBreakdown: Record<string, number>
+}
+
+export interface RedirectChainEntry {
+  visitId: number
+  url: string
+  depth: number
+}
+
+export interface ClusterInfo {
+  clusterId: number
+  label: string | null
+  visits: Array<{ visitId: number; score: number; url: string; title: string }>
+}
+
+export interface CookieInfo {
+  name: string
+  value: string
+  host: string
+  path: string
+  creationUtc: Date
+  lastAccessUtc: Date
+  hasExpires: boolean
+  expiresUtc: Date | null
+  isSecure: boolean
+  isHttpOnly: boolean
+  samesite: string
+  priority: string
+}
+
+export interface BookmarkNode {
+  id: string
+  name: string
+  url?: string
+  dateAdded?: Date
+  dateModified?: Date
+  children?: BookmarkNode[]
+  type: 'url' | 'folder'
+}
+
+export interface SessionTab {
+  tabId: number
+  url: string
+  title: string
+  lastActiveTime?: Date
+  pinned: boolean
+  navigationIndex: number
+  navigationCount: number
+}
+
+export interface ChromeVersion {
+  browserVersion: string
+  protocolVersion: string
+  userAgent: string
+  jsVersion: string
+  v8Version: string
+}
+
+export interface SystemInfo {
+  modelName: string
+  modelVersion: string
+  commandLine: string
+  gpu: { vendor: string; device: string; driverVersion: string }
+}
+
+export interface ProcessInfo {
+  type: string
+  id: number
+  cpuTime: number
+}
+
+export interface PageMetrics {
+  timestamp: number
+  documents: number
+  nodes: number
+  jsHeapUsedSize: number
+  jsHeapTotalSize: number
+  navigationStart: number
+  domContentLoaded: number
+  firstMeaningfulPaint: number
+  layoutCount: number
+  scriptDuration: number
+  taskDuration: number
+}
+
+export interface BrowserWindowBounds {
+  windowId: number
+  left: number
+  top: number
+  width: number
+  height: number
+  windowState: 'normal' | 'minimized' | 'maximized' | 'fullscreen'
+}
+
+export interface ChromeActivity {
+  activePages: number
+  pageTargets: string[]
+  lastVisit: ChromeVisit | null
+  recentlyUsed: boolean
+  meta: {
+    checkedAt: string
+    cdpHost: string
+    profileDir: string
+  }
+}
+
+export interface ChromeMemoryCounters {
+  nodes: number
+  documents: number
+  jsEventListeners: number
+  layouts: number
+  recalcStyleCount: number
+}
+
+// ═══════════════════════════════════════════════════════════════════════════════
+// From search-types.ts (shared search types)
+// ═══════════════════════════════════════════════════════════════════════════════
+
+export type BanSignal =
+  | 'captcha'
+  | 'banned'
+  | 'rate_limited'
+  | 'login_required'
+
+export interface BanRule {
+  name: string
+  signal: BanSignal
+  /** Check the response URL path. */
+  checkUrl?: RegExp
+  /** Check HTTP status code. */
+  checkStatus?: number[]
+  /** Check if body contains a pattern. */
+  checkBody?: RegExp
+}
+
+export interface RetryConfig {
+  maxAttempts: number
+  baseDelayMs: number
+  onCaptcha: 'retry' | 'abort' | 'hitl'
+  onRateLimit: 'retry' | 'abort' | 'hitl'
+  onTimeout: 'retry' | 'abort'
+  onBan: 'abort' | 'hitl'
+}
+
+export interface PageSource {
+  provider: string
+  strategy: 'network' | 'dom'
+  capturedUrl: string
+  position: number
+  capturedAt: string
+}
+
+/** Parsed result from a search provider. Renamed from SearchResult. */
+export interface ParseResult {
+  title: string
+  url: string
+  snippet: string
+  meta?: Record<string, string>
+  source?: PageSource
+}
+
+export interface DomPattern {
+  tag?: string
+  attrs?: Record<string, string | RegExp>
+  text?: RegExp
+}
+
+export interface DomExtractor {
+  /** If true, use structural position-based extraction instead of class-based. */
+  structural?: boolean
+  container?: DomPattern
+  title?: DomPattern & { attr?: string }
+  link?: DomPattern & { attr: string }
+  snippet?: DomPattern
+  extra?: Record<string, DomPattern & { attr?: string }>
+}
+
+/** Structural extraction config — finds results by DOM position, not classes. */
+export interface StructuralExtractor {
+  rootSelector: string
+  itemTag: string
+  itemDepth: number
+  headingTag: string
+  linkTag: string
+  snippetTag: string
+  searchDepth: number
+}
+
+/** Network capture config. Renamed from NetworkCaptureConfig. */
+export interface CaptureConfig {
+  urlPattern: string
+  parser: 'html' | 'json' | 'xml' | 'embedded-json'
+  resultSelector: string
+  fields: {
+    title: string
+    url: string
+    snippet: string
+    linkSelector?: string
+    /** Optional URL template with `{}` placeholder replaced by the extracted url field value.
+     *  E.g. `'https://en.wikipedia.org/?curid={}'` turns pageid `30621` into a real URL.
+     *  E.g. `'https://developer.mozilla.org{}'` turns relative path `/en-US/docs/...` into a full URL. */
+    urlTemplate?: string
+    meta?: Record<string, string>
+    clean?: {
+      title?: { pattern: string; replace: string }
+      snippet?: { pattern: string; replace: string }
+    }
+  }
+  /** For embedded-json parser: which data-target attribute to match on the <script> tag. */
+  dataTarget?: string
+  /** How many lines from the snippets array to include in each result's snippet. Default: 1. */
+  snippetLines?: number
+  /** Override URL for directFetch. If set, use this instead of provider.url(query). */
+  apiUrl?: string
+  extraWaitMs?: number
+  directFetch?: boolean
+}
+
+export interface CapturedRequest {
+  requestId: string
+  url: string
+  method: string
+  status: number
+  responseHeaders?: Record<string, string>
+  responseBody?: string
+  base64Encoded?: boolean
+  finished: boolean
+  isNavigation: boolean
+}
