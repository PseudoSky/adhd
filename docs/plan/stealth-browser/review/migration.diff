+  it('with no entryPath the link resolves the entry itself: an absolute path, or a typed REAPER_UNAVAILABLE (never a null entry)', async () => {
+    const l = link({ entryPath: undefined })
+    const up = await l.ensureAndHello()
+    if (up) {
