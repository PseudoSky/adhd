+    expect(a).toEqual({})
+    expect(b).toEqual({})
+    expect(nav).toEqual({ frameId: 'F1', loaderId: 'L1' })
+    expect(server.received.map((r) => [r.id, r.method])).toEqual([
+      [1, 'Page.enable'],
