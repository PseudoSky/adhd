+  it('a lost create race puts the marker back', async () => {
+    const env = makeEnv({ clearPolicy: 'open' });
+    await env.tw.trip('k', {
+      reason: 'x',
+      context: {},
+    });
+    await env.tw.clear('k', { method: 'mcp-clear' });
