+    try { closeSync(fd) } catch { /* ignore */ }
+    try { unlinkSync(launchLockPath(port)) } catch { /* ignore */ }
+  }
+}
+
+/** How long a loser waits for the winner's Chrome before giving up with LAUNCH_LOCK_TIMEOUT. */
+const LAUNCH_LOCK_WAIT_MS = 30_000
