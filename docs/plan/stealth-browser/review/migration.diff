+/**
+ * A picker that, phase by phase, runs only the operations of one tagged
+ * process until the phase's `until` operation has been released; then it
+ * releases operations in arrival order. Splices `tags` with the queue.
+ */
+function phasedPicker(
+  phases: Array<{ tag: string; until: (o: FsOpRecord) => boolean }>,
+  tags: string[],
+): SchedulePicker {
+  return (pending) => {
+    let i = 0;
+    const phase = phases[0];
+    if (phase) {
+      const j = tags.findIndex((t) => t === phase.tag);
+      if (j >= 0) i = j;
+      if (phase.until(pending[i])) phases.shift();
+    }
+    tags.splice(i, 1);
+    return i;
+  };
+}
diff --git a/packages/resilience/resilience-core-tripwire/test/unit/legacy.spec.ts b/packages/resilience/resilience-core-tripwire/test/unit/legacy.spec.ts
new file mode 100644
index 000000000..4342b30f2
--- /dev/null
+++ b/packages/resilience/resilience-core-tripwire/test/unit/legacy.spec.ts
@@ -0,0 +1,125 @@
+/**
+ * guards: a previous implementation lock record is not honoured, or its counts are dropped
+ * tier: S
+ * cites: ticket 8468f7b1; [tripwire-core.4] TW4.
+ * Ticket 8468f7b1 - legacy flat lock shapes written by the two previous
+ * implementations are read and honoured: the reverse request-builder
+ * `{reason, trippedAt, lastStatus, lastOperationId}` and the agent-search
+ * record with its in-record blockedCount and reverifiedAt. Extra fields
+ * land in `context`; the in-record count adds to the sidecar count.
+ * Criteria: [tripwire-core.4] TW4.
+ */
+import { CONFIRM_TOKEN, TripwireTrippedError } from '../../src/index';
+import { makeEnv } from '../helpers/harness';
+
+const REVERSE_LOCK = {
+  reason: 'http-4xx',
+  trippedAt: '2026-10-01T10:00:00.000Z',
+  lastStatus: 401,
+  lastOperationId: 'getMe',
+};
+
+const SEARCH_LOCK = {
+  reason: 'captcha',
+  provider: 'google',
+  query: 'some query',
+  searchSessionId: 'f1f2',
+  browserSessionId: 'TARGET-9',
+  pageUrl: 'https://www.google.com/sorry/index',
+  strategy: 'cdp',
+  trippedAt: '2026-10-01T11:00:00.000Z',
+  reverifiedAt: '2026-10-01T11:05:00.000Z',
+  blockedCount: 4,
+  lastOperation: 'search',
+};
+
+describe('[tripwire-core.4] TW4 legacy locks are honoured', () => {
+  it('reads a reverse-shaped lock: lastStatus, lastOperationId', async () => {
+    const env = makeEnv({ namespace: 'request-builder' });
+    env.mfs.writeText(env.lockPath('tinder'), JSON.stringify(REVERSE_LOCK));
+    const snap = await env.tw.read('tinder');
+    expect(snap.status).toBe('tripped');
+    expect(snap.record).toMatchObject({
+      schema: 1,
+      key: 'tinder',
+      namespace: 'request-builder',
+      reason: 'http-4xx',
+      trippedAt: REVERSE_LOCK.trippedAt,
+      blockedCount: 0,
+      context: {
+        lastStatus: 401,
+        lastOperationId: 'getMe',
+      },
+    });
+    const err = await env.tw.assertOpen('tinder').catch((e: unknown) => e);
+    expect(err).toBeInstanceOf(TripwireTrippedError);
+    expect((err as TripwireTrippedError).record?.context['lastStatus'])
+      .toBe(401);
+  });
+
+  it('reads a search-shaped lock; blockedCount adds to the sidecar',
+    async () => {
+      const env = makeEnv({ namespace: 'agent-search' });
+      env.mfs.writeText(env.lockPath('google'), JSON.stringify(SEARCH_LOCK));
+      const snap = await env.tw.read('google');
+      expect(snap.status).toBe('tripped');
+      expect(snap.record?.blockedCount).toBe(4);
+      expect(snap.record?.context).toEqual({
+        provider: 'google',
+        query: 'some query',
+        searchSessionId: 'f1f2',
+        browserSessionId: 'TARGET-9',
+        pageUrl: 'https://www.google.com/sorry/index',
+        strategy: 'cdp',
+        reverifiedAt: '2026-10-01T11:05:00.000Z',
+        lastOperation: 'search',
+      });
+      const g = await env.tw.gate('google');
+      expect(g.open).toBe(false);
+      expect(g.snapshot.record?.blockedCount).toBe(5);
+      await env.tw.gate('google');
+      expect((await env.tw.read('google')).record?.blockedCount).toBe(6);
+      // the legacy lock itself is never rewritten by counting
+      expect(JSON.parse(env.mfs.readText(env.lockPath('google')) as string))
+        .toEqual(SEARCH_LOCK);
+      expect(Object.keys(await env.tw.status())).toEqual(['google']);
+    });
+
+  it('a legacy lock blocks a retrip and can be cleared', async () => {
+    const env = makeEnv();
+    env.mfs.writeText(env.lockPath('tinder'), JSON.stringify(REVERSE_LOCK));
+    const r = await env.tw.trip('tinder', {
+      reason: 'http-4xx',
+      context: { lastStatus: 403 },
+    });
+    expect(r.created).toBe(false);
+    expect(r.record.context['lastStatus']).toBe(401);
+    expect(await env.tw.clear('tinder', {
+      method: 'programmatic-confirm',
+      confirm: CONFIRM_TOKEN,
+    })).toEqual({ cleared: true });
+    expect(env.mfs.exists(env.lockPath('tinder'))).toBe(false);
+  });
+
+  it('a legacy search lock expires by its trippedAt under a TTL', async () => {
+    const env = makeEnv({ expiry: { ttlMs: 7_200_000 } });
+    env.clock.now = Date.parse(SEARCH_LOCK.trippedAt) + 7_200_001;
+    env.mfs.writeText(env.lockPath('google'), JSON.stringify(SEARCH_LOCK));
+    expect((await env.tw.read('google')).status).toBe('expired');
+    expect((await env.tw.gate('google')).open).toBe(true);
+    expect(env.mfs.exists(env.lockPath('google'))).toBe(false);
+  });
+
+  it('non-JSON-safe legacy fields are dropped, never fatal', async () => {
+    const env = makeEnv();
+    env.mfs.writeText(
+      env.lockPath('k'),
+      '{"reason":"banned","trippedAt":"2026-10-01T00:00:00Z",' +
+        '"nested":{"a":[1,"b",null]},"blockedCount":"x"}',
+    );
+    const snap = await env.tw.read('k');
+    expect(snap.status).toBe('tripped');
+    expect(snap.record?.blockedCount).toBe(0);
+    expect(snap.record?.context).toEqual({ nested: { a: [1, 'b', null] } });
+  });
+});
diff --git a/packages/resilience/resilience-core-tripwire/test/unit/node-io.spec.ts b/packages/resilience/resilience-core-tripwire/test/unit/node-io.spec.ts
new file mode 100644
index 000000000..a07204a79
--- /dev/null
+++ b/packages/resilience/resilience-core-tripwire/test/unit/node-io.spec.ts
@@ -0,0 +1,139 @@
+/**
+ * guards: the Node adapter hangs on closed input, loses piped answers, or writes prompts to stdout
+ * tier: S
+ * cites: ticket 8468f7b1; [tripwire-interactive.8] TW31, [tripwire-interactive.2] TW25.
+ * Ticket 8468f7b1 - nodeTripwireIo, the single Node adapter of
+ * TripwireIo (TW31: the only lib module touching the process streams and
+ * environment): prompts go to stderr, out/err are line-oriented, piped
+ * answers are never lost between questions, and a question resolves null
+ * once the input ended or closed (never a hang).
+ * Criteria: [tripwire-interactive.8] TW31, [tripwire-interactive.2] TW25.
+ */
+import { PassThrough } from 'node:stream';
+import { nodeTripwireIo } from '../../src/index';
+
+function sink(): { stream: PassThrough; text: () => string } {
+  const stream = new PassThrough();
+  const chunks: Buffer[] = [];
+  stream.on('data', (c: Buffer) => chunks.push(c));
+  return { stream, text: () => Buffer.concat(chunks).toString('utf8') };
+}
+
+function make(input: PassThrough, isTTY?: boolean) {
+  const out = sink();
+  const err = sink();
+  const io = nodeTripwireIo({
+    input,
+    output: out.stream,
+    errorOutput: err.stream,
+    env: { CONFIRM: 'x' },
+    ...(isTTY === undefined ? {} : { isTTY }),
+  });
+  return { io, out, err };
+}
+
+describe('[tripwire-interactive.8] TW31 nodeTripwireIo', () => {
+  it('defaults to the process streams and environment', () => {
+    const io = nodeTripwireIo();
+    expect(io.env).toBe(process.env);
+    expect(io.isTTY).toBe(process.stdin.isTTY === true);
+  });
+
+  it('out and err write one line each to their own stream', async () => {
+    const { io, out, err } = make(new PassThrough());
+    io.out('to stdout');
+    io.err('to stderr');
+    await new Promise((r) => setImmediate(r));
+    expect(out.text()).toBe('to stdout\n');
+    expect(err.text()).toBe('to stderr\n');
+    expect(io.env).toEqual({ CONFIRM: 'x' });
+  });
+
+  it('isTTY follows the input unless overridden', () => {
+    const tty = Object.assign(new PassThrough(), { isTTY: true });
+    expect(make(tty).io.isTTY).toBe(true);
+    expect(make(new PassThrough()).io.isTTY).toBe(false);
+    expect(make(tty, false).io.isTTY).toBe(false);
+  });
+
+  it('question writes the prompt to stderr and resolves the answer line',
+    async () => {
+      const input = new PassThrough();
+      const { io, out, err } = make(input, true);
+      const p = io.question('ok? ');
+      input.write('yes\r\n');
+      expect(await p).toBe('yes');
+      expect(err.text()).toBe('ok? ');
+      expect(out.text()).toBe('');
+      input.end();
+    });
+
+  it('piped answers written at once are not lost between questions',
+    async () => {
+      const input = new PassThrough();
+      input.end('first\nsecond\n\nthird');
+      const { io } = make(input);
+      expect(await io.question('1')).toBe('first');
+      expect(await io.question('2')).toBe('second');
+      expect(await io.question('3')).toBe('');
+      expect(await io.question('4')).toBe('third');
+      expect(await io.question('5')).toBeNull();
+      expect(await io.question('6')).toBeNull();
+    });
+});
+
+describe('[tripwire-interactive.8] TW31 an idle prompt reader does not ' +
+  'keep the process alive', () => {
+  it('the input handle is ref\'d while a question waits and unref\'d after ' +
+    'the answer', async () => {
+    const calls: string[] = [];
+    const input = Object.assign(new PassThrough(), {
+      ref: () => calls.push('ref'),
+      unref: () => calls.push('unref'),
+    });
+    const { io } = make(input, true);
+    const p = io.question('1');
+    expect(calls).toEqual(['ref']);
+    input.write('a\n');
+    expect(await p).toBe('a');
+    expect(calls).toEqual(['ref', 'unref']);
+    const q = io.question('2');
+    input.write('b\n');
+    expect(await q).toBe('b');
+    expect(calls).toEqual(['ref', 'unref', 'ref', 'unref']);
+    input.end();
+  });
+});
+
+describe('[tripwire-interactive.2] TW25 EOF resolves null, never a hang',
+  () => {
+    it('an input already ended answers null', async () => {
+      const input = new PassThrough();
+      input.end();
+      expect(await make(input).io.question('?')).toBeNull();
+    });
+
+    it('an input ended while a question waits answers null', async () => {
+      const input = new PassThrough();
+      const { io } = make(input);
+      const p = io.question('?');
+      input.end();
+      expect(await p).toBeNull();
+    });
+
+    it('a destroyed input answers null', async () => {
+      const input = new PassThrough();
+      input.destroy();
+      await new Promise((r) => setImmediate(r));
+      expect(await make(input).io.question('?')).toBeNull();
+    });
+
+    it('a partial line before EOF is still delivered, then null', async () => {
+      const input = new PassThrough();
+      const { io } = make(input);
+      const p = io.question('?');
+      input.end('no newline');
+      expect(await p).toBe('no newline');
+      expect(await io.question('?')).toBeNull();
+    });
+  });
diff --git a/packages/resilience/resilience-core-tripwire/test/unit/paths.spec.ts b/packages/resilience/resilience-core-tripwire/test/unit/paths.spec.ts
