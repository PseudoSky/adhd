+/**
+ * guards: PDF text extraction fails or returns wrong text for fixture bytes
+ * tier: S
+ * cites: ticket 8468f7b1 [search-port-fetch.4] [search-port-fetch.1] [audit-fixes.4]
+ * PDF text extraction through the real pdfjs on fixture bytes read in-process (inventory [I-30]).
+ * Ticket 8468f7b1 · [search-port-fetch.4] [search-port-fetch.1]
+ */
+import { readFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+import { isSearchError } from '../../../src/errors.js'
+import { createPdfjsLoader, extractPdfText, PDF_MAX_PAGES } from '../../../src/lib/fetch/pdf.js'
+import { PDF_SENTENCE, readFixture } from '../../helpers/fetch/harness.js'
+
+describe('pdf text extraction', () => {
+  it('extracts a fixture PDF page by page', async () => {
+    const bytes = new Uint8Array(readFixture('two-page.pdf'))
+    const r = await extractPdfText(bytes)
+    expect(r.pages).toBe(2)
+    expect(r.extractedPages).toBe(2)
+    expect(r.text).toContain(PDF_SENTENCE)
+    expect(r.text).toContain('second page')
+    expect(r.text.split('\n\n')).toHaveLength(2)
+    expect(bytes.length).toBeGreaterThan(1024) // caller bytes not detached
+  })
+
+  it('honours the per-document page cap', async () => {
+    expect(PDF_MAX_PAGES).toBe(100)
+    const r = await extractPdfText(new Uint8Array(readFixture('two-page.pdf')), 1)
+    expect(r.pages).toBe(2)
+    expect(r.extractedPages).toBe(1)
+    expect(r.text).toContain(PDF_SENTENCE)
+    expect(r.text).not.toContain('second page')
+  })
+
+  it('a corrupt PDF raises PDF_EXTRACT_FAILED', async () => {
+    const err = await extractPdfText(new Uint8Array(readFixture('corrupt.pdf'))).catch((e: unknown) => e)
+    expect(isSearchError(err, 'PDF_EXTRACT_FAILED')).toBe(true)
+  })
+
+  it('a loader that cannot load pdfjs raises PDF_EXTRACT_FAILED', async () => {
+    const err = await extractPdfText(new Uint8Array(1), 1, async () => {
+      throw new Error('module missing')
+    }).catch((e: unknown) => e)
+    expect(isSearchError(err, 'PDF_EXTRACT_FAILED')).toBe(true)
+  })
+})
+
+describe('[audit-fixes.4] P35 the pdfjs loader avoids code generation from strings unless require(esm) is unavailable', () => {
+  const pdfjs = { getDocument: () => ({ promise: Promise.reject(new Error('unused')) }) }
+
+  it('a plain import that works is used and the native import is never built', async () => {
+    let nativeCalls = 0
+    const load = createPdfjsLoader({
+      plain: async () => pdfjs,
+      native: async () => {
+        nativeCalls++
+        return pdfjs
+      },
+    })
+    expect(await load()).toBe(pdfjs)
+    expect(nativeCalls).toBe(0)
+  })
+
+  it.each(['ERR_REQUIRE_ESM', 'ERR_REQUIRE_ASYNC_MODULE'])('%s from the plain import falls back to the native import with the pdfjs specifier', async (code) => {
+    const asked: string[] = []
+    const load = createPdfjsLoader({
+      plain: async () => {
+        throw Object.assign(new Error('cannot require esm'), { code })
+      },
+      native: async (specifier) => {
+        asked.push(specifier)
+        return pdfjs
+      },
+    })
+    expect(await load()).toBe(pdfjs)
+    expect(asked).toEqual(['pdfjs-dist/legacy/build/pdf.mjs'])
+  })
+
+  it('any other plain-import failure is rethrown and the native import is not tried', async () => {
+    const boom = Object.assign(new Error('Cannot find package'), { code: 'ERR_MODULE_NOT_FOUND' })
+    let nativeCalls = 0
+    const load = createPdfjsLoader({
+      plain: async () => {
+        throw boom
+      },
+      native: async () => {
+        nativeCalls++
+        return pdfjs
+      },
+    })
+    await expect(load()).rejects.toBe(boom)
+    expect(nativeCalls).toBe(0)
+  })
+
+  it('a failure without a code is rethrown', async () => {
+    const load = createPdfjsLoader({
+      plain: async () => {
+        throw 'plain string'
+      },
+      native: async () => pdfjs,
+    })
+    await expect(load()).rejects.toBe('plain string')
+  })
+
+  it('the Function constructor appears only inside the lazily-called native import, never at module load', () => {
+    const src = readFileSync(join(dirname(fileURLToPath(import.meta.url)), '..', '..', '..', 'src', 'lib', 'fetch', 'pdf.ts'), 'utf8')
+    const code = src.split('\n').filter((l) => !l.trimStart().startsWith('*') && !l.trimStart().startsWith('//'))
+    const sites = code.map((l, i) => ({ l, i })).filter(({ l }) => l.includes('new Function('))
+    expect(sites).toHaveLength(1)
+    const fnStart = code.findIndex((l) => l.includes('function nativeImportViaFunction'))
+    expect(sites[0]?.i).toBeGreaterThan(fnStart)
+    expect(sites[0]?.i).toBeLessThan(fnStart + 4)
+  })
+})
diff --git a/entrypoint/stealth-search/test/unit/fetch/fetch-pinned.spec.ts b/entrypoint/stealth-search/test/unit/fetch/fetch-pinned.spec.ts
new file mode 100644
index 000000000..c4d4fe209
--- /dev/null
+++ b/entrypoint/stealth-search/test/unit/fetch/fetch-pinned.spec.ts
@@ -0,0 +1,143 @@
+/**
+ * guards: the production direct fetch connects by name instead of the validated address, or buffers an oversized or endless body without a cap or a timeout
+ * tier: S
+ * cites: ticket 8468f7b1 [audit-fixes.1]
+ * `pinnedGet` over a mocked `node:https` (no socket): the request carries a lookup that answers only the pinned
+ * address, keeps the hostname for TLS, ends on an oversized body or a stalled one, and reports a redirect without
+ * following it. Pre-review P4 and P29.
+ * Ticket 8468f7b1 · [audit-fixes.1]
+ */
+import { EventEmitter } from 'node:events'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+const hoisted = vi.hoisted(() => ({ request: vi.fn() }))
+vi.mock('node:https', () => ({ default: { request: hoisted.request }, request: hoisted.request }))
+
+import { pinnedGet, pinnedLookup } from '../../../src/lib/fetch/pinned.js'
+
+class FakeRes extends EventEmitter {
+  destroyed = false
+  constructor(
+    public statusCode: number,
+    public headers: Record<string, string> = {},
+  ) {
+    super()
+  }
+  destroy(): void {
+    this.destroyed = true
+  }
+}
+class FakeReq extends EventEmitter {
+  destroyed = false
+  ended = false
+  destroy(): void {
+    this.destroyed = true
+  }
+  end(): void {
+    this.ended = true
+  }
+}
+
+/** Make `https.request` answer with `res` (called once the request is created) and return the captured request. */
+function serve(res: FakeRes | null): { req: FakeReq; options: () => Record<string, unknown> } {
+  const req = new FakeReq()
+  let captured: Record<string, unknown> = {}
+  hoisted.request.mockImplementation((options: Record<string, unknown>, cb: (r: FakeRes) => void) => {
+    captured = options
+    if (res) queueMicrotask(() => cb(res))
+    return req
+  })
+  return { req, options: () => captured }
+}
+
+const OPTS = { headers: { Accept: '*/*' }, maxBytes: 10, timeoutMs: 1000 }
+
+afterEach(() => {
+  vi.useRealTimers()
+  hoisted.request.mockReset()
+})
+
+describe('the production direct fetch connects to the validated address and is bounded [audit-fixes.1]', () => {
+  it('P4 pinned lookup: the request connects through a lookup that answers only the pinned address and keeps the hostname for TLS', async () => {
+    const res = new FakeRes(200)
+    const s = serve(res)
+    const done = pinnedGet('https://docs.example.test/a.pdf?x=1', '93.184.216.34', OPTS)
+    await Promise.resolve()
+    res.emit('data', Buffer.from('abc'))
+    res.emit('end')
+    await expect(done).resolves.toMatchObject({ status: 200, location: null, body: new Uint8Array(Buffer.from('abc')) })
+    const o = s.options()
+    expect(o['hostname']).toBe('docs.example.test')
+    expect(o['servername']).toBe('docs.example.test')
+    expect(o['path']).toBe('/a.pdf?x=1')
+    const lookup = o['lookup'] as (h: string, opts: { all?: boolean }, cb: (...a: unknown[]) => void) => void
+    const single: unknown[] = []
+    lookup('docs.example.test', {}, (...a) => single.push(...a))
+    expect(single).toEqual([null, '93.184.216.34', 4])
+    const all: unknown[] = []
+    lookup('anything.else', { all: true }, (...a) => all.push(...a))
+    expect(all).toEqual([null, [{ address: '93.184.216.34', family: 4 }]])
+    expect(s.req.ended).toBe(true)
+  })
+
+  it('P4 pinned lookup: an IPv6 pinned address answers family 6', () => {
+    const out: unknown[] = []
+    pinnedLookup('2606:4700::1')('h', {}, (...a) => out.push(...a))
+    expect(out).toEqual([null, '2606:4700::1', 6])
+  })
+
+  it('P29 byte cap: a streamed body above maxBytes ends the request with a typed error', async () => {
+    const res = new FakeRes(200)
+    const s = serve(res)
+    const done = pinnedGet('https://docs.example.test/a.pdf', '93.184.216.34', OPTS)
+    await Promise.resolve()
+    res.emit('data', Buffer.alloc(6))
+    res.emit('data', Buffer.alloc(6))
+    await expect(done).rejects.toMatchObject({ code: 'SEARCH_FAILED', detail: { reason: 'direct-fetch-too-large' } })
+    expect(res.destroyed).toBe(true)
+    expect(s.req.destroyed).toBe(true)
+  })
+
+  it('P29 byte cap: a declared content-length above maxBytes is refused before any body is read', async () => {
+    const res = new FakeRes(200, { 'content-length': '999' })
+    serve(res)
+    await expect(pinnedGet('https://docs.example.test/a.pdf', '93.184.216.34', OPTS)).rejects.toMatchObject({ detail: { reason: 'direct-fetch-too-large' } })
+    expect(res.destroyed).toBe(true)
+  })
+
+  it('P29 timeout: a response that never arrives ends with a typed timeout error', async () => {
+    vi.useFakeTimers()
+    const s = serve(null)
+    const done = pinnedGet('https://docs.example.test/a.pdf', '93.184.216.34', OPTS)
+    const assertion = expect(done).rejects.toMatchObject({ code: 'SEARCH_FAILED', detail: { reason: 'direct-fetch-timeout' } })
+    await vi.advanceTimersByTimeAsync(1001)
+    await assertion
+    expect(s.req.destroyed).toBe(true)
+  })
+
+  it('P29 timeout: an endless body that stalls after the headers also ends on the deadline', async () => {
+    vi.useFakeTimers()
+    const res = new FakeRes(200)
+    serve(res)
+    const done = pinnedGet('https://docs.example.test/a.pdf', '93.184.216.34', { ...OPTS, maxBytes: 1_000_000 })
+    const assertion = expect(done).rejects.toMatchObject({ detail: { reason: 'direct-fetch-timeout' } })
+    await vi.advanceTimersByTimeAsync(0)
+    res.emit('data', Buffer.alloc(3))
+    await vi.advanceTimersByTimeAsync(1001)
+    await assertion
+  })
+
+  it('P4 redirect: a 3xx is reported with its Location and no body, never followed', async () => {
+    const res = new FakeRes(302, { location: 'https://cdn.example.test/a.pdf' })
+    serve(res)
+    await expect(pinnedGet('https://docs.example.test/a.pdf', '93.184.216.34', OPTS)).resolves.toEqual({ status: 302, location: 'https://cdn.example.test/a.pdf', body: new Uint8Array(0) })
+    expect(res.destroyed).toBe(true)
+  })
+
+  it('P29 transport failure: a socket error is a typed SEARCH_FAILED', async () => {
+    const s = serve(null)
+    const done = pinnedGet('https://docs.example.test/a.pdf', '93.184.216.34', OPTS)
+    s.req.emit('error', new Error('ECONNRESET'))
+    await expect(done).rejects.toMatchObject({ code: 'SEARCH_FAILED', detail: { reason: 'direct-fetch-failed' } })
+  })
+})
diff --git a/entrypoint/stealth-search/test/unit/fetch/fetch-policy.spec.ts b/entrypoint/stealth-search/test/unit/fetch/fetch-policy.spec.ts
