+  fetchDirect: DirectFetch
+  /** Resolves a hostname to every address; the SSRF check refuses a name that resolves to a private one. */
+  resolveHost(host: string): Promise<string[]>
+  now(): number
+  sleep(ms: number): Promise<void>
