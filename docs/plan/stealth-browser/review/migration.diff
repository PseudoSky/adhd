+    const l = link()
+    expect(await l.reapIfIdle()).toBeNull()
+    expect(await l.status()).toBeNull()
+    await l.ensureAndHello()
+    world.pages = [{ id: 'P', url: 'https://example.com/' }]
+    expect(await l.reapIfIdle()).toEqual({ action: 'keep', pinnedBy: 'page', reaped: false })
