--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/lifecycle/isolated-page.ts
@@ -0,0 +1,83 @@
+/**
+ * @adhd/stealth-core-browser — src/lib/lifecycle/isolated-page.ts
+ *
+ * An isolated page: a page target in its own cookie-less browser context
+ * (no shared context, never the user's profile session), background and
+ * minimized by default, with a connected page session. Every failure path
+ * leaves no open socket and no undisposed context (F20 F21 F22, gap G1):
+ * `createIsolatedPageTarget` cleans up its own steps, and a failure to
+ * connect the page session disposes the context before the typed error
+ * propagates. `withIsolatedPage` always disposes, also when `fn` throws.
+ *
+ * Ticket 8468f7b1 · plan state chrome-lifecycle (CL13).
+ */
+
+import { CdpSession } from '../cdp/session.js'
+import { createIsolatedPageTarget } from '../cdp/targets.js'
+import { lifecycleErrors } from './errors.js'
+
+export interface IsolatedPageOptions {
+  /** Create the window in the foreground (no minimize, focus). Default false. */
+  foreground?: boolean
+  /** Page-session connect deadline in ms. Default 10_000. */
+  connectTimeoutMs?: number
+}
+
+export interface IsolatedPage {
+  /** Connected CDP session to the isolated page target. */
+  page: CdpSession
+  targetId: string
+  browserContextId: string
+  /** Bring the minimized window on screen (human captcha solving). Best effort. */
+  reveal(): Promise<void>
+  /** Close the page session and dispose the whole context. Idempotent, never throws. */
+  dispose(): Promise<void>
+}
+
+export async function openIsolatedPage(cdpHost: string, opts: IsolatedPageOptions = {}): Promise<IsolatedPage> {
+  let target: Awaited<ReturnType<typeof createIsolatedPageTarget>>
+  try {
+    target = await createIsolatedPageTarget(cdpHost, { foreground: opts.foreground })
+  } catch (err) {
+    throw lifecycleErrors.isolatedContextFailed('createIsolatedPageTarget', err)
+  }
+
+  const page = new CdpSession()
+  try {
+    await page.connect(target.pageWsUrl, opts.connectTimeoutMs ?? 10_000)
+  } catch (err) {
+    page.close()
+    await target.dispose()
+    throw lifecycleErrors.isolatedContextFailed('connect', err)
+  }
+
+  let disposed: Promise<void> | null = null
+  return {
+    page,
+    targetId: target.targetId,
+    browserContextId: target.browserContextId,
+    reveal: () => target.reveal(),
+    dispose(): Promise<void> {
+      if (!disposed) {
+        disposed = (async () => {
+          page.close()
+          await target.dispose()
+        })()
+      }
+      return disposed
+    },
+  }
+}
+
+export async function withIsolatedPage<T>(
+  cdpHost: string,
+  opts: IsolatedPageOptions | undefined,
+  fn: (p: IsolatedPage) => Promise<T>,
+): Promise<T> {
+  const p = await openIsolatedPage(cdpHost, opts)
+  try {
+    return await fn(p)
+  } finally {
+    await p.dispose()
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/src/lib/lifecycle/launch-breaker.ts b/packages/stealth/stealth-core-browser/src/lib/lifecycle/launch-breaker.ts
new file mode 100644
index 000000000..cd1f0f4c7
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/lifecycle/launch-breaker.ts
@@ -0,0 +1,121 @@
+/**
+ * @adhd/stealth-core-browser — src/lib/lifecycle/launch-breaker.ts
+ *
+ * The launch circuit breaker (N4): 3 failed launches within 60 s open the
+ * breaker for 30 s, during which `ready()` fails fast with
+ * LAUNCH_CIRCUIT_OPEN (carrying `retryAfterMs`) WITHOUT spawning; after the
+ * cool-off exactly one probe launch is let through; a success closes it.
+ *
+ * The state machine is the service proxy's `createCircuitBreaker`; the state is
+ * shared across processes through the stealth-owned `FileBreakerStore`
+ * (`<stateDir>/breaker-<port>.json`, atomic rename). The store is best effort:
+ * a lost update only under-counts by one, and a throwing store degrades the
+ * breaker to in-memory state (it is not presence and not a lease).
+ *
+ * Ticket 8468f7b1 · plan state chrome-lifecycle (SPEC-single-pass-lifecycle.md 3.1 3.3, CL17).
+ */
+
+import * as nodeFs from 'node:fs'
+import { join } from 'node:path'
+import { errorMessage, lifecycleErrors } from './errors.js'
+import { createCircuitBreaker, type BreakerState, type BreakerStore, type CircuitBreaker } from './sp.js'
+
+export const LAUNCH_FAILURE_THRESHOLD = 3
+export const LAUNCH_WINDOW_MS = 60_000
+export const LAUNCH_COOLDOWN_MS = 30_000
+
+export interface BreakerFs {
+  readFileSync(path: string, encoding: 'utf8'): string
+  writeFileSync(path: string, data: string, opts?: { mode?: number }): void
+  renameSync(from: string, to: string): void
+}
+
+export function breakerPath(stateDir: string, port: number): string {
+  return join(stateDir, `breaker-${port}.json`)
+}
+
+function isState(v: unknown): v is BreakerState {
+  if (v === null || typeof v !== 'object') return false
+  const s = v as Record<string, unknown>
+  const numOrNull = (x: unknown) => x === null || typeof x === 'number'
+  const recent = s['recent']
+  return typeof s['consecutive'] === 'number' && Array.isArray(recent) && recent.every((n) => typeof n === 'number') && numOrNull(s['openedAt']) && numOrNull(s['probeStartedAt'])
+}
+
+/** `BreakerStore` over one JSON file. `load` never throws; `save` writes temp + rename. */
+export class FileBreakerStore implements BreakerStore {
+  constructor(
+    readonly path: string,
+    private readonly fs: BreakerFs = nodeFs as unknown as BreakerFs,
+  ) {}
+
+  load(): BreakerState | null {
+    try {
+      const v: unknown = JSON.parse(this.fs.readFileSync(this.path, 'utf8'))
+      return isState(v) ? v : null
+    } catch {
+      return null
+    }
+  }
+
+  save(state: BreakerState): void {
+    const tmp = `${this.path}.${process.pid}.tmp`
+    this.fs.writeFileSync(tmp, JSON.stringify(state), { mode: 0o600 })
+    this.fs.renameSync(tmp, this.path)
+  }
+}
+
+export interface LaunchBreakerOptions {
+  port: number
+  /** The private state dir; omitted (degraded) means an in-memory breaker. */
+  stateDir?: string
+  fs?: BreakerFs
+  now?: () => number
+  logger?: (msg: string) => void
+}
+
+export interface LaunchBreaker {
+  /** Throws LAUNCH_CIRCUIT_OPEN (with `retryAfterMs`) while open; returns otherwise. */
+  assertClosed(): void
+  recordSuccess(): void
+  recordFailure(): void
+  /** Non-throwing view for `status()`. */
+  state(): { open: boolean; retryAfterMs?: number }
+}
+
+export function createLaunchBreaker(opts: LaunchBreakerOptions): LaunchBreaker {
+  const log = opts.logger ?? (() => undefined)
+  const now = opts.now ?? Date.now
+  /** In-memory view of the last open period (used when there is no shared store). */
+  let openUntil: number | null = null
+  const store = opts.stateDir === undefined ? undefined : new FileBreakerStore(breakerPath(opts.stateDir, opts.port), opts.fs)
+  const breaker: CircuitBreaker = createCircuitBreaker({
+    failureThreshold: LAUNCH_FAILURE_THRESHOLD,
+    windowMs: LAUNCH_WINDOW_MS,
+    cooldownMs: LAUNCH_COOLDOWN_MS,
+    ...(store ? { store } : {}),
+    now,
+    onEvent: (e) => {
+      if (e.type === 'opened') openUntil = now() + e.retryAfterMs
+      else if (e.type === 'closed') openUntil = null
+      if (e.type === 'store-failed') log(`launch breaker store failed (in-memory from now on): ${errorMessage(e.error)}`)
+      else if (e.type === 'opened') log(`launch breaker opened: Chrome failed to launch ${LAUNCH_FAILURE_THRESHOLD} times in ${LAUNCH_WINDOW_MS / 1000} s`)
+    },
+  })
+  return {
+    assertClosed(): void {
+      const c = breaker.check()
+      if (c.open) throw lifecycleErrors.circuitOpen(opts.port, c.retryAfterMs)
+    },
+    recordSuccess: () => breaker.recordSuccess(),
+    recordFailure: () => breaker.recordFailure(),
+    state(): { open: boolean; retryAfterMs?: number } {
+      // Peek without consuming the half-open probe: read the stored state directly.
+      const s = store?.load()
+      let until = openUntil
+      if (s) until = s.openedAt === null ? null : s.openedAt + LAUNCH_COOLDOWN_MS
+      const left = until === null ? 0 : until - now()
+      return left > 0 ? { open: true, retryAfterMs: left } : { open: false }
+    },
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/src/lib/lifecycle/ownership.ts b/packages/stealth/stealth-core-browser/src/lib/lifecycle/ownership.ts
new file mode 100644
index 000000000..ec433db16
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/lifecycle/ownership.ts
@@ -0,0 +1,135 @@
+/**
+ * @adhd/stealth-core-browser — src/lib/lifecycle/ownership.ts
+ *
+ * The single-writer launched-Chrome record `<stateDir>/chrome-<port>.json` =
+ * `{ pid, procStart, port, profileDir, launchedAt }`. Only the process whose
+ * `ensureChromeRunning` actually spawned Chrome (a non-null pid) writes it,
+ * atomically (temp file + rename). The record is VALID only while
+ * `isSameProcess(pid, procStart)` holds — the pid is alive AND its start token
+ * is unchanged — so a recycled pid is never signalled. All I/O is best effort
+ * (F26): a failure is logged and never fails a call.
+ *
+ * Ticket 8468f7b1 · plan state chrome-lifecycle (SPEC-single-pass-lifecycle.md 3.1, CL12 CL21).
+ */
+
+import * as nodeFs from 'node:fs'
+import { join } from 'node:path'
+import { errorMessage } from './errors.js'
+import type { OwnerRecord } from './reaper-host.js'
+import { isSameProcess, readProcessStartToken } from './sp.js'
+
+/** The synchronous fs subset the record needs (MemFs implements it). */
+export interface OwnershipFs {
+  readFileSync(path: string, encoding: 'utf8'): string
+  writeFileSync(path: string, data: string, opts?: { mode?: number }): void
+  renameSync(from: string, to: string): void
+  unlinkSync(path: string): void
+}
+
+export interface OwnershipOptions {
+  stateDir: string
+  port: number
+  fs?: OwnershipFs
+  logger?: (msg: string) => void
+  /** Default `isSameProcess` of the service proxy. */
+  isSameProcess?: (pid: number, procStart: string | null) => boolean
+  /** Default `readProcessStartToken` of the service proxy. */
+  readProcessStartToken?: (pid: number) => string | null
+  now?: () => number
+}
+
+export interface OwnershipStore {
+  readonly path: string
+  /** Record that this process launched `pid`. Best effort. */
+  write(pid: number, profileDir: string): OwnerRecord | null
+  /** The record, or null when absent or malformed. Never throws. */
+  read(): OwnerRecord | null
+  /** pid alive and its start token unchanged (never a recycled pid). */
+  isValid(rec: OwnerRecord): boolean
+  /** Forget the record. Best effort. */
+  remove(): void
+}
+
+export function ownerRecordPath(stateDir: string, port: number): string {
+  return join(stateDir, `chrome-${port}.json`)
+}
+
+function parseRecord(raw: string, port: number): OwnerRecord | null {
+  try {
+    const v = JSON.parse(raw) as Record<string, unknown>
+    const pid = v['pid']
+    if (typeof pid !== 'number' || !Number.isInteger(pid) || pid <= 0) return null
+    if (v['port'] !== port) return null
+    const procStart = typeof v['procStart'] === 'string' ? v['procStart'] : null
+    const profileDir = v['profileDir']
+    const launchedAt = v['launchedAt']
+    return {
+      pid,
+      procStart,
+      port,
+      ...(typeof profileDir === 'string' ? { profileDir } : {}),
+      ...(typeof launchedAt === 'number' ? { launchedAt } : {}),
+    }
+  } catch {
+    return null
+  }
+}
+
+export function createOwnershipStore(opts: OwnershipOptions): OwnershipStore {
+  const fs: OwnershipFs = opts.fs ?? (nodeFs as unknown as OwnershipFs)
+  const log = opts.logger ?? (() => undefined)
+  const same = opts.isSameProcess ?? ((pid: number, start: string | null) => isSameProcess(pid, start))
+  const token = opts.readProcessStartToken ?? ((pid: number) => readProcessStartToken(pid))
+  const now = opts.now ?? Date.now
+  const path = ownerRecordPath(opts.stateDir, opts.port)
+
+  return {
+    path,
+    write(pid: number, profileDir: string): OwnerRecord | null {
+      const rec: OwnerRecord = { pid, procStart: null, port: opts.port, profileDir, launchedAt: now() }
+      try {
+        rec.procStart = token(pid)
+      } catch (e) {
+        log(`owner record: start token of ${pid} unreadable: ${errorMessage(e)}`)
+      }
+      const tmp = `${path}.${process.pid}.tmp`
+      try {
+        fs.writeFileSync(tmp, JSON.stringify(rec), { mode: 0o600 })
+        fs.renameSync(tmp, path)
+        return rec
+      } catch (e) {
+        log(`owner record write failed (${path}): ${errorMessage(e)}`)
+        try {
+          fs.unlinkSync(tmp)
+        } catch {
+          /* nothing to clean */
+        }
+        return null
+      }
+    },
+    read(): OwnerRecord | null {
+      try {
+        return parseRecord(fs.readFileSync(path, 'utf8'), opts.port)
+      } catch {
+        return null
+      }
+    },
+    isValid(rec: OwnerRecord): boolean {
+      // A record without a start token cannot prove the pid was not recycled: never valid.
+      if (rec.procStart === null) return false
+      try {
+        return same(rec.pid, rec.procStart)
+      } catch (e) {
+        log(`owner record check failed: ${errorMessage(e)}`)
+        return false
+      }
+    },
+    remove(): void {
+      try {
+        fs.unlinkSync(path)
+      } catch {
+        /* absent or unremovable: best effort */
+      }
+    },
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/src/lib/lifecycle/page-tier.ts b/packages/stealth/stealth-core-browser/src/lib/lifecycle/page-tier.ts
new file mode 100644
index 000000000..046d87334
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/lifecycle/page-tier.ts
@@ -0,0 +1,38 @@
+/**
+ * @adhd/stealth-core-browser — src/lib/lifecycle/page-tier.ts
+ *
+ * Safety tier 2 (page): an open http(s) document means a human (a captcha
+ * window) or another call (a keepPage result) is using Chrome.
+ *
+ * Ticket 8468f7b1 · plan state chrome-lifecycle (CL7, F10 F11 F12).
+ */
+
+/**
+ * True only for a real WEB document that means a human (or another call) is
+ * using Chrome. Browser-internal pages — `chrome://newtab/`, `chrome://omnibox…`,
+ * `chrome-untrusted://…`, `about:`, `devtools://`, extension backgrounds — are
+ * NOT a reason to keep Chrome alive: the default window always shows
+ * `chrome://newtab/`, so counting it would make the idle shutdown defer forever.
+ */
+export function isActiveWebTarget(url: string): boolean {
+  return /^https?:/i.test(url)
+}
+
+/** A page target as listed by `/json/list` (only `url` matters to the tier). */
+export interface PageTierTarget {
+  url?: string
+}
+
+/**
+ * Count the page targets that pin Chrome. A listing failure (CDP unreachable
+ * during the check) yields `'unreachable'`, which the policy treats as
+ * "proceed" (F12): an unreachable Chrome must never defer the reap forever.
+ */
+export async function countActiveWebPages(list: () => Promise<PageTierTarget[]>): Promise<number | 'unreachable'> {
+  try {
+    const targets = await list()
+    return targets.filter((t) => typeof t.url === 'string' && isActiveWebTarget(t.url)).length
+  } catch {
+    return 'unreachable'
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/src/lib/lifecycle/reap-policy.ts b/packages/stealth/stealth-core-browser/src/lib/lifecycle/reap-policy.ts
new file mode 100644
index 000000000..f87c32fb7
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/lifecycle/reap-policy.ts
@@ -0,0 +1,103 @@
+/**
+ * @adhd/stealth-core-browser — src/lib/lifecycle/reap-policy.ts
+ *
+ * The ONE reap policy. Pure: no I/O, no clock, no writes. The reaper host
+ * calls it from its tick (graceMs = shutdownGraceMs) and from a client's soft
+ * `reapIfIdle` (graceMs = 0); there is no second implementation.
+ *
+ * Tier order (each tier that pins returns `keep`):
+ *   1. another connected client sent `activity` within `idleTimeoutMs`
+ *      (the caller's own activity never pins — F8, F13 of the inventory);
+ *   2. an open http(s) page (`isActiveWebTarget`; browser-internal targets
+ *      never pin; an unreachable CDP during the check proceeds — F10-F12);
+ *   3. a history visit within 2 minutes, when the tier is enabled (on when ANY
+ *      connected client enables it, else the reaper default; an unavailable
+ *      history database proceeds — F13);
+ * then the grace window since the last pin (`wait`), then the scope:
+ * `launched-only` without a valid owner record never signals anything (`none`),
+ * `port-occupant` (the default, F19) reaps.
+ *
+ * Livelock protection (F9): deciding never writes anything. Only the
+ * `activity` message mutates `lastActivityAt`, and only `bump()` sends it.
+ *
+ * Ticket 8468f7b1 · plan state chrome-lifecycle (SPEC-single-pass-lifecycle.md 3.2).
+ */
+
+export type ReaperScope = 'launched-only' | 'port-occupant'
+
+/** One connected client as the policy sees it. */
+export interface ClientView {
+  id: string
+  pid: number | null
+  checkHistory: boolean
+  /** Host-clock time of the client's last `activity`, null when it never sent one. */
+  lastActivityAt: number | null
+}
+
+export interface ReapInput {
+  now: number
+  clients: readonly ClientView[]
+  /** The client asking (soft `reapIfIdle`): excluded from the client pin check. */
+  callerId?: string
+  idleTimeoutMs: number
+  /** Explicit soft shutdown passes 0 (F15); the host tick passes shutdownGraceMs (N2). */
+  graceMs: number
+  chromeUp: boolean
+  /** `'unreachable'` means the page listing failed: proceed (F12). */
+  httpPageCount: number | 'unreachable'
+  /** `'unavailable'` means the history database could not be read: proceed. */
+  historyRecent: boolean | 'unavailable'
+  /** The history tier when no client is connected (the reaper default, true). */
+  checkHistoryDefault: boolean
+  scope: ReaperScope
+  /** True only when the launched-Chrome record matches a live process (pid + start token). */
+  ownerValid: boolean
+  /** Host-clock time Chrome was last pinned (or a pinning client left); null = never. */
+  lastPinAt: number | null
+}
+
+export type ReapAction = 'keep' | 'wait' | 'reap' | 'none'
+export type PinReason = 'client' | 'page' | 'history' | 'grace'
+
+export interface ReapDecision {
+  action: ReapAction
+  pinnedBy?: PinReason
+}
+
+/** True when a client's activity is inside the idle window at `now`. */
+export function isClientActive(c: ClientView, now: number, idleTimeoutMs: number): boolean {
+  return c.lastActivityAt !== null && now - c.lastActivityAt < idleTimeoutMs
+}
+
+/** The history tier is on when ANY connected client enables it, else the reaper default. */
+export function historyTierEnabled(clients: readonly ClientView[], checkHistoryDefault: boolean): boolean {
+  return clients.length === 0 ? checkHistoryDefault : clients.some((c) => c.checkHistory)
+}
+
+export function decideReap(i: ReapInput): ReapDecision {
+  if (!i.chromeUp) return { action: 'none' }
+
+  // Tier 1: another connected client active within the idle window.
+  if (i.clients.some((c) => c.id !== i.callerId && isClientActive(c, i.now, i.idleTimeoutMs))) {
+    return { action: 'keep', pinnedBy: 'client' }
+  }
+
+  // Tier 2: an open http(s) page. Unreachable CDP proceeds.
+  if (i.httpPageCount !== 'unreachable' && i.httpPageCount > 0) {
+    return { action: 'keep', pinnedBy: 'page' }
+  }
+
+  // Tier 3: recent history, when enabled. An unavailable database proceeds.
+  if (historyTierEnabled(i.clients, i.checkHistoryDefault) && i.historyRecent === true) {
+    return { action: 'keep', pinnedBy: 'history' }
+  }
+
+  // Grace since the last pin.
+  if (i.graceMs > 0 && i.lastPinAt !== null && i.now - i.lastPinAt < i.graceMs) {
+    return { action: 'wait', pinnedBy: 'grace' }
+  }
+
+  // Scope: launched-only never signals a Chrome it cannot prove it launched.
+  if (i.scope === 'launched-only' && !i.ownerValid) return { action: 'none' }
+  return { action: 'reap' }
+}
diff --git a/packages/stealth/stealth-core-browser/src/lib/lifecycle/reaper-entry.ts b/packages/stealth/stealth-core-browser/src/lib/lifecycle/reaper-entry.ts
new file mode 100644
index 000000000..cb6febae9
--- /dev/null
+++ b/packages/stealth/stealth-core-browser/src/lib/lifecycle/reaper-entry.ts
@@ -0,0 +1,158 @@
+/**
+ * @adhd/stealth-core-browser — src/lib/lifecycle/reaper-entry.ts
+ *
+ * `runChromeReaper(cfg)`: the body of the detached reaper host process for one
+ * CDP port. `createProxyReaperLink` spawns it through `ensureBackend` with the
+ * form pinned by sp-reaper-load-proof:
+ *
+ *   process.execPath -e 'require(process.argv[1]).lifecycle.runChromeReaper(JSON.parse(process.argv[2]))' <dist/index.js> <json cfg>
+ *
+ * It serves the pure reaper host (`createReaperHost`) over the service-proxy
+ * transport (`serveBackend` with the connection hooks), ticks every 5 s
+ * (`decideReap` with `graceMs = shutdownGraceMs`), and retires itself through
+ * `createIdleRetirer` once nobody needs it: the retirer is busy while Chrome is
+ * reachable (a flag the ticker refreshes by probing `/json/version`, because
+ * `isBusy` is synchronous) and `activity` touches it, so a host nobody uses
+ * retires `orphanWindowMs` after Chrome is gone (N5). Connections never pin it
+ * (ADR-0022).
+ *
+ * Ticket 8468f7b1 · plan state chrome-lifecycle (SPEC-single-pass-lifecycle.md 3.1 3.3, CL15).
+ */
+
+import { killChrome, killProcessGroup, type KillChromeOptions } from '../cdp/browser.js'
+import { closeAllPageTargets, isChromeReachable, listPageTargetsOnly } from '../cdp/targets.js'
+import { HistoryClient } from '../storage/history.js'
+import { errorMessage } from './errors.js'
+import { createOwnershipStore } from './ownership.js'
+import { countActiveWebPages } from './page-tier.js'
+import type { ReaperScope } from './reap-policy.js'
+import { createReaperHost, type ReaperHost, type ReaperHostDeps } from './reaper-host.js'
+import { createIdleRetirer, serveBackend, type BackendHandle, type IdleRetirer } from './sp.js'
+
+/** The JSON configuration handed to the reaper process (argv[2]). */
+export interface ChromeReaperConfig {
+  port: number
+  /** Default `127.0.0.1:<port>`. */
+  cdpHost?: string
+  stateDir: string
+  socketPath: string
+  idleTimeoutMs: number
+  shutdownGraceMs: number
+  orphanWindowMs: number
+  scope?: ReaperScope
+  /**
+   * The manager's RESOLVED profile (`--user-data-dir`): the port-occupant kill signals only a
+   * Chrome carrying it. Absent = the default dedicated profile.
+   */
+  profileDir?: string
+  checkHistoryDefault?: boolean
+  /** Default 5000. */
+  tickMs?: number
+}
+
+export interface ChromeReaperHandle {
+  host: ReaperHost
+  retirer: IdleRetirer
+  backend: BackendHandle
+  /** Resolves when the host has retired (ticker stopped, socket closed). */
+  retired: Promise<void>
+  /** Retire now. */
+  close(): Promise<void>
+}
+
+export interface ChromeReaperOverrides {
+  /** Replace individual host effects (tests). */
+  hostDeps?: Partial<ReaperHostDeps>
+  logger?: (msg: string) => void
+  /** Probe / logger of the port-occupant kill (tests inject a simulated machine). `profileDir` comes from the config. */
+  killOptions?: Omit<KillChromeOptions, 'profileDir'>
+}
+
+export const REAPER_TICK_MS = 5_000
+
+export async function runChromeReaper(cfg: ChromeReaperConfig, overrides: ChromeReaperOverrides = {}): Promise<ChromeReaperHandle> {
+  const log = overrides.logger ?? ((m: string) => console.error(`[@adhd/stealth-core-browser reaper ${cfg.port}] ${m}`))
+  const cdpHost = cfg.cdpHost ?? `127.0.0.1:${cfg.port}`
+  const tickMs = cfg.tickMs ?? REAPER_TICK_MS
+  const owner = createOwnershipStore({ stateDir: cfg.stateDir, port: cfg.port, logger: log })
+  // The history safety tier must read the profile this reaper guards, not the default one.
+  const history = new HistoryClient(cfg.profileDir)
+
+  let retirer: IdleRetirer | null = null
+  const host = createReaperHost({
+    port: cfg.port,
+    idleTimeoutMs: cfg.idleTimeoutMs,
+    shutdownGraceMs: cfg.shutdownGraceMs,
+    ...(cfg.scope ? { scope: cfg.scope } : {}),
+    ...(cfg.checkHistoryDefault === undefined ? {} : { checkHistoryDefault: cfg.checkHistoryDefault }),
+    now: Date.now,
+    probeChrome: () => isChromeReachable(cdpHost),
+    countHttpPages: () => countActiveWebPages(() => listPageTargetsOnly(cdpHost)),
+    historyRecent: () => history.isRecentlyUsed(2),
+    owner: { read: () => owner.read(), isValid: (r) => owner.isValid(r), remove: () => owner.remove() },
+    closeAllPageTargets: () => closeAllPageTargets(cdpHost),
+    killProcessGroup,
+    killChrome: (port) => killChrome(port, { logger: log, ...overrides.killOptions, ...(cfg.profileDir === undefined ? {} : { profileDir: cfg.profileDir }) }),
+    logger: log,
+    onActivity: () => retirer?.touch(),
+    ...overrides.hostDeps,
+  })
+
+  const backend = await serveBackend({
+    socketPath: cfg.socketPath,
+    handler: (req, ctx) => host.handler(req, ctx),
+    onClientConnect: (id) => host.onClientConnect(id),
+    onClientDisconnect: (id, reason) => host.onClientDisconnect(id, reason),
+    onDiagnostic: log,
+  })
+
+  let ticking = false
+  const tick = async (): Promise<void> => {
+    if (ticking) return
+    ticking = true
+    try {
+      const wasUp = host.chromeReachable()
+      const out = await host.tick()
+      if (out.reaped) log('reaped idle Chrome')
+      // The orphan window starts when Chrome goes away (reaped here or killed elsewhere).
+      if (wasUp && !host.chromeReachable()) retirer?.touch()
+    } catch (e) {
+      log(`tick failed: ${errorMessage(e)}`)
+    } finally {
+      ticking = false
+    }
+  }
+  const ticker = setInterval(() => void tick(), tickMs)
+  ticker.unref()
+
+  let resolveRetired!: () => void
+  const retired = new Promise<void>((r) => (resolveRetired = r))
+  retirer = createIdleRetirer({
+    idleWindowMs: cfg.orphanWindowMs,
+    isBusy: () => host.chromeReachable(),
+    steps: [
+      { name: 'stop-ticker', run: () => clearInterval(ticker) },
+      { name: 'close-backend', run: () => backend.close() },
+    ],
+    onEvent: (e) => {
+      if (e.type === 'retired') {
+        log(`retired (${e.reason})`)
+        resolveRetired()
+      } else if (e.type === 'retire-step-failed') {
+        log(`retire step ${e.step} failed: ${errorMessage(e.error)}`)
+      }
+    },
+  })
+  // Learn Chrome's state before the first idle evaluation, then start the idle clock.
+  await tick()
+  retirer.arm()
+
+  const armed = retirer
+  return {
+    host,
+    retirer,
+    backend,
+    retired,
+    close: () => armed.retire('closed'),
+  }
+}
diff --git a/packages/stealth/stealth-core-browser/src/lib/lifecycle/reaper-host.ts b/packages/stealth/stealth-core-browser/src/lib/lifecycle/reaper-host.ts
