index 000000000..f4f4446a9
--- /dev/null
+++ b/entrypoint/stealth-search/test/unit/verbs/timeout-deadline.spec.ts
@@ -0,0 +1,127 @@
+/**
+ * guards: a hung provider outlives timeoutMs, leaks its concurrency slot or page, or arms the cooldown
+ * tier: S
+ * cites: ticket 8468f7b1 [search-verbs.11]
+ * A hung provider cannot outlive the deadline: one overall `timeoutMs` (default 30000, shared across attempts,
+ * never the 90 s of the old tool) ends a search whose engine never settles with outcome `timeout`, the
+ * concurrency slot is released, the page is disposed and the cooldown is not armed.
+ *
+ * Inventory rows: I-04 (concurrency slot), I-05 (cooldown), I-14 (dispose in finally).
+ * Ticket 8468f7b1 · backlog 861571da, 224e7a44 · [search-verbs.11]
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { DEFAULT_SEARCH_TIMEOUT_MS } from '../../../src/lib/search.js'
+import { hitlResponse, input, makeFakeCore, makeWorld, response, scriptedEngine } from '../../helpers/verbs/harness.js'
+
+const hung = (): Promise<never> => new Promise<never>(() => undefined)
+
+beforeEach(() => {
+  vi.useFakeTimers()
+})
+afterEach(() => {
+  vi.useRealTimers()
+})
+
+describe('861571da 224e7a44: a hung github engine resolves with outcome timeout at the 30000 deadline [search-verbs.11]', () => {
+  it('useFakeTimers: a github search whose engine never settles resolves at 30000 ms with outcome timeout, not error after two attempts', async () => {
+    expect(DEFAULT_SEARCH_TIMEOUT_MS).toBe(30000)
+    const engine = scriptedEngine(hung)
+    const world = makeWorld({ strategies: engine.strategies })
+    let settled = false
+    const pending = world.svc.search(input()).then((r) => {
+      settled = true
+      return r
+    })
+
+    await vi.advanceTimersByTimeAsync(29_999)
+    expect(settled).toBe(false)
+    await vi.advanceTimersByTimeAsync(1)
+    const out = await pending
+
+    expect(out).toMatchObject({ provider: 'github', outcome: 'timeout', count: 0, results: [] })
+    expect(out.outcome).not.toBe('error')
+    expect(out.tookMs).toBe(30_000)
+    expect(out.error).toContain('30000ms')
+    // one attempt began and never came back: the deadline is shared, not restarted per attempt
+    expect(engine.calls).toHaveLength(1)
+  })
+
+  it('dispose: the page of the hung attempt is disposed exactly once', async () => {
+    const world = makeWorld({ strategies: scriptedEngine(hung).strategies })
+    const pending = world.svc.search(input())
+    await vi.advanceTimersByTimeAsync(30_000)
+    await pending
+    expect(world.core.pages).toHaveLength(1)
+    expect(world.core.pages[0]?.disposed).toBe(1)
+    expect(world.core.live).toBe(0)
+  })
+
+  it('release: the concurrency slot is released, so the next search runs under maxConcurrent 1', async () => {
+    const engine = scriptedEngine(hung, response())
+    const world = makeWorld({ strategies: engine.strategies, config: { maxConcurrent: 1 } })
+    const first = world.svc.search(input())
+    await vi.advanceTimersByTimeAsync(30_000)
+    expect((await first).outcome).toBe('timeout')
+
+    const second = await world.svc.search(input({ query: 'react' }))
+    expect(second).toMatchObject({ outcome: 'success', attempts: 1 })
+    expect(engine.calls).toHaveLength(2)
+  })
+
+  it('no cooldown: a timeout does not arm the provider cooldown and writes no tripwire', async () => {
+    const world = makeWorld({ strategies: scriptedEngine(hung).strategies })
+    const pending = world.svc.search(input())
+    await vi.advanceTimersByTimeAsync(30_000)
+    await pending
+    expect(await world.svc.guard.readProviderCooldown('github')).toBeNull()
+    expect(await world.svc.guard.cooldownRemainingMs('github')).toBe(0)
+    expect(world.fs.files()).toEqual([])
+  })
+
+  it('timeoutMs: an explicit 5000 deadline wins over the 30000 default', async () => {
+    const world = makeWorld({ strategies: scriptedEngine(hung).strategies })
+    const pending = world.svc.search(input({ timeoutMs: 5000 }))
+    await vi.advanceTimersByTimeAsync(5000)
+    const out = await pending
+    expect(out).toMatchObject({ outcome: 'timeout', tookMs: 5000 })
+  })
+
+  it('timeout: a Chrome that never becomes ready is also cut at 30000 with no page opened', async () => {
+    const world = makeWorld({ strategies: scriptedEngine(response()).strategies })
+    world.core.core.ensureChrome = hung
+    const pending = world.svc.search(input())
+    await vi.advanceTimersByTimeAsync(30_000)
+    expect(await pending).toMatchObject({ outcome: 'timeout', attempts: 0 })
+    expect(world.core.pages).toHaveLength(0)
+  })
+
+  it('timeout: a hung fetch render is cut at 30000, its page disposed and the fetch strategy reported', async () => {
+    const world = makeWorld({
+      fetch: {
+        newSession: () => ({ connect: async () => undefined, on: () => () => undefined, close: () => undefined, send: (async () => ({})) as never }),
+        settle: hung,
+      },
+    })
+    const pending = world.svc.search({ provider: 'fetch', query: 'https://example.com/slow' })
+    await vi.advanceTimersByTimeAsync(30_000)
+    const out = await pending
+    expect(out).toMatchObject({ provider: 'fetch', outcome: 'timeout', strategy: 'fetch', url: 'https://example.com/slow' })
+    expect(world.core.pages.every((p) => p.disposed === 1)).toBe(true)
+  })
+
+  it('a human prompt does not spend the deadline: the budget is paused while confirmSolved waits', async () => {
+    // hitl then a slow human (45 s) then success: total wall time exceeds 30 s but the search still succeeds.
+    const order: string[] = []
+    const interaction = {
+      confirmSolved: async () => {
+        await new Promise((r) => setTimeout(r, 45_000))
+        return 'solved' as const
+      },
+      promptTripwireGate: async () => 'clear' as const,
+    }
+    const world = makeWorld({ core: makeFakeCore(order), interaction, strategies: scriptedEngine(hitlResponse('captcha', 'https://github.com/sorry'), response()).strategies })
+    const pending = world.svc.search(input())
+    await vi.advanceTimersByTimeAsync(45_000)
+    expect(await pending).toMatchObject({ outcome: 'success', attempts: 2 })
+  })
+})
diff --git a/entrypoint/stealth-search/test/unit/verbs/timeout-propagation.spec.ts b/entrypoint/stealth-search/test/unit/verbs/timeout-propagation.spec.ts
new file mode 100644
index 000000000..9ce670269
--- /dev/null
+++ b/entrypoint/stealth-search/test/unit/verbs/timeout-propagation.spec.ts
@@ -0,0 +1,83 @@
+/**
+ * guards: the request timeoutMs is not threaded to a capture, so a slow provider response is reported empty
+ * tier: S
+ * cites: ticket 8468f7b1 [search-verbs.14]
+ * The request timeout reaches every capture: the verb threads the SearchInput `timeoutMs` (default 30000)
+ * to each engine `networkSearch` call (primary, fallback and the post-challenge retry), so a slow provider
+ * response (arXiv, 8 to 16 s) is captured instead of reported `empty`. The real engine runs over a recording
+ * capture; only the page, the clock and the network are fakes.
+ *
+ * Ticket 8468f7b1 · commit 591e1a7 · [search-verbs.14]
+ */
+import { describe, expect, it, vi } from 'vitest'
+import { body, exchange, exchangesCapture, fixture, FakePage, githubFixture, makeClock, makeDeps, recordingCapture } from '../../helpers/engine/harness.js'
+import { input, makeWorld } from '../../helpers/verbs/harness.js'
+
+const arxivPage = '<html><body><li class="arxiv-result"><p class="title is-5"><a href="/abs/2410.00001">A paper</a></p><span class="abstract-short">s</span></li></body></html>'
+
+describe('591e1a7: timeoutMs reaches networkSearch from the verb [search-verbs.14]', () => {
+  it.each([
+    [undefined, 30000],
+    [12000, 12000],
+  ])('primary networkSearch: a search with timeoutMs %s records %i at the first capture', async (given, expected) => {
+    const rec = recordingCapture(async () => body(arxivPage))
+    const world = makeWorld({ engine: makeDeps({ capture: rec.capture }) })
+    const out = await world.svc.search(input({ provider: 'arxiv', query: 'x', ...(given !== undefined ? { timeoutMs: given } : {}) }))
+    expect(out.outcome).toBe('success')
+    expect(rec.calls.map((c) => c.options.timeoutMs)).toEqual([expected])
+  })
+
+  it.each([
+    [undefined, 30000],
+    [12000, 12000],
+  ])('fallback networkSearch: github with the direct fetch failing and timeoutMs %s records %i at the fallback capture', async (given, expected) => {
+    const rec = recordingCapture(async () => body(githubFixture('repo-search.html'), { url: 'https://github.com/search?q=vite&type=repositories' }))
+    const world = makeWorld({
+      engine: makeDeps({ capture: rec.capture, fetchImpl: async () => new Response('{}', { status: 500 }) }),
+    })
+    await world.svc.search(input({ ...(given !== undefined ? { timeoutMs: given } : {}) }))
+    expect(rec.calls.length).toBeGreaterThan(0)
+    expect(rec.calls.map((c) => c.options.timeoutMs)).toEqual(rec.calls.map(() => expected))
+  })
+
+  it.each([
+    [undefined, 30000],
+    [12000, 12000],
+  ])('post-challenge networkSearch retry: pypi behind a challenge with timeoutMs %s records %i at both captures', async (given, expected) => {
+    const clean = new FakePage({ html: fixture('pypi-results.html') })
+    const rec = recordingCapture(async (_call, n) => (n === 0 ? body(fixture('cf-challenge.html')) : body(fixture('pypi-results.html'))))
+    const clock = makeClock()
+    const world = makeWorld({ engine: makeDeps({ capture: rec.capture, clock, connect: async () => clean }) })
+    const out = await world.svc.search(input({ provider: 'pypi', query: 'requests', ...(given !== undefined ? { timeoutMs: given } : {}) }))
+    expect(rec.calls.map((c) => c.options.timeoutMs)).toEqual([expected, expected])
+    expect(out.outcome).toBe('success')
+  })
+
+  it('30000: the wait the verb hands the capture is the deadline default, never a fixed 10 s', async () => {
+    const rec = recordingCapture(async () => body(arxivPage))
+    const world = makeWorld({ engine: makeDeps({ capture: rec.capture }) })
+    await world.svc.search(input({ provider: 'arxiv', query: 'x' }))
+    expect(rec.calls[0]?.options.timeoutMs).not.toBe(10_000)
+    expect(rec.calls[0]?.options.timeoutMs).toBe(30000)
+  })
+
+  it('12000: a slow arXiv response at 14 s is captured under the 30000 default and reported timeout, not empty, under timeoutMs 12000', async () => {
+    vi.useFakeTimers()
+    try {
+      const landing = [{ at: 14000, exchange: exchange({ url: 'https://arxiv.org/search/?query=x', status: 200, body: arxivPage }) }]
+      const engine = () => makeDeps({ capture: recordingCapture(exchangesCapture(landing)).capture, sleep: async () => undefined, now: () => Date.now() })
+      // under the default 30000 the response lands at 14 s and is captured
+      const slow = makeWorld({ engine: engine() })
+      const ok = slow.svc.search(input({ provider: 'arxiv', query: 'x', maxAttempts: 1 }))
+      await vi.advanceTimersByTimeAsync(14_000)
+      expect((await ok).outcome).toBe('success')
+      // under 12000 nothing lands in time: a transport timeout
+      const tight = makeWorld({ engine: engine() })
+      const miss = tight.svc.search(input({ provider: 'arxiv', query: 'x', maxAttempts: 1, timeoutMs: 12000 }))
+      await vi.advanceTimersByTimeAsync(12_000)
+      expect((await miss).outcome).toBe('timeout')
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+})
