+    expect(env.mfs.readText(env.lockPath('google'))).toContain(
+      'very private words',
+    );
+  });
+});
diff --git a/packages/resilience/resilience-core-tripwire/test/unit/render.spec.ts b/packages/resilience/resilience-core-tripwire/test/unit/render.spec.ts
