+++ b/packages/resilience/resilience-core-tripwire/test/helpers/gates.ts
@@ -0,0 +1,118 @@
+/**
+ * Gate-driven interleaving over the memory fs (no timers, no polling).
+ *
+ * Every port operation of every task parks on a gate (a promise only the
+ * driver resolves). The driver waits, by event notification, until every
+ * task is parked or finished, lets the picker choose one parked operation,
+ * resolves its gate and repeats. The schedule is therefore a pure function
+ * of the picker, independent of machine load.
+ */
+import type {
+  FsFileHandle,
+  FsOpRecord,
+  FsPort,
+  MemoryFs,
+  SchedulePicker,
+} from '../../src/lib/memory-fs';
+import { processView } from './harness';
+
+interface Parked {
+  op: string;
+  path: string;
+  release: () => void;
+}
+
+/** A gated view of a memory fs plus the driver that interleaves tasks over it. */
+export interface Gates {
+  /** The port to build the storages under test on: every operation parks. */
+  fs: FsPort;
+  /** Run `tasks` to completion; `pick` chooses which parked operation proceeds. */
+  run<T>(
+    tasks: ReadonlyArray<() => Promise<T>>,
+    pick: SchedulePicker,
+  ): Promise<PromiseSettledResult<T>[]>;
+}
+
+/** Gate every port operation (and file-handle operation) of `mfs`. */
+export function createGates(mfs: MemoryFs): Gates {
+  const parked: Parked[] = [];
+  let finished = 0;
+  let total = 0;
+  let wake: (() => void) | undefined;
+  const notify = (): void => {
+    const w = wake;
+    wake = undefined;
+    w?.();
+  };
+
+  const gate = (op: string, path: string): Promise<void> =>
+    new Promise<void>((release) => {
+      parked.push({ op, path, release });
+      notify();
+    });
+
+  const wrapHandle = (h: FsFileHandle): FsFileHandle => ({
+    write: async (d) => {
+      await gate('write', '');
+      return h.write(d);
+    },
+    sync: async () => {
+      await gate('sync', '');
+      return h.sync();
+    },
+    close: async () => {
+      await gate('close', '');
+      return h.close();
+    },
+  });
+
+  const base = processView(mfs);
+  const fs: FsPort = {
+    mkdir: async (p, m) => (await gate('mkdir', p), base.mkdir(p, m)),
+    chmod: async (p, m) => (await gate('chmod', p), base.chmod(p, m)),
+    openExclusive: async (p, m) => {
+      await gate('openExclusive', p);
+      return wrapHandle(await base.openExclusive(p, m));
+    },
+    appendFile: async (p, d, m, x) =>
+      (await gate('appendFile', p), base.appendFile(p, d, m, x)),
+    link: async (a, b) => (await gate('link', b), base.link(a, b)),
+    rename: async (a, b) => (await gate('rename', b), base.rename(a, b)),
+    unlink: async (p) => (await gate('unlink', p), base.unlink(p)),
+    readFile: async (p) => (await gate('readFile', p), base.readFile(p)),
+    stat: async (p) => (await gate('stat', p), base.stat(p)),
+    readdir: async (p) => (await gate('readdir', p), base.readdir(p)),
+  };
+
+  return {
+    fs,
+    async run(tasks, pick) {
+      total = tasks.length;
+      finished = 0;
+      const results = tasks.map((task) =>
+        Promise.resolve()
+          .then(task)
+          .finally(() => {
+            finished += 1;
+            notify();
+          }),
+      );
+      const all = Promise.allSettled(results);
+      for (let step = 0; ; step += 1) {
+        // Every task is either parked on a gate or finished: only then pick.
+        while (parked.length + finished < total) {
+          await new Promise<void>((resolve) => {
+            wake = resolve;
+          });
+        }
+        if (finished === total) break;
+        const view = parked.map((p) => ({ op: p.op, path: p.path }) as FsOpRecord);
+        const raw = pick(view, step);
+        const index = Math.max(0, Math.min(parked.length - 1, raw));
+        const [next] = parked.splice(index, 1);
+        next.release();
+      }
+      return all;
+    },
+  };
+}
diff --git a/packages/resilience/resilience-core-tripwire/test/helpers/harness.ts b/packages/resilience/resilience-core-tripwire/test/helpers/harness.ts
new file mode 100644
index 000000000..0d7630ccd
--- /dev/null
+++ b/packages/resilience/resilience-core-tripwire/test/helpers/harness.ts
@@ -0,0 +1,148 @@
+/**
+ * Test harness for the tripwire unit lane (ticket 8468f7b1): a memory fs,
+ * a controllable clock, warning capture, audit parsing and "process views"
+ * (distinct FsPort objects over one memory fs, so two tripwire instances
+ * behave like two OS processes sharing a disk: they do not share the
+ * in-memory latch).
+ */
+import {
+  createMemoryFs,
+  createTripwire,
+  type AuditEvent,
+  type FsPort,
+  type MemoryFs,
+  type TripContext,
+  type Tripwire,
+  type TripwireOptions,
+  type TripwireWarning,
+} from '../../src/index';
+import { MUTATING_FS_OPS, type FsOpRecord } from '../../src/lib/memory-fs';
+
+export const STATE_DIR = '/state';
+export const T0 = Date.parse('2026-10-12T00:00:00.000Z');
+
+/** A distinct FsPort object over `mfs` (simulates another process). */
+export function processView(mfs: MemoryFs): FsPort {
+  return {
+    mkdir: (p, m) => mfs.mkdir(p, m),
+    chmod: (p, m) => mfs.chmod(p, m),
+    openExclusive: (p, m) => mfs.openExclusive(p, m),
+    appendFile: (p, d, m, x) => mfs.appendFile(p, d, m, x),
+    link: (a, b) => mfs.link(a, b),
+    rename: (a, b) => mfs.rename(a, b),
+    unlink: (p) => mfs.unlink(p),
+    readFile: (p) => mfs.readFile(p),
+    stat: (p) => mfs.stat(p),
+    readdir: (p) => mfs.readdir(p),
+  };
+}
+
+export interface Clock {
+  now: number;
+  advance(ms: number): void;
+  fn: () => number;
+}
+
+export function makeClock(start = T0): Clock {
+  const c: Clock = {
+    now: start,
+    advance(ms) {
+      c.now += ms;
+    },
+    fn: () => c.now,
+  };
+  return c;
+}
+
+export type EnvOptions = Partial<TripwireOptions> & {
+  linkSupported?: boolean;
+};
+
+export interface Env<C extends TripContext = TripContext> {
+  mfs: MemoryFs;
+  clock: Clock;
+  warnings: TripwireWarning[];
+  /** The main instance (same process as `sameProcess`). */
+  tw: Tripwire<C>;
+  /** Another instance in the same process (shares the latch). */
+  sameProcess(over?: EnvOptions): Tripwire<C>;
+  /** An instance in a simulated other process (own latch). */
+  otherProcess(over?: EnvOptions): Tripwire<C>;
+  lockPath(key: string): string;
+  /** The block sidecar of `key` (of lock generation `gen`, if given). */
+  blockedPath(key: string, gen?: string): string;
+  markerPath(key: string): string;
+  auditPath: string;
+  /** Parsed audit lines. */
+  audit(): AuditEvent[];
+  /** Raw audit text ('' when absent). */
+  auditText(): string;
+  /** Mutating fs ops executed so far. */
+  writes(): FsOpRecord[];
+}
+
+export function makeEnv<C extends TripContext = TripContext>(
+  over: EnvOptions = {},
+): Env<C> {
+  const clock = makeClock();
+  const mfs = createMemoryFs({
+    clock: clock.fn,
+    linkSupported: over.linkSupported,
+  });
+  const warnings: TripwireWarning[] = [];
+  const auditPath = over.auditPath ?? `${STATE_DIR}/audit.log`;
+  const base = (fs: FsPort, o: EnvOptions): Tripwire<C> => {
+    const {
+      linkSupported: _ignored,
+      fs: explicitFs,
+      ...rest
+    } = { ...over, ...o };
+    return createTripwire<C>({
+      namespace: 'test-ns',
+      stateDir: STATE_DIR,
+      actor: 'tester',
+      clock: clock.fn,
+      onWarning: (w) => warnings.push(w),
+      ...rest,
+      // an explicit `fs` (e.g. a tagged view) wins over the process view
+      fs: explicitFs ?? fs,
+    });
+  };
+  const sharedFs = processView(mfs);
+  const env: Env<C> = {
+    mfs,
+    clock,
+    warnings,
+    tw: base(sharedFs, {}),
+    sameProcess: (o = {}) => base(sharedFs, o),
+    otherProcess: (o = {}) => base(processView(mfs), o),
+    lockPath: (k) => `${STATE_DIR}/tripwire/${k}.lock`,
+    blockedPath: (k, gen) =>
+      `${STATE_DIR}/tripwire/${k}.blocked${gen === undefined ? '' : `.${gen}`}`,
+    markerPath: (k) => `${STATE_DIR}/tripwire/${k}.cleared`,
+    auditPath,
+    auditText: () => mfs.readText(auditPath) ?? '',
+    audit: () =>
+      (mfs.readText(auditPath) ?? '')
+        .split('\n')
+        .filter((l) => l !== '')
+        .map((l) => JSON.parse(l) as AuditEvent),
+    writes: () => mfs.ops.filter((r) => MUTATING_FS_OPS.includes(r.op)),
+  };
+  return env;
+}
+
+/** Events of a given name in the audit. */
+export function eventsOf(env: Env, name: AuditEvent['event']): AuditEvent[] {
+  return env.audit().filter((e) => e.event === name);
+}
+
+/** Await a promise expected to reject; returns the rejection reason. */
+export async function rejectionOf(p: Promise<unknown>): Promise<unknown> {
+  try {
+    await p;
+  } catch (e) {
+    return e;
+  }
+  throw new Error('expected the promise to reject');
+}
