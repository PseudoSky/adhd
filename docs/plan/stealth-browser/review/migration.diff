@@ -0,0 +1,39 @@
+/**
+ * guards: a spec mutates the shared PROVIDERS registry so a later test sees a changed provider
+ * tier: S
+ * cites: ticket 8468f7b1 [fix-search-output.2]
+ * The provider registry is injected (`SearchDeps.providers`), so a per-test registry copy carries any retry
+ * override and the module singleton is never written: two consecutive tests both see the pristine github retry
+ * policy, and an override in one test does not leak to the next.
+ *
+ * Ticket 8468f7b1 · [fix-search-output.2]
+ */
+import { describe, expect, it } from 'vitest'
+import { PROVIDERS } from '../../../src/lib/providers.js'
+import { input, makeWorld, providersWithGithubRetry, response, scriptedEngine } from '../../helpers/verbs/harness.js'
+
+const PRISTINE = JSON.stringify(PROVIDERS.github.retry)
+const failure = response({ outcome: 'timeout', results: [], count: 0, error: 'nothing captured within 30000ms' })
+
+describe('fix-search-output.2: the registry is pristine across tests (per-test copy)', () => {
+  it('registry per-test: an injected abort policy is honoured by this test only (attempts 1)', async () => {
+    const world = makeWorld({ strategies: scriptedEngine(failure).strategies, providers: providersWithGithubRetry({ onTimeout: 'abort' }) })
+    expect(await world.svc.search(input({ maxAttempts: 3 }))).toMatchObject({ outcome: 'timeout', attempts: 1 })
+    expect(JSON.stringify(PROVIDERS.github.retry)).toBe(PRISTINE)
+  })
+
+  it('registry pristine: the next test sees the unmodified singleton and the default retry policy (attempts 3)', async () => {
+    expect(PROVIDERS.github.retry.onTimeout).toBe('retry')
+    expect(JSON.stringify(PROVIDERS.github.retry)).toBe(PRISTINE)
+    const world = makeWorld({ strategies: scriptedEngine(failure).strategies })
+    expect(await world.svc.search(input({ maxAttempts: 3 }))).toMatchObject({ outcome: 'timeout', attempts: 3 })
+  })
+
+  it('per-test copy: the copy is a distinct object graph from the module registry at the github retry level', () => {
+    const copy = providersWithGithubRetry({ onTimeout: 'abort' })
+    expect(copy.github).not.toBe(PROVIDERS.github)
+    expect(copy.github.retry).not.toBe(PROVIDERS.github.retry)
+    expect(copy.github.retry.onTimeout).toBe('abort')
+    expect(PROVIDERS.github.retry.onTimeout).toBe('retry')
+  })
+})
diff --git a/entrypoint/stealth-search/test/unit/verbs/result-bytes.spec.ts b/entrypoint/stealth-search/test/unit/verbs/result-bytes.spec.ts
new file mode 100644
index 000000000..e707ecf80
--- /dev/null
+++ b/entrypoint/stealth-search/test/unit/verbs/result-bytes.spec.ts
@@ -0,0 +1,86 @@
+/**
+ * guards: a long-snippet result list (30 or more hits) serializes over 8192 bytes under a count-only bound
+ * tier: S
+ * cites: ticket 8468f7b1 [fix-search-output.1]
+ * The default search output is bounded by result count AND bytes. 40 results whose raw snippets are 600 bytes
+ * serialize within DEFAULT_MAX_RESULT_BYTES (8192) by dropping whole results from the tail (never a result cut
+ * mid-record), with `omitted` carrying the dropped count (the truncation marker; api.ts allows no optional boolean); 5 short results are untouched;
+ * `maxResultBytes` overrides the bound and a non-positive value is a typed SEARCH_FAILED usage error.
+ *
+ * Ticket 8468f7b1 · [fix-search-output.1]
+ */
+import { describe, expect, it } from 'vitest'
+import type { SearchOutput } from '../../../src/api.js'
+import { StealthSearchError } from '../../../src/errors.js'
+import { DEFAULT_MAX_RESULT_BYTES } from '../../../src/lib/search.js'
+import { input, makeWorld, response, scriptedEngine } from '../../helpers/verbs/harness.js'
+
+const bytes = (out: SearchOutput): number => Buffer.byteLength(JSON.stringify(out))
+const longResults = (n: number) =>
+  Array.from({ length: n }, (_, i) => ({ title: `Result ${i}`, url: `https://example.com/p/${i}`, snippet: `${String(i).padStart(3, '0')} ${'lorem ipsum '.repeat(50)}`.slice(0, 600) }))
+const run = (n: number, over: Record<string, unknown> = {}) => {
+  const world = makeWorld({ strategies: scriptedEngine(response({ results: longResults(n), count: n })).strategies })
+  return world.svc.search(input(over))
+}
+
+describe('fix-search-output.1: the 8192 byte bound on the default result list', () => {
+  it('8192 bytes count: 40 long-snippet results serialize within the default byte bound (DEFAULT_MAX_RESULT_BYTES is 8192)', async () => {
+    expect(DEFAULT_MAX_RESULT_BYTES).toBe(8192)
+    const out = await run(40)
+    expect(out.outcome).toBe('success')
+    expect(bytes(out)).toBeLessThanOrEqual(8192)
+    expect(out.results.length).toBeGreaterThan(0)
+    expect(out.results.length).toBeLessThan(40)
+  })
+
+  it('whole results truncated: the kept results are an unbroken prefix, each intact, with omitted the dropped count', async () => {
+    const out = await run(40)
+    const all = longResults(40)
+    expect(out.omitted).toBeGreaterThan(0)
+    expect(out.omitted).toBe(40 - out.results.length)
+    expect(out.count).toBe(40)
+    out.results.forEach((hit, i) => {
+      expect(hit.title).toBe(all[i]?.title)
+      expect(hit.url).toBe(all[i]?.url)
+      expect(hit.snippet).toBe(`${all[i]?.snippet.slice(0, 300)}…`)
+    })
+  })
+
+  it('whole results: dropping one more result would not be needed, so the bound is filled greedily', async () => {
+    const out = await run(40)
+    expect(out.omitted).toBeGreaterThan(0)
+    const next = longResults(40)[out.results.length]
+    const withNext: SearchOutput = { ...out, omitted: (out.omitted ?? 0) - 1, results: [...out.results, { title: next?.title ?? '', url: next?.url ?? '', snippet: `${next?.snippet.slice(0, 300)}…` }] }
+    expect(bytes(withNext)).toBeGreaterThan(8192)
+  })
+
+  it('count: 5 short results are untouched, with no omitted marker', async () => {
+    const world = makeWorld({ strategies: scriptedEngine(response({ results: longResults(5).map((r) => ({ ...r, snippet: 'short' })), count: 5 })).strategies })
+    const out = await world.svc.search(input())
+    expect(out.results).toHaveLength(5)
+    expect(out.results.every((r) => r.snippet === 'short')).toBe(true)
+    expect(out).not.toHaveProperty('omitted')
+  })
+
+  it('maxResultBytes overrides the default bound: a larger bound keeps more whole results, still within the bound', async () => {
+    const small = await run(40)
+    const big = await run(40, { maxResultBytes: 20_000 })
+    expect(big.results.length).toBeGreaterThan(small.results.length)
+    expect(bytes(big)).toBeLessThanOrEqual(20_000)
+  })
+
+  it('a bound smaller than one result drops every result and still marks omitted, never a partial record', async () => {
+    const out = await run(40, { maxResultBytes: 1 })
+    expect(out.results).toEqual([])
+    expect(out.omitted).toBeGreaterThan(0)
+    expect(out.omitted).toBe(40)
+  })
+
+  it.each([0, -1, 1.5, Number.NaN])('typed error: maxResultBytes %s is a SEARCH_FAILED invalid-option error before any page opens', async (bad) => {
+    const world = makeWorld({ strategies: scriptedEngine(response()).strategies })
+    const err = await world.svc.search(input({ maxResultBytes: bad })).catch((e: unknown) => e)
+    expect(err).toBeInstanceOf(StealthSearchError)
+    expect(err).toMatchObject({ code: 'SEARCH_FAILED', detail: { reason: 'invalid-option', field: 'maxResultBytes' } })
+    expect(world.core.pages).toHaveLength(0)
+  })
+})
diff --git a/entrypoint/stealth-search/test/unit/verbs/retry.spec.ts b/entrypoint/stealth-search/test/unit/verbs/retry.spec.ts
new file mode 100644
index 000000000..d294029e9
--- /dev/null
+++ b/entrypoint/stealth-search/test/unit/verbs/retry.spec.ts
@@ -0,0 +1,97 @@
+/**
+ * guards: a zero-result page is retried, or a transport failure stops retrying before maxAttempts or abort
+ * tier: S
+ * cites: ticket 8468f7b1 [search-verbs.16]
+ * A zero-result page is one attempt: the verb's attempt loop uses the core `decideRetry`; a github zero-match
+ * response (outcome `empty`) returns `empty` with attempts 1, a transport failure (`error` or `timeout` from
+ * `noCaptureOutcome`) retries up to maxAttempts, and `onTimeout: 'abort'` stops.
+ *
+ * Inventory rows: I-06 (retry with backoff), I-07 (hostile outcomes end the call).
+ * Ticket 8468f7b1 · commit c00edea · [search-verbs.16]
+ */
+import { describe, expect, it } from 'vitest'
+import { noCaptureOutcome } from '../../../src/lib/network.js'
+import { body, makeDeps, recordingCapture } from '../../helpers/engine/harness.js'
+import { input, makeWorld, providersWithGithubRetry, response, scriptedEngine } from '../../helpers/verbs/harness.js'
+
+const failure = (socketError: string | null) => {
+  const outcome = noCaptureOutcome(socketError)
+  return response({ outcome, error: outcome === 'timeout' ? 'nothing captured within 30000ms' : `socket: ${socketError ?? ''}` })
+}
+
+describe('c00edea: legitimate zero results are one attempt [search-verbs.16]', () => {
+  it('empty: a github zero-match response returns outcome empty with attempts 1 (it was 3) and one engine pass', async () => {
+    const engine = scriptedEngine(response({ outcome: 'empty', results: [], count: 0 }))
+    const world = makeWorld({ strategies: engine.strategies })
+    const out = await world.svc.search(input({ query: 'zzzz-no-such-repo-0000' }))
+    expect(out).toMatchObject({ outcome: 'empty', count: 0, attempts: 1 })
+    expect(engine.calls).toHaveLength(1)
+    expect(world.sleeps).toEqual([])
+    expect(world.core.pages).toHaveLength(1)
+    expect(world.core.pages[0]?.disposed).toBe(1)
+  })
+
+  it('empty: through the real engine a github API answer of zero items is outcome empty with attempts 1 and no backoff', async () => {
+    const rec = recordingCapture(async () => body('<html></html>'))
+    const world = makeWorld({
+      engine: makeDeps({ capture: rec.capture, fetchImpl: async () => new Response(JSON.stringify({ total_count: 0, items: [] }), { status: 200, headers: { 'content-type': 'application/json' } }) }),
+    })
+    const out = await world.svc.search(input({ query: 'zzzz-no-such-repo-0000' }))
+    expect(out.outcome).toBe('empty')
+    expect(out.attempts).toBe(1)
+    expect(world.sleeps).toEqual([])
+  })
+
+  it('decideRetry: an empty answer is never retried, so the cooldown is disarmed rather than armed', async () => {
+    const world = makeWorld({ strategies: scriptedEngine(response({ outcome: 'empty', results: [], count: 0 })).strategies })
+    await world.svc.search(input())
+    expect(await world.svc.guard.readProviderCooldown('github')).toBeNull()
+  })
+})
+
+describe('c00edea: noCaptureOutcome transport failures still retry up to maxAttempts [search-verbs.16]', () => {
+  it.each([
+    ['timeout', null],
+    ['error', 'socket closed'],
+  ] as const)('noCaptureOutcome %s: the attempts count reaches maxAttempts 3 with a recorded backoff sleep between attempts', async (expected, socketError) => {
+    expect(noCaptureOutcome(socketError)).toBe(expected)
+    const engine = scriptedEngine(failure(socketError))
+    const world = makeWorld({ strategies: engine.strategies })
+    const out = await world.svc.search(input({ maxAttempts: 3 }))
+    expect(out).toMatchObject({ outcome: expected, attempts: 3 })
+    expect(engine.calls).toHaveLength(3)
+    expect(world.sleeps).toHaveLength(2)
+    expect(world.sleeps.every((ms) => ms > 0)).toBe(true)
+    // every attempt got its own page and each was disposed
+    expect(world.core.pages).toHaveLength(3)
+    expect(world.core.pages.every((p) => p.disposed === 1)).toBe(true)
+  })
+
+  it('attempts: a transport failure followed by a success returns success with attempts 2', async () => {
+    const engine = scriptedEngine(failure(null), response())
+    const world = makeWorld({ strategies: engine.strategies })
+    expect(await world.svc.search(input())).toMatchObject({ outcome: 'success', attempts: 2 })
+    expect(world.sleeps).toHaveLength(1)
+  })
+
+  it('attempts: without maxAttempts the github provider retry config bounds the loop at 2', async () => {
+    const engine = scriptedEngine(failure(null))
+    const world = makeWorld({ strategies: engine.strategies })
+    expect(await world.svc.search(input())).toMatchObject({ outcome: 'timeout', attempts: 2 })
+  })
+
+  it("decideRetry onTimeout 'abort' stops after the first timeout: attempts 1, no sleep", async () => {
+    const engine = scriptedEngine(failure(null))
+    const world = makeWorld({ strategies: engine.strategies, providers: providersWithGithubRetry({ onTimeout: 'abort' }) })
+    const out = await world.svc.search(input({ maxAttempts: 3 }))
+    expect(out).toMatchObject({ outcome: 'timeout', attempts: 1 })
+    expect(engine.calls).toHaveLength(1)
+    expect(world.sleeps).toEqual([])
+  })
+
+  it('attempts: a transport failure arms no cooldown (only hostile outcomes do)', async () => {
+    const world = makeWorld({ strategies: scriptedEngine(failure('socket closed')).strategies })
+    await world.svc.search(input({ maxAttempts: 2 }))
+    expect(await world.svc.guard.readProviderCooldown('github')).toBeNull()
+  })
+})
diff --git a/entrypoint/stealth-search/test/unit/verbs/root.spec.ts b/entrypoint/stealth-search/test/unit/verbs/root.spec.ts
