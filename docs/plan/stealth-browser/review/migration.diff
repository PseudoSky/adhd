+/**
+ * guards: a second copy of the Google result-page walker lives in the search package, or the dead whitespace-split title fallback returns
+ * tier: S
+ * cites: ticket 8468f7b1 [fix-search-engine.2] [fix-search-engine.3]
+ * One Google SERP walker, kept in the core (OD-11, provisional). The search package's extractGoogleSerp
+ * delegates to the core walkDomTree structural mode; a Google fixture parses to the same titles, and the
+ * title fallback that split on runs of whitespace (dead, because the text helper already collapses
+ * whitespace) exists in neither package. Ticket 8468f7b1 · [fix-search-engine.2] [fix-search-engine.3]
+ */
+import { readFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+import { extractGoogleSerp } from '../../../src/lib/dom.js'
+import { fixture, htmlToDomTree } from '../../helpers/engine/harness.js'
+
+const here = dirname(fileURLToPath(import.meta.url))
+const searchDom = readFileSync(join(here, '..', '..', '..', 'src', 'lib', 'dom.ts'), 'utf8')
+const coreDom = readFileSync(join(here, '..', '..', '..', '..', '..', 'packages', 'stealth', 'stealth-core-browser', 'src', 'lib', 'capture', 'dom.ts'), 'utf8')
+
+describe('google serp through the single walker [fix-search-engine.2]', () => {
+  it('google fixture: the title of each result is its heading text, read by the single walker', async () => {
+    const results = await extractGoogleSerp(htmlToDomTree(fixture('google-serp.html')))
+    expect(results.map((r) => r.title)).toEqual(['pino - super fast, all natural JSON logger for Node.js', '11 Node.js logging best practices'])
+    expect(results[0]?.url).toBe('https://github.com/pinojs/pino')
+  })
+
+  it('google heading with inner whitespace: the title is whitespace-collapsed by the text helper, not split into chunks', async () => {
+    const html = '<div id="rso"><div><div><a jsname="a" href="https://a.test/x"><div><div><h3>Two   words\n  and   a gap</h3></div></div></a><span>x</span><p>y</p></div></div></div>'
+    const results = await extractGoogleSerp(htmlToDomTree(html))
+    expect(results.map((r) => r.title)).toEqual(['Two words and a gap'])
+  })
+
+  it('google anchor without a heading: the dead title fallback is gone, so no guessed title is produced', async () => {
+    const html =
+      '<div id="rso"><div><div><a jsname="a" href="https://a.test/x"><div><div><span>A short title</span><span>a.test deep breadcrumb path here</span></div></div></div></a><span>x</span><p>y</p></div></div>'
+    expect(await extractGoogleSerp(htmlToDomTree(html))).toEqual([])
+  })
+
+  it('google redirect href: the single walker normalizes the goto, protocol-relative and q= redirects', async () => {
+    const card = (href: string, title: string): string => `<div><a jsname="k" href="${href}"><div><div><h3>${title}</h3></div></div></a></div>`
+    const results = await extractGoogleSerp(htmlToDomTree(`<body>${card('/goto?url=abc', 'One')}${card('//example.com/p', 'Two')}${card('/url?q=https%3A%2F%2Fthree.test%2F&sa=U', 'Three')}</body>`))
+    expect(results.map((r) => r.url)).toEqual(['https://www.google.com/goto?url=abc', 'https://example.com/p', 'https://three.test/'])
+  })
+})
+
+describe('exactly one walker [fix-search-engine.3]', () => {
+  it('single walker: the search dom.ts holds no second copy of the google result-page walker helpers', () => {
+    for (const helper of ['hasDivDiv', 'findHeadingText', 'findSnippet', 'findContainer']) expect(searchDom).not.toMatch(new RegExp(`function ${helper}\\b`))
+    expect(searchDom).toContain('walkDomTree')
+  })
+
+  it('whitespace split fallback: the dead \\s{2,} title fallback exists in neither the search nor the core dom.ts', () => {
+    expect(searchDom).not.toMatch(/\\s\{2,\}/)
+    expect(coreDom).not.toMatch(/\\s\{2,\}/)
+  })
+
+  it('google walker lives in the core: the core dom.ts still holds hasDivDiv and findHeadingText', () => {
+    expect(coreDom).toContain('function hasDivDiv')
+    expect(coreDom).toContain('function findHeadingText')
+  })
+})
diff --git a/entrypoint/stealth-search/test/unit/engine/socket-closed.spec.ts b/entrypoint/stealth-search/test/unit/engine/socket-closed.spec.ts
new file mode 100644
index 000000000..c58c015d7
--- /dev/null
+++ b/entrypoint/stealth-search/test/unit/engine/socket-closed.spec.ts
@@ -0,0 +1,109 @@
+/**
+ * guards: a closed or erroring CDP socket hangs the search or escapes as an unhandled rejection instead of one fallback then outcome error
+ * tier: S
+ * cites: ticket 8468f7b1 [search-port-engine.9] [search-port-engine.14]
+ * A network-capture failure never hangs or escapes as an unhandled rejection (backlog 224e7a44): when the CDP socket
+ * closes or errors during capture the engine falls back once to the provider's next strategy when it declares one
+ * (the dom strategy for a provider with a dom config) and returns its results; when the fallback also fails it
+ * returns outcome error whose message names the cause.
+ * Ticket 8468f7b1 · [search-port-engine.9] [search-port-engine.14] · backlog 224e7a44.
+ */
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { getProvider } from '../../../src/lib/providers.js'
+import { networkSearch, runStrategies } from '../../../src/lib/network.js'
+import { captureFailure, fixture, FakePage, makeDeps, recordingCapture } from '../../helpers/engine/harness.js'
+
+const page = { pageWsUrl: 'ws://page', reveal: async () => undefined }
+const SOCKET_CLOSED = 'the CDP socket closed before any matching response was captured'
+const flush = (): Promise<void> => new Promise((resolve) => setImmediate(resolve))
+
+describe('224e7a44: socket closed during capture [search-port-engine.9]', () => {
+  const rejections: unknown[] = []
+  const listener = (reason: unknown): void => {
+    rejections.push(reason)
+  }
+  beforeEach(() => {
+    rejections.length = 0
+    process.on('unhandledRejection', listener)
+  })
+  afterEach(() => {
+    process.off('unhandledRejection', listener)
+  })
+
+  it('socket closed falls back to the dom strategy: duckduckgo returns the dom results and no unhandledRejection fires', async () => {
+    const rec = recordingCapture(async () => {
+      throw captureFailure('CAPTURE_SESSION_CLOSED', SOCKET_CLOSED)
+    })
+    const dom = new FakePage({ html: fixture('ddg-results.html') })
+    const r = await runStrategies(page, getProvider('duckduckgo'), 'tree-sitter', {}, makeDeps({ capture: rec.capture, connect: async () => dom }))
+    await flush()
+    await flush()
+    expect(rec.calls).toHaveLength(1)
+    expect(r.outcome).toBe('success')
+    expect(r.strategy).toBe('dom')
+    expect(r.count).toBe(3)
+    expect(dom.closed).toBe(1)
+    expect(rejections).toEqual([])
+  })
+
+  it('socket closed and the dom fallback also fails: outcome error whose message names the cause, no unhandledRejection', async () => {
+    const rec = recordingCapture(async () => {
+      throw captureFailure('CAPTURE_SESSION_CLOSED', SOCKET_CLOSED)
+    })
+    const dom = new FakePage({ html: '<html></html>', reject: { 'Page.navigate': 'Target closed' } })
+    const r = await runStrategies(page, getProvider('duckduckgo'), 'tree-sitter', {}, makeDeps({ capture: rec.capture, connect: async () => dom }))
+    await flush()
+    expect(r.outcome).toBe('error')
+    expect(r.strategy).toBe('dom')
+    expect(r.error).toBe('Target closed')
+    expect(rejections).toEqual([])
+  })
+
+  it('socket closed on a provider with no dom config (github): the fallback network call fails too and the error names the cause', async () => {
+    const rec = recordingCapture(async () => {
+      throw captureFailure('CAPTURE_SESSION_CLOSED', SOCKET_CLOSED)
+    })
+    const r = await runStrategies(page, getProvider('github'), 'vite', {}, makeDeps({ capture: rec.capture, fetchImpl: async () => new Response('', { status: 502 }) }))
+    await flush()
+    expect(r.outcome).toBe('error')
+    expect(r.error).toBe(SOCKET_CLOSED)
+    expect(rejections).toEqual([])
+  })
+
+  it('a socket closed when the page itself cannot open a dom session is an error outcome, not a throw', async () => {
+    const rec = recordingCapture(async () => {
+      throw captureFailure('CAPTURE_SESSION_CLOSED', SOCKET_CLOSED)
+    })
+    const r = await runStrategies(
+      page,
+      getProvider('duckduckgo'),
+      'x',
+      {},
+      makeDeps({
+        capture: rec.capture,
+        connect: async () => {
+          throw captureFailure('CAPTURE_CONNECT_FAILED', 'cannot connect to ws://page: WebSocket error')
+        },
+      }),
+    )
+    await flush()
+    expect(r.outcome).toBe('error')
+    expect(r.error).toContain('WebSocket error')
+    expect(rejections).toEqual([])
+  })
+
+  it('an unexpected exception inside the capture (not a typed capture error) becomes outcome error, falls back to dom and fires no unhandledRejection', async () => {
+    const rec = recordingCapture(async () => {
+      throw new TypeError('Cannot read properties of undefined')
+    })
+    const direct = await networkSearch('ws://page', getProvider('duckduckgo'), 'x', {}, makeDeps({ capture: rec.capture }))
+    expect(direct.outcome).toBe('error')
+    expect(direct.error).toBe('Cannot read properties of undefined')
+    const dom = new FakePage({ html: fixture('ddg-results.html') })
+    const r = await runStrategies(page, getProvider('duckduckgo'), 'x', {}, makeDeps({ capture: rec.capture, connect: async () => dom }))
+    await flush()
+    expect(r.outcome).toBe('success')
+    expect(r.strategy).toBe('dom')
+    expect(rejections).toEqual([])
+  })
+})
diff --git a/entrypoint/stealth-search/test/unit/engine/strategy-select.spec.ts b/entrypoint/stealth-search/test/unit/engine/strategy-select.spec.ts
new file mode 100644
index 000000000..686e4b638
--- /dev/null
+++ b/entrypoint/stealth-search/test/unit/engine/strategy-select.spec.ts
@@ -0,0 +1,143 @@
+/**
+ * guards: strategy index 0 runs the wrong view, or a dom strategy on a provider without dom config throws or touches a page
+ * tier: S
+ * cites: ticket 8468f7b1 [search-port-engine.14]
+ * The strategy pass is provider-shaped: strategy index 0 runs against the provider as given, a network strategy at
+ * index above 0 runs against fallbackView(provider), and a dom strategy on a provider with no dom config (github)
+ * returns outcome error without throwing, touching a page or entering a retry.
+ * Inventory rows [I-11] (strategy select), [I-11.a] (dom strategy without config errors).
+ * Ticket 8468f7b1 · [search-port-engine.14] · commit 591e1a7.
+ */
+import { describe, expect, it } from 'vitest'
+import { getProvider } from '../../../src/lib/providers.js'
+import { planStrategies, runStrategies } from '../../../src/lib/network.js'
+import { fallbackView } from '../../../src/lib/utils.js'
+import { body, fixture, FakePage, githubFixture, makeDeps, recordingCapture } from '../../helpers/engine/harness.js'
+
+const github = getProvider('github')
+const page = { pageWsUrl: 'ws://page', reveal: async () => undefined }
+const apiJson = JSON.stringify({ items: [{ full_name: 'vitejs/vite', html_url: 'https://github.com/vitejs/vite', description: 'tooling', stargazers_count: 1, language: 'TypeScript', forks_count: 2, updated_at: '2026-10-01' }] })
+
+describe('591e1a7: strategy select by index [search-port-engine.14]', () => {
+  it('strategy select: the plan follows primary then fallback, and a forced strategy is the only one', () => {
+    expect(planStrategies(getProvider('duckduckgo'))).toEqual(['network', 'dom'])
+    expect(planStrategies(getProvider('mdn'))).toEqual(['dom', 'network'])
+    expect(planStrategies(getProvider('maven'))).toEqual(['network'])
+    expect(planStrategies(github)).toEqual(['network', 'network'])
+    expect(planStrategies(getProvider('fetch'))).toEqual([])
+    expect(planStrategies(getProvider('duckduckgo'), 'dom')).toEqual(['dom'])
+    expect(planStrategies(getProvider('duckduckgo'), 'network')).toEqual(['network'])
+  })
+
+  it('fallbackView: github index 0 hits the API (direct fetch, no capture) and the index 1 fallback hits the page url pattern', async () => {
+    const fetched: string[] = []
+    const rec = recordingCapture(async () => body(githubFixture('repo-search.html'), { url: 'https://github.com/search?q=vite&type=repositories' }))
+    const r = await runStrategies(
+      page,
+      github,
+      'vite',
+      {},
+      makeDeps({
+        capture: rec.capture,
+        fetchImpl: async (url) => {
+          fetched.push(String(url))
+          return new Response('Server Error', { status: 500 })
+        },
+      }),
+    )
+    // index 0: the provider as given -> the REST API, fetched directly
+    expect(fetched).toEqual(['https://api.github.com/search/repositories?q=vite'])
+    // index 1: fallbackView(github) -> the rendered page, captured through the core
+    expect(rec.calls).toHaveLength(1)
+    const pattern = rec.calls[0]?.options.urlPattern as RegExp
+    expect(pattern.test('https://github.com/search?q=vite&type=repositories')).toBe(true)
+    expect(pattern.test('https://api.github.com/search/repositories?q=vite')).toBe(false)
+    expect(pattern.source).toBe(new RegExp(fallbackView(github).network?.urlPattern ?? '').source)
+    expect(rec.calls[0]?.options.navigateUrl).toBe(github.url('vite'))
+    expect(r.outcome).toBe('success')
+    expect(r.count).toBe(2)
+    expect(r.results[0]?.title).toBe('vitejs/vite')
+  })
+
+  it('index 0 success returns at once: the github API answer never runs the fallback', async () => {
+    const rec = recordingCapture(async () => body(''))
+    const r = await runStrategies(page, github, 'vite', {}, makeDeps({ capture: rec.capture, fetchImpl: async () => new Response(apiJson, { status: 200 }) }))
+    expect(r.outcome).toBe('success')
+    expect(rec.calls).toHaveLength(0)
+  })
+
+  it('index above 0 for a provider without fallbackNetwork runs against the provider itself (mdn: dom primary, network fallback)', async () => {
+    const mdn = getProvider('mdn')
+    const dom = new FakePage({ html: fixture('google-serp-empty.html') })
+    const rec = recordingCapture(async () => body(fixture('google-serp.html'), { url: 'https://www.google.com/search?q=x' }))
+    const r = await runStrategies(page, mdn, 'x', { timeoutMs: 20000 }, makeDeps({ capture: rec.capture, connect: async () => dom }))
+    // dom at index 0 found a results container with no organic cards -> empty -> falls back to the network strategy at index 1
+    expect(dom.methods()).toContain('DOM.getDocument')
+    expect(dom.closed).toBe(1)
+    expect(rec.calls).toHaveLength(1)
+    expect(rec.calls[0]?.options.urlPattern.source).toBe(new RegExp(fallbackView(mdn).network?.urlPattern ?? '').source)
+    expect(r.strategy).toBe('network')
+  })
+})
+
+describe('591e1a7: dom strategy without config errors [search-port-engine.14]', () => {
+  it('dom strategy without config errors: github forced to dom returns outcome error naming "no DOM strategy config", never throws', async () => {
+    const rec = recordingCapture(async () => body(''))
+    let sessions = 0
+    let fetches = 0
+    const r = await runStrategies(
+      page,
+      github,
+      'vite',
+      { strategy: 'dom' },
+      makeDeps({
+        capture: rec.capture,
+        connect: async () => {
+          sessions++
+          throw new TypeError('page must not be opened')
+        },
+        fetchImpl: async () => {
+          fetches++
+          return new Response('{}')
+        },
+      }),
+    )
+    expect(r.outcome).toBe('error')
+    expect(r.error).toBe('Provider "github" has no DOM strategy config')
+    expect(r.strategy).toBe('dom')
+    expect(r.attempts).toBe(1)
+    expect(r.count).toBe(0)
+    expect(rec.calls).toHaveLength(0)
+    expect(sessions).toBe(0)
+    expect(fetches).toBe(0)
+  })
+
+  it('github has no dom to fall back to: with the primary failing and the fallback failing the result is the last error, not a throw', async () => {
+    const rec = recordingCapture(async () => {
+      throw Object.assign(new Error('the CDP socket closed before any matching response was captured'), { code: 'CAPTURE_SESSION_CLOSED' })
+    })
+    const r = await runStrategies(page, github, 'vite', {}, makeDeps({ capture: rec.capture, fetchImpl: async () => new Response('', { status: 502 }) }))
+    expect(github.dom).toBeUndefined()
+    expect(r.outcome).toBe('error')
+    expect(r.strategy).toBe('network')
+    expect(r.error).toContain('socket closed')
+    expect(rec.calls).toHaveLength(1)
+  })
+
+  it('a provider that has a dom config accepts a forced dom strategy: duckduckgo over a result page at index 0', async () => {
+    const dom = new FakePage({ html: fixture('ddg-results.html') })
+    const rec = recordingCapture(async () => body(''))
+    const r = await runStrategies(page, getProvider('duckduckgo'), 'tree-sitter', { strategy: 'dom', timeoutMs: 8000 }, makeDeps({ capture: rec.capture, connect: async () => dom }))
+    expect(r.outcome).toBe('success')
+    expect(r.strategy).toBe('dom')
+    expect(r.count).toBe(3)
+    expect(rec.calls).toHaveLength(0)
+    expect(dom.closed).toBe(1)
+  })
+
+  it('no strategy to run (the fetch provider) is an error outcome, not a throw', async () => {
+    const r = await runStrategies(page, getProvider('fetch'), 'https://example.com', {}, makeDeps())
+    expect(r.outcome).toBe('error')
+    expect(r.error).toBe('No strategy to run')
+  })
+})
diff --git a/entrypoint/stealth-search/test/unit/engine/timeout.spec.ts b/entrypoint/stealth-search/test/unit/engine/timeout.spec.ts
new file mode 100644
index 000000000..66ab0dd33
--- /dev/null
+++ b/entrypoint/stealth-search/test/unit/engine/timeout.spec.ts
@@ -0,0 +1,112 @@
+/**
+ * guards: the capture wait ignores the request timeoutMs and uses a fixed 10 s on the primary, fallback or retry call
+ * tier: S
+ * cites: ticket 8468f7b1 [search-port-engine.13]
+ * The capture wait honours the request timeout: networkSearch passes the SearchInput timeoutMs (default 30000)
+ * as the capture wait for the primary call, the fallback call and the post-challenge retry call, never a fixed 10 s.
+ * Ticket 8468f7b1 · [search-port-engine.13] · commit 591e1a7.
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { getProvider } from '../../../src/lib/providers.js'
+import { networkSearch, runStrategies } from '../../../src/lib/network.js'
+import { body, exchange, exchangesCapture, fixture, FakePage, makeClock, makeDeps, recordingCapture } from '../../helpers/engine/harness.js'
+
+const arxiv = getProvider('arxiv')
+const ddgResults = fixture('ddg-results.html')
+const arxivPage = '<html><body><li class="arxiv-result"><p class="title is-5"><a href="/abs/2410.00001">A paper</a></p><span class="abstract-short">s</span></li></body></html>'
+
+describe('591e1a7: timeoutMs reaches the capture [search-port-engine.13]', () => {
+  beforeEach(() => {
+    vi.useFakeTimers()
+  })
+  afterEach(() => {
+    vi.useRealTimers()
+  })
+
+  it('14000: a response delivered at 14000 ms is captured with timeoutMs 30000 (a fixed 10 s would report timeout)', async () => {
+    const rec = recordingCapture(exchangesCapture([{ at: 14000, exchange: exchange({ url: 'https://arxiv.org/search/?query=x', status: 200, body: arxivPage }) }]))
+    const pending = networkSearch('ws://page', arxiv, 'x', { timeoutMs: 30000 }, makeDeps({ capture: rec.capture, now: () => Date.now() }))
+    await vi.advanceTimersByTimeAsync(14000)
+    const r = await pending
+    expect(r.outcome).toBe('success')
+    expect(r.count).toBe(1)
+    expect(rec.calls[0]?.options.timeoutMs).toBe(30000)
+    expect(r.tookMs).toBe(14000)
+  })
+
+  it('5000: the same response with timeoutMs 5000 is outcome timeout, reported at 5000 ms (not empty)', async () => {
+    const rec = recordingCapture(exchangesCapture([{ at: 14000, exchange: exchange({ url: 'https://arxiv.org/search/?query=x', status: 200, body: arxivPage }) }]))
+    const pending = networkSearch('ws://page', arxiv, 'x', { timeoutMs: 5000 }, makeDeps({ capture: rec.capture, now: () => Date.now() }))
+    await vi.advanceTimersByTimeAsync(5000)
+    const r = await pending
+    expect(r.outcome).toBe('timeout')
+    expect(r.error).toBe('nothing captured within 5000ms')
+    expect(r.tookMs).toBe(5000)
+    expect(rec.calls[0]?.options.timeoutMs).toBe(5000)
+  })
+
+  it('30000: with no timeoutMs given the capture wait is the 30000 default', async () => {
+    const rec = recordingCapture(exchangesCapture([{ at: 14000, exchange: exchange({ url: 'https://arxiv.org/search/?query=x', status: 200, body: arxivPage }) }]))
+    const pending = networkSearch('ws://page', arxiv, 'x', {}, makeDeps({ capture: rec.capture, now: () => Date.now() }))
+    await vi.advanceTimersByTimeAsync(14000)
