+  it('direct JSON fetch: the request carries an abort signal and a fetch timeout is outcome timeout', async () => {
+    let signal: AbortSignal | null | undefined
+    const r = await networkSearch(
+      '',
+      npm,
+      'ast-grep',
+      { timeoutMs: 1234 },
