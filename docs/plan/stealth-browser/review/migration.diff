+export function describeFailure(err: unknown): string {
+  if (isSearchError(err)) return `${err.code}: ${err.message}`
+  const msg = err instanceof Error ? err.message : String(err)
+  return `SEARCH_FAILED: fetch failed: ${msg}`
+}
