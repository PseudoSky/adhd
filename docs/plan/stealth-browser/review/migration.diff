+      resultSelector: '#rso',
+      fields: { title: '', url: '', snippet: '' },
+      extraWaitMs: 2000,
+    },
+    dom: {
+      waitFor: '#search',
+      structural: true,
+      extract: {
+        container: { tag: 'DIV' },
+        title: { tag: 'A' },
+        link: { tag: 'A', attr: 'href' },
+        snippet: { tag: 'DIV' },
+      },
+    },
+    bans: [
+      { name: 'google-captcha', signal: 'captcha', checkUrl: /\/sorry\// },
+      { name: 'cloudflare-challenge', signal: 'captcha', checkBody: /Just a moment\.\.\.|\/cdn-cgi\/challenge-platform\/|__cf_chl_|cf_chl_opt|window\._cf_chl|_fs-ch-|Client Challenge/i },
+      { name: 'cloudflare-captcha-widget', signal: 'captcha', checkBody: /challenges\.cloudflare\.com\/turnstile|www\.google\.com\/recaptcha\/api|hcaptcha\.com\/1\/api/i },
+    ],
+    retry: { maxAttempts: 3, baseDelayMs: 3000, onCaptcha: 'hitl', onRateLimit: 'retry', onTimeout: 'retry', onBan: 'abort' },
+  },
+
+  // ─── Fetch (arbitrary URL → markdown) ───────────────────────────────────────
+  // Not a search provider: the "query" IS the URL to fetch. Renders the page in a
+  // fresh COOKIELESS context (logged out), serializes the settled DOM, and returns
+  // it as markdown in `content`. Zero per-site config — the general web-fetch path.
+  // See search-fetch.ts / FETCH.md §2.3. The authenticated (session) tier is not
+  // built yet — an anonymous fetch that hits a bot wall reports the challenge
+  // rather than solving it.
+  fetch: {
+    id: 'fetch',
+    name: 'Fetch',
+    help: 'Fetch any URL and return it as markdown. The query IS the URL (e.g. `fetch https://react.dev`). Cookieless render, no per-site config. Returns markdown in `content`, not `results`.',
+    qualifierExamples: [],
+    url: (q) => q,
+    strategies: { primary: 'fetch' },
+    // Markers are STRUCTURAL (script paths, challenge tokens, widget hosts) — not
+    // prose — and are only consulted when the rendered page is near-empty
+    // (search-fetch.ts CHALLENGE_SPARSE_CHARS gate). A content-rich page that
+    // merely mentions these words in text is never flagged.
+    bans: [
+      { name: 'cloudflare-challenge', signal: 'captcha', checkBody: /Just a moment\.\.\.|\/cdn-cgi\/challenge-platform\/|__cf_chl_|cf_chl_opt|window\._cf_chl|_fs-ch-|Client Challenge/i },
+      { name: 'captcha-widget', signal: 'captcha', checkBody: /challenges\.cloudflare\.com\/turnstile|www\.google\.com\/recaptcha\/api|hcaptcha\.com\/1\/api/i },
+      { name: 'access-blocked', signal: 'banned', checkBody: /Attention Required! \| Cloudflare|Error 1020|error code: 1020|\/cdn-cgi\/error\//i },
+    ],
+    retry: { maxAttempts: 1, baseDelayMs: 0, onCaptcha: 'abort', onRateLimit: 'abort', onTimeout: 'abort', onBan: 'abort' },
+  },
+} satisfies Record<string, ProviderConfig>
+
+/** The id of every registered provider, in registration order. */
+export type ProviderName = keyof typeof PROVIDERS
+
+export const PROVIDER_NAMES = Object.keys(PROVIDERS) as ProviderName[]
+
+/** True when `name` is a registered provider id. */
+export function isProviderName(name: string): name is ProviderName {
+  return Object.prototype.hasOwnProperty.call(PROVIDERS, name)
+}
+
+/** The provider registered under `name`; throws UNKNOWN_PROVIDER (StealthSearchError) otherwise. */
+export function getProvider(name: string): ProviderConfig {
+  if (!isProviderName(name)) {
+    throw searchError('UNKNOWN_PROVIDER', `Unknown provider "${name}". Available: ${PROVIDER_NAMES.join(', ')}`, {
+      detail: { provider: name, available: PROVIDER_NAMES },
+    })
+  }
+  return PROVIDERS[name]
+}
diff --git a/entrypoint/stealth-search/src/lib/queries/last-search.ts b/entrypoint/stealth-search/src/lib/queries/last-search.ts
new file mode 100644
index 000000000..37a40a40c
--- /dev/null
+++ b/entrypoint/stealth-search/src/lib/queries/last-search.ts
@@ -0,0 +1,71 @@
+/**
+ * @adhd/stealth-search — src/lib/queries/last-search.ts
+ *
+ * Recovers the last search from the Chrome profile's history by reading the core
+ * `storage.history` API. For a Google results page the keyword is read from the visit URL's `q`
+ * parameter; when the URL carries none, from the history's own keyword-search-terms table.
+ * This file holds no SQL, no profile path and no database driver: the core owns all of that.
+ *
+ * Inventory row: I-31 (Google-history keyword recovery).
+ * Ticket 8468f7b1 · plan state search-port-providers.
+ */
+import { storage } from '@adhd/stealth-core-browser'
+import type { ChromeVisit } from '@adhd/stealth-core-browser'
+
+export interface LastSearchResult {
+  visit: ChromeVisit
+  isFromSearchEngine: boolean
+  /** Provider id of the engine whose results page the visit was, or null. */
+  searchEngine: string | null
+  /** The search keyword for a Google results page; null for every other visit. */
+  keyword: string | null
+}
+
+/** The slice of the core history client this module reads (the real `storage.HistoryClient` satisfies it). */
+export interface LastVisitSource {
+  getLastVisit(): ChromeVisit | null
+  getSearchTermsForUrl(url: string): Array<{ term: string; normalizedTerm: string }>
+}
+
+const SEARCH_ENGINE_PATTERNS: ReadonlyArray<readonly [string, RegExp]> = [
+  ['duckduckgo', /duckduckgo\.com\/html/],
+  ['google', /google\.com\/search/],
+  ['arxiv', /arxiv\.org\/search/],
+  ['github', /github\.com\/search/],
+  ['npm', /registry\.npmjs\.org/],
+  ['maven', /search\.maven\.org/],
+  ['wikipedia', /en\.wikipedia\.org\/w\/api/],
+  ['crates', /crates\.io\/api/],
+  ['pypi', /pypi\.org\/search/],
+]
+
+function googleKeyword(history: LastVisitSource, url: string): string | null {
+  try {
+    const q = new URL(url).searchParams.get('q')
+    if (q !== null && q.trim() !== '') return q.trim()
+  } catch {
+    // Not a parseable URL: fall through to the history's keyword table.
+  }
+  return history.getSearchTermsForUrl(url)[0]?.term ?? null
+}
+
+/**
+ * The last visit and, when it was a search-engine results page, which engine and (Google) which
+ * keyword. Null for an empty history. `history` defaults to the core's `storage.HistoryClient`
+ * on the default profile.
+ */
+export function getLastSearchFromHistory(history: LastVisitSource = new storage.HistoryClient()): LastSearchResult | null {
+  const visit = history.getLastVisit()
+  if (!visit) return null
+
+  const url = visit.url.toLowerCase()
+  const match = SEARCH_ENGINE_PATTERNS.find(([, pattern]) => pattern.test(url))
+  const searchEngine = match ? match[0] : null
+
+  return {
+    visit,
+    isFromSearchEngine: searchEngine !== null,
+    searchEngine,
+    keyword: searchEngine === 'google' ? googleKeyword(history, visit.url) : null,
+  }
+}
diff --git a/entrypoint/stealth-search/src/lib/search.ts b/entrypoint/stealth-search/src/lib/search.ts
