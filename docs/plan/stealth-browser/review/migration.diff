+/**
+ * guards: the unlock CLI exits with the wrong code, or confirms without the token
+ * tier: S
+ * cites: ticket 8468f7b1; [tripwire-interactive.4] TW27.
+ * Ticket 8468f7b1 - runUnlockCli over injected IO: usage (1), no lock (0),
+ * the forensic fields with (none) fallbacks, the unparseable-lock warning,
+ * the TTY confirm path (unlock-cli-tty), the CONFIRM env path
+ * (unlock-cli-env), mismatch (1, lock kept), No TTY without CONFIRM (1),
+ * storage errors (2), and the exact strings and stdout/stderr split of the
+ * reverse-apis unlock-tripwire bin.
+ * Criteria: [tripwire-interactive.4] TW27.
+ */
+import {
+  CONFIRM_TOKEN,
+  createTripwire,
+  runUnlockCli,
+  type Tripwire,
+} from '../../src/index';
+import { eventsOf, makeEnv, type Env } from '../helpers/harness';
+import { fakeIo } from '../helpers/io';
+
+/** The last element (the spec lib predates Array.prototype.at). */
+function last<T>(xs: readonly T[]): T | undefined {
+  return xs[xs.length - 1];
+}
+
+const KEY = 'testclient';
+
+async function trippedEnv(
+  context: Record<string, string | number> = {
+    lastStatus: 401,
+    lastOperationId: 'getProfile',
+  },
+): Promise<Env> {
+  const env = makeEnv();
+  await env.tw.trip(KEY, { reason: 'http-4xx', context });
+  return env;
+}
+
+describe('[tripwire-interactive.4] TW27 runUnlockCli', () => {
+  it('no key prints the usage line to stderr and returns 1', async () => {
+    const env = makeEnv();
+    for (const argv of [[], ['']]) {
+      const io = fakeIo();
+      expect(await runUnlockCli(argv, io, env.tw)).toBe(1);
+      expect(io.errLines).toEqual(['Usage: pnpm unlock-tripwire <client>']);
+      expect(io.outLines).toEqual([]);
+    }
+    const io = fakeIo();
+    expect(await runUnlockCli([], io, env.tw, { usage: 'Usage: x <key>' }))
+      .toBe(1);
+    expect(io.errLines).toEqual(['Usage: x <key>']);
+  });
+
+  it('no lock prints `no tripwire to unlock for X` to stdout and returns 0',
+    async () => {
+      const env = makeEnv();
+      const io = fakeIo();
+      expect(await runUnlockCli([KEY], io, env.tw)).toBe(0);
+      expect(io.outLines).toEqual([`no tripwire to unlock for ${KEY}`]);
+      expect(io.errLines).toEqual([]);
+      expect(io.prompts).toEqual([]);
+      expect(env.writes()).toEqual([]);
+    });
+
+  it('an invalid key returns 1 before any IO', async () => {
+    const env = makeEnv();
+    const io = fakeIo();
+    expect(await runUnlockCli(['../../lib/etc'], io, env.tw)).toBe(1);
+    expect(io.errText()).toContain('invalid tripwire key');
+    expect(env.mfs.ops).toEqual([]);
+  });
+
+  it('prints reason, trippedAt, lastStatus and lastOperationId', async () => {
+    const env = await trippedEnv();
+    const trippedAt = (await env.tw.read(KEY)).record?.trippedAt;
+    const io = fakeIo([CONFIRM_TOKEN]);
+    expect(await runUnlockCli([KEY], io, env.tw, {
+      lockPath: env.lockPath,
+    })).toBe(0);
+    expect(io.errLines.slice(0, 5)).toEqual([
+      `Tripwire lock for "${KEY}" at ${env.lockPath(KEY)}:`,
+      '  reason:          http-4xx',
+      `  trippedAt:       ${trippedAt}`,
+      '  lastStatus:      401',
+      '  lastOperationId: getProfile',
+    ]);
+    expect(io.outLines).toEqual([
+      `unlocked tripwire for ${KEY} (removed ${env.lockPath(KEY)})`,
+    ]);
+  });
+
+  it('missing fields print (none); without lockPath only the key is named',
+    async () => {
+      const env = await trippedEnv({});
+      const io = fakeIo([CONFIRM_TOKEN]);
+      expect(await runUnlockCli([KEY], io, env.tw)).toBe(0);
+      expect(io.errLines.slice(0, 5)).toEqual([
+        `Tripwire lock for "${KEY}":`,
+        '  reason:          http-4xx',
+        expect.stringMatching(/^ {2}trippedAt: {7}\d{4}-\d\d-\d\dT/),
+        '  lastStatus:      (none)',
+        '  lastOperationId: (none)',
+      ]);
+      expect(io.outLines).toEqual([`unlocked tripwire for ${KEY}`]);
+    });
+
+  it('a legacy flat reverse lock is shown field by field', async () => {
+    const env = makeEnv();
+    env.mfs.writeText(env.lockPath(KEY), JSON.stringify({
+      reason: 'http-4xx',
+      trippedAt: '2026-01-02T03:04:05.000Z',
+      lastStatus: 403,
+      lastOperationId: 'swipe',
+    }), 0o600);
+    const io = fakeIo([], { env: { CONFIRM: CONFIRM_TOKEN } });
+    expect(await runUnlockCli([KEY], io, env.tw)).toBe(0);
+    expect(io.errLines).toEqual([
+      `Tripwire lock for "${KEY}":`,
+      '  reason:          http-4xx',
+      '  trippedAt:       2026-01-02T03:04:05.000Z',
+      '  lastStatus:      403',
+      '  lastOperationId: swipe',
+    ]);
+    expect(env.mfs.exists(env.lockPath(KEY))).toBe(false);
+  });
+
+  it('an unparseable lock warns, prints (none) everywhere and proceeds',
+    async () => {
+      const env = makeEnv();
+      env.mfs.writeText(env.lockPath(KEY), '{"reason": "http-4', 0o600);
+      const io = fakeIo([], { env: { CONFIRM: CONFIRM_TOKEN } });
+      expect(await runUnlockCli([KEY], io, env.tw, {
+        lockPath: env.lockPath,
+      })).toBe(0);
+      expect(io.errLines).toEqual([
+        `warning: lock at ${env.lockPath(KEY)} could not be parsed as ` +
+          'JSON: corrupt',
+        `Tripwire lock for "${KEY}" at ${env.lockPath(KEY)}:`,
+        '  reason:          (none)',
+        '  trippedAt:       (none)',
+        '  lastStatus:      (none)',
+        '  lastOperationId: (none)',
+      ]);
+      expect(env.mfs.exists(env.lockPath(KEY))).toBe(false);
+      const empty = makeEnv();
+      empty.mfs.writeText(empty.lockPath(KEY), '', 0o600);
+      const io2 = fakeIo([], { env: { CONFIRM: CONFIRM_TOKEN } });
+      expect(await runUnlockCli([KEY], io2, empty.tw)).toBe(0);
+      expect(io2.errLines[0]).toBe(
+        `warning: lock for ${KEY} could not be parsed as JSON: empty`,
+      );
+    });
+
+  it('TTY path: the trimmed answer confirms; audit method unlock-cli-tty',
+    async () => {
+      const env = await trippedEnv();
+      const io = fakeIo([`  ${CONFIRM_TOKEN}  `]);
+      expect(await runUnlockCli([KEY], io, env.tw, { actor: 'op' }))
+        .toBe(0);
+      expect(io.prompts).toEqual([`Type '${CONFIRM_TOKEN}' to confirm: `]);
+      expect(env.mfs.exists(env.lockPath(KEY))).toBe(false);
+      expect(eventsOf(env, 'tripwire-cleared')).toEqual([
+        expect.objectContaining({ method: 'unlock-cli-tty', actor: 'op' }),
+      ]);
+    });
+
+  it('CONFIRM env path: no prompt even on a TTY; audit method unlock-cli-env',
+    async () => {
+      for (const isTTY of [false, true]) {
+        const env = await trippedEnv();
+        const io = fakeIo(['wrong'], {
+          isTTY,
+          env: { CONFIRM: CONFIRM_TOKEN },
+        });
+        expect(await runUnlockCli([KEY], io, env.tw)).toBe(0);
+        expect(io.prompts).toEqual([]);
+        expect(eventsOf(env, 'tripwire-cleared')).toEqual([
+          expect.objectContaining({ method: 'unlock-cli-env' }),
+        ]);
+      }
+    });
+
+  it('a mismatch returns 1 and keeps the lock (TTY, env, untrimmed env, ' +
+    'empty env)', async () => {
+    const cases = [
+      fakeIo(['i-understand-the-risk']),
+      fakeIo([], { env: { CONFIRM: 'yes' } }),
+      fakeIo([], { env: { CONFIRM: ` ${CONFIRM_TOKEN}` } }),
+      fakeIo([], { env: { CONFIRM: '' } }),
+    ];
+    for (const io of cases) {
+      const env = await trippedEnv();
+      const before = env.mfs.readText(env.lockPath(KEY));
+      expect(await runUnlockCli([KEY], io, env.tw)).toBe(1);
+      expect(last(io.errLines)).toBe(
+        '\nConfirmation mismatch. Lock NOT removed.',
+      );
+      expect(io.outLines).toEqual([]);
+      expect(env.mfs.readText(env.lockPath(KEY))).toBe(before);
+      expect(eventsOf(env, 'tripwire-cleared')).toHaveLength(0);
+    }
+  });
+
+  it('no TTY and no CONFIRM returns 1 with `No TTY`, lock kept', async () => {
+    const env = await trippedEnv();
+    const io = fakeIo([CONFIRM_TOKEN], { isTTY: false });
+    expect(await runUnlockCli([KEY], io, env.tw)).toBe(1);
+    expect(io.prompts).toEqual([]);
+    expect(last(io.errLines)).toBe(
+      '\nNo TTY detected and CONFIRM env var is unset. ' +
+        `Re-run interactively or set CONFIRM=${CONFIRM_TOKEN}.`,
+    );
+    expect(env.mfs.exists(env.lockPath(KEY))).toBe(true);
+  });
+
+  it('EOF at the TTY prompt returns 1, lock kept', async () => {
+    const env = await trippedEnv();
+    const io = fakeIo([null]);
+    expect(await runUnlockCli([KEY], io, env.tw)).toBe(1);
+    expect(io.errText()).toContain('Lock NOT removed.');
+    expect(env.mfs.exists(env.lockPath(KEY))).toBe(true);
+  });
+
+  it('a storage error while clearing returns 2, lock kept', async () => {
+    const env = await trippedEnv();
+    env.mfs.failOn({ op: 'rename', path: /\.lock$/, code: 'EIO' });
+    const io = fakeIo([], { env: { CONFIRM: CONFIRM_TOKEN } });
+    expect(await runUnlockCli([KEY], io, env.tw)).toBe(2);
+    expect(last(io.errLines)).toMatch(
+      /^failed to unlock: Tripwire clear failed: /,
+    );
+    expect(io.outLines).toEqual([]);
+    expect(env.mfs.exists(env.lockPath(KEY))).toBe(true);
+  });
+
+  it('an unexpected read failure returns 2', async () => {
+    const env = makeEnv();
+    const tw: Tripwire = {
+      ...env.tw,
+      read: () => Promise.reject(new Error('disk on fire')),
+    };
+    const io = fakeIo();
+    expect(await runUnlockCli([KEY], io, tw)).toBe(2);
+    expect(io.errLines).toEqual(['failed to read tripwire: disk on fire']);
+  });
+
+  it('a lock removed by someone else between read and clear: 0, nothing ' +
+    'to unlock', async () => {
+    const env = await trippedEnv();
+    const tw: Tripwire = {
+      ...env.tw,
+      clear: () => Promise.resolve({ cleared: false }),
+    };
+    const io = fakeIo([CONFIRM_TOKEN]);
+    expect(await runUnlockCli([KEY], io, tw)).toBe(0);
+    expect(io.outLines).toEqual([`no tripwire to unlock for ${KEY}`]);
+  });
+
+  it('an expired lock is still offered for unlock', async () => {
+    const env = makeEnv({ expiry: { ttlMs: 1000 } });
+    await env.tw.trip(KEY, { reason: 'http-4xx', context: {} });
+    env.clock.advance(5000);
+    const io = fakeIo([CONFIRM_TOKEN]);
+    expect(await runUnlockCli([KEY], io, env.tw)).toBe(0);
+    expect(io.outLines).toEqual([`unlocked tripwire for ${KEY}`]);
+    expect(env.mfs.exists(env.lockPath(KEY))).toBe(false);
+  });
+
+  it('works on an open-policy instance too', async () => {
+    const env = makeEnv();
+    const tw = createTripwire({
+      namespace: 'n',
+      stateDir: '/state',
+      fs: env.mfs,
+      clearPolicy: 'open',
+      actor: 'x',
+    });
+    await tw.trip(KEY, { reason: 'captcha', context: {} });
+    const io = fakeIo([CONFIRM_TOKEN]);
+    expect(await runUnlockCli([KEY], io, tw)).toBe(0);
+    expect(env.mfs.exists(env.lockPath(KEY))).toBe(false);
+  });
+});
diff --git a/packages/resilience/resilience-core-tripwire/test/unit/errors.spec.ts b/packages/resilience/resilience-core-tripwire/test/unit/errors.spec.ts
new file mode 100644
index 000000000..050f5a57b
--- /dev/null
+++ b/packages/resilience/resilience-core-tripwire/test/unit/errors.spec.ts
@@ -0,0 +1,246 @@
+/**
+ * guards: a typed error loses its code or brand so cross-copy detection fails, or a response body is persisted
+ * tier: S
+ * cites: ticket 8468f7b1; [tripwire-core.26] TW32, [tripwire-core.27] TW33.
+ * Ticket 8468f7b1 - typed errors: a stable `code` from the closed registry
+ * and the brand Symbol.for('adhd.tripwire.error') on every error class, so
+ * isTripwireError / isTripwireTrippedError recognise an error thrown by a
+ * duplicate copy of the package (where `instanceof` fails); and
+ * TripwireTrippedError.fromRecord carries typed, memory-only responseStatus
+ * and responseBody that are never serialized, written to the lock or
+ * audited.
+ * Criteria: [tripwire-core.26] TW32, [tripwire-core.27] TW33.
+ */
+import {
+  createTripwire,
+  isTripwireError,
+  isTripwireTrippedError,
+  TripwireAbortedError,
+  TripwireConfirmError,
+  TripwireError,
+  TripwireIoError,
+  TripwireKeyError,
+  TripwireTrippedError,
+  type TripwireErrorCode,
+  type TripwireRecord,
+} from '../../src/index';
+import {
+  TRIPWIRE_ERROR_BRAND,
+  TRIPWIRE_ERROR_CODES,
+} from '../../src/lib/errors';
+import { makeEnv, rejectionOf } from '../helpers/harness';
+
+/** The brand, spelled independently of this module's copy. */
+const BRAND = Symbol.for('adhd.tripwire.error');
+
+const REGISTRY: readonly TripwireErrorCode[] = [
+  'TRIPWIRE_TRIPPED',
+  'TRIPWIRE_CONFIRM_REQUIRED',
+  'TRIPWIRE_ABORTED',
+  'TRIPWIRE_INVALID_KEY',
+  'TRIPWIRE_IO',
+];
+
+const RECORD: TripwireRecord = {
+  schema: 1,
+  key: 'tinder',
+  namespace: 'request-builder',
+  reason: 'http-4xx',
+  trippedAt: '2026-10-12T00:00:00.000Z',
+  trippedBy: { pid: 42 },
+  blockedCount: 0,
+  context: {
+    lastStatus: 401,
+    lastOperationId: 'getMe',
+  },
+};
+
+/**
+ * Structural stand-in for an error created by a DUPLICATE module copy: a
+ * plain Error (not an instance of this copy's classes) carrying the
+ * registry brand and code exactly as the other copy would set them.
+ */
+function foreignError(code: string, extra: Record<string, unknown> = {}) {
+  const e = Object.assign(new Error('from another copy'), {
+    code,
+    ...extra,
+  }) as unknown as Error & Record<PropertyKey, unknown>;
+  e[BRAND] = true;
+  return e;
+}
+
+describe('[tripwire-core.26] TW32 stable code and brand on every error', () => {
+  const instances: Array<[string, TripwireError, TripwireErrorCode]> = [
+    ['TripwireTrippedError', TripwireTrippedError.fromRecord(RECORD),
+      'TRIPWIRE_TRIPPED'],
+    ['TripwireConfirmError', new TripwireConfirmError('k'),
+      'TRIPWIRE_CONFIRM_REQUIRED'],
+    ['TripwireKeyError', new TripwireKeyError('../../lib/x'), 'TRIPWIRE_INVALID_KEY'],
+    ['TripwireIoError', new TripwireIoError('trip.persist', new Error('EIO')),
+      'TRIPWIRE_IO'],
+    ['TripwireAbortedError', new TripwireAbortedError(), 'TRIPWIRE_ABORTED'],
+  ];
+
+  it('the registry is exactly the five codes', () => {
+    expect([...TRIPWIRE_ERROR_CODES].sort()).toEqual([...REGISTRY].sort());
+    expect(TRIPWIRE_ERROR_BRAND).toBe(BRAND);
+  });
+
+  it.each(instances)('%s has a registry code, the brand and its name',
+    (name, err, code) => {
+      expect(err.code).toBe(code);
+      expect(REGISTRY).toContain(err.code);
+      expect((err as unknown as Record<symbol, unknown>)[BRAND]).toBe(true);
+      expect(err.name).toBe(name);
+      expect(err).toBeInstanceOf(TripwireError);
+      expect(err).toBeInstanceOf(Error);
+      expect(isTripwireError(err)).toBe(true);
+      expect(isTripwireTrippedError(err)).toBe(code === 'TRIPWIRE_TRIPPED');
+    });
+
+  it('isTripwireTrippedError is true for a structural clone from a '
+    + 'duplicate module copy (brand + code, no instanceof)', () => {
+    const clone = foreignError('TRIPWIRE_TRIPPED', {
+      key: 'tinder',
+      reason: 'http-4xx',
+    });
+    expect(clone).not.toBeInstanceOf(TripwireTrippedError);
+    expect(clone).not.toBeInstanceOf(TripwireError);
+    expect(isTripwireError(clone)).toBe(true);
+    expect(isTripwireTrippedError(clone)).toBe(true);
+    // every registry code is recognised the same way
+    for (const code of REGISTRY) {
+      expect(isTripwireError(foreignError(code))).toBe(true);
+      expect(isTripwireTrippedError(foreignError(code)))
+        .toBe(code === 'TRIPWIRE_TRIPPED');
+    }
+  });
+
+  it('rejects look-alikes: brand with an unknown code, code without the '
+    + 'brand, a plain Error with .code, non-objects', () => {
+    expect(isTripwireError(foreignError('TRIPWIRE_NOPE'))).toBe(false);
+    expect(isTripwireTrippedError(foreignError('ENOENT'))).toBe(false);
+    const unbranded = Object.assign(new Error('x'), {
+      code: 'TRIPWIRE_TRIPPED',
+    });
+    expect(isTripwireError(unbranded)).toBe(false);
+    expect(isTripwireTrippedError(unbranded)).toBe(false);
+    const wrongBrand = foreignError('TRIPWIRE_TRIPPED');
+    wrongBrand[BRAND] = 'yes';
+    expect(isTripwireTrippedError(wrongBrand)).toBe(false);
+    for (const v of [null, undefined, 'TRIPWIRE_TRIPPED', 42, {}]) {
+      expect(isTripwireError(v)).toBe(false);
+      expect(isTripwireTrippedError(v)).toBe(false);
+    }
+  });
+
+  it('errors thrown by the latch carry their codes', async () => {
+    const env = makeEnv();
+    const keyErr = await rejectionOf(env.tw.read('../../lib/escape'));
+    expect(isTripwireError(keyErr)).toBe(true);
+    expect((keyErr as TripwireError).code).toBe('TRIPWIRE_INVALID_KEY');
+    await env.tw.trip('k', {
+      reason: 'captcha',
+      context: {},
+    });
+    const confirm = await rejectionOf(env.tw.clear('k', {
+      method: 'programmatic-confirm',
+      confirm: 'wrong',
+    }));
+    expect((confirm as TripwireError).code).toBe('TRIPWIRE_CONFIRM_REQUIRED');
+    const tripped = await rejectionOf(env.tw.assertOpen('k'));
+    expect(isTripwireTrippedError(tripped)).toBe(true);
+    env.mfs.failOn({
+      op: 'rename',
+      path: env.lockPath('k'),
+      code: 'EACCES',
+    });
+    const io = await rejectionOf(env.tw.clear('k', {
+      method: 'programmatic-confirm',
+      confirm: 'I-UNDERSTAND-THE-RISK',
+    }));
+    expect((io as TripwireIoError).code).toBe('TRIPWIRE_IO');
+    expect(((io as TripwireIoError).cause as { code: string }).code)
+      .toBe('EACCES');
+  });
+});
+
+describe('[tripwire-core.27] TW33 fromRecord responseStatus / responseBody',
+  () => {
+    const SENTINEL = 'SENTINEL-BODY-7f3a';
+
+    it('exposes typed fields and the record', () => {
+      const err = TripwireTrippedError.fromRecord(RECORD, {
+        responseStatus: 401,
+        responseBody: {
+          error: SENTINEL,
+        },
+      });
+      const status: number | undefined = err.responseStatus;
+      const body: unknown = err.responseBody;
+      expect(status).toBe(401);
+      expect(body).toEqual({ error: SENTINEL });
+      expect(err.key).toBe('tinder');
+      expect(err.reason).toBe('http-4xx');
+      expect(err.trippedAt).toBeInstanceOf(Date);
+      expect(err.trippedAt.toISOString()).toBe(RECORD.trippedAt);
+      expect(err.record).toBe(RECORD);
+      expect(typeof err.recoveryHint).toBe('string');
+      expect(err.code).toBe('TRIPWIRE_TRIPPED');
+    });
+
+    it('responseBody is non-enumerable and never serialized', () => {
+      const err = TripwireTrippedError.fromRecord(RECORD, {
+        responseStatus: 403,
+        responseBody: SENTINEL,
+      });
+      expect(Object.keys(err)).not.toContain('responseBody');
+      const json = JSON.stringify(err);
+      expect(json).not.toContain(SENTINEL);
+      expect(json).not.toContain('responseBody');
+      expect(JSON.parse(json)).toMatchObject({
+        code: 'TRIPWIRE_TRIPPED',
+        responseStatus: 403,
+      });
+      // the record's context is not part of the JSON form either
+      expect(json).not.toContain('getMe');
+      const plain = TripwireTrippedError.fromRecord(RECORD);
+      expect(plain.responseStatus).toBeUndefined();
+      expect(plain.responseBody).toBeUndefined();
+    });
+
+    it('trip never writes responseStatus or responseBody to the lock or the '
+      + 'audit', async () => {
+      const env = makeEnv();
+      const tw = createTripwire({
+        namespace: 'request-builder',
+        stateDir: '/state',
+        fs: env.mfs,
+        clock: env.clock.fn,
+        actor: 'tester',
+      });
+      // a consumer that (wrongly) puts the body into the context
+      const r = await tw.trip('tinder', {
+        reason: 'http-4xx',
+        context: {
+          lastStatus: 401,
+          lastOperationId: 'getMe',
+          responseBody: SENTINEL,
+        },
+      });
+      const err = TripwireTrippedError.fromRecord(r.record, {
+        responseStatus: 401,
+        responseBody: SENTINEL,
+      });
+      expect(err.responseBody).toBe(SENTINEL);
+      await tw.gate('tinder');
+      await rejectionOf(tw.assertOpen('tinder'));
+      const lock = env.mfs.readText(env.lockPath('tinder')) as string;
+      const audit = env.auditText();
+      for (const text of [lock, audit]) {
+        expect(text).not.toContain(SENTINEL);
+        expect(text).not.toContain('responseStatus');
+      }
+      expect(JSON.parse(lock).context).not.toHaveProperty('responseBody');
+    });
+  });
diff --git a/packages/resilience/resilience-core-tripwire/test/unit/expiry.spec.ts b/packages/resilience/resilience-core-tripwire/test/unit/expiry.spec.ts
new file mode 100644
index 000000000..b880e2b80
--- /dev/null
+++ b/packages/resilience/resilience-core-tripwire/test/unit/expiry.spec.ts
@@ -0,0 +1,119 @@
+/**
+ * guards: an expired lock still blocks, or a lock without a ttl expires
+ * tier: S
+ * cites: ticket 8468f7b1; [tripwire-core.13] TW13.
+ * Ticket 8468f7b1 - optional expiry: an older-than-ttlMs lock is open and
+ * lazily removed with exactly one tripwire-expired audit; without expiry a
+ * lock never expires; status hides expired locks unless includeExpired
+ * (one rule for the CLI and the MCP surface).
+ * Criteria: [tripwire-core.13] TW13.
+ */
+import { exploreExhaustive } from '../helpers/explore';
+import { eventsOf, makeEnv } from '../helpers/harness';
