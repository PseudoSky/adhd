# pnpm settings for the @adhd monorepo.
#
# node-linker=hoisted — lay external deps out FLAT at the workspace root, exactly
#   like the outgoing yarn Berry config (.yarnrc.yml `nodeLinker: node-modules`).
#   This keeps the install behaviourally faithful to the pre-migration state
#   (every project resolves the single hoisted copy of each external dep) so the
#   migration does NOT force a 54-package per-project dependency-range
#   reconciliation up front. Workspace @adhd/* packages are still symlinked into
#   node_modules/@adhd/ regardless of linker — that linking is the whole point.
node-linker=hoisted

# Internal @adhd/* deps are declared with plain semver ranges (e.g. "^0.1.0"),
# NOT the pnpm `workspace:` protocol. Default pnpm only links `workspace:`-protocol
# deps and fetches everything else from the registry (→ 404 for our unpublished
# internal packages). These two settings tell pnpm to link a local workspace
# package whenever its on-disk version satisfies the declared range, and to prefer
# that local copy over the registry — reproducing yarn's behaviour and leaving the
# source dep ranges (hence the publish contract) untouched.
link-workspace-packages=true
prefer-workspace-packages=true

# The pre-migration graph installed cleanly under yarn's lenient peer handling;
# don't let a pre-existing peer-range mismatch (not introduced here) hard-fail
# the install. Peers are still auto-installed; they just don't gate.
strict-peer-dependencies=false
auto-install-peers=true
