{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "module": "esnext",
    "moduleResolution": "bundler",
    "composite": false,
    "noEmit": true,
    "rootDir": "../../..",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ]
  },
  "exclude": [
  ],
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "src/**/*.d.ts"
  ]
}
