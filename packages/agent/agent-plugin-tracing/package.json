    "vendor",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@adhd/agent-base-types": "^2.3.7"
  },
  "dependencies": {
    "@adhd/sox-telemetry": "file:./vendor/adhd-sox-telemetry-0.4.2-logchannel.03a776c8.tgz",
    "tslib": "^2.6.0",
    "zod": "^4.4.3"
  },
  "keywords": [
    "agent",
    "tracing",
    "telemetry",
    "plugin",
    "observability",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PseudoSky/adhd.git",
    "directory": "packages/agent/agent-plugin-tracing"
  },
  "homepage": "https://github.com/PseudoSky/adhd/tree/main/packages/agent/agent-plugin-tracing#readme",
  "bugs": {
    "url": "https://github.com/PseudoSky/adhd/issues"
  },
  "devDependencies": {
    "@adhd/agent-engine-orchestrator": "^2.3.6",
    "@adhd/agent-store-runtime": "^2.2.5",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "12.10.0",
    "drizzle-orm": "0.45.2"
  }
}
