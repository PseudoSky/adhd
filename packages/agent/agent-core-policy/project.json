{
  "name": "agent-core-policy",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/agent/agent-core-policy/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["{projectRoot}"]
    }
  },
  "tags": ["layer:ai", "platform:node"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/agent/agent-core-policy/dist",
        "main": "packages/agent/agent-core-policy/src/index.ts",
        "tsConfig": "packages/agent/agent-core-policy/tsconfig.lib.json",
        "clean": true,
        "assets": [
          {
            "input": "packages/agent/agent-core-policy",
            "glob": "drizzle/**/*",
            "output": "."
          }
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/agent/agent-core-policy/tsconfig.typecheck.json --noEmit"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist/packages/agent/agent-core-policy"
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ],
      "options": {
        "packageRoot": "{projectRoot}/dist"
      }
    }
  }
}
