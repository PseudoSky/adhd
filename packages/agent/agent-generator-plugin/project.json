{
  "name": "agent-generator-plugin",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/agent/agent-generator-plugin/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["{projectRoot}"]
    }
  },
  "tags": ["layer:logic", "platform:node"],
  "implicitDependencies": ["!workspace-base-vite-paths"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/agent/agent-generator-plugin/dist",
        "main": "packages/agent/agent-generator-plugin/src/index.ts",
        "tsConfig": "packages/agent/agent-generator-plugin/tsconfig.lib.json",
        "clean": true,
        "assets": [
          "packages/agent/agent-generator-plugin/*.md",
          {
            "input": "packages/agent/agent-generator-plugin",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "packages/agent/agent-generator-plugin/src/generators",
            "glob": "**/__files__/**/*",
            "output": "./src/generators"
          },
          {
            "input": "packages/agent/agent-generator-plugin/src/generators",
            "glob": "**/schema.json",
            "output": "./src/generators"
          }
        ]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "configFile": "packages/agent/agent-generator-plugin/vite.config.ts",
        "reportsDirectory": "../../../coverage/packages/agent/agent-generator-plugin"
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ],
      "options": {
        "packageRoot": "{projectRoot}/dist"
      }
    }
  }
}
