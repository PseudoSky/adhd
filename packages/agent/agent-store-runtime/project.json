{
  "name": "agent-store-runtime",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/agent/agent-store-runtime/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["{projectRoot}"]
    }
  },
  "tags": [
    "domain:agent",
    "pkg-kind:store",
    "pkg-class:foundation",
    "layer:data",
    "platform:node"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/agent/agent-store-runtime/dist",
        "main": "packages/agent/agent-store-runtime/src/index.ts",
        "tsConfig": "packages/agent/agent-store-runtime/tsconfig.lib.json",
        "clean": true,
        "assets": [
          {
            "input": "packages/agent/agent-store-runtime",
            "glob": "drizzle/**/*",
            "output": "."
          }
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/agent/agent-store-runtime/tsconfig.typecheck.json --noEmit"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist/packages/agent/agent-store-runtime"
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ],
      "options": {
        "packageRoot": "{projectRoot}/dist"
      }
    }
  }
}
