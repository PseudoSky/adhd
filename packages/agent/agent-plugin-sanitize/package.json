{
  "name": "@adhd/agent-plugin-sanitize",
  "version": "0.0.1",
  "description": "Sub-agent output sanitization plugin for @adhd/agent-mcp — configurable strategies (prefix, wrap, none) to defend against prompt injection across agent boundaries",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@adhd/agent-base-types": "*"
  },
  "dependencies": {
    "zod": "*"
  }
}
