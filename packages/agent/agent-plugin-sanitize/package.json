{
  "name": "@adhd/agent-plugin-sanitize",
  "version": "0.1.1",
  "description": "Sub-agent output sanitization plugin for @adhd/agent-mcp — configurable strategies (prefix, wrap, none) to defend against prompt injection across agent boundaries",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@adhd/agent-base-types": "^2.3.0"
  },
  "dependencies": {
    "zod": "*"
  },
  "keywords": [
    "agent",
    "sanitize",
    "prompt-injection",
    "llm",
    "security",
    "mcp",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PseudoSky/adhd.git",
    "directory": "packages/agent/agent-plugin-sanitize"
  },
  "homepage": "https://github.com/PseudoSky/adhd/tree/main/packages/agent/agent-plugin-sanitize#readme",
  "bugs": {
    "url": "https://github.com/PseudoSky/adhd/issues"
  }
}
