{
  "name": "workspace-base-tools",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/workspace/workspace-base-tools/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": [
    "domain:workspace",
    "pkg-kind:base",
    "pkg-class:foundation",
    "layer:logic",
    "platform:shared",
    "access:public",
    "publish:npm"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "packages/workspace/workspace-base-tools/dist",
        "main": "packages/workspace/workspace-base-tools/src/index.ts",
        "tsConfig": "packages/workspace/workspace-base-tools/tsconfig.lib.json",
        "assets": [
          {
            "input": "packages/workspace/workspace-base-tools",
            "glob": "*.md",
            "output": "."
          }
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "{projectRoot}/dist"
      },
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ]
    },
    "test": {
      "executor": "@nx/vite:test",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": [
            "vitest"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/coverage/packages/workspace/workspace-base-tools"
      ],
      "options": {
        "vitestConfig": "packages/workspace/workspace-base-tools/vite.config.ts"
      }
    }
  }
}
