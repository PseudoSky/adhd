{
  "name": "workspace-base-tools",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/workspace/workspace-base-tools/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["{projectRoot}"]
    }
  },
  "tags": [
    "domain:workspace",
    "pkg-kind:base",
    "pkg-class:foundation",
    "layer:logic",
    "platform:shared",
    "access:public",
    "publish:npm"
  ],
  "implicitDependencies": ["!workspace-base-vite-paths"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/workspace/workspace-base-tools/dist",
        "main": "packages/workspace/workspace-base-tools/src/index.ts",
        "tsConfig": "packages/workspace/workspace-base-tools/tsconfig.lib.json",
        "assets": [
          {
            "input": "packages/workspace/workspace-base-tools",
            "glob": "*.md",
            "output": "."
          }
        ]
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ],
      "options": {
        "packageRoot": "{projectRoot}/dist"
      }
    }
  }
}
