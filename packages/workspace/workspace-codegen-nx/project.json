{
  "name": "workspace-codegen-nx",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/workspace/workspace-codegen-nx/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["{projectRoot}"]
    }
  },
  "tags": [
    "domain:workspace",
    "pkg-kind:generator",
    "pkg-class:optional",
    "layer:logic",
    "platform:node",
    "access:domain"
  ],
  "implicitDependencies": ["!workspace-base-vite-paths"],
  "targets": {
    "build": {
      "//": "Override of the `build` target inferred by @nx/js/typescript (see that plugin's registration in nx.json for why the inferred `tsc --build tsconfig.lib.json` cannot run in this workspace). The `*.md` asset glob is covered by the inferred `assets` target.",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": ".",
        "command": "node node_modules/typescript/bin/tsc -p {projectRoot}/tsconfig.lib.json --outDir {projectRoot}/dist --rootDir {projectRoot} --baseUrl {projectRoot} --composite false --noEmitOnError"
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ],
      "options": {
        "packageRoot": "{projectRoot}/dist"
      }
    }
  }
}
