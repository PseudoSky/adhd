{
  "name": "workspace-codegen-nx",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/workspace/workspace-codegen-nx/src",
  "projectType": "library",
  "implicitDependencies": ["!workspace-base-vite-paths"],
  "tags": [
    "domain:workspace",
    "pkg-kind:generator",
    "pkg-class:optional",
    "layer:logic",
    "platform:node",
    "access:domain"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "packages/workspace/workspace-codegen-nx/dist",
        "main": "packages/workspace/workspace-codegen-nx/src/index.ts",
        "tsConfig": "packages/workspace/workspace-codegen-nx/tsconfig.lib.json",
        "assets": [
          "packages/workspace/workspace-codegen-nx/*.md"
        ]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/workspace/workspace-codegen-nx"
      ],
      "options": {
        "configFile": "packages/workspace/workspace-codegen-nx/vite.config.ts"
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ],
      "options": {
        "packageRoot": "{projectRoot}/dist"
      }
    }
  },
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  }
}
