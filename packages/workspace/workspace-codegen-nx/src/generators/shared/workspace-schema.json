{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "ADHD Workspace Configuration",
  "description": "Configuration for the ADHD monorepo workspace generator. Defines valid groups, package kinds, platforms, and layers.",
  "required": ["scope", "groups", "kinds", "platforms", "layers"],
  "properties": {
    "scope": {
      "type": "string",
      "description": "NPM scope for packages (e.g. @adhd)",
      "pattern": "^@[a-z0-9-]+$"
    },
    "groups": {
      "type": "object",
      "description": "Valid domain groups. Each key is a group name.",
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string" }
        }
      }
    },
    "kinds": {
      "type": "object",
      "description": "Valid package kinds (layer types). Each key is a kind name.",
      "additionalProperties": {
        "type": "object",
        "required": ["class", "description"],
        "properties": {
          "class": {
            "type": "string",
            "enum": ["foundation", "optional", "types", "entrypoint"],
            "description": "ESLint pkg-class for enforcement"
          },
          "description": { "type": "string" }
        }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string" }
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string" }
        }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "types": {
          "type": "object",
          "properties": {
            "access": { "type": "string", "default": "public" },
            "publish": { "type": "boolean", "default": true },
            "nxLayer": { "type": "string", "default": "shared" },
            "platform": { "type": "string", "default": "shared" }
          }
        },
        "entrypoint": {
          "type": "object",
          "properties": {
            "nxLayer": { "type": "string", "default": "entrypoints" },
            "platform": { "type": "string", "default": "node" },
            "access": { "type": "string", "default": "domain" },
            "publish": { "type": "boolean", "default": false }
          }
        },
        "library": {
          "type": "object",
          "properties": {
            "access": { "type": "string", "default": "domain" },
            "publish": { "type": "boolean", "default": false }
          }
        }
      }
    }
  }
}
