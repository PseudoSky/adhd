{
  "$schema": "http://json-schema.org/schema",
  "id": "workspace-codegen-nx-entrypoint",
  "title": "Scaffold a entrypoint package",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Entrypoint name (becomes <name>/ directory under entrypoint/)",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "group": {
      "type": "string",
      "description": "Domain/group (optional for entrypoints — they live under entrypoint/ not packages/<group>/)",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "nxLayer": {
      "type": "string",
      "enum": ["shared", "logic", "data", "entrypoints", "ui-primitives", "ui-composites", "components", "workflows", "ai", "mcp"],
      "default": "entrypoints",
      "description": "Nx architectural layer tag"
    },
    "platform": {
      "type": "string",
      "enum": ["node", "browser", "shared"],
      "description": "Platform tag"
    },
    "access": {
      "type": "string",
      "enum": ["domain", "public"],
      "default": "domain",
      "description": "Cross-domain access permission"
    },
    "publish": {
      "type": "boolean",
      "default": false,
      "description": "Whether to publish to npm"
    }
  },
  "required": ["name", "nxLayer", "platform"]
}
