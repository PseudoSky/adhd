{
  "meta": {
    "name": "no-body-204",
    "origin": "synthetic-protocol-conformant",
    "chromeVersion": "126.0.6478.0"
  },
  "steps": [
    {
      "when": {
        "method": "Page.enable"
      }
    },
    {
      "when": {
        "method": "Network.enable"
      }
    },
    {
      "when": {
        "method": "Page.navigate",
        "params": {
          "url": "https://site.test/api/ping"
        }
      },
      "reply": {
        "result": {
          "frameId": "F1",
          "loaderId": "L1"
        }
      },
      "emit": [
        {
          "method": "Network.requestWillBeSent",
          "params": {
            "requestId": "R1",
            "loaderId": "L1",
            "documentURL": "https://site.test/api/ping",
            "request": {
              "url": "https://site.test/api/ping",
              "method": "POST",
              "headers": {
                "Accept": "*/*"
              }
            },
            "timestamp": 100.0,
            "wallTime": 1700000000.0,
            "initiator": {
              "type": "other"
            },
            "type": "Fetch"
          }
        },
        {
          "method": "Network.responseReceived",
          "params": {
            "requestId": "R1",
            "loaderId": "L1",
            "timestamp": 100.1,
            "type": "Fetch",
            "response": {
              "url": "https://site.test/api/ping",
              "status": 204,
              "statusText": "No Content",
              "headers": {
                "content-type": "text/plain"
              },
              "mimeType": "text/plain"
            }
          }
        },
        {
          "method": "Network.loadingFinished",
          "params": {
            "requestId": "R1",
            "timestamp": 100.2,
            "encodedDataLength": 0
          }
        }
      ]
    },
    {
      "when": {
        "method": "Network.getResponseBody"
      },
      "reply": {
        "error": {
          "code": -32000,
          "message": "No resource with given identifier found"
        }
      }
    }
  ]
}
