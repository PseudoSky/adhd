{
  "meta": {
    "name": "search-404",
    "origin": "synthetic-protocol-conformant",
    "chromeVersion": "126.0.6478.0"
  },
  "steps": [
    {
      "when": {
        "method": "Page.enable"
      }
    },
    {
      "when": {
        "method": "Network.enable"
      }
    },
    {
      "when": {
        "method": "Page.navigate",
        "params": {
          "url": "https://site.test/search?q=x"
        }
      },
      "reply": {
        "result": {
          "frameId": "F1",
          "loaderId": "L1"
        }
      },
      "emit": [
        {
          "method": "Network.requestWillBeSent",
          "params": {
            "requestId": "R1",
            "loaderId": "L1",
            "documentURL": "https://site.test/search?q=x",
            "request": {
              "url": "https://site.test/search?q=x",
              "method": "GET",
              "headers": {
                "Accept": "*/*"
              }
            },
            "timestamp": 100.0,
            "wallTime": 1700000000.0,
            "initiator": {
              "type": "other"
            },
            "type": "XHR"
          }
        },
        {
          "method": "Network.responseReceived",
          "params": {
            "requestId": "R1",
            "loaderId": "L1",
            "timestamp": 100.1,
            "type": "XHR",
            "response": {
              "url": "https://site.test/search?q=x",
              "status": 404,
              "statusText": "Not Found",
              "headers": {
                "content-type": "application/json"
              },
              "mimeType": "application/json"
            }
          }
        },
        {
          "method": "Network.loadingFinished",
          "params": {
            "requestId": "R1",
            "timestamp": 100.2,
            "encodedDataLength": 40
          }
        }
      ]
    },
    {
      "when": {
        "method": "Network.getResponseBody"
      },
      "reply": {
        "result": {
          "body": "{\"error\":\"not found\"}",
          "base64Encoded": false
        }
      }
    }
  ]
}
