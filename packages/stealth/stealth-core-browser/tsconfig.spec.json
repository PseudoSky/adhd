{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ],
    "allowJs": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.config.mts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.d.ts",
    "examples/**/*.ts"
  ]
}
