{
  "name": "dispatch-cli",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/dispatch/dispatch-cli/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": [
    "layer:entrypoints",
    "platform:node"
  ],
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "dependsOn": [
        "generate-cli"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/packages/dispatch/dispatch-cli"
      ],
      "options": {
        "configFile": "packages/dispatch/dispatch-cli/vite.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", { "externalDependencies": ["typescript"] }],
      "options": {
        "command": "tsc -p packages/dispatch/dispatch-cli/tsconfig.lib.json --noEmit"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/dispatch/dispatch-cli",
        "main": "packages/dispatch/dispatch-cli/src/index.ts",
        "tsConfig": "packages/dispatch/dispatch-cli/tsconfig.lib.json",
        "assets": [
          "packages/dispatch/dispatch-cli/*.md"
        ]
      }
    },
    "generate-cli": {
      "executor": "@adhd/apigen-nx:generate",
      "options": {
        "source": "src/api.ts",
        "type": "cli",
        "outDir": "dist/packages/dispatch/dispatch-cli/cli"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      },
      "dependsOn": [
        "build",
        "test"
      ]
    }
  }
}
