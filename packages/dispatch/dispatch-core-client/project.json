{
  "name": "dispatch-core-client",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/dispatch/dispatch-core-client/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": ["layer:data", "platform:shared"],
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/dispatch/dispatch-core-client"
      ],
      "options": {
        "configFile": "packages/dispatch/dispatch-core-client/vite.config.ts"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/dispatch/dispatch-core-client",
        "main": "packages/dispatch/dispatch-core-client/src/index.ts",
        "tsConfig": "packages/dispatch/dispatch-core-client/tsconfig.lib.json",
        "assets": ["packages/dispatch/dispatch-core-client/*.md"]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      },
      "dependsOn": ["build", "test", "verify-dist-load"]
    }
  }
}
