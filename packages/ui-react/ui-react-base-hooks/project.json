{
  "name": "ui-react-base-hooks",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ui-react/ui-react-base-hooks/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": [
    "platform:browser",
    "layer:ui-primitives"
  ],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/ui-react/ui-react-base-hooks",
        "main": "packages/ui-react/ui-react-base-hooks/src/index.ts",
        "generatePackageJson": true,
        "tsConfig": "packages/ui-react/ui-react-base-hooks/tsconfig.lib.json",
        "assets": [
          "packages/ui-react/ui-react-base-hooks/*.md"
        ]
      }
    },
    "version": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "scripts/version-packages.sh react-hooks packages/ui-react/ui-react-base-hooks"
        ]
      }
    },
    "version-prerelease": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "scripts/version-packages.sh react-hooks packages/ui-react/ui-react-base-hooks @adhd -prerelease"
        ]
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "echo 'Running npm publish dry run'",
          "npm publish --dry-run dist/packages/ui-react/ui-react-base-hooks"
        ]
      },
      "configurations": {
        "production": {
          "parallel": false,
          "commands": [
            "npm publish dist/packages/ui-react/ui-react-base-hooks"
          ]
        }
      }
    },
    "nx-release-publish": {
      "dependsOn": ["build", "verify-dist-load"],
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": [
            "vitest"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/coverage/packages/ui-react/ui-react-base-hooks"
      ],
      "options": {
        "vitestConfig": "packages/ui-react/ui-react-base-hooks/vite.config.ts"
      }
    }
  }
}
