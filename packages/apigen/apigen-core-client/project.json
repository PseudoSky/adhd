{
  "name": "apigen-core-client",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/apigen/apigen-core-client/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": ["layer:logic", "platform:shared"],
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/apigen/apigen-core-client"
      ],
      "options": {
        "configFile": "packages/apigen/apigen-core-client/vite.config.ts"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/apigen/apigen-core-client",
        "main": "packages/apigen/apigen-core-client/src/index.ts",
        "tsConfig": "packages/apigen/apigen-core-client/tsconfig.lib.json",
        "assets": [
          "packages/apigen/apigen-core-client/*.md",
          {
            "input": "packages/apigen/apigen-core-client/src/lib",
            "glob": "*.json",
            "output": "lib"
          }
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      },
      "dependsOn": ["build", "test"]
    }
  }
}
