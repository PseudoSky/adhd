{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "declaration": true,
    "types": ["node", "vite/client"],
    // Allows `esm-require.ts` to use `import.meta.url` (review 663d463c /
    // BUG-APIGEN-CORE-CLIENT-ESM-REQUIRE-001) so the lazily-`require`d heavy
    // deps resolve in BOTH shipped formats instead of throwing
    // `ReferenceError: require is not defined` from `dist/index.mjs`. Same
    // override already proven at
    // packages/apigen/apigen-plugin-ir-cache/tsconfig.lib.json,
    // packages/apigen/apigen-engine-conformance/tsconfig.lib.json,
    // entrypoint/backlog/tsconfig.lib.json and
    // entrypoint/apigen-cli/tsconfig.lib.json for the identical
    // dual-CJS/ESM-output problem — this only affects the typecheck step;
    // Rollup still bundles both `dist/index.mjs` and `dist/index.js` per
    // vite.config.ts's `formats: ['es', 'cjs']`.
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "vite.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/test/**"
  ]
}
