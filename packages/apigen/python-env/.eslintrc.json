{
  "extends": ["../../../.eslintrc.base.json"],
  "ignorePatterns": [
    "!**/*",
    "vite.config.js",
    "vite.config.ts",
    "vite.config.mjs",
    "vite.config.mts",
    "vitest.e2e.config.ts"
  ],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {}
    },
    {
      "files": ["*.ts", "*.tsx"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "rules": {}
    },
    {
      "files": ["*.mjs"],
      "parserOptions": {
        "sourceType": "module",
        "ecmaVersion": 2022
      },
      "extends": ["plugin:@nx/javascript"],
      "rules": {}
    },
    {
      "files": ["*.json"],
      "parser": "jsonc-eslint-parser",
      "rules": {
        "@nx/dependency-checks": [
          "error",
          {
            "ignoredFiles": [
              "{projectRoot}/vite.config.{js,ts,mjs,mts}",
              "{projectRoot}/vitest.e2e.config.{js,ts,mjs,mts}",
              "{projectRoot}/**/*.e2e.{ts,tsx,mts,cts}"
            ]
          }
        ]
      }
    }
  ]
}
