{
  "name": "apigen-python-env",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/apigen/python-env/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": [
    "layer:logic",
    "platform:node"
  ],
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/packages/apigen/python-env"
      ],
      "options": {
        "configFile": "packages/apigen/python-env/vite.config.ts"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/packages/apigen/python/**/*",
        "!{workspaceRoot}/packages/apigen/python/**/__pycache__/**",
        "!{workspaceRoot}/packages/apigen/python/**/*.pyc",
        "!{workspaceRoot}/packages/apigen/python/.pytest_cache/**",
        "!{workspaceRoot}/packages/apigen/python/build/**",
        "!{workspaceRoot}/packages/apigen/python/*.egg-info/**"
      ],
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "packages/apigen/python-env/dist",
        "main": "packages/apigen/python-env/src/index.ts",
        "tsConfig": "packages/apigen/python-env/tsconfig.lib.json",
        "assets": [
          "packages/apigen/python-env/*.md"
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "{projectRoot}/dist"
      },
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ]
    }
  }
}
