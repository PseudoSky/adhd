{
  "name": "apigen-plugin-py-flask",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "packages/apigen/apigen-plugin-py-flask"
      }
    }
  },
  "tags": [
    "layer:logic",
    "platform:node"
  ],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "packages/apigen/apigen-plugin-py-flask/dist",
        "emptyOutDir": true
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/packages/apigen/python/**/*",
        "!{workspaceRoot}/packages/apigen/python/**/__pycache__/**",
        "!{workspaceRoot}/packages/apigen/python/**/*.pyc",
        "!{workspaceRoot}/packages/apigen/python/.pytest_cache/**",
        "!{workspaceRoot}/packages/apigen/python/build/**",
        "!{workspaceRoot}/packages/apigen/python/*.egg-info/**"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/packages/apigen/apigen-plugin-py-flask"
      ],
      "options": {
        "configFile": "packages/apigen/apigen-plugin-py-flask/vite.config.ts"
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ],
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "{projectRoot}/dist"
      }
    }
  }
}
