{
  "name": "apigen-engine-conformance",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/apigen/apigen-engine-conformance/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["{projectRoot}"]
    }
  },
  "tags": ["layer:logic", "platform:shared"],
  "targets": {
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/apigen/apigen-engine-conformance"
      ],
      "options": {
        "configFile": "packages/apigen/apigen-engine-conformance/vite.config.ts"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/apigen/apigen-engine-conformance/dist",
        "main": "packages/apigen/apigen-engine-conformance/src/index.ts",
        "tsConfig": "packages/apigen/apigen-engine-conformance/tsconfig.lib.json",
        "assets": ["packages/apigen/apigen-engine-conformance/*.md"]
      }
    },
    "conformance": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/packages/apigen/java/pom.xml",
        "{workspaceRoot}/packages/apigen/java/src/**/*"
      ],
      "outputs": [
        "{workspaceRoot}/tmp/apigen-engine-conformance/conformance-report.json"
      ],
      "dependsOn": [],
      "options": {
        "command": "{workspaceRoot}/node_modules/.bin/tsx --tsconfig packages/apigen/apigen-engine-conformance/tsconfig.json packages/apigen/apigen-engine-conformance/src/lib/gate.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ],
      "options": {
        "packageRoot": "{projectRoot}/dist"
      }
    }
  }
}
