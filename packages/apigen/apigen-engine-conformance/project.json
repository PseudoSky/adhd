{
  "name": "apigen-engine-conformance",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/apigen/apigen-engine-conformance/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": [
    "layer:logic",
    "platform:shared"
  ],
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/apigen/apigen-engine-conformance"
      ],
      "options": {
        "configFile": "packages/apigen/apigen-engine-conformance/vite.config.ts"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "packages/apigen/apigen-engine-conformance/dist",
        "main": "packages/apigen/apigen-engine-conformance/src/index.ts",
        "tsConfig": "packages/apigen/apigen-engine-conformance/tsconfig.lib.json",
        "assets": [
          "packages/apigen/apigen-engine-conformance/*.md"
        ]
      }
    },
    "conformance": {
      "executor": "nx:run-commands",
      "options": {
        "command": "{workspaceRoot}/node_modules/.bin/tsx --tsconfig packages/apigen/apigen-engine-conformance/tsconfig.json packages/apigen/apigen-engine-conformance/src/lib/gate.ts",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": []
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "{projectRoot}"
      },
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load"
      ]
    }
  }
}
