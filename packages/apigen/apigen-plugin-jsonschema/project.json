{
  "name": "apigen-plugin-jsonschema",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "packages/apigen/apigen-plugin-jsonschema"
      }
    }
  },
  "tags": ["layer:logic", "platform:node"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "outputPath": "dist/packages/apigen/apigen-plugin-jsonschema",
        "emptyOutDir": true
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/apigen/apigen-plugin-jsonschema"
      ],
      "options": {
        "configFile": "packages/apigen/apigen-plugin-jsonschema/vite.config.ts"
      }
    },
    "nx-release-publish": {
      "dependsOn": ["build", "test"],
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
