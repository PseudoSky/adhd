{
  "name": "apigen-base-logical",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/apigen/apigen-base-logical/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["{projectRoot}"]
    }
  },
  "tags": ["layer:logic", "platform:shared"],
  "targets": {
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/apigen/apigen-base-logical"
      ],
      "options": {
        "configFile": "packages/apigen/apigen-base-logical/vite.config.ts"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/apigen/apigen-base-logical/dist",
        "main": "packages/apigen/apigen-base-logical/src/index.ts",
        "tsConfig": "packages/apigen/apigen-base-logical/tsconfig.lib.json",
        "assets": ["packages/apigen/apigen-base-logical/*.md"]
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ],
      "options": {
        "packageRoot": "{projectRoot}/dist"
      }
    }
  }
}
