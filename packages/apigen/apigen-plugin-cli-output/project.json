{
  "name": "apigen-plugin-cli-output",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "release": {
    "version": {
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["packages/apigen/apigen-plugin-cli-output"]
    }
  },
  "tags": ["layer:logic", "platform:node"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/apigen/apigen-plugin-cli-output/dist",
        "emptyOutDir": true
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/apigen/apigen-plugin-cli-output"
      ],
      "dependsOn": [
        "build",
        {
          "projects": ["apigen-cli"],
          "target": "build"
        }
      ],
      "options": {
        "configFile": "packages/apigen/apigen-plugin-cli-output/vite.config.ts"
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ],
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "{projectRoot}/dist"
      }
    }
  }
}
