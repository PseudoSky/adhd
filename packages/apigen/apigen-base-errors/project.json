{
  "name": "apigen-base-errors",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/apigen/apigen-base-errors/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": ["layer:logic", "platform:shared"],
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/apigen/apigen-base-errors"
      ],
      "options": {
        "configFile": "packages/apigen/apigen-base-errors/vite.config.ts"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/apigen/apigen-base-errors",
        "main": "packages/apigen/apigen-base-errors/src/index.ts",
        "tsConfig": "packages/apigen/apigen-base-errors/tsconfig.lib.json",
        "assets": ["packages/apigen/apigen-base-errors/*.md"]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      },
      "dependsOn": ["build", "test", "verify-dist-load"]
    }
  }
}
