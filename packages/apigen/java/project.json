{
  "name": "apigen-java",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/apigen/java/src",
  "projectType": "library",
  "tags": [
    "domain:apigen",
    "pkg-kind:core",
    "pkg-class:foundation",
    "layer:logic",
    "platform:java",
    "access:domain",
    "build:custom"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/pom.xml",
        "{projectRoot}/src/main/**/*",
        "{projectRoot}/nx-run.sh"
      ],
      "outputs": ["{projectRoot}/target"],
      "options": {
        "command": "sh packages/apigen/java/nx-run.sh build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/pom.xml",
        "{projectRoot}/src/main/**/*",
        "{projectRoot}/src/test/**/*",
        "{projectRoot}/nx-run.sh"
      ],
      "outputs": ["{projectRoot}/target/surefire-reports"],
      "options": {
        "command": "sh packages/apigen/java/nx-run.sh test"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/pom.xml",
        "{projectRoot}/src/main/**/*",
        "{projectRoot}/nx-run.sh"
      ],
      "outputs": ["{projectRoot}/target"],
      "options": {
        "command": "sh packages/apigen/java/nx-run.sh package"
      }
    }
  }
}
