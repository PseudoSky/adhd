{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adhd.dev/schemas/environment/adhd-environment.schema.json",
  "title": "AdhdEnvironmentSnapshot",
  "description": "Canonical JSON Schema for the adhd-environment.json snapshot file written by @adhd/environment-builder's build() pipeline and read by every runtime client (TypeScript @adhd/environment, Python adhd_environment, Rust adhd-environment). This is the single source of truth for the on-disk snapshot format: the TypeScript SnapshotData interface (packages/environment/environment-base-spec/src/index.ts) mirrors this schema's `properties` exactly, field for field. See spec/SPEC.md for the full contract narrative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "libraryVersion",
    "generatedAt",
    "project",
    "config",
    "raw",
    "fieldSchema",
    "configHash",
    "structureHash",
    "dirs",
    "provenance",
    "envVars"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Snapshot format version (semver). Must equal SPEC_VERSION at build time.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "libraryVersion": {
      "type": "string",
      "description": "Version of the builder library that produced this snapshot."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of when the snapshot was generated."
    },
    "project": {
      "$ref": "#/$defs/projectIdentity"
    },
    "config": {
      "type": "object",
      "description": "Fully resolved, nested config object (dot-paths expanded into nested objects).",
      "additionalProperties": true
    },
    "raw": {
      "type": "object",
      "description": "Flat, un-nested config (dot.path -> value) used for hashing and direct lookup.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "fieldSchema": {
      "description": "Generated JSON Schema (see generateFieldSchema) for validating `config`. Null when the project declares no config fields.",
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "configHash": {
      "type": "string",
      "description": "contentHash() of `raw` -- \"sha256-\" + hex(SHA-256(sorted key=value\\n lines)).",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "structureHash": {
      "type": "string",
      "description": "Hash of logical directory structure (type:name:scope tuples), not absolute paths.",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "dirs": {
      "type": "array",
      "description": "Resolved directory paths (fully expanded, absolute).",
      "items": {
        "$ref": "#/$defs/resolvedDirectoryEntry"
      }
    },
    "provenance": {
      "type": "object",
      "description": "Provenance map: flat field path -> provenance entry.",
      "additionalProperties": {
        "$ref": "#/$defs/provenanceEntry"
      }
    },
    "envVars": {
      "type": "object",
      "description": "Env var values recorded at build time (raw strings as read from process.env).",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "configScope": {
      "type": "string",
      "description": "Three-tier field resolution scope. project overrides global overrides system.",
      "enum": ["system", "global", "project"]
    },
    "fieldType": {
      "type": "string",
      "description": "JSON-Schema-derived value type a config field may hold.",
      "enum": ["string", "integer", "number", "boolean", "array"]
    },
    "directoryType": {
      "type": "string",
      "enum": ["state.data", "runtime.log", "runtime.cache", "runtime.temp"]
    },
    "provenanceSource": {
      "type": "string",
      "description": "Origin of a resolved config field's value.",
      "enum": [
        "project.env",
        "project.set",
        "project.default",
        "project.override",
        "global.env",
        "global.default",
        "system.default"
      ]
    },
    "projectIdentity": {
      "type": "object",
      "description": "Resolved identity of the project + namespace pairing this snapshot was built for.",
      "additionalProperties": false,
      "required": ["name", "orgNamespace", "envPrefix", "namespace"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name (kebab-case)."
        },
        "orgNamespace": {
          "type": "string",
          "description": "Resolved org namespace (explicit or \"adhd\")."
        },
        "envPrefix": {
          "type": "string",
          "description": "Resolved env prefix (from envPrefixOverride or inferred via projectEnvPrefix())."
        },
        "namespace": {
          "type": "string",
          "description": "The namespace this snapshot was built for (explicit or \"default\")."
        },
        "description": {
          "type": "string"
        }
      }
    },
    "resolvedDirectoryEntry": {
      "type": "object",
      "description": "A DirectoryEntry after path resolution, as written into the snapshot dirs array.",
      "additionalProperties": false,
      "required": ["type", "path", "scope"],
      "properties": {
        "type": {
          "$ref": "#/$defs/directoryType"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "Fully expanded, absolute path."
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "provenanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "scope"],
      "properties": {
        "source": {
          "$ref": "#/$defs/provenanceSource"
        },
        "scope": {
          "$ref": "#/$defs/configScope"
        },
        "env": {
          "type": "string",
          "description": "The env var name, if resolved from an env var."
        }
      }
    },
    "directoryEntry": {
      "type": "object",
      "description": "Authoring-time directory catalog entry, as declared in adhd.environment.yaml (before path resolution).",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "$ref": "#/$defs/directoryType"
        },
        "name": {
          "type": "string",
          "description": "Optional name for disambiguation when multiple dirs share a type."
        },
        "path": {
          "type": "string",
          "description": "Optional path override. Supports $HOME, ${PROJECT_ROOT}, ${NAMESPACE} interpolation."
        },
        "scope": {
          "$ref": "#/$defs/configScope"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "yamlFieldDefinition": {
      "type": "object",
      "description": "Authoring-time config field definition, as declared in adhd.environment.yaml (before scope merge / resolution).",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "$ref": "#/$defs/fieldType"
        },
        "default": {
          "description": "Default value. Used when no env var or stored value is present."
        },
        "env": {
          "type": "string",
          "description": "Explicit env var name override. When absent, inferred via inferEnvVar()."
        },
        "scope": {
          "$ref": "#/$defs/configScope"
        },
        "description": {
          "type": "string"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "enum": {
          "type": "array"
        },
        "pattern": {
          "type": "string"
        },
        "minLength": {
          "type": "integer"
        },
        "maxLength": {
          "type": "integer"
        },
        "items": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string"
            }
          }
        },
        "secret": {
          "type": "boolean",
          "description": "Marks field as sensitive (not logged)."
        },
        "noEnv": {
          "type": "boolean",
          "description": "When true, env var inference is suppressed for this field."
        }
      }
    },
    "configFieldDefinition": {
      "type": "object",
      "description": "Resolved, merged, scope-aware config field definition (after mergeFieldDefinitions applies the scope cascade).",
      "additionalProperties": false,
      "required": ["type", "default", "scope", "env", "sourceScope"],
      "properties": {
        "type": {
          "$ref": "#/$defs/fieldType"
        },
        "default": {},
        "scope": {
          "$ref": "#/$defs/configScope",
          "description": "Effective scope after merge (project > global > system)."
        },
        "env": {
          "type": "string",
          "description": "Effective env var name (explicit override or inferred)."
        },
        "sourceScope": {
          "$ref": "#/$defs/configScope",
          "description": "The source scope from which this field originated."
        },
        "description": {
          "type": "string"
        },
        "secret": {
          "type": "boolean"
        },
        "noEnv": {
          "type": "boolean"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "enum": {
          "type": "array"
        },
        "pattern": {
          "type": "string"
        },
        "minLength": {
          "type": "integer"
        },
        "maxLength": {
          "type": "integer"
        },
        "items": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string"
            }
          }
        }
      }
    },
    "projectConfig": {
      "type": "object",
      "description": "The `project:` section of adhd.environment.yaml, as authored by a project owner.",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name (kebab-case)."
        },
        "orgNamespace": {
          "type": "string",
          "description": "Organization namespace. Defaults to \"adhd\"."
        },
        "envPrefixOverride": {
          "type": "string",
          "description": "Explicit env var prefix override. When absent, inferred via projectEnvPrefix()."
        },
        "description": {
          "type": "string"
        },
        "namespaces": {
          "type": "array",
          "description": "When absent, namespace defaults to [\"default\"]. When listed, only those namespaces are valid.",
          "items": {
            "type": "string"
          }
        },
        "dirs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/directoryEntry"
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/configFieldDefinition"
              }
            },
            "global": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/configFieldDefinition"
              }
            },
            "project": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/configFieldDefinition"
              }
            }
          }
        }
      }
    }
  }
}
