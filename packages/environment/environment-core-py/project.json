{
  "name": "environment-core-py",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/environment/environment-core-py/src",
  "projectType": "library",
  "tags": [
    "domain:environment",
    "pkg-kind:core",
    "pkg-class:foundation",
    "layer:data",
    "platform:python",
    "access:domain",
    "publish:pypi"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{projectRoot}/src/**/*",
        "{projectRoot}/nx-run.sh"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "sh packages/environment/environment-core-py/nx-run.sh build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/uv.lock",
        "{projectRoot}/src/**/*",
        "{projectRoot}/tests/**/*",
        "{projectRoot}/nx-run.sh"
      ],
      "options": {
        "command": "sh packages/environment/environment-core-py/nx-run.sh test"
      }
    },
    "nx-release-publish": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "test"],
      "options": {
        "command": "sh packages/environment/environment-core-py/nx-run.sh publish"
      }
    }
  }
}
