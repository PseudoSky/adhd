{
  "name": "data-base-transforms",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/data/data-base-transforms/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": [
    "platform:shared",
    "layer:shared"
  ],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "packages/data/data-base-transforms/dist",
        "main": "packages/data/data-base-transforms/src/index.ts",
        "tsConfig": "packages/data/data-base-transforms/tsconfig.lib.json",
        "assets": [
          "packages/data/data-base-transforms/*.md"
        ]
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build",
        "verify-dist-load"
      ],
      "options": {
        "packageRoot": "{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": [
            "vitest"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/coverage/packages/data/data-base-transforms"
      ],
      "options": {
        "vitestConfig": "packages/data/data-base-transforms/vite.config.ts"
      }
    }
  }
}
