    "storybook": "nx run ui-react-base-storybook:storybook",
    "list": "nx show projects --affected",
    "lint:all": "nx run-many --targets=lint --configuration=production",
    "test:all": "nx run-many --targets=test --configuration=production",
    "check:publish-hygiene": "nx run @adhd/source:check-publish-hygiene",
