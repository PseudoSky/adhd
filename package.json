    "release": "node tools/nx-plugins/build/executors/smoke-test/run-release.mjs",
    "release:dry": "pnpm run build && ADHD_NX_VERSION_DRY_RUN=1 npx nx run-many -t version --dryRun && node tools/nx-plugins/build/executors/range-check/check-release-ranges.mjs && npx nx run-many -t publish --dryRun",
