  "license": "MIT",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "watch:test": "vitest watch --changed",
    "watch": "nx run-many --targets=build --configuration=development --all --watch",
    "build": "nx run-many --targets=build --configuration=production --all",
    "release": "pnpm nx run-many -t publish",
    "release:dry": "pnpm run build && ADHD_NX_VERSION_DRY_RUN=1 npx nx run-many -t version --dryRun && npx nx run-many -t publish --dryRun",
    "release:commit": "node tools/nx-plugins/build/executors/publish/release-commit.mjs",
    "release:commit:dry": "node tools/nx-plugins/build/executors/publish/release-commit.mjs --dry-run",
    "storybook": "nx run storybook:storybook",
    "list": "nx show projects --affected",
    "lint": "nx run-many --targets=lint --configuration=production",
    "test": "nx run-many --targets=test --configuration=production",
    "version:old": "nx run-many --targets=version --configuration=production",
    "publish:old": "nx run-many --targets=publish --configuration=production",
    "check:publish-hygiene": "nx run @adhd/source:check-publish-hygiene",
    "logs:agent": "node dist/packages/ai/agent-mcp/src/scripts/agent-mcp-tail.js",
    "check:test-wiring": "node scripts/check-test-wiring.mjs",
    "test:build-tools": "node --test tools/nx-plugins/build/executors/manifest/generate-manifest.spec.mjs tools/nx-plugins/build/executors/version/compare-published.spec.mjs tools/nx-plugins/build/executors/version/impl.spec.mjs tools/nx-plugins/build/executors/publish/impl.spec.mjs tools/nx-plugins/build/executors/publish/release-commit.spec.mjs tools/nx-plugins/build/executors/reconcile/reconcile-core.spec.mjs tools/nx-plugins/build/lib/published-state.spec.mjs tools/nx-plugins/deps/eslint-check.spec.mjs tools/nx-plugins/deps/executors/sync/impl.spec.mjs tools/nx-plugins/deps/executors/check/impl.spec.mjs tools/nx-plugins/lib/file-lock.spec.mjs tools/nx-plugins/lib/metrics.spec.mjs"
  },
