#!/usr/bin/env sh
#
# Pre-commit hook. Two gates, in order:
#   1. secret-scan — blocks credentials from entering the repo (gitleaks + built-in rules)
#   2. affected lint (self-healing dependency ranges, otherwise VERIFY ONLY) —
#      runs `nx affected -t lint` on the projects touched by staged changes
#      and BLOCKS on any error. `lint` now `dependsOn: ["sync-deps"]` (nx.json
#      targetDefaults — see BUILD-TOOLING-VERSION-SYNC-DEPS-001 /
#      CHANGELOG.md), so it can MUTATE a project's package.json (fixing stale
#      internal @adhd/* dependency ranges) as a side effect of running lint.
#      This hook NEVER auto-stages that mutation (see the incident history
#      below) — it detects it and FAILS the commit instead, so a stale,
#      already-staged package.json can never be silently committed under a
#      "lint passed" banner. See the "GATE 2 SELF-HEALING" block below.
#
# Secrets are checked FIRST and are cheap: a leaked credential is unrecoverable
# once pushed (rotation, not reversion, is the fix), whereas a lint error is not.
# Never reorder these.
#
# Activated repo-wide via `core.hooksPath=.githooks` (set by the root `prepare`
# script on `npm install`, or manually: `git config core.hooksPath .githooks`).
#
# Bypass for an emergency commit: `git commit --no-verify`  (use sparingly).
#
# ── WHY GATE 2 NO LONGER RUNS --fix (history — do not reintroduce it) ──────
# This hook used to run `nx affected -t lint --fix --skip-nx-cache` and then
# `git add` back whatever the fix touched, on the theory that
# @nx/dependency-checks' auto-fix (deriving package.json deps from actual
# imports) was safe to apply silently on every commit. Two confirmed
# incidents proved that model actively dangerous and it was removed:
#
#   BUG-REPO-PRECOMMIT-PARTIAL-STAGE-001 — an agent used `git apply --cached`
#   to stage only 4 of 7 hunks in a shared file (leaving another agent's 3
#   WIP hunks deliberately unstaged), then committed with the repo's own
#   explicit-pathspec convention (`git commit -- <paths>`). This hook's
#   auto-fix ran `eslint --fix` against the WORKING-TREE copy (all 7 hunks,
#   since only the index was partial) and then blindly `git add`'d the file
#   WHOLESALE, silently overwriting the deliberately-partial index — the
#   resulting commit shipped another agent's untested WIP under the wrong
#   message. `git commit -- <paths>` alone does NOT protect against this:
#   the hook re-stages *after* the pathspec commit builds its index.
#
#   BUG-REPO-PRECOMMIT-DEPCHECK-STRIPS-USED-DEPS-001 — @nx/dependency-checks
#   in this repo resolves each npm dependency via Nx's yarn-lockfile parser
#   (`yarn.lock` shadows `pnpm-lock.yaml` — see detectPackageManager() in
#   nx/src/utils/package-manager.js, which checks yarn.lock first), which in
#   turn resolves the "canonical" version of every dependency NOT declared
#   at the monorepo root by reading `<workspaceRoot>/node_modules/<pkg>/
#   package.json` straight off disk. A freshly created git worktree (git
#   does not copy/install node_modules) has none of that installed, so this
#   lookup silently fails for nearly every project-level dependency — and
#   `--fix` deleted real, fully-static, genuinely-used deps (`fs-extra`,
#   `source-map`, `tough-cookie`, `ajv`, `yaml`) from real package.json
#   files as a result. `git commit -- <paths>` does not protect against
#   this either, since the corruption happens to package.json BEFORE the
#   commit is made, not to the git index.
#
# Both incidents share the same shape: a step that MUTATES tracked files
# and then STAGES what it mutated, running inside the commit path, where
# neither pathspec commits nor careful manual staging can see it coming.
# The fix is structural, not "run it more carefully": THIS HOOK never
# stages anything, ever, full stop — that invariant is preserved below even
# though Gate 2 gained a new mutating dependency (next section).
#
# ── GATE 2 SELF-HEALING (BUILD-TOOLING-VERSION-SYNC-DEPS-001) ──────────────
# `lint` now `dependsOn: ["sync-deps"]` globally (nx.json targetDefaults), so
# that @nx/dependency-checks errors from a stale/undeclared internal @adhd/*
# range self-heal (get fixed on disk) BEFORE the check runs, instead of
# hard-failing lint on every fixable drift. That means running
# `nx affected -t lint` from THIS hook can now mutate a project's
# package.json in the WORKING TREE, mid-hook, as a side effect.
#
# This does NOT get to reintroduce BUG-REPO-PRECOMMIT-PARTIAL-STAGE-001. The
# hook still never runs `git add`/stages anything. Instead, Gate 2 snapshots
# every `package.json`'s working-tree status immediately before running lint
# and diffs it against the status immediately after. If sync-deps touched
# ANY package.json, the commit is FAILED (even if lint itself reported
# clean) — the fix is sitting in the working tree, unstaged, and the
# developer must review it, `git add -- <path>/package.json` themselves, and
# commit again. This is deliberate: without this check, the ALREADY-STAGED
# (stale) package.json would otherwise get silently committed while lint
# reports green, because dependency-checks now validates the just-fixed
# DISK copy, not the index. See tools/nx-plugins/deps/README.md and
# tools/nx-plugins/build/README.md for the full write-up, and CHANGELOG.md.
#
# The guard for a not-really-installed node_modules (below) is unaffected
# and unchanged in spirit: it still hard-fails BEFORE `nx` is even invoked,
# which remains the actual enforcement point for the commit path. (A
# separate, softer no-op+warn guard now also lives inside sync-deps itself —
# tools/nx-plugins/deps/eslint-check.mjs — for callers OTHER than this hook,
# e.g. a bare `nx affected -t lint` run outside the commit path; see its
# header for why that one may no longer be a hard fail.)

# Staged files (Added/Copied/Modified/Renamed), NUL-safe join into a comma list.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

files=$(printf '%s' "$staged" | paste -sd, -)

# ── Gate 1: credentials ──────────────────────────────────────────────────────
# A missing scanner must NEVER read as a pass — refuse the commit instead.
hook_dir=$(dirname "$0")
scanner="$hook_dir/check-no-credentials.js"
if [ ! -f "$scanner" ]; then
  echo "✖ pre-commit: $scanner is missing — refusing to commit without a secret scan."
  exit 1
fi

echo "pre-commit: scanning staged changes for secrets…"
node "$scanner" --staged || exit 1

# ── Gate 2: lint (VERIFY ONLY — never --fix, never re-stages) ───────────────
repo_root=$(cd "$hook_dir/.." && pwd)

# If this workspace root's node_modules was never really installed (e.g. a
# fresh git worktree — git does not copy node_modules), @nx/dependency-checks
# will misreport nearly every dependency as unused (BUG-REPO-PRECOMMIT-
# DEPCHECK-STRIPS-USED-DEPS-001). Fail with the RIGHT message instead of
# letting confusing false-positive lint errors surface here.
if [ ! -f "$repo_root/node_modules/.modules.yaml" ] || [ ! -f "$repo_root/node_modules/nx/package.json" ]; then
  echo "✖ pre-commit: node_modules in this workspace root is not a real"
  echo "  package-manager install (missing node_modules/.modules.yaml"
  echo "  and/or node_modules/nx). Lint would misreport dependencies."
  echo "  Fix: run 'pnpm install' in this workspace root, then commit again."
  exit 1
fi

# Snapshot every package.json's working-tree status BEFORE lint runs, so we
# can tell exactly what sync-deps (lint's new dependency) mutated — and only
# that — regardless of any OTHER, unrelated dirty package.json already
# sitting in the tree (e.g. another agent's in-flight version-bump diff).
pkg_status_before=$(git status --porcelain | grep -E 'package\.json$' || true)

echo "pre-commit: running 'nx affected -t lint' on staged changes (sync-deps runs first and self-heals fixable dependency drift)…"
# CI=true: a git hook is never an interactive terminal. Without it, the nx
# CLI's own interactive prompting (e.g. Nx Cloud onboarding) can fail outright
# with a generic "NX Failed to process project graph" instead of prompting or
# skipping — reproduced 2026-07-22 on a completely vanilla `nx show projects`
# (nothing to do with this hook's own logic), see
# BUG-REPO-PRECOMMIT-NX-NONINTERACTIVE-001 (BACKLOG.md). Exporting CI=true is
# the standard, widely-recognized way to tell a CLI "there is no human here."
CI=true npx nx affected --target=lint --files="$files"
status=$?

pkg_status_after=$(git status --porcelain | grep -E 'package\.json$' || true)

if [ "$pkg_status_before" != "$pkg_status_after" ]; then
  echo ""
  echo "✖ pre-commit: 'lint' ran 'sync-deps' first, which reconciled stale"
  echo "  internal @adhd/* dependency ranges by MUTATING package.json in the"
  echo "  WORKING TREE (not the index — this hook never auto-stages, see"
  echo "  BUG-REPO-PRECOMMIT-PARTIAL-STAGE-001)."
  echo "  Changed since Gate 2 started:"
  before_tmp=$(mktemp) && after_tmp=$(mktemp)
  printf '%s\n' "$pkg_status_before" >"$before_tmp"
  printf '%s\n' "$pkg_status_after" >"$after_tmp"
  diff "$before_tmp" "$after_tmp" 2>/dev/null | grep '^>' | sed 's/^> */    · /'
  rm -f "$before_tmp" "$after_tmp"
  echo "  Review the diff (git diff -- <path>/package.json), then"
  echo "  'git add -- <path>/package.json' the ones you want, and commit again."
  echo "  This failure is deliberate: without it, your ALREADY-STAGED (now"
  echo "  stale) package.json would silently ship even though lint reports"
  echo "  clean, since dependency-checks validated the just-fixed disk copy."
  echo "  (bypass in an emergency with: git commit --no-verify)"
  exit 1
fi

if [ "$status" -ne 0 ]; then
  echo ""
  echo "✖ pre-commit: affected lint failed — fix and re-commit."
  echo "  @nx/dependency-checks drift is now self-healing (sync-deps runs"
  echo "  automatically before lint) — if you're still seeing a"
  echo "  missing/obsolete package.json dependency error here, sync-deps"
  echo "  could not fix it automatically; inspect it directly:"
  echo "    npx nx affected -t sync-deps --files=\"$files\""
  echo "  (or for one project: npx nx run <project>:sync-deps)"
  echo "  Review the diff it produces, stage it yourself, then commit."
  echo "  For other lint errors: npx nx affected -t lint --fix --files=\"$files\","
  echo "  review the diff, stage it yourself, then commit."
  echo "  (bypass in an emergency with: git commit --no-verify)"
  exit 1
fi

echo "✓ pre-commit: affected lint clean (no dependency-range drift to reconcile)."
exit 0
