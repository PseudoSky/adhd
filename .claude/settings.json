{
  "permissions": {
    "allow": [
      "mcp__backlog__backlog_get_item",
      "mcp__backlog__backlog_list_items",
      "mcp__backlog__backlog_stats",
      "mcp__backlog__backlog_export_json",
      "mcp__backlog__backlog_migration_status",
      "mcp__backlog__backlog_audit_trail",
      "mcp__backlog__backlog_dependency_graph",
      "mcp__agent-mcp__task_list",
      "mcp__agent-mcp__result",
      "mcp__memory-server__memory_ping",
      "mcp__memory-server__memory_stats",
      "mcp__memory-server__memory_recall",
      "Bash(npm view *)",
      "Bash(npm whoami)",
      "Bash(npx nx show *)",
      "Bash(npx nx graph *)",
      "Bash(npx nx test *)",
      "Bash(npx nx lint *)",
      "Bash(npx nx affected -t test *)",
      "Bash(npx nx affected -t lint *)",
      "Bash(npx nx affected -t test)",
      "Bash(npx nx affected -t lint)",
      "Bash(adhd-backlog get *)",
      "Bash(adhd-backlog backlog get *)",
      "Bash(adhd-backlog search *)",
      "Bash(adhd-backlog backlog query *)",
      "Bash(shasum -a 256 *)",
      "Bash(adhd-backlog query *)",
      "Bash(adhd-backlog --help)",
      "mcp__backlog__backlog_get",
      "mcp__search__agent_browser_search_mcp_source_search",
      "mcp__backlog__backlog_query",
      "mcp__r2info__get_ticket",
      "Bash(git merge-base *)",
      "Bash(md5 *)",
      "Bash(git config --get *)",
      "Bash(gx status)",
      "Bash(gx query *)",
      "Bash(gitnexus list)",
      "Bash(git check-ignore *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-nx-scope.sh\"",
            "timeout": 10,
            "statusMessage": "Checking nx command scope..."
          }
        ]
      }
    ]
  }
}
