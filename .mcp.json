{
  "mcpServers": {
    "agent-mcp-published": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "--prefer-online=false", "@adhd/agent-mcp@latest"],
      "env": {
        "ADHD_AGENT_DATABASE_PATH": "/Users/nix/.adhd/agent-mcp/production/data/agents.db",
        "ADHD_AGENT_REGISTRY_DB_PATH": "/Users/nix/.adhd/agent-registry/production/data/registry.db"
      }
    },
    "backlog-published": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "--prefer-online=false", "@adhd/backlog@latest", "serve", "--transport", "mcp", "--allow-production-write"]
    }
  }
}
