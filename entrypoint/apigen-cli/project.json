{
  "name": "apigen-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "entrypoint/apigen-cli/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["{projectRoot}"]
    }
  },
  "tags": ["layer:entrypoints", "platform:node"],
  "targets": {
    "test": {
      "//": "Override of the inferred `test` target (dependsOn only; executor/cache/outputs come from inference — the inferred coverage output matches vite.config.ts's reportsDirectory, which main's explicit output did not). Adds the project's OWN `build` — the integration specs (ir-cache-plugin-registration, java-ts-decimal-parity) spawn the built CLI bin — and `apigen-java:package`, which the java-javalin parity host needs (PR #11). `lint`/`^build` mirror the workspace `test` targetDefaults, which an explicit dependsOn otherwise replaces.",
      "dependsOn": ["lint", "^build", "build", "apigen-java:package"]
    },
    "generate-api": {
      "executor": "@adhd/apigen-nx:generate",
      "cache": true,
      "outputs": ["{workspaceRoot}/tmp/apigen-generate-out"],
      "inputs": ["default", "^production"],
      "dependsOn": ["build"],
      "options": {
        "source": "src/test/fixtures/real-api.ts",
        "type": "mcp",
        "outDir": "tmp/apigen-generate-out"
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ],
      "options": {
        "packageRoot": "{projectRoot}/dist"
      }
    },
    "bench": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --expose-gc --import tsx packages/apigen/tools/bench-extract.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "TSX_TSCONFIG_PATH": "tsconfig.base.json"
        }
      }
    }
  }
}
