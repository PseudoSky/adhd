{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ]
  },
  "include": [
    "vite.config.ts",
    "vitest.e2e.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.e2e.ts",
    "src/test/**/*.ts",
    "src/**/*.d.ts"
  ]
}
