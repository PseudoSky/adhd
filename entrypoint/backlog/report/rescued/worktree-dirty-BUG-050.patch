 # `nx test <project>`-only blind spot documented in
 # DEBT-PROCESS-AFFECTED-TEST-001 — it does NOT close the separate
 # cross-worktree blind spot also described there; that remains open).
-CI=true npx nx affected --target=test --files="$files" --output-style=stream-without-prefixes >"$out" 2>&1
+# Failure diagnostics (BUG-GATE-001). On failure, `nx affected` prints only a
+# "Failed tasks:" summary of task NAMES; without the failing task's own output,
+# the first diagnostic step is a manual re-run of the FULL affected set (~8 min
+# / 63 projects). This gate therefore captures the run with
+# `--output-style=static`, which emits each task's output as a contiguous block
+# under its "> nx run <task>" header — the default `stream-without-prefixes`
+# style interleaves concurrent tasks and drops per-line attribution, so the
+# failing block cannot be recovered from it reliably. `print_gate3_failures`
+# then prints the failing task name(s) plus the tail of each captured block,
+# and a NARROW re-run command per task — seconds, not minutes. Diagnostics-only:
+# the run is fully redirected to a file (never watched live), so `static`
+# changes nothing on the passing path, and no gate semantics, gate order, or
+# exit codes change. If the summary/output can't be parsed it falls back to the
+# full captured log so a diagnostic is never lost.
+print_gate3_failures() {
+  _log=$1
+
+  # Task names from Nx's "Failed tasks:" block, e.g. "- data-base-transforms:test".
+  _failed=$(awk '
+    /^Failed tasks:/ { in_list = 1; next }
+    in_list && /^[[:space:]]*-[[:space:]]*[^[:space:]]/ {
+      sub(/^[[:space:]]*-[[:space:]]*/, ""); print; next
+    }
+    in_list && !/^[[:space:]]*$/ { in_list = 0 }
+  ' "$_log")
+
+  if [ -z "$_failed" ]; then
+    echo "  (could not parse Nx's 'Failed tasks:' summary — full captured log follows)"
+    cat "$_log"
+    return
+  fi
+
+  echo "  Failed task(s):"
+  printf '%s\n' "$_failed" | sed 's/^/  - /'
+
+  # Each task's output is a contiguous block between its "> nx run <task>"
+  # header and the next "> nx run ..." header (or Nx's final summary) — see the
+  # `--output-style=static` note above. Print the last 60 lines of that block:
+  # enough to carry the failure, bounded even for a large run.
+  _shown=0
+  for _task in $_failed; do
+    _slice=$(awk -v task="$_task" -v n=60 '
+      BEGIN { hdr = "> nx run " task }
+      !started && ($0 == hdr || index($0, hdr " ") == 1) { started = 1; next }
+      started && (/^> nx run / || $0 ~ /^[[:space:]]*NX[[:space:]]+Running target/) { started = 0 }
+      started { lines[++c] = $0 }
+      END {
+        first = (c > n) ? c - n + 1 : 1
+        for (i = first; i <= c; i++) print lines[i]
+      }
+    ' "$_log")
+    if [ -n "$_slice" ]; then
+      _shown=1
+      echo ""
+      echo "  ── output for $_task (last 60 lines) ──"
+      printf '%s\n' "$_slice" | sed 's/^/  /'
+    fi
+  done
+
+  if [ "$_shown" -eq 0 ]; then
+    echo ""
+    echo "  (no per-task output found in the captured log — full log follows)"
+    cat "$_log"
+  fi
+
+  echo ""
+  echo "  Inspect (re-run ONLY the failing task — seconds, not the full set):"
+  printf '%s\n' "$_failed" | sed 's/^/  npx nx run /'
+}
+
+CI=true npx nx affected --target=test --files="$files" --output-style=static >"$out" 2>&1
 status=$?
 
 if [ "$status" -ne 0 ]; then
-  cat "$out"
+  print_gate3_failures "$out"
   echo ""
   echo "✖ pre-commit: affected test failed — fix and re-commit."
-  echo "  Inspect: npx nx affected -t test --files=\"$files\", fix the failure, then commit again."
   echo "  (bypass in an emergency with: git commit --no-verify)"
   exit 1
 fi
