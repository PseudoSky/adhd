{
  "name": "agent-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "entrypoint/agent-mcp/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["{projectRoot}"]
    }
  },
  "tags": ["entrypoint:mcp", "pkg-class:entrypoint", "platform:node"],
  "targets": {
    "build": {
      "//": "Override of the `build` target inferred by @nx/js/typescript (see that plugin's registration in nx.json for why the inferred `tsc --build tsconfig.lib.json` cannot run in this workspace). The trailing cp calls reproduce the `assets` globs the retired tsc build executor copied; the rest of that spec (README/CHANGELOG/llms.txt/drizzle/package.json) is owned by the inferred `assets` target.",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": ".",
        "command": "node node_modules/typescript/bin/tsc -p {projectRoot}/tsconfig.lib.json --outDir {projectRoot}/dist --rootDir {projectRoot} --baseUrl {projectRoot} --composite false --noEmitOnError && cp {projectRoot}/*.md {projectRoot}/LICENSE {projectRoot}/dist/ && cp -R {projectRoot}/docs {projectRoot}/dist/"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p entrypoint/agent-mcp/tsconfig.typecheck.json --noEmit"
      }
    },
    "nx-release-publish": {
      "dependsOn": [
        "build",
        "test",
        "verify-dist-load",
        "dist-manifest",
        "publish-hygiene"
      ],
      "options": {
        "packageRoot": "{projectRoot}/dist"
      }
    }
  }
}
