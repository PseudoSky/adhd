{
  "meta": {
    "name": "binary-base64",
    "origin": "synthetic-protocol-conformant",
    "chromeVersion": "126.0.6478.0"
  },
  "steps": [
    {
      "when": {
        "method": "Page.enable"
      }
    },
    {
      "when": {
        "method": "Network.enable"
      }
    },
    {
      "when": {
        "method": "Page.navigate",
        "params": {
          "url": "https://site.test/img.png"
        }
      },
      "reply": {
        "result": {
          "frameId": "F1",
          "loaderId": "L1"
        }
      },
      "emit": [
        {
          "method": "Network.requestWillBeSent",
          "params": {
            "requestId": "R1",
            "loaderId": "L1",
            "documentURL": "https://site.test/img.png",
            "request": {
              "url": "https://site.test/img.png",
              "method": "GET",
              "headers": {
                "Accept": "*/*"
              }
            },
            "timestamp": 100.0,
            "wallTime": 1700000000.0,
            "initiator": {
              "type": "other"
            },
            "type": "Image"
          }
        },
        {
          "method": "Network.responseReceived",
          "params": {
            "requestId": "R1",
            "loaderId": "L1",
            "timestamp": 100.1,
            "type": "Image",
            "response": {
              "url": "https://site.test/img.png",
              "status": 200,
              "statusText": "",
              "headers": {
                "content-type": "image/png"
              },
              "mimeType": "image/png"
            }
          }
        },
        {
          "method": "Network.loadingFinished",
          "params": {
            "requestId": "R1",
            "timestamp": 100.2,
            "encodedDataLength": 8
          }
        }
      ]
    },
    {
      "when": {
        "method": "Network.getResponseBody"
      },
      "reply": {
        "result": {
          "body": "iVBORw0KGgo=",
          "base64Encoded": true
        }
      }
    }
  ]
}
