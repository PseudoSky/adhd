{
  "name": "environment-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "entrypoint/environment-cli/src",
  "projectType": "application",
  "tags": [
    "domain:entrypoint",
    "pkg-kind:entrypoint",
    "pkg-class:entrypoint",
    "layer:entrypoints",
    "platform:node"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "generatePackageJson": true,
      "updateBuildableProjectDepsInPackageJson": true,
      "buildableProjectDepsInPackageJsonType": "dependencies",
      "options": {
        "outputPath": "dist/entrypoint/environment-cli",
        "tsConfig": "entrypoint/environment-cli/tsconfig.lib.json",
        "packageJson": "entrypoint/environment-cli/package.json",
        "main": "entrypoint/environment-cli/src/index.ts",
        "assets": ["entrypoint/environment-cli/*.md"],
        "createLockFile": false
      }
    }
  }
}
